---
// Reviews of a home from the sitters who stayed (owner, round 3: "they need
// reviews too, same concept as sitters"). A swipeable row of cards, used on
// both owner page designs. First names and city or region only.
interface Props { reviews: { text: string; name: string; initials?: string; platform?: string }[] }
const { reviews } = Astro.props;
const ini = (n: string) => n.split(/\s+/).map((w) => w[0] || '').join('').slice(0, 2).toUpperCase();
---
<div class="orv">
  <div class="orv-sum"><span class="orv-st" aria-hidden="true">★★★★★</span><span>{reviews.length} {reviews.length === 1 ? 'review' : 'reviews'} from sitters</span></div>
  <div class="orv-row">
    {reviews.map((r) => (
      <figure class="orv-card">
        <span class="orv-st" aria-label="Five stars">★★★★★</span>
        <blockquote>“{r.text}”</blockquote>
        <figcaption><i>{r.initials || ini(r.name)}</i><span><b>{r.name}</b><small>Sitter{r.platform && r.platform !== 'MYAH' ? ' · ' + r.platform : ' on MYAH'}</small></span></figcaption>
      </figure>
    ))}
  </div>
</div>
<style is:global>
  .orv-sum { display:flex; align-items:center; gap:12px; margin:0 0 20px; font-size:.78rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--soft,#6b4e35); }
  .orv-st { color:var(--accent,#2f5d45); letter-spacing:.22em; }
  .orv-row { display:flex; gap:18px; overflow-x:auto; scrollbar-width:none; scroll-snap-type:x mandatory; padding:2px 2px 10px; }
  .orv-row::-webkit-scrollbar { display:none; }
  .orv-card { flex:none; width:340px; margin:0; scroll-snap-align:start; display:flex; flex-direction:column; gap:14px; background:#fff; border:1px solid rgba(110,84,56,.2); border-radius:18px; padding:26px 24px; box-shadow:0 10px 28px rgba(44,26,14,.05); }
  .orv-card blockquote { margin:0; font-size:.93rem; line-height:1.75; font-style:italic; color:var(--soft,#6b4e35); }
  .orv-card figcaption { display:flex; align-items:center; gap:12px; margin-top:auto; padding-top:14px; border-top:1px solid rgba(44,26,14,.08); }
  .orv-card figcaption i { font-style:normal; width:40px; height:40px; border-radius:50%; background:var(--accent,#2f5d45); color:#fff; display:flex; align-items:center; justify-content:center; font-size:.76rem; font-weight:600; flex:none; }
  .orv-card b { display:block; font-size:.9rem; color:var(--ink,#2c1a0e); }
  .orv-card small { font-size:.76rem; color:var(--soft,#6b4e35); }
  @media (max-width:640px) { .orv-card { width:84%; padding:20px 18px; } .orv-row { margin:0 -16px; padding:2px 16px 10px; scroll-padding:0 16px; } }
</style>
