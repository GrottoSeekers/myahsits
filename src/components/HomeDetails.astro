---
// "The home" on an owner's page, Airbnb style (owner, round 3): the key facts,
// highlights, then tabs for what the home offers, sleeping, house rules, the
// sitter's jobs, the area and who they're looking for. Used by the Basic
// owner page and the Premium one (OwnerSignature), in the page's colours.
import { type Home, homeFacts, homeRules, carLine } from '../lib/home';
interface Props { home: Home; amenities: string[]; lookingFor: string[]; first: string }
const { home, amenities, lookingFor, first } = Astro.props;
const facts = homeFacts(home);
const rules = homeRules(home);
const car = carLine(home);
const AM_FIRST = 8;
const tabs = [
  { id: 'offers', label: 'What it offers', show: amenities.length > 0 },
  { id: 'sleep', label: 'Sleeping', show: !!home.room },
  { id: 'rules', label: 'House rules', show: rules.length > 0 || !!home.rules_note || !!home.alone },
  { id: 'jobs', label: 'Your jobs', show: home.duties.length > 0 },
  { id: 'area', label: "Where you'll be", show: !!(home.area || home.nearby || car) },
  { id: 'looking', label: 'Looking for', show: lookingFor.length > 0 },
].filter((t) => t.show);
const ICON: Record<string, string> = {
  type: '<path d="M3 10.5 12 3l9 7.5V21H3z"/><path d="M9 21v-6h6v6"/>',
  bed: '<path d="M3 18V7M21 18v-5a3 3 0 0 0-3-3h-8v8M3 14h18"/><circle cx="7" cy="11" r="1.6"/>',
  bath: '<path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/><path d="M6 12V6a2 2 0 0 1 4 0"/><path d="M7 19l-1 2M17 19l1 2"/>',
  out: '<path d="M12 21v-7"/><path d="M12 14c-4 0-6-3-6-6a6 6 0 0 1 12 0c0 3-2 6-6 6z"/>',
};
const factIcons = [home.type && 'type', home.bedrooms && 'bed', home.bathrooms && 'bath', home.outdoor && 'out'].filter(Boolean) as string[];
const uid = 'hd' + Math.random().toString(36).slice(2, 7);
---
<div class="hd" data-hd={uid}>
  {facts.length > 0 && (
    <ul class="hd-facts">
      {facts.map((f, i) => <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[factIcons[i]] || ICON.type}></svg><span>{f}</span></li>)}
    </ul>
  )}
  {home.highlights.length > 0 && (
    <ul class="hd-hl">
      {home.highlights.map((h) => <li><i aria-hidden="true">✦</i>{h}</li>)}
    </ul>
  )}
  {tabs.length > 0 && (
    <>
      <div class="hd-tabs" role="tablist" aria-label={`About ${first}'s home`}>
        {tabs.map((t, i) => <button type="button" role="tab" id={`${uid}-t-${t.id}`} aria-controls={`${uid}-p-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>)}
      </div>
      <div class="hd-panels">
        {tabs.map((t, i) => (
          <div class="hd-panel" role="tabpanel" id={`${uid}-p-${t.id}`} aria-labelledby={`${uid}-t-${t.id}`} hidden={i !== 0}>
            {t.id === 'offers' && (
              <>
                <ul class="hd-am" data-hd-am>{amenities.map((a, k) => <li class={k >= AM_FIRST ? 'more' : undefined}><span aria-hidden="true">✓</span>{a}</li>)}</ul>
                {amenities.length > AM_FIRST && <button type="button" class="hd-all" data-hd-all>Show all {amenities.length} amenities</button>}
              </>
            )}
            {t.id === 'sleep' && <div class="hd-card"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.bed}></svg><div><b>Your room</b><p>{home.room}</p></div></div>}
            {t.id === 'rules' && (
              <ul class="hd-list">
                {rules.map((r) => <li>{r}</li>)}
                {home.alone && <li>Pets can be left alone: {home.alone.replace(/^./, (c) => c.toLowerCase())}</li>}
                {home.rules_note && <li>{home.rules_note}</li>}
              </ul>
            )}
            {t.id === 'jobs' && <div class="hd-chips">{home.duties.map((d) => <span>{d}</span>)}</div>}
            {t.id === 'area' && (
              <div class="hd-area">
                {home.area && <p>{home.area}</p>}
                <ul class="hd-list">
                  {home.nearby && <li>{home.nearby}</li>}
                  {car && <li>{car}</li>}
                </ul>
              </div>
            )}
            {t.id === 'looking' && <div class="hd-area">{lookingFor.map((l) => <p>{l}</p>)}</div>}
          </div>
        ))}
      </div>
    </>
  )}
</div>

<style is:global>
  .hd { display:flex; flex-direction:column; gap:22px; }
  .hd-facts { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:10px; }
  .hd-facts li { display:inline-flex; align-items:center; gap:9px; padding:10px 16px; border-radius:14px; background:#fff; border:1px solid rgba(110,84,56,.2); font-size:.88rem; color:var(--ink,#2c1a0e); }
  .hd-facts svg { width:20px; height:20px; fill:none; stroke:var(--accent,#2f5d45); stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; flex:none; }
  .hd-hl { list-style:none; margin:0; padding:0; display:grid; gap:10px; }
  .hd-hl li { display:flex; align-items:center; gap:12px; font-size:.95rem; color:var(--ink,#2c1a0e); }
  .hd-hl i { font-style:normal; width:30px; height:30px; flex:none; border-radius:50%; display:flex; align-items:center; justify-content:center; background:color-mix(in srgb, var(--accent,#2f5d45) 12%, #fff); color:var(--accent,#2f5d45); font-size:.7rem; }
  .hd-tabs { display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding-bottom:2px; }
  .hd-tabs::-webkit-scrollbar { display:none; }
  .hd-tabs button { flex:none; font-family:'Montserrat',sans-serif; font-size:.74rem; font-weight:600; letter-spacing:.06em; color:#5c3d20; background:#fff; border:1px solid rgba(110,84,56,.28); border-radius:50px; padding:10px 16px; cursor:pointer; transition:background .2s, color .2s, border-color .2s; }
  .hd-tabs button:hover { border-color:var(--accent,#2f5d45); }
  .hd-tabs button[aria-selected="true"] { background:var(--accent,#2f5d45); border-color:var(--accent,#2f5d45); color:#fff; }
  .hd-panels { background:#fff; border:1px solid rgba(110,84,56,.2); border-radius:18px; padding:24px; }
  .hd-panel { animation:hd-in .35s ease both; }
  @keyframes hd-in { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
  .hd-am { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px 24px; }
  .hd-am li { display:flex; align-items:center; gap:10px; font-size:.92rem; color:var(--ink,#2c1a0e); }
  .hd-am li span { color:var(--accent,#2f5d45); font-weight:700; }
  .hd-am li.more { display:none; }
  .hd-am.all li.more { display:flex; }
  .hd-all { margin-top:18px; font-family:'Montserrat',sans-serif; font-size:.72rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--accent,#2f5d45); background:none; border:1.5px solid rgba(110,84,56,.35); border-radius:50px; padding:10px 20px; cursor:pointer; }
  .hd-card { display:flex; gap:14px; align-items:flex-start; }
  .hd-card svg { width:40px; height:40px; padding:9px; border-radius:12px; background:var(--bg,#faf6ee); fill:none; stroke:var(--accent,#2f5d45); stroke-width:1.6; flex:none; }
  .hd-card b { display:block; font-family:'Marcellus',serif; font-weight:400; font-size:1.1rem; color:var(--ink,#2c1a0e); margin-bottom:4px; }
  .hd-card p, .hd-area p { margin:0 0 10px; font-size:.94rem; line-height:1.75; color:var(--soft,#6b4e35); }
  .hd-list { list-style:none; margin:0; padding:0; display:grid; gap:10px; }
  .hd-list li { position:relative; padding-left:22px; font-size:.92rem; line-height:1.6; color:var(--ink,#2c1a0e); }
  .hd-list li::before { content:""; position:absolute; left:4px; top:.6em; width:7px; height:7px; border-radius:50%; background:var(--accent,#2f5d45); }
  .hd-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .hd-chips span { padding:9px 15px; border-radius:50px; background:var(--bg,#faf6ee); border:1px solid rgba(110,84,56,.22); font-size:.86rem; color:#5c3d20; }
  @media (max-width:640px) {
    .hd { gap:16px; }
    .hd-facts li { padding:8px 12px; font-size:.8rem; }
    .hd-panels { padding:18px; }
    .hd-am { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:10px 14px; }
    .hd-am li { font-size:.84rem; }
  }
</style>

<script is:inline define:vars={{ uid }}>
(() => {
  const box = document.querySelector('[data-hd="' + uid + '"]');
  if (!box) return;
  const tabs = [...box.querySelectorAll('[role=tab]')];
  const show = (t) => tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute('aria-controls')).hidden = !on; });
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t));
    t.addEventListener('keydown', (e) => { const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (d) { e.preventDefault(); const n = tabs[(i + d + tabs.length) % tabs.length]; show(n); n.focus(); } });
  });
  const all = box.querySelector('[data-hd-all]');
  all && all.addEventListener('click', () => { const l = box.querySelector('[data-hd-am]'); const o = l.classList.toggle('all'); all.textContent = o ? 'Show fewer' : 'Show all ' + l.children.length + ' amenities'; });
})();
</script>
