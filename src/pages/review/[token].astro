---
export const prerender =
  false;
import {
  supabase,
} from
  '../../lib/supabase';

const { token } =
  Astro.params;
const ok =
  Astro.url.searchParams
  .get('success');
const success =
  ok === '1' ||
  ok === 'true';

// Token validation: the
// form needs a pending
// request with this token.
let name = '';
let photo = '';
let slug = '';
let valid = false;
let used = false;
let ownerId = '';
if (token) {
  const pr =
    await supabase
    .from('profiles')
    .select(
      'name, slug, user_id,' +
      ' profile_pic,' +
      ' review_requests_json',
    )
    .not(
      'review_requests_json',
      'is',
      null,
    );
  for (const p of pr.data ??
    []) {
    const reqs =
      Array.isArray(
        p.review_requests_json,
      )
        ? p
          .review_requests_json
        : [];
    const match =
      reqs.find(
        (r: any) =>
          r.token === token,
      );
    if (!match) continue;
    name = p.name || '';
    photo =
      p.profile_pic || '';
    slug = p.slug || '';
    ownerId = p.user_id || '';
    valid =
      match.status ===
      'pending';
    used = !valid;
    break;
  }
}

// Home owners get reviews from sitters too (owner, round 3): same link,
// questions about the home and the welcome instead of the sitting.
let isOwner = false;
if (ownerId) {
  try {
    const u = await supabase.from('users').select('role').eq('id', ownerId).maybeSingle();
    isOwner = u.data?.role === 'owner';
  } catch {}
}
const cats = isOwner
  ? [
    ['accuracy', 'Home as described', 'The home, area and amenities matched the page'],
    ['pets', 'Pets as described', 'Routines, needs and personalities were as told'],
    ['communication', 'Communication', 'Clear instructions and quick replies'],
    ['welcome', 'Welcome & handover', 'A tidy home, a good handover and a warm welcome'],
    ['again', 'Would sit again', 'How happy you would be to come back'],
  ]
  : [
    ['cleanliness', 'Cleanliness', 'How you found the home on your return'],
    ['communication', 'Communication', 'Updates, replies and clarity'],
    ['pet_care', 'Care of pets', 'Routines, walks and affection'],
    ['reliability', 'Reliability', 'Turning up and doing what was agreed'],
    ['extra_mile', 'Going the extra mile', 'The things nobody asked for'],
  ];

const view =
  success && (valid || used)
    ? 'success'
    : valid
      ? 'form'
      : 'invalid';

const tx = (
  s: string,
) => s.trim();
// Design copy — used
// when there is no name.
const introDef = tx(`
Callum & Niamh have asked you to share your experience. Your review will appear on their MYAH profile page.
`);
const thanksDef = tx(`
Your review has been submitted and will appear on Callum & Niamh's profile.
`);
const plural =
  name.includes('&') ||
  / and /i.test(name);
const intro = name
  ? name +
    (plural
      ? ' have'
      : ' has') +
    ' asked you to' +
    ' share your' +
    ' experience.' +
    ' Your review' +
    ' will appear on' +
    ' their MYAH' +
    ' profile page.'
  : introDef;
const thanks = name
  ? 'Your review has' +
    ' been submitted' +
    ' and will appear' +
    ' on ' +
    name +
    "'s profile."
  : thanksDef;
const pic =
  photo ||
  '/images/' +
  'avatar-cream.png';
const profileHref = slug
  ? '/' + slug
  : '/';
const title =
  view === 'success'
    ? 'Thank you!'
    : view === 'invalid'
      ? 'Link not valid'
      : 'Leave a review';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>{title} — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @keyframes card-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @media (max-width: 700px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-wrap] { padding: 36px 20px !important; }
      [data-card] { padding: 32px 24px !important; }
    }

    /* Field focus — same treatment as Log in */
    [data-review] input:focus, [data-review] textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }

    .rv-logo:hover { transform:translateY(-1px) !important; }
    .rv-card:hover { box-shadow:0 14px 44px rgba(44,26,14,.1) !important; border-color:rgba(110,84,56,.4) !important; }
    .rv-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; color:#fff !important; }
    .rv-btn:active { transform:translateY(0) scale(.98) !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <nav data-topnav="1" style="display:flex;justify-content:center;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.2)">
    <a href="/" class="rv-logo" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;transition:transform .25s ease;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:#2f5d45;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
    </a>
  </nav>

  <main data-wrap="1" style="flex:1;display:flex;align-items:center;justify-content:center;padding:60px 24px">

    {view === 'form' && (
      <div data-card="1" class="rv-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:20px;padding:48px;box-shadow:0 4px 28px rgba(44,26,14,.07);max-width:580px;width:100%;animation:card-in .4s ease;transition:box-shadow .3s ease, border-color .3s ease">
        <div style="display:flex;gap:20px;align-items:center;margin-bottom:26px">
          <img src={pic} alt={name} style="width:76px;height:76px;border-radius:50%;object-fit:cover;border:3px solid rgba(110,84,56,.32);flex-shrink:0" />
          <div style="min-width:0">
            <p style="font-size:.74rem;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#6e5438;margin:0 0 8px;display:flex;align-items:center;gap:10px"><span style="width:22px;height:1px;background:#2f5d45;display:block;flex-shrink:0"></span>Leave a review for</p>
            <h1 style="font-family:'Marcellus',serif;font-size:1.95rem;color:#2c1a0e;line-height:1.2;margin:0">{name}</h1>
          </div>
        </div>

        <p style="font-size:.95rem;color:#6b4e35;line-height:1.8;margin:0 0 28px;padding-bottom:26px;border-bottom:1px solid rgba(44,26,14,.08)">{intro}</p>

        <div data-form-error="1" role="alert" style="display:none;margin:0 0 22px;padding:14px 18px;border-radius:12px;background:#fdeeee;border:1px solid #f7cfcf;font-size:.86rem;font-weight:600;color:#a4442e"></div>

        <div style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:26px 24px;margin-bottom:26px">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:20px">
            <div>
              <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 6px">Rate your sit</p>
              <p style="font-size:.85rem;color:#6b4e35;margin:0;line-height:1.6">Tap the stars for each part of the stay.</p>
            </div>
            <div data-avg-box="1">
              <span data-avg-value="1" style="font-family:'Marcellus',serif;font-size:1.9rem;color:#6e5438;line-height:1"></span>
              <span data-avg-stars="1" style="display:block;color:#2f5d45;font-size:.8rem;letter-spacing:.2em;margin-top:2px"></span>
              <span data-avg-label="1" style="display:block;font-size:.66rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin-top:6px"></span>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            {cats.map(([key, label, hint]) => (
            <div data-cat={key} style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:11px 0;border-top:1px solid rgba(44,26,14,.08);flex-wrap:wrap">
              <span style="display:flex;flex-direction:column;gap:2px;min-width:0">
                <span data-cat-label="1" style="font-size:.9rem;font-weight:600;color:#2c1a0e">{label}</span>
                <span style="font-size:.78rem;color:#6b4e35">{hint}</span>
              </span>
              <span data-stars="1" style="display:flex;align-items:center;gap:5px;flex-shrink:0"></span>
            </div>
            ))}
          </div>
        </div>

        <form data-review="1" action="/api/review/submit" method="POST" style="display:flex;flex-direction:column;gap:22px">
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="ratings" data-ratings="1" value="{}" />
          <div>
            <label for="rname" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Your name <span style="color:#2f5d45">*</span></label>
            <input type="text" id="rname" name="name" required="required" placeholder="e.g. Sarah &amp; Tom" autocomplete="name" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .25s ease, box-shadow .25s ease" />
            <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">This will be shown alongside your review.</p>
          </div>
          <div>
            <label for="rtext" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Your review <span style="color:#2f5d45">*</span></label>
            <textarea data-text="1" id="rtext" name="text" rows="5" required="required" placeholder={isOwner ? "What was your sit like? Tell other sitters about the home, the pets and the welcome." : "What was your experience like? How did they look after your pets and home?"} style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .25s ease, box-shadow .25s ease"></textarea>
            <div style="display:flex;justify-content:space-between;gap:16px;margin-top:8px">
              <p style="font-size:.82rem;color:#6b4e35;margin:0;line-height:1.6">{isOwner ? "Be as detailed as you like — sitters love reading real experiences." : "Be as detailed as you like — pet owners love reading real experiences."}</p>
              <p data-count="1" style="font-size:.78rem;color:#6b4e35;margin:0;white-space:nowrap;font-weight:600"></p>
            </div>
          </div>
          <button type="submit" class="rv-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;align-self:flex-start;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">Submit review</button>
        </form>
      </div>
    )}

    {view === 'success' && (
      <div data-card="1" class="rv-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:20px;padding:56px 48px;box-shadow:0 4px 28px rgba(44,26,14,.07);max-width:520px;width:100%;text-align:center;animation:card-in .4s ease;transition:box-shadow .3s ease, border-color .3s ease">
        <span style="width:70px;height:70px;border-radius:50%;background:rgba(110,84,56,.12);border:1px solid rgba(110,84,56,.35);color:#2f5d45;display:inline-flex;align-items:center;justify-content:center;margin-bottom:24px">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        </span>
        <h1 style="font-family:'Marcellus',serif;font-size:2rem;color:#2c1a0e;margin:0 0 14px">Thank you!</h1>
        <div style="width:48px;height:2px;background:#6e5438;margin:0 auto 22px"></div>
        <p style="font-size:.97rem;color:#6b4e35;line-height:1.8;margin:0 0 30px">{thanks}</p>
        <a href={profileHref} class="rv-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">View their profile</a>
      </div>
    )}

    {view === 'invalid' && (
      <div data-card="1" class="rv-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:20px;padding:56px 48px;box-shadow:0 4px 28px rgba(44,26,14,.07);max-width:520px;width:100%;text-align:center;animation:card-in .4s ease;transition:box-shadow .3s ease, border-color .3s ease">
        <span style="width:70px;height:70px;border-radius:50%;background:#faf6ee;border:1px solid rgba(110,84,56,.35);color:#2f5d45;display:inline-flex;align-items:center;justify-content:center;margin-bottom:24px">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10.6 13.4a3 3 0 0 0 4.2 0l3.2-3.2a3 3 0 0 0-4.2-4.2l-.6.6"></path><path d="M13.4 10.6a3 3 0 0 0-4.2 0l-3.2 3.2a3 3 0 0 0 4.2 4.2l.6-.6"></path></svg>
        </span>
        <h1 style="font-family:'Marcellus',serif;font-size:2rem;color:#2c1a0e;margin:0 0 14px">Link not valid</h1>
        <div style="width:48px;height:2px;background:#6e5438;margin:0 auto 22px"></div>
        <p style="font-size:.97rem;color:#6b4e35;line-height:1.8;margin:0 0 30px">This review link has already been used or is no longer valid. If you think this is a mistake, ask for a new link.</p>
        <a href="/" class="rv-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">Visit MYAH</a>
      </div>
    )}

  </main>
</div>

<script is:inline>
(() => {
  // Ported from the design's script: star ratings, average box, character count, loader.
  const q = s => document.querySelector(s);
  const qa = s => Array.from(document.querySelectorAll(s));

  const loader = q('[data-loader]');
  let hideT;
  const show = stay => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    if (!stay) hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };
  qa('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http')) return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; show(); });
  });

  const form = q('[data-review]');
  if (!form) return;

  const cats = qa('[data-cat]').map(row => ({
    key: row.getAttribute('data-cat'),
    label: row.querySelector('[data-cat-label]').textContent,
    row
  }));
  const state = { chars: 0, ratings: {} };

  const render = () => {
    const ratings = state.ratings;
    const given = cats.map(c => ratings[c.key]).filter(Boolean);
    const avg = given.length ? given.reduce((a, b) => a + b, 0) / given.length : 0;
    const rounded = Math.round(avg * 10) / 10;
    const full = Math.round(avg);

    cats.forEach(c => {
      const box = c.row.querySelector('[data-stars]');
      if (!box.children.length) {
        [1, 2, 3, 4, 5].forEach(n => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = '★';
          b.setAttribute('aria-label', n + ' star' + (n === 1 ? '' : 's') + ' for ' + c.label);
          b.addEventListener('click', () => {
            const next = Object.assign({}, state.ratings);
            next[c.key] = next[c.key] === n ? 0 : n;
            state.ratings = next;
            render();
          });
          box.appendChild(b);
        });
      }
      Array.from(box.children).forEach((b, i) => {
        const on = (ratings[c.key] || 0) >= i + 1;
        b.style.cssText = 'border:none;background:none;cursor:pointer;padding:2px;font-size:1.35rem;line-height:1;font-family:\'Montserrat\',sans-serif;transition:color .2s ease, transform .15s ease;color:' +
          (on ? '#2f5d45' : 'rgba(110,84,56,.3)');
      });
    });

    q('[data-avg-value]').textContent = given.length ? rounded.toFixed(1) : '—';
    q('[data-avg-stars]').textContent = given.length ? '★★★★★'.slice(0, full) + '☆☆☆☆☆'.slice(0, 5 - full) : '☆☆☆☆☆';
    q('[data-avg-label]').textContent = given.length === cats.length ? 'Overall rating' : given.length ? given.length + ' of ' + cats.length + ' rated' : 'Not rated yet';
    q('[data-avg-box]').style.cssText = 'text-align:center;min-width:126px;padding:14px 18px;border-radius:14px;background:#fff;transition:border-color .3s ease, box-shadow .3s ease;border:1.5px solid ' +
      (given.length === cats.length ? '#2f5d45;box-shadow:0 6px 18px rgba(110,84,56,.18);' : 'rgba(110,84,56,.3);');
    q('[data-count]').textContent = state.chars > 0 ? state.chars + ' characters' : '';
    q('[data-ratings]').value = JSON.stringify(ratings);
  };

  q('[data-text]').addEventListener('input', e => { state.chars = e.target.value.trim().length; render(); });

  // Submits to the existing /api/review/submit endpoint; only the loader shows here.
  form.addEventListener('submit', () => show(true));

  const messages = {
    missing: 'Please fill in your name and review.',
    server: 'Something went wrong. Please try again.'
  };
  const err = new URLSearchParams(location.search).get('error');
  const errEl = q('[data-form-error]');
  if (err && messages[err] && errEl) { errEl.textContent = messages[err]; errEl.style.display = 'block'; }

  render();
})();
</script>
</body>
</html>
