---
export const prerender =
  false;
import DashHero from '../components/DashHero.astro';
import DashGlance from '../components/DashGlance.astro';
import DashPreview from '../components/DashPreview.astro';
import { PAYMENTS_ENABLED, getBilling } from '../lib/billing';
import { layoutOf } from '../lib/tier';
import IdGate from
  './_idgate.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../lib/account';
import {
  getSession,
} from '../lib/auth';
import {
  supabase,
} from '../lib/supabase';
import {
  arr,
  tx,
  clip,
  dateRange,
  durationLabel,
  strength,
  sitterSits,
} from '../lib/dashboard';
import
  '../styles/dash.css';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'sitter',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

let profile: any = null;
try {
  const pr =
    await supabase
    .from('profiles')
    .select('*')
    .eq(
      'user_id',
      session.userId,
    )
    .single();
  profile = pr.data;
} catch {}
if (!profile) {
  return Astro.redirect(
    '/profile/create',
  );
}

const lr =
  await supabase
  .from('listings')
  .select(
    'id, title,' +
    ' description,' +
    ' date_from,' +
    ' date_to,' +
    ' profile_id,' +
    ' profiles!inner(' +
    'name, location,' +
    ' slug,' +
    ' profile_pic,' +
    ' pets_json,' +
    ' hero_images_json)'
  )
  .eq('status', 'active')
  .gte(
    'date_to',
    new Date()
    .toISOString()
    .slice(0, 10),
  )
  .order(
    'date_from',
    { ascending: true },
  );
const listings: any[] =
  lr.data ?? [];

const heroImages =
  arr(
    profile.hero_images_json,
  );
const aboutImages =
  arr(
    profile.about_images_json,
  );
const gallery = arr(
  profile.gallery_json,
);
const reviews = arr(
  profile.reviews_json,
);
const platforms = arr(
  profile.platforms_json,
);
const theme =
  profile.theme_json ??
  {};

// Design copy — used
// when a field is empty.
const taglineDef = tx(`
Experienced house & pet sitters available worldwide.
`);
const badgeDef = tx(`
Experienced sitters worldwide
`);
const aboutDef = tx(`
We're Callum and Niamh — a couple who have spent the last few years looking after homes and animals across the UK and Australia…
`);

const name: string =
  profile.name || '';
const slug: string =
  profile.slug || '';
const pageUrl =
  'myahsits.com/' +
  slug;
const shareUrl =
  'https://' + pageUrl;
const publicHref =
  '/' + slug;
// The founders' words
// and photos fill gaps on
// their own account only.
const F =
  profile.slug ===
  'callumandniamh';
const tagline =
  profile.tagline ||
  (F ? taglineDef : '');
const badge =
  profile.badge_text ||
  (F ? badgeDef : '');
const pic: string =
  profile.profile_pic ||
  (F
    ? '/images/couple-bw-1.jpg'
    : '/images/' +
      'avatar-cream.png');
const bio: string =
  profile.bio || '';
const aboutText =
  bio
    ? bio.length > 120
      ? bio.slice(0, 120) +
        '…'
      : bio
    : F
      ? aboutDef
      : 'Add a bio so' +
        ' owners can get' +
        ' to know you.';
const pvHero =
  heroImages[0] || {
    src: F
      ? '/images/' +
        'couple-villa-1.jpg'
      : '/images/slideshow-' +
        'living-room.jpeg',
    pos: 'center 30%',
  };
const pvHeroStyle =
  'width:100%;' +
  'height:100%;' +
  'object-fit:cover;' +
  'display:block;' +
  'object-position:' +
  (pvHero.pos ||
    'center 30%');
const pvAbout: string =
  aboutImages[0]?.src ||
  (F
    ? '/images/' +
      'couple-dinner-1.jpg'
    : pic);
const pvReviews = reviews
  .slice(0, 3)
  .map((r: any) => ({
    text: clip(
      r.text,
      60,
    ),
    name: r.name || '',
  }));
const pvGallery = gallery
  .slice(0, 8)
  .map((g: any) => g.src);

const items = [
  {
    label: 'Bio written',
    done: !!bio,
  },
  {
    label:
      'Hero photos added',
    done:
      heroImages.length >
      0,
  },
  {
    label: tx(`
Gallery photos added
`),
    done:
      gallery.length > 0,
  },
  {
    label:
      'Reviews collected',
    done:
      reviews.length > 0,
  },
  {
    label: tx(`
Platform links added
`),
    done:
      platforms.length >
      0,
  },
  {
    label: tx(`
Colours customised
`),
    done:
      Object.keys(theme)
      .length > 0,
  },
];
const st =
  strength(items);
const strengthLabel =
  st.label;
const strengthBar =
  'height:100%;width:' +
  st.pct +
  '%;border-radius:' +
  '50px;background:' +
  'linear-gradient(' +
  '90deg,#2f5d45 0%,' +
  '#3e7a5b 100%);' +
  'transition:width ' +
  '.4s ease';
const markOn =
  'background:#2f5d45;' +
  'color:#fff;';
const markOff =
  'background:' +
  'transparent;' +
  'border:1.5px dashed' +
  ' rgba(110,84,56,.55);' +
  'color:#2f5d45;';
const markBase =
  'width:20px;' +
  'height:20px;' +
  'border-radius:50%;' +
  'flex-shrink:0;' +
  'display:flex;' +
  'align-items:center;' +
  'justify-content:' +
  'center;' +
  'font-size:.64rem;' +
  'font-weight:700;' +
  'line-height:1;';
const checklist = items
  .map((i) => ({
    label: i.label,
    mark:
      i.done ? '✓' : '',
    markStyle:
      markBase +
      (i.done
        ? markOn
        : markOff),
  }));


// Confirmed sits: the
// next one for the strip
// and all of them for
// the Sits tab.
const mySits =
  await sitterSits(
  supabase,
  session.userId,
);
const nextSit =
  mySits.find(
    (c) => !c.past,
  ) || null;
const nextLine = nextSit
  ? [
    nextSit.dates,
    nextSit.who,
  ]
    .filter(Boolean)
    .join(' · ')
  : '';
const sitCardStyle =
  'display:flex;' +
  'flex-direction:' +
  'column;' +
  'background:#fff;' +
  'border:1px solid ' +
  'rgba(110,84,56,.22);' +
  'border-radius:18px;' +
  'overflow:hidden;' +
  'text-decoration:none;' +
  'color:inherit;' +
  'transition:transform' +
  ' .3s ease, ' +
  'box-shadow .3s ease,' +
  ' border-color .3s' +
  ' ease;';
const sits = listings
  .map((l: any) => {
    const lp =
      l.profiles || {};
    const pets = arr(
      lp.pets_json,
    );
    const lh = arr(
      lp.hero_images_json,
    );
    const petList = pets
      .slice(0, 3)
      .map((p: any) =>
        p.type
          ? p.name +
            ' · ' +
            p.type
          : p.name,
      );
    if (pets.length > 3) {
      petList.push(
        '+' +
        (pets.length - 3) +
        ' more',
      );
    }
    return {
      href:
        '/listings/' +
        l.id,
      title: l.title,
      owner: lp.location
        ? lp.name +
          ' · ' +
          lp.location
        : lp.name,
      dates: dateRange(
        l.date_from,
        l.date_to,
      ),
      duration:
        durationLabel(
          l.date_from,
          l.date_to,
        ),
      img:
        lh[0]?.src ||
        lp.profile_pic ||
        '',
      pic:
        lp.profile_pic ||
        '',
      petList,
    };
  });

const icons = {
  dashboard: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect>',
  sits: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>',
  messages: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>',
  profile: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>'
};
const tabs = [
  {
    id: 'dashboard',
    label: 'Dashboard',
  },
  {
    id: 'sits',
    label: 'Sits',
  },
  {
    id: 'messages',
    label: 'Messages',
  },
  {
    id: 'profile',
    label: 'Profile',
  },
].map((t, i) => ({
  ...t,
  icon: (icons as any)[
    t.id
  ],
  style:
    'flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:13px 4px 12px;border:none;background:none;cursor:pointer;position:relative;font-family:\'Montserrat\',sans-serif;color:' +
    (i === 0
      ? '#2f5d45'
      : '#8a6a4f') +
    ';transition:color' +
    ' .2s',
  underlineStyle:
    'position:absolute;bottom:0;left:22%;right:22%;height:3px;border-radius:3px 3px 0 0;background:' +
    (i === 0
      ? '#2f5d45'
      : 'transparent'),
}));
// Dashboard banner and stat cards (founders' page style).
const dashBilling = PAYMENTS_ENABLED ? await getBilling(session.userId).catch(() => null) : null;
const design = layoutOf(profile, dashBilling);
const firstName = String(name || '').split(/\s+&\s+|\s+/)[0] || name;
const dashPhoto = heroImages[0]?.src ? { src: heroImages[0].src, pos: heroImages[0].pos } : { src: pvHero.src, pos: pvHero.pos };
const glance = [
  { n: reviews.length, l: reviews.length === 1 ? 'review' : 'reviews', icon: 'quote', href: '/profile/edit#reviews' },
  { n: sits.length, l: 'sits to apply for', icon: 'cal', href: '/listings' },
  { n: gallery.length, l: 'photos on your page', icon: 'photo', href: '/profile/edit#photos' },
  { n: platforms.length || st.done, l: platforms.length ? 'other profiles' : 'of ' + st.total + ' steps done', icon: 'star', href: '/profile/edit' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Dashboard — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 900px) {
      [data-topnav] { padding: 12px 24px !important; }
      [data-dash-pad] { padding: 28px 24px 60px !important; }
      [data-dash-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-stats] { flex-direction: row !important; }
      [data-dash-two] { grid-template-columns: minmax(0,1fr) !important; }
    }
    @media (max-width: 560px) {
      [data-dash-pad] { padding: 16px 16px 48px !important; }
      [data-panel="dashboard"] { gap: 16px !important; }
      [data-dash-two] { gap: 16px !important; }
      .db-next { padding: 16px 18px !important; gap: 14px !important; }
      .db-next > div { min-width: 0 !important; flex-basis: calc(100% - 80px) !important; }
      .db-next > span:last-child { width: 100%; padding: 11px 20px !important; }
    }

    .db-nav-link:hover { color:#2f5d45 !important; }
    .db-pill:hover { background:#2f5d45 !important; color:#fff !important; border-color:#2f5d45 !important; }
    .db-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .db-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; color:#fff !important; }
    .db-btn:active { transform:translateY(0) scale(.98) !important; }
    .db-text-link:hover { color:#2c1a0e !important; }
    .db-sit:hover { transform:translateY(-6px) !important; box-shadow:0 20px 50px rgba(44,26,14,.12) !important; border-color:rgba(110,84,56,.45) !important; }

    .db-next:hover { transform:translateY(-3px) !important; box-shadow:0 16px 40px rgba(44,26,14,.22) !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <link rel="stylesheet" href="/dash.css" />
  <link rel="stylesheet" href="/apptabs.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <nav data-topnav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.18)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:#2f5d45;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
    </a>
    <button type="button" data-acct-toggle="1" aria-label="Menu" aria-expanded="false" onclick="var n=this.closest('[data-topnav]');var o=n.classList.toggle('acct-open');this.setAttribute('aria-expanded',o)"><span></span><span></span><span></span></button>
    <div data-acct-links="1" style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;justify-content:flex-end">
      <a href="/listings" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Browse sits</a>
      <a href="/saved" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Saved</a>
      <a href="/availability" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Availability</a>
      <a href="/verification" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Verification</a>
      <a href="/notifications" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Notifications</a>
      <a href="/api/auth/logout" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;white-space:nowrap;transition:color .2s">Log out</a>
    </div>
  </nav>

  <div class="apt"><div class="apt-in">
    {tabs.map((t, i) => (
      <button type="button" data-tab={t.id} class="apt-t" aria-current={i === 0 ? 'page' : undefined}>
        <span class="apt-ic">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon}></svg>
          {t.id === 'messages' && (
            <span data-msg-badge="1" class="apt-badge">0</span>
          )}
        </span>
        <span>{t.label}</span>
      </button>
    ))}
  </div></div>

  <div data-msg-toasts="1" style="position:fixed;top:20px;right:20px;z-index:1000;display:flex;flex-direction:column;gap:10px;pointer-events:none"></div>

  <main data-dash-pad="1" style="flex:1;padding:44px 48px 70px">
    <div style="max-width:1100px;margin:0 auto">
      <IdGate profile={acct!.profile} what="apply for sits and message owners" />

      <div data-panel="dashboard" style="display:flex;flex-direction:column;gap:24px">
        <DashHero kicker="Your sitter dashboard" first={firstName} photo={dashPhoto} avatar={pic} line={tagline} url={pageUrl} href={publicHref}
          primary={{ href: '/profile/edit', label: 'Edit your page' }} secondary={{ href: publicHref, label: 'View your page' }}
          pills={[{ href: '/profile/edit#photos', label: 'Add photos' }, { href: '/profile/edit#reviews', label: 'Request a review' }, { href: '/availability', label: 'Your availability' }, { href: '/profile/edit#page-style', label: 'Page design' }]}
          pct={st.pct} pctLabel="Page complete" design={design} designHref="/profile/edit#page-style" />
{nextSit && (
          <a href={nextSit.href} class="db-next" style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;background:#2c1a0e;border-radius:18px;padding:24px 28px;text-decoration:none;color:#fff;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:transform .3s ease, box-shadow .3s ease">
            {nextSit.pic ? (
              <img src={nextSit.pic} alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(196,171,138,.5)" />
            ) : (
              <span style="width:56px;height:56px;border-radius:50%;flex-shrink:0;background:rgba(196,171,138,.18);color:#c4ab8a;font-family:'Marcellus',serif;font-size:1.3rem;display:flex;align-items:center;justify-content:center">{nextSit.who.charAt(0)}</span>
            )}
            <div style="flex:1;min-width:220px">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#c4ab8a;margin:0 0 8px">{nextSit.when}</p>
              <p style="font-family:'Marcellus',serif;font-size:1.3rem;color:#fff;margin:0 0 4px;line-height:1.25">{nextSit.title}</p>
              <p style="font-size:.86rem;color:rgba(255,255,255,.7);margin:0">{nextLine}</p>
            </div>
            <span style="display:inline-flex;align-items:center;justify-content:center;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 26px;white-space:nowrap">Open sit pack</span>
          </a>
        )}
        <DashGlance items={glance} />

        <div data-dash-two="1" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:stretch">
        <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
          <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 8px">Share your profile</h3>
          <p class="db-share-txt" style="font-size:.93rem;color:#6b4e35;margin:0 0 20px;line-height:1.7;max-width:560px">Send this link to pet owners so they can view your full portfolio, reviews, and get in touch.</p>
          <div class="db-share-row" style="display:flex;gap:12px;flex-wrap:wrap">
            <input data-share="1" type="text" readonly="readonly" value={shareUrl} style="flex:1;min-width:240px;border:1.5px solid rgba(44,26,14,.15);border-radius:10px;padding:13px 16px;font-size:.92rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none" />
            <button type="button" data-copy="1" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:13px 28px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Copy</button>
          </div>
        </div>

        <details class="db-card db-fold" open data-fold="1" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
          <summary>
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:16px">
            <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Profile strength</h3>
            <span style="font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45">{strengthLabel}</span>
          </div>
          <div style="height:8px;border-radius:50px;background:rgba(110,84,56,.15);overflow:hidden;margin-bottom:22px">
            <div style={strengthBar}></div>
          </div>
          <span class="db-fold-more">See the checklist &darr;</span>
          </summary>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px">
            {checklist.map((c) => (
              <div style="display:flex;align-items:center;gap:11px;font-size:.88rem;color:#2c1a0e">
                <span style={c.markStyle}>{c.mark}</span>{c.label}
              </div>
            ))}
          </div>
        </details>

        </div>

        <DashPreview href={publicHref} url={pageUrl} edit="/profile/edit" />
      </div>

      <div data-panel="sits" style="display:none">
        {mySits.length > 0 && (
          <div style="margin-bottom:38px">
            <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 18px">Confirmed sits</p>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:22px">
              {mySits.map((c) => (
                <a href={c.href} class="db-sit" style={c.past ? sitCardStyle + 'opacity:.7;' : sitCardStyle}>
                  <div style="position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#e9e0d2">
                    {c.img && <img src={c.img} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />}
                    <span style="position:absolute;top:14px;left:14px;background:#2f5d45;color:#fff;font-size:.7rem;font-weight:700;letter-spacing:.06em;padding:7px 15px;border-radius:50px">{c.when}</span>
                  </div>
                  <div style="padding:20px 22px 22px;display:flex;flex-direction:column;gap:8px">
                    <h3 style="font-family:'Marcellus',serif;font-size:1.12rem;color:#2c1a0e;line-height:1.3;margin:0">{c.title}</h3>
                    <div style="display:flex;align-items:center;gap:10px">
                      {c.pic && <img src={c.pic} alt="" style="width:30px;height:30px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.25)" />}
                      <span style="font-size:.84rem;color:#6b4e35">{c.who}</span>
                    </div>
                    <p style="font-size:.83rem;color:#5c3d20;font-weight:700;margin:0">{c.dates} &middot; {c.duration}</p>
                    <span style="font-size:.74rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;margin-top:6px">Open sit pack &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
        <div style="margin-bottom:34px">
          <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Available sits</p>
          <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;margin:0 0 10px;line-height:1.2">Find your <em style="color:#2f5d45;">next sit</em></h1>
          <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;max-width:600px;margin:0">Browse homes looking for trusted sitters. Open any listing to see the full details, meet the pets, and get in touch.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:26px">
          {sits.map((sit) => (
            <a href={sit.href} class="db-sit" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;text-decoration:none;color:inherit;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease">
              <div style="position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;background:#e9e0d2">
                {sit.img && <img src={sit.img} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />}
                <span style="position:absolute;top:14px;left:14px;background:#fff;color:#2c1a0e;font-size:.72rem;font-weight:700;letter-spacing:.06em;padding:7px 15px;border-radius:50px;box-shadow:0 2px 8px rgba(0,0,0,.14)">{sit.duration}</span>
              </div>
              <div style="padding:20px 22px 24px">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px">
                  <h3 style="font-family:'Marcellus',serif;font-size:1.12rem;color:#2c1a0e;line-height:1.3;margin:0;flex:1">{sit.title}</h3>
                  {sit.pic && <img src={sit.pic} alt="" style="width:38px;height:38px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.25)" />}
                </div>
                <p style="font-size:.83rem;color:#6b4e35;margin:6px 0 10px">{sit.owner}</p>
                <p style="font-size:.83rem;color:#5c3d20;font-weight:700;margin:0 0 12px">{sit.dates}</p>
                <div style="display:flex;flex-wrap:wrap;gap:7px">
                  {sit.petList.map((p) => (
                    <span style="background:rgba(110,84,56,.08);color:#5c3d20;font-size:.74rem;font-weight:700;padding:5px 13px;border-radius:50px;border:1px solid rgba(110,84,56,.22)">{p}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div data-panel="messages" class="db-card" style="display:none;background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
        <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></span>
        <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">No messages yet</h2>
        <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0">When an owner gets in touch about a sit, the conversation will appear here.</p>
      </div>

      <div data-panel="profile" class="db-card" style="display:none;background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
        <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
        <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">Edit your profile</h2>
        <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">Update your bio, photos, reviews, platform links and colours — everything that appears on your public page.</p>
        <a href="/profile/edit" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Open profile editor</a>
      </div>

    </div>
  </main>
</div>

<script>
  import { initDashboard } from '../scripts/dashboard';
  initDashboard();
</script>
<script is:inline src="/dash.js" defer></script>
<script is:inline>
  if (matchMedia('(max-width:560px)').matches) document.querySelectorAll('[data-fold]').forEach(function (d) { d.open = false; });
</script>
</body>
</html>
