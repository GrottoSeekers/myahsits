---
export const prerender = false;
import { getSession } from '../lib/auth';
import AuthShell from '../components/AuthShell.astro';

const sess = await getSession(Astro.request);
if (sess) return Astro.redirect('/dashboard');

const sp = Astro.url.searchParams;
const e = sp.get('error');
const email = sp.get('email') || '';
const errTxt = !e ? null
  : e === 'missing' ? 'Please enter your email and password.'
  : e === 'invalid' ? 'Incorrect email or password.'
  : e === 'link' ? "That link has expired or isn't right. Log in and we'll send you a new one."
  : e === 'unverified' ? null
  : 'Something went wrong.';
const unverified = e === 'unverified';
const okTxt = sp.has('verified') ? 'Your email is confirmed. Log in to set up your page.'
  : sp.has('resent') ? `We've sent a new link to ${email || 'your email'}. It works for 3 days.`
  : null;
---
<AuthShell title="Log in">
  <p class="au-eye">MYAH</p>
  <h1>Welcome <em>back</em></h1>
  <p class="au-lead">Log in to manage your page, enquiries and sits.</p>

  {errTxt && <div class="au-note err" role="alert"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span>{errTxt}</span></div>}
  {okTxt && <div class="au-note ok" role="status"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg><span>{okTxt}</span></div>}
  {unverified && (
    <div class="au-note err" role="alert"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Please confirm your email first. We sent a link to <b>{email}</b>; tap it and you'll come straight back here.
      <form method="POST" action="/api/auth/resend" style="margin:10px 0 0"><input type="hidden" name="email" value={email} /><button type="submit" class="au-btn line" style="height:42px;font-size:.7rem">Send the link again</button></form>
    </span></div>
  )}

  <form method="POST" action="/api/auth/login" class="au-form" data-login-form="1">
    <label class="au-f"><input type="email" name="email" required autocomplete="email" placeholder="Email address" value={email} /><span>Email address</span></label>
    <label class="au-f pw"><input type="password" name="password" required autocomplete="current-password" placeholder="Password" /><span>Password</span><button type="button" class="au-show" data-pw-toggle="1" aria-label="Show password">Show</button></label>
    <button type="submit" class="au-btn" style="margin-top:6px">Log in</button>
  </form>

  <p class="au-alt">Don't have an account? <a href="/signup">Sign up</a></p>
  <div class="au-trust"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>Everyone ID checked</span><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Private details stay private</span></div>
</AuthShell>
