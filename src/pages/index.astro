          <ul style="list-style:none;padding:0;margin:0">
            <li style="margin-bottom:12px"><a href="/signup" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">Get started</a></li>
            <li style="margin-bottom:12px"><a href="/login" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">Log in</a></li>
            <li style="margin-bottom:12px"><a href="/for-sitters" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">For sitters</a></li>
            <li style="margin-bottom:12px"><a href="/for-owners" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">For owners</a></li>
            <li style="margin-bottom:12px"><a href="/how-it-works" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">How it works</a></li>
            <li style="margin-bottom:12px"><a href="/listings" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">Browse sits</a></li>
          </ul>
        </div>
        <div>
          <h4 style="color:#fff;font-size:.76rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin:0 0 20px;padding-bottom:14px;border-bottom:1px solid rgba(196,171,138,.28)">Example profile</h4>
          <ul style="list-style:none;padding:0;margin:0">
            <li style="margin-bottom:12px"><a href="/callumandniamh" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;display:inline-flex;align-items:center;gap:8px;transition:color .2s">Callum &amp; Niamh</a></li>
          </ul>
        </div>
      </div>
      <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:28px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.45)">
          <span>&copy; 2026 MYAH</span>
          <span style="width:4px;height:4px;border-radius:50%;background:rgba(196,171,138,.5);display:block"></span>
          <a href="/privacy" style="color:rgba(255,255,255,.45);text-decoration:none;transition:color .2s">Privacy</a>
          <span style="width:4px;height:4px;border-radius:50%;background:rgba(196,171,138,.5);display:block"></span>
          <a href="/terms" style="color:rgba(255,255,255,.45);text-decoration:none;transition:color .2s">Terms</a>
        </div>
        <span style="display:flex;align-items:center;gap:9px;font-size:.82rem;color:rgba(255,255,255,.55);font-style:italic">Made with <span style="font-style:normal">&#9825;</span> for house &amp; pet sitters everywhere</span>
      </div>
    </div>
  </footer>

  <style is:global>
    /* ── Hover / active states ────────────────────────────────────────── */
    #header-signup-btn:hover,
    #hero-cta:hover,
    [data-mobile-menu] a[href="/signup"]:hover,
    #view-profile-btn:hover,
    #final-cta-btn:hover,
    #footer-signup-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px); box-shadow:0 12px 28px rgba(110,84,56,.36); }

    #header-signup-btn:active,
    #hero-cta:active,
    [data-mobile-menu] a[href="/signup"]:active,
    #view-profile-btn:active,
    #final-cta-btn:active,
    #footer-signup-btn:active { transform:translateY(0) scale(.98); }

    [data-hero-copy] a[href="/callumandniamh"]:hover { color:#2f5d45 !important; border-color:#2f5d45 !important; }

    footer a[href="/privacy"]:hover, footer a[href="/terms"]:hover { color:#c4ab8a !important; }


    /* ── Explore tiles ─────────────────────────────────────────────── */
    .explore-tile { display:flex; flex-direction:column; text-decoration:none; color:#2c1a0e; background:#faf6ee; border:1px solid rgba(110,84,56,.22); border-radius:18px; overflow:hidden; transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease; }
    .explore-tile:hover { transform:translateY(-6px); box-shadow:0 20px 50px rgba(44,26,14,.1); border-color:rgba(47,93,69,.5); }
    .explore-tile .et-img { display:block; aspect-ratio:4/3; overflow:hidden; }
    .explore-tile img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .6s ease; }
    .explore-tile:hover img { transform:scale(1.05); }
    .explore-tile .et-body { display:flex; flex-direction:column; gap:6px; padding:20px 22px 24px; }
    .explore-tile small { font-family:'Lato',sans-serif; font-size:.68rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:#6e5438; }
    .explore-tile b { font-family:'Marcellus',serif; font-weight:400; font-size:1.35rem; line-height:1.2; }
    .explore-tile b::after { content:"\00a0→"; color:#2f5d45; }
    .explore-tile .et-body > span { font-size:.88rem; color:#6b4e35; line-height:1.6; }
    @media (max-width:1240px) {
      [data-header-nav] { display:none !important; }
      [data-burger] { display:flex !important; }
    }
    @media (max-width:1000px) {
      .explore-grid { grid-template-columns:minmax(0,1fr) minmax(0,1fr) !important; }
      [data-explore] { padding:56px 0 48px !important; }
      [data-explore] h2 { font-size:1.9rem !important; }
    }
    @media (max-width:640px) {
      /* headline in the first screen on phones */
      section[data-hero][data-hero] [data-hero-photo] { min-height:32vh !important; }
      section[data-hero][data-hero] [data-hero-copy] { padding-top:24px !important; padding-bottom:44px !important; }
      .explore-grid { gap:12px !important; margin-top:28px !important; }
      .explore-tile .et-img { aspect-ratio:1/1; }
      .explore-tile .et-body { padding:12px 12px 16px; gap:4px; }
      .explore-tile b { font-size:1.05rem; }
      .explore-tile small { font-size:.58rem; letter-spacing:.12em; }
      .explore-tile .et-body > span { font-size:.78rem; line-height:1.45; }
    }

    /* ── Mobile 1000px ────────────────────────────────────────────────── */
    @media (max-width:1000px) {
      [data-header-nav] { display:none !important; }
      [data-burger] { display:flex !important; }
      header[data-site-header] { padding: 16px 24px !important; background:rgba(250,246,238,.97) !important; backdrop-filter:blur(12px); }
      header[data-site-header] [data-nav-logo] { color:#2c1a0e !important; }
      header[data-site-header] [data-burger-bar] { background:#2c1a0e !important; }

      section[data-hero] { grid-template-columns:minmax(0,1fr) !important; }
      section[data-hero] [data-hero-photo] { grid-column:1 !important; grid-row:1 !important; min-height:60vh !important; }
      section[data-hero] [data-hero-copy] { grid-column:1 !important; grid-row:2 !important; min-height:auto !important; padding:48px 20px 60px !important; }

      .two-col-grid { grid-template-columns:minmax(0,1fr) !important; }
      .three-col-grid { grid-template-columns:minmax(0,1fr) !important; }
      .four-col-grid { grid-template-columns:minmax(0,1fr) minmax(0,1fr) !important; }
      .section-inner { padding:0 20px !important; }
      .footer-grid { grid-template-columns:minmax(0,1fr) !important; gap:40px !important; }
      .hero-h1 { font-size:2.2rem !important; }
    }

    /* ── Mobile 640px ─────────────────────────────────────────────────── */
    @media (max-width:1000px) {
    }
    @media (max-width:640px) {
      .four-col-grid { grid-template-columns:minmax(0,1fr) minmax(0,1fr) !important; }
      .hero-h1 { font-size:clamp(2.4rem, 8vw, 4.2rem) !important; }
      [data-hero-copy] h1 { font-size:clamp(2.4rem, 8vw, 4.2rem) !important; }
      [data-hero-copy] p { font-size:1rem !important; }
      [data-burger] { min-height:44px; min-width:44px; }
      [data-mm-item] { min-height:44px; }
    }
  </style>

  <script>
    // Hero slideshow
    const slides = document.querySelectorAll('[data-hero-slide]');
    let slideIdx = 0;
    if (slides.length > 1) {
      setInterval(() => {
        (slides[slideIdx] as HTMLElement).style.opacity = '0';
        slideIdx = (slideIdx + 1) % slides.length;
        (slides[slideIdx] as HTMLElement).style.opacity = '1';
      }, 4500);
    }

    // Header scroll
    const header = document.querySelector('[data-site-header]') as HTMLElement | null;
    const logoImg = document.querySelector('[data-logo-img]') as HTMLImageElement | null;
    const logoWord = document.querySelector('[data-logo-word]') as HTMLElement | null;
    const logoTag = document.querySelector('[data-logo-tag]') as HTMLElement | null;
    const navLinks = document.querySelectorAll('[data-nav-link]');
    const burgerBars = document.querySelectorAll('[data-burger-bar]');

    function onScroll() {
      const on = window.scrollY > 60 || window.innerWidth <= 1000;
      if (!header) return;
      header.style.background = on ? 'rgba(250,246,238,0.97)' : 'transparent';
      header.style.backdropFilter = on ? 'blur(12px)' : 'none';
      header.style.boxShadow = on ? '0 1px 0 rgba(110,84,56,0.15)' : 'none';
      header.style.padding = on ? '14px 48px' : '20px 48px';
      if (logoImg) logoImg.src = on ? '/images/logo-mark.png' : '/images/logo-mark-white.png';
      if (logoWord) logoWord.style.color = on ? '#6e5438' : '#e9e0d2';
      if (logoTag) {
        logoTag.style.color = on ? '#8a6a4f' : 'rgba(255,255,255,.82)';
        logoTag.style.textShadow = on ? 'none' : '0 1px 8px rgba(44,26,14,.55)';
      }
      navLinks.forEach(a => {
        (a as HTMLElement).style.color = on ? '#5c3d20' : '#fff';
        (a as HTMLElement).style.textShadow = on ? 'none' : '0 1px 8px rgba(44,26,14,.55)';
      });
      burgerBars.forEach(b => {
        (b as HTMLElement).style.background = on ? '#2c1a0e' : '#fff';
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();

    // Mobile drawer
    const burger = document.querySelector('[data-burger]') as HTMLElement | null;
    const drawer = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
    const mmOverlay = document.querySelector('[data-mm-overlay]') as HTMLElement | null;
    const mmClose = document.querySelector('[data-mm-close]') as HTMLElement | null;

    function setDrawer(open: boolean) {
      if (!drawer || !mmOverlay) return;
      drawer.style.transform = open ? 'translateX(0)' : 'translateX(100%)';
      mmOverlay.style.opacity = open ? '1' : '0';
      mmOverlay.style.visibility = open ? 'visible' : 'hidden';
    }
    burger?.addEventListener('click', () => setDrawer(true));
    mmClose?.addEventListener('click', () => setDrawer(false));
    mmOverlay?.addEventListener('click', () => setDrawer(false));
    document.querySelectorAll('[data-mm-item]').forEach(a => a.addEventListener('click', () => setDrawer(false)));

    // Loading overlay
    const loader = document.querySelector('[data-loader]') as HTMLElement | null;
    let hideTimer: ReturnType<typeof setTimeout>;
    function showLoader() {
      if (!loader) return;
      loader.style.opacity = '1';
      loader.style.pointerEvents = 'all';
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        if (loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
      }, 1600);
    }
    document.querySelectorAll('form').forEach(f => f.addEventListener('submit', e => { e.preventDefault(); showLoader(); }));
    document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(el => {
      const href = el.getAttribute('href') || '';
      if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel') || el.target === '_blank') return;
      el.addEventListener('click', e => { if ((e as MouseEvent).metaKey || (e as MouseEvent).ctrlKey || (e as MouseEvent).shiftKey) return; showLoader(); });
    });
    window.addEventListener('pageshow', e => { if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; } });
  </script>
</body>
</html>
