---
// MYAH admin (standalone, bookmarkable: myahsits.com/admin). Founders only:
// review members' photo ID against their selfie. Linked from the email sent
// when a new check arrives.
// Photos come from the private id-documents storage as links that expire in
// ten minutes, and are deleted as soon as a decision is made.
export const prerender = false;
import { getAccount } from '../../lib/account';
import { supabase } from '../../lib/supabase';
import { LAUNCHED, PREVIEW_COOKIE } from '../../lib/launch';
import { FOUNDERS_SLUG } from '../../data/founders';

const acct = await getAccount(Astro.request);
// Signed out, or signed in without admin rights: show the sign-in box.
const allowed = !!acct?.isAdmin;
const loginError = Astro.url.searchParams.get('error');
const previewOn = Astro.cookies.get(PREVIEW_COOKIE)?.value === '1';

let pending: any[] = [];
let setupError = '';
if (allowed) try {
  const r = await supabase.from('profiles').select('*').eq('id_check_status', 'pending').order('id_submitted_at', { ascending: true });
  if (r.error) setupError = r.error.message;
  pending = r.data ?? [];
} catch (e) { setupError = e instanceof Error ? e.message : 'error'; }

let recent: any[] = [];
if (allowed) try {
  const r = await supabase.from('profiles').select('id, name, slug, id_check_status, id_verified_at, id_reject_reason').in('id_check_status', ['verified', 'rejected']).order('id_verified_at', { ascending: false, nullsFirst: false }).limit(12);
  recent = r.data ?? [];
} catch {}

// The "launching soon" interest list.
let interest: any[] = [];
let interestError = '';
if (allowed) try {
  // select('*') so an older list without the where-from columns still loads.
  const r = await supabase.from('launch_interest').select('*').order('created_at', { ascending: false }).limit(5000);
  if (r.error) interestError = r.error.message;
  interest = r.data ?? [];
} catch (e) { interestError = e instanceof Error ? e.message : 'error'; }
const waiting = interest.filter((i) => !i.notified_at).length;

// Overview (round 3): who has signed up, when, and where from.
let members: any[] = [];
if (allowed) try {
  const r = await supabase.from('users').select('*').order('created_at', { ascending: false }).limit(5000);
  members = r.data ?? [];
} catch {}
let profiles: any[] = [];
if (allowed) try {
  const r = await supabase.from('profiles').select('id, location, id_check_status').limit(5000);
  profiles = r.data ?? [];
} catch {}
const DAY = 864e5;
const since = (n: number) => (x: any) => x.created_at && Date.now() - new Date(x.created_at).getTime() < n * DAY;
const count = (list: any[], key: (x: any) => string) => {
  const m = new Map<string, number>();
  list.forEach((x) => { const k = key(x); if (k) m.set(k, (m.get(k) || 0) + 1); });
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
};
const COUNTRY: Record<string, string> = { GB: 'United Kingdom', AU: 'Australia', NZ: 'New Zealand', US: 'United States', IE: 'Ireland', CA: 'Canada', FR: 'France', ES: 'Spain', DE: 'Germany', NL: 'Netherlands', IT: 'Italy', PT: 'Portugal', ZA: 'South Africa', AE: 'United Arab Emirates' };
const flag = (c: string) => (c && c.length === 2 ? String.fromCodePoint(...[...c.toUpperCase()].map((ch) => 127397 + ch.charCodeAt(0))) : '');
const everyone = [
  ...interest.map((i) => ({ kind: 'list', created_at: i.created_at, role: i.role, country: i.country, city: i.city, via: i.referrer || (i.source ? 'Coming soon page' : ''), device: i.device })),
  ...members.map((u) => ({ kind: 'member', created_at: u.created_at, role: u.role, country: u.signup_country, city: u.signup_city, via: '', device: u.signup_device })),
];
const located = everyone.filter((x) => x.country);
const byCountry = count(located, (x) => x.country).map(([c, n]) => ({ label: (flag(c) + ' ' + (COUNTRY[c] || c)).trim(), n }));
const byCity = count(everyone.filter((x) => x.city), (x) => x.city + (x.country ? ', ' + x.country : '')).slice(0, 8).map(([label, n]) => ({ label, n }));
const VIA: Record<string, string> = { 'instagram.com': 'Instagram', 'l.instagram.com': 'Instagram', 'facebook.com': 'Facebook', 'm.facebook.com': 'Facebook', 'l.facebook.com': 'Facebook', 'tiktok.com': 'TikTok', 'google.com': 'Google', 't.co': 'X (Twitter)', 'linkedin.com': 'LinkedIn', 'lnkd.in': 'LinkedIn' };
const byVia = count(interest, (i) => (i.referrer ? VIA[i.referrer] || i.referrer : 'Typed in or shared link')).map(([label, n]) => ({ label, n }));
const byDevice = count(everyone.filter((x) => x.device), (x) => x.device).map(([d, n]) => ({ label: d === 'phone' ? 'Phone' : d === 'tablet' ? 'Tablet' : 'Computer', n }));
const roleN = (r: string) => interest.filter((i) => i.role === r).length;
const days30 = Array.from({ length: 30 }, (_, i) => {
  const d = new Date(Date.now() - (29 - i) * DAY);
  const k = d.toISOString().slice(0, 10);
  return { k, label: d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }), n: everyone.filter((x) => String(x.created_at || '').slice(0, 10) === k).length };
});
const maxDay = Math.max(1, ...days30.map((d) => d.n));
const tiles = [
  { n: interest.length, l: 'On the launch list', sub: `+${interest.filter(since(7)).length} this week` },
  { n: members.length, l: 'Accounts', sub: `+${members.filter(since(7)).length} this week` },
  { n: profiles.filter((p) => p.id_check_status === 'verified').length, l: 'ID verified', sub: `${pending.length} waiting` },
  { n: located.length ? byCountry.length : 0, l: 'Countries', sub: byCountry[0] ? 'Most from ' + byCountry[0].label.replace(/^\S+\s/, '') : 'Recorded from today' },
];
const unknownWhere = everyone.length - located.length;

const sideOf = async (userId: string) => {
  try { const { data } = await supabase.from('users').select('role').eq('id', userId).limit(1); return (data as any)?.[0]?.role === 'owner' ? 'Home owner' : 'Sitter'; } catch { return 'Member'; }
};
const sign = async (path: string | null) => {
  if (!path) return null;
  try { const { data } = await supabase.storage.from('id-documents').createSignedUrl(path, 600); return data?.signedUrl ?? null; } catch { return null; }
};
const rows = await Promise.all(pending.map(async (p) => ({
  id: p.id, name: p.name || 'Member', slug: p.slug, location: p.location || '', pic: p.profile_pic || null,
  side: await sideOf(p.user_id),
  when: p.id_submitted_at ? new Date(p.id_submitted_at).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '',
  doc: await sign(p.id_doc_path), selfie: await sign(p.id_selfie_path),
})));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>MYAH Admin — ID checks</title>
  <link rel="icon" href="/images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:wght@400;500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    body { margin:0; background:#faf6ee; color:#2c1a0e; font-family:"Montserrat",sans-serif; }
    * { box-sizing:border-box; }
    .ad-top { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; padding:16px 48px; background:#fff; border-bottom:1px solid rgba(110,84,56,.2); }
    .ad-logo { display:inline-flex; align-items:center; gap:14px; text-decoration:none; font-weight:500; font-size:1.3rem; letter-spacing:.28em; }
    .ad-logo img { width:42px; height:42px; object-fit:contain; }
    .ad-logo > span { display:flex; flex-direction:column; gap:5px; padding-left:14px; border-left:1px solid rgba(110,84,56,.4); line-height:1; }
    .ad-logo b { color:#2f5d45; font-weight:500; }
    .ad-logo small { font-family:'Lato',sans-serif; font-weight:700; font-size:.5rem; letter-spacing:.2em; text-transform:uppercase; color:#8a6a4f; white-space:nowrap; }
    .ad-nav { display:flex; gap:20px; align-items:center; flex-wrap:wrap; font-size:.8rem; color:#8a6a4f; }
    .ad-nav a { font-size:.74rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#2f5d45; text-decoration:none; }
    .ad-login { max-width:460px; margin:40px auto; }
    .ad-form { display:flex; flex-direction:column; gap:14px; }
    .ad-form label { display:flex; flex-direction:column; gap:7px; font-family:'Lato',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:#5c3d20; }
    .ad-form input { padding:12px 14px; border:1.5px solid rgba(110,84,56,.3); border-radius:10px; background:#faf6ee; font-family:'Montserrat',sans-serif; font-size:16px; text-transform:none; letter-spacing:0; font-weight:400; color:#2c1a0e; }
    .ad-form .btn { align-self:flex-start; }
    main { padding:44px 48px 90px; }
    .wrap { max-width:1100px; margin:0 auto; }
    .eyebrow { font-family:'Lato',sans-serif; font-size:.75rem; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:#6e5438; margin:0 0 14px; display:flex; align-items:center; gap:12px; }
    .eyebrow::before { content:""; width:26px; height:1px; background:#6e5438; }
    h1 { font-family:'Marcellus',serif; font-weight:400; font-size:2.3rem; margin:0 0 10px; }
    .lead { color:#6b4e35; line-height:1.75; margin:0 0 28px; max-width:640px; }
    .card { background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; padding:24px 26px; margin-bottom:20px; }
    .who { display:flex; align-items:center; gap:14px; margin-bottom:18px; flex-wrap:wrap; }
    .who img, .who .ini { width:48px; height:48px; border-radius:50%; object-fit:cover; background:#e9e0d2; display:flex; align-items:center; justify-content:center; font-family:'Marcellus',serif; color:#2f5d45; }
    .who h2 { font-family:'Marcellus',serif; font-weight:400; font-size:1.3rem; margin:0; }
    .who p { margin:2px 0 0; font-size:.82rem; color:#8a6a4f; }
    .pics { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:18px; }
    .pics figure { margin:0; }
    .pics figcaption { font-family:'Lato',sans-serif; font-size:.7rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:#8a6a4f; margin:0 0 8px; }
    .pics a { display:block; border-radius:12px; overflow:hidden; background:#e9e0d2; aspect-ratio:4/3; }
    .pics img { width:100%; height:100%; object-fit:contain; display:block; background:#2c1a0e; }
    .missing { display:flex; align-items:center; justify-content:center; height:100%; color:#8a6a4f; font-size:.85rem; }
    .actions { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .btn { font-family:'Montserrat',sans-serif; font-size:.74rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; border-radius:50px; padding:12px 22px; cursor:pointer; border:1.5px solid #2f5d45; background:#2f5d45; color:#fff; }
    .btn.ghost { background:#fff; color:#a4442e; border-color:rgba(164,68,46,.45); }
    .actions input { flex:1 1 220px; min-width:0; padding:11px 14px; border:1.5px solid rgba(110,84,56,.3); border-radius:10px; background:#faf6ee; font-family:'Montserrat',sans-serif; font-size:.9rem; }
    .status { font-size:.85rem; font-weight:600; margin:10px 0 0; min-height:1.2em; }
    .empty { text-align:center; padding:48px 24px; color:#6b4e35; }
    .recent li { display:flex; justify-content:space-between; gap:12px; padding:10px 0; border-bottom:1px solid rgba(110,84,56,.12); font-size:.9rem; }
    .recent ul { list-style:none; margin:0; padding:0; }
    .tag { font-size:.66rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; padding:4px 10px; border-radius:50px; }
    .ad-tabs { display:inline-flex; gap:3px; padding:4px; margin:6px 0 26px; border-radius:14px; background:#efe7da; max-width:100%; overflow-x:auto; }
    .ad-tabs button { flex:none; border:0; background:none; border-radius:10px; padding:10px 18px; font:600 .82rem 'Montserrat',sans-serif; color:#6b4e35; cursor:pointer; }
    .ad-tabs button small { margin-left:6px; font-size:.7rem; padding:2px 7px; border-radius:50px; background:#2f5d45; color:#fff; }
    .ad-tabs button[aria-selected="true"] { background:#fff; color:#2c1a0e; box-shadow:0 2px 8px rgba(44,26,14,.12); }
    [data-adpane][hidden] { display:none; }
    .ad-h2 { font-family:'Marcellus',serif; font-weight:400; font-size:1.5rem; margin:0 0 14px; }
    .ov-tiles { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin-bottom:16px; }
    .ov-tile { position:relative; overflow:hidden; background:linear-gradient(160deg,#fff,#fbf7f0); border:1px solid rgba(110,84,56,.2); border-radius:18px; padding:20px; display:flex; flex-direction:column; gap:3px; box-shadow:0 10px 28px rgba(44,26,14,.05); }
    .ov-tile::before { content:""; position:absolute; left:0; right:0; top:0; height:3px; background:linear-gradient(90deg,#2f5d45,#c4ab8a); }
    .ov-tile b { font:400 2.2rem/1 'Marcellus',serif; color:#2f5d45; }
    .ov-tile span { font:700 .66rem 'Lato',sans-serif; letter-spacing:.14em; text-transform:uppercase; color:#6e5438; margin-top:6px; }
    .ov-tile small { font-size:.78rem; color:#8a6a4f; }
    .ov-card { background:#fff; border:1px solid rgba(110,84,56,.2); border-radius:18px; padding:22px 24px; margin-bottom:16px; }
    .ov-head { display:flex; justify-content:space-between; align-items:baseline; gap:10px; margin-bottom:16px; }
    .ov-head p { margin:0; font:400 1.15rem 'Marcellus',serif; color:#2c1a0e; }
    .ov-head span { font-size:.72rem; color:#8a6a4f; }
    .ov-bars { display:grid; grid-template-columns:repeat(30,minmax(0,1fr)); align-items:end; gap:4px; height:140px; padding-bottom:2px; border-bottom:1px solid rgba(44,26,14,.1); }
    .ov-bar { height:100%; display:flex; align-items:flex-end; }
    .ov-bar i { display:block; width:100%; min-height:2px; border-radius:4px 4px 0 0; background:#2f5d45; transition:background .2s; }
    .ov-bar:hover i { background:#c4ab8a; }
    .ov-axis { display:flex; justify-content:space-between; font-size:.7rem; color:#8a6a4f; margin-top:6px; }
    .ov-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .ov-grid .ov-card { margin:0; }
    .ov-list { list-style:none; margin:0; padding:0; display:grid; gap:10px; }
    .ov-list li { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) auto; align-items:center; gap:12px; font-size:.9rem; color:#2c1a0e; }
    .ov-list li span { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .ov-list li i { position:relative; height:8px; border-radius:8px; background:#f3ece0; overflow:hidden; }
    .ov-list li i::after { content:""; position:absolute; inset:0 auto 0 0; width:var(--w); border-radius:8px; background:#2f5d45; }
    .ov-list li b { font-weight:600; min-width:24px; text-align:right; }
    .ov-none { margin:0; font-size:.88rem; color:#8a6a4f; line-height:1.6; }
    .ov-note { margin:14px 0 0; font-size:.78rem; color:#8a6a4f; }
    .ov-note code { background:#f3ece0; padding:1px 6px; border-radius:6px; }
    @media (max-width:760px) { .ov-tiles { grid-template-columns:1fr 1fr; gap:10px; } .ov-grid { grid-template-columns:minmax(0,1fr); } .ov-bars { gap:2px; height:110px; } .ov-tile b { font-size:1.8rem; } }
    @media (max-width:640px) { .ad-top { padding:12px 16px; } main { padding:24px 16px 60px; } .pics { grid-template-columns:1fr; } h1 { font-size:1.9rem; } }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
  <header class="ad-top">
    <a href="/admin" class="ad-logo"><img src="/images/logo-mark.png" alt="" /><span><b>MYAH</b><small>Make Yourself At Home · Admin</small></span></a>
    {allowed && (
      <nav class="ad-nav"><span>{acct!.email}</span><a href={'/' + FOUNDERS_SLUG} target="_blank" rel="noopener">Our page</a><a href="/profile/edit">Edit our page</a><a href="/" target="_blank" rel="noopener">View site</a><a href="/api/auth/logout?next=/admin">Sign out</a></nav>
    )}
  </header>
  <main>
    <div class="wrap">
      {!allowed ? (
        <div class="card ad-login">
          <p class="eyebrow">Founders only</p>
          <h1>Sign in to review ID checks</h1>
          {acct && <p class="lead" style="color:#a4442e">This account ({acct.email}) can't review ID checks. Sign in with the Callum &amp; Niamh account.</p>}
          {loginError && <p class="lead" style="color:#a4442e">That email and password didn't match.</p>}
          <form method="POST" action="/api/auth/login" class="ad-form">
            <input type="hidden" name="next" value="/admin" />
            <label>Email<input type="email" name="email" required autocomplete="username" /></label>
            <label>Password<input type="password" name="password" required autocomplete="current-password" /></label>
            <button type="submit" class="btn">Sign in</button>
          </form>
        </div>
      ) : (
      <>
      <p class="eyebrow">Founders only</p>
      <h1>MYAH <em style="color:#2f5d45">admin</em></h1>
      <nav class="ad-tabs" role="tablist">
        <button type="button" data-adtab="overview" aria-selected="true">Overview</button>
        <button type="button" data-adtab="checks" aria-selected="false">ID checks{rows.length ? <small>{rows.length}</small> : null}</button>
        <button type="button" data-adtab="list" aria-selected="false">Launch list <small>{interest.length}</small></button>
      </nav>

      <section data-adpane="overview">
        <div class="ov-tiles">
          {tiles.map((t) => <div class="ov-tile"><b>{t.n}</b><span>{t.l}</span><small>{t.sub}</small></div>)}
        </div>
        <div class="ov-card">
          <div class="ov-head"><p>Sign-ups, last 30 days</p><span>Launch list and accounts</span></div>
          <div class="ov-bars" role="img" aria-label={`Sign-ups per day for the last 30 days, most in a day ${maxDay}`}>
            {days30.map((d) => <div class="ov-bar" title={`${d.label}: ${d.n}`}><i style={`height:${Math.round((d.n / maxDay) * 100)}%`}></i></div>)}
          </div>
          <div class="ov-axis"><span>{days30[0].label}</span><span>{days30[14].label}</span><span>Today</span></div>
        </div>
        <div class="ov-grid">
          <div class="ov-card">
            <div class="ov-head"><p>Where they signed up from</p><span>Country</span></div>
            {byCountry.length ? <ul class="ov-list">{byCountry.map((r) => <li><span>{r.label}</span><i style={`--w:${Math.round((r.n / byCountry[0].n) * 100)}%`}></i><b>{r.n}</b></li>)}</ul> : <p class="ov-none">No locations yet. Recorded for everyone who signs up from now on.</p>}
            {unknownWhere > 0 && byCountry.length > 0 && <p class="ov-note">{unknownWhere} signed up before locations were recorded.</p>}
          </div>
          <div class="ov-card">
            <div class="ov-head"><p>Top cities</p><span>City or region only</span></div>
            {byCity.length ? <ul class="ov-list">{byCity.map((r) => <li><span>{r.label}</span><i style={`--w:${Math.round((r.n / byCity[0].n) * 100)}%`}></i><b>{r.n}</b></li>)}</ul> : <p class="ov-none">No cities yet.</p>}
          </div>
          <div class="ov-card">
            <div class="ov-head"><p>How they found you</p><span>Launch list</span></div>
            {byVia.length ? <ul class="ov-list">{byVia.map((r) => <li><span>{r.label}</span><i style={`--w:${Math.round((r.n / byVia[0].n) * 100)}%`}></i><b>{r.n}</b></li>)}</ul> : <p class="ov-none">Nothing yet.</p>}
            <p class="ov-note">Add <code>?utm_source=instagram</code> to links you post to see them here.</p>
          </div>
          <div class="ov-card">
            <div class="ov-head"><p>Who they are</p><span>Launch list</span></div>
            <ul class="ov-list">
              {[['Sitters', roleN('sitter')], ['Home owners', roleN('owner')], ['Both', roleN('both')]].map(([l, n]) => <li><span>{l}</span><i style={`--w:${Math.round(((n as number) / Math.max(1, roleN('sitter'), roleN('owner'), roleN('both'))) * 100)}%`}></i><b>{n}</b></li>)}
            </ul>
            {byDevice.length > 0 && <p class="ov-note">{byDevice.map((d) => `${d.label} ${Math.round((d.n / byDevice.reduce((a, b) => a + b.n, 0)) * 100)}%`).join(' · ')}</p>}
          </div>
        </div>
      </section>

      <section data-adpane="checks" hidden>
      <h2 class="ad-h2">ID checks</h2>
      <p class="lead">Check that the face in the selfie matches the photo ID, and that the name matches the profile. Approving unlocks applying, posting, messaging and confirming for that member. The photos are deleted as soon as you decide.</p>

      {setupError && (
        <div class="card" style="border-left:4px solid #a4442e"><strong>Setup needed.</strong> Run <code>supabase/id-verification.sql</code> in Supabase. ({setupError})</div>
      )}

      {rows.length === 0 && !setupError && (
        <div class="card empty">No ID checks waiting. You will get a notification when someone sends theirs.</div>
      )}

      {rows.map((r) => (
        <div class="card" data-check={r.id}>
          <div class="who">
            {r.pic ? <img src={r.pic} alt="" /> : <span class="ini">{r.name.slice(0, 1)}</span>}
            <div>
              <h2>{r.name}</h2>
              <p>{r.side}{r.location ? ' · ' + r.location : ''}{r.when ? ' · sent ' + r.when : ''} · <a href={'/' + r.slug} target="_blank" rel="noopener">View profile</a></p>
            </div>
          </div>
          <div class="pics">
            <figure><figcaption>Photo ID</figcaption>{r.doc ? <a href={r.doc} target="_blank" rel="noopener"><img src={r.doc} alt="Photo ID" /></a> : <a><span class="missing">Photo not found</span></a>}</figure>
            <figure><figcaption>Selfie</figcaption>{r.selfie ? <a href={r.selfie} target="_blank" rel="noopener"><img src={r.selfie} alt="Selfie" /></a> : <a><span class="missing">Photo not found</span></a>}</figure>
          </div>
          <div class="actions">
            <button type="button" class="btn" data-decide="approve">Approve</button>
            <input type="text" data-reason placeholder="Reason if rejecting, e.g. photo too blurry" />
            <button type="button" class="btn ghost" data-decide="reject">Reject</button>
          </div>
          <p class="status" data-status></p>
        </div>
      ))}

      </section>

      <section data-adpane="list" hidden>
      {!LAUNCHED && (
        <div class="card recent">
          <p class="eyebrow" style="margin-bottom:6px">Launching soon mode</p>
          <p style="margin:0 0 12px;font-size:.92rem;color:#4a3726;line-height:1.6">Everyone, including you, sees only the launching soon page and your page. {previewOn ? <b>Full-site preview is on for you on this device.</b> : 'To test the full site, turn on a preview just for you (lasts 8 hours).'}</p>
          <a class="btn ghost" href={previewOn ? '/api/admin/preview?on=0' : '/api/admin/preview?on=1'} style="text-decoration:none;color:#2f5d45;border-color:rgba(47,93,69,.45)">{previewOn ? 'Turn preview off' : 'Preview the full site'}</a>
        </div>
      )}

      <div class="card recent" id="launch-list">
        <p class="eyebrow" style="margin-bottom:6px">Launch list</p>
        {interestError ? (
          <p style="color:#a4442e;font-size:.9rem;margin:0">The launch list isn't set up yet. Run <b>supabase/launch-interest.sql</b> in Supabase.</p>
        ) : (
          <>
            <p style="margin:0 0 12px;font-size:.92rem;color:#4a3726"><b>{interest.length}</b> {interest.length === 1 ? 'person has' : 'people have'} registered interest{waiting !== interest.length ? `, ${waiting} not yet emailed` : ''}. The site is {LAUNCHED ? <b>live</b> : <b>in “launching soon” mode</b>}.</p>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px">
              <a class="btn ghost" href="/api/admin/interest" style="text-decoration:none;color:#2f5d45;border-color:rgba(47,93,69,.45)">Download list (CSV)</a>
              <button type="button" class="btn" data-launch-email disabled={!waiting}>Email everyone: MYAH is live</button>
            </div>
            <p class="status" data-launch-status style="margin:0 0 10px"></p>
            {interest.length > 0 && (
              <ul>
                {interest.slice(0, 50).map((i) => (
                  <li><span style="word-break:break-all">{i.email}{(i.city || i.country) && <small style="display:block;color:#8a6a4f;font-size:.76rem;margin-top:2px">{[i.city, i.country].filter(Boolean).join(', ')}{i.referrer ? ' · via ' + (VIA[i.referrer] || i.referrer) : ''}</small>}</span>
                    <span class="tag" style="background:#f3ece0;color:#6e5438;white-space:nowrap;align-self:center">{i.role === 'owner' ? 'Home owner' : i.role === 'sitter' ? 'Sitter' : i.role === 'both' ? 'Both' : '—'}{i.notified_at ? ' · emailed' : ''}</span></li>
                ))}
              </ul>
            )}
          </>
        )}
      </div>

      {recent.length > 0 && (
        <div class="card recent">
          <p class="eyebrow" style="margin-bottom:6px">Recently decided</p>
          <ul>
            {recent.map((r) => (
              <li><a href={'/' + r.slug} style="color:#2c1a0e;text-decoration:none">{r.name}</a>
                <span class="tag" style={r.id_check_status === 'verified' ? 'background:#2f5d45;color:#fff' : 'background:rgba(164,68,46,.12);color:#a4442e'}>{r.id_check_status === 'verified' ? 'Verified' : 'Rejected'}</span></li>
            ))}
          </ul>
        </div>
      )}
      </section>
      </>
      )}
    </div>
  </main>
  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('[data-adtab]');
      function show(k) {
        tabs.forEach(function (t) { t.setAttribute('aria-selected', String(t.getAttribute('data-adtab') === k)); });
        document.querySelectorAll('[data-adpane]').forEach(function (p) { p.hidden = p.getAttribute('data-adpane') !== k; });
      }
      tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-adtab')); history.replaceState(null, '', '#' + t.getAttribute('data-adtab')); }); });
      var h = location.hash.slice(1);
      if (h === 'launch-list') h = 'list';
      if (h && document.querySelector('[data-adpane="' + h + '"]')) show(h);
    })();
    var lb = document.querySelector('[data-launch-email]');
    if (lb) lb.addEventListener('click', function () {
      var st = document.querySelector('[data-launch-status]');
      if (!confirm('Send the "MYAH is live" email to everyone on the launch list who has not had it yet? Only do this once the site is open.')) return;
      lb.disabled = true; st.style.color = '#6b4e35'; st.textContent = 'Sending…';
      fetch('/api/admin/interest', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'notify' }) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok && !d.sent) throw new Error(d.error || 'Could not send'); return d; }); })
        .then(function (d) { st.style.color = d.error ? '#a4442e' : '#2f5d45'; st.textContent = 'Sent to ' + d.sent + (d.sent === 1 ? ' person.' : ' people.') + (d.error ? ' Stopped early: ' + d.error : ''); })
        .catch(function (e) { st.style.color = '#a4442e'; st.textContent = e.message; lb.disabled = false; });
    });
    document.querySelectorAll('[data-check]').forEach(function (card) {
      card.querySelectorAll('[data-decide]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var decision = btn.getAttribute('data-decide');
          var reason = card.querySelector('[data-reason]').value;
          var status = card.querySelector('[data-status]');
          if (decision === 'reject' && !reason.trim() && !confirm('Reject without a reason? The member will be told the photos could not be matched.')) return;
          card.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
          status.style.color = '#6b4e35'; status.textContent = 'Saving…';
          fetch('/api/admin/verifications', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ profile_id: card.getAttribute('data-check'), decision: decision, reason: reason }) })
            .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error(d.error || 'Could not save'); }); })
            .then(function () { status.style.color = '#2f5d45'; status.textContent = decision === 'approve' ? 'Approved — they have been told.' : 'Rejected — they have been asked to try again.'; card.querySelector('.pics').style.opacity = '.35'; })
            .catch(function (e) { status.style.color = '#a4442e'; status.textContent = e.message; card.querySelectorAll('button').forEach(function (b) { b.disabled = false; }); });
        });
      });
    });
  </script>
</body>
</html>
