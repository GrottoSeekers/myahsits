---
export const prerender = false;
// "Launching soon" — what everyone sees at myahsits.com before launch: a
// sneak peek of what MYAH will do, and the register-your-interest form.
// The only page it links to is the founders' own page.
import { FOUNDERS_SLUG, FOUNDERS_REVIEW_TOTAL } from '../data/founders';
import Welcome from './_welcome.astro';
import { supabase } from '../lib/supabase';

const registered = Astro.url.searchParams.has('registered');
const error = Astro.url.searchParams.get('error');
const desc = "MYAH is a new home for house & pet sitters and home owners, launching soon. Register your interest and we'll tell you the moment it's live.";
const errText = error === 'email' ? 'Please check your email address and try again.' : error ? 'Something went wrong, please try again.' : '';
const founders = '/' + FOUNDERS_SLUG;

// Our own photos for "Hello, we're Callum & Niamh": the single photos with
// dogs from the slideshow on our page (owner, 27 Oct 2026), so changing them
// on the founders' page changes them here too.
let ourPics: string[] = [];
try {
  const { data } = await supabase.from('profiles').select('about_images_json').eq('slug', FOUNDERS_SLUG).maybeSingle();
  const raw = data?.about_images_json;
  const list = Array.isArray(raw) ? raw : typeof raw === 'string' ? JSON.parse(raw || '[]') : [];
  ourPics = list.map((x: any) => (typeof x === 'string' ? x : x?.src)).filter((x: any) => typeof x === 'string' && x);
} catch {}
// The big photo at the top: our own sits, a dog then a home, in turn
// (owner, 27 Oct 2026). Each is [file, which part of the photo to keep in view].
const heroPics: [string, string][] = [
  ['hero-dog-springer-beach', 'center 80%'],
  ['hero-home-ocean-living', 'center 60%'],
  ['hero-dog-collie-lawn', 'center 72%'],
  ['hero-home-sunset-balcony', 'center 45%'],
  ['hero-dog-snow', 'center 62%'],
  ['hero-home-sunroom-kitchen', 'center 42%'],
  ['hero-dog-harbour-beach', 'center 70%'],
  ['hero-home-harbour-window', 'center 50%'],
  ['hero-dog-cavapoo-lawn', 'center 62%'],
  ['hero-home-green-sunroom', 'center 50%'],
  ['hero-home-living-room', 'center 55%'],
];

// Callum (1st), the two of us (2nd) and Niamh (3rd), as on our page.
if (ourPics.length < 3) ourPics = ['/images/couple-villa-1.jpg', '/images/couple-boat-1.jpg', '/images/couple-field-1.jpg'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MYAH — launching soon</title>
  <meta name="description" content={desc} />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <link rel="canonical" href="https://www.myahsits.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.myahsits.com/" />
  <meta property="og:site_name" content="MYAH" />
  <meta property="og:title" content="MYAH — Make Yourself At Home. Launching soon" />
  <meta property="og:description" content={desc} />
  <meta property="og:image" content="https://www.myahsits.com/images/slideshow-springer-beach.jpeg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:wght@400;500;600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root { --ink:#2c1a0e; --bg:#faf6ee; --cream:#f3ece0; --green:#2f5d45; --green2:#3e7a5b; --brown:#6e5438; --text:#4a3726; --soft:#6b4e35; --line:rgba(110,84,56,.22); }
    body { margin:0; background:var(--bg); color:var(--ink); font-family:"Montserrat",sans-serif; overflow-x:hidden; }
    * { box-sizing:border-box; }
    a { color:var(--green); }
    img { display:block; max-width:100%; }

    /* header: sits over the hero photo, turns solid once you scroll */
    .cs-top { position:fixed; top:0; left:0; right:0; z-index:50; padding:14px 48px; display:flex; justify-content:space-between; align-items:center; gap:20px; transition:background .3s, box-shadow .3s; }
    .cs-top.solid { background:rgba(250,246,238,.96); backdrop-filter:blur(12px); box-shadow:0 1px 0 rgba(110,84,56,.18); }
    .cs-logo { display:inline-flex; align-items:center; gap:14px; line-height:1; font-weight:500; font-size:1.4rem; letter-spacing:.28em; color:#fff; transition:color .3s; }
    .cs-logo img { height:46px; width:46px; object-fit:contain; }
    .cs-logo .dk { display:none; }
    .cs-top.solid .cs-logo .dk { display:block; }
    .cs-top.solid .cs-logo .lt { display:none; }
    .cs-logo > span { display:flex; flex-direction:column; gap:5px; padding-left:14px; border-left:1px solid rgba(255,255,255,.45); }
    .cs-logo b { color:#fff; font-weight:500; transition:color .3s; }
    .cs-logo small { font-family:'Lato',sans-serif; font-weight:700; font-size:.5rem; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.85); white-space:nowrap; }
    .cs-top.solid .cs-logo > span { border-color:rgba(110,84,56,.4); }
    .cs-top.solid .cs-logo b { color:var(--green); }
    .cs-top.solid .cs-logo small { color:#8a6a4f; }
    .cs-top-cta { font-size:.74rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fff; background:var(--green); text-decoration:none; border-radius:50px; padding:12px 22px; white-space:nowrap; box-shadow:0 4px 14px rgba(20,13,7,.25); }
    .cs-top-cta .sm { display:none; }
    .cs-top-cta:hover { background:var(--green2); color:#fff; }

    /* shared */
    .wrap { max-width:1140px; margin:0 auto; padding:0 48px; }
    .eyebrow { font-family:'Lato',sans-serif; font-size:.74rem; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:var(--brown); margin:0 0 16px; display:flex; align-items:center; gap:12px; }
    .eyebrow::before { content:""; width:26px; height:1px; background:var(--brown); }
    .eyebrow.c { justify-content:center; }
    .eyebrow.c::after { content:""; width:26px; height:1px; background:var(--brown); }
    h1, h2, h3 { font-family:'Marcellus',serif; font-weight:400; margin:0; }
    h2 { font-size:2.4rem; line-height:1.15; }
    h2 em, h1 em { font-style:normal; color:var(--green); }
    .lead { color:var(--soft); font-size:1.04rem; line-height:1.8; }
    .sec { padding:96px 0; }
    .sec-head { text-align:center; max-width:640px; margin:0 auto 52px; }
    .sec-head .lead { margin:14px 0 0; }
    .reveal { opacity:0; transform:translateY(18px); transition:opacity .7s ease, transform .7s ease; }
    .reveal.in { opacity:1; transform:none; }

    /* hero: one full-screen photo like the founders' page */
    .hero { position:relative; min-height:min(100vh,900px); min-height:min(100svh,900px); display:flex; align-items:flex-end; color:#fff; overflow:hidden; background:var(--ink); }
    .hero .bg img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity 1.6s ease; }
    .hero .bg img.on { opacity:1; animation:kb 12s ease-out both; }
    @keyframes kb { from { transform:scale(1.09); } to { transform:scale(1); } }
    .hero .shade { position:absolute; inset:0; background:linear-gradient(90deg,rgba(20,13,7,.82) 0%,rgba(20,13,7,.55) 45%,rgba(20,13,7,.1) 75%), linear-gradient(180deg,rgba(20,13,7,.45) 0%,rgba(20,13,7,0) 22%,rgba(20,13,7,0) 70%,rgba(20,13,7,.55) 100%); }
    .hero .wrap { position:relative; width:100%; display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr); gap:56px; align-items:end; padding-top:130px; padding-bottom:64px; }
    @keyframes rise { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }
    .hero .copy > * { animation:rise .9s cubic-bezier(.2,.7,.2,1) both; }
    .hero .copy > :nth-child(2) { animation-delay:.12s; } .hero .copy > :nth-child(3) { animation-delay:.24s; } .hero .copy > :nth-child(4) { animation-delay:.36s; } .hero .copy > :nth-child(5) { animation-delay:.48s; }
    .pill { display:inline-flex; align-items:center; gap:8px; font-family:'Lato',sans-serif; font-size:.72rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:#f1e6d6; background:rgba(255,255,255,.12); border:1px solid rgba(255,255,255,.3); backdrop-filter:blur(6px); border-radius:50px; padding:8px 14px; margin-bottom:22px; }
    .pill i { width:8px; height:8px; border-radius:50%; background:#8fd1a8; animation:pulse 1.8s ease-in-out infinite; }
    @keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.4; transform:scale(.8); } }
    .hero h1 { font-size:4.4rem; line-height:1.02; margin:0 0 20px; letter-spacing:-.01em; text-shadow:0 2px 24px rgba(20,13,7,.35); }
    .hero h1 em { color:#d9c3a5; font-style:italic; }
    .hero .lead { margin:0 0 28px; max-width:520px; color:rgba(255,255,255,.86); }
    .trust { display:flex; gap:18px; flex-wrap:wrap; margin-top:20px; font-size:.82rem; color:rgba(255,255,255,.85); }
    .trust span { display:inline-flex; align-items:center; gap:7px; }
    .trust svg { color:#8fd1a8; flex:none; }

    /* seal, as on the founders' page */
    .seal { position:absolute; right:48px; top:110px; width:132px; height:132px; animation:rise 1s .8s both; }
    .seal svg { width:100%; height:100%; animation:spin 28s linear infinite; }
    .seal text { font:700 9.4px 'Lato',sans-serif; letter-spacing:.2em; fill:#f1e6d6; }
    .seal img { position:absolute; inset:0; margin:auto; width:46px; height:46px; }
    .seal::before { content:""; position:absolute; inset:22px; border-radius:50%; border:1px solid rgba(241,230,214,.35); background:rgba(20,13,7,.28); backdrop-filter:blur(4px); }
    @keyframes spin { to { transform:rotate(360deg); } }

    /* moving highlights strip */

    /* interest form */
    .iform { background:#fff; border:1px solid var(--line); border-radius:18px; padding:22px; box-shadow:0 10px 30px rgba(44,26,14,.06); max-width:520px; color:var(--ink); }
    .hero .iform { background:rgba(250,246,238,.97); border-color:rgba(255,255,255,.5); box-shadow:0 24px 60px rgba(20,13,7,.35); }
    .iform-row { display:flex; gap:10px; }
    .iform input[type=email] { flex:1; min-width:0; font:inherit; font-size:1rem; padding:14px 16px; border:1px solid rgba(110,84,56,.35); border-radius:50px; background:var(--bg); color:var(--ink); }
    .iform input[type=email]:focus { outline:2px solid rgba(47,93,69,.3); border-color:var(--green); }
    .iform button { font:inherit; font-size:.76rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fff; background:var(--green); border:0; border-radius:50px; padding:0 24px; cursor:pointer; white-space:nowrap; box-shadow:0 4px 14px rgba(44,26,14,.18); }
    .iform button:hover { background:var(--green2); }
    .roles { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:8px; margin-top:14px; }
    .roles > span { grid-column:1 / -1; font-size:.7rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--soft); }
    .roles label { position:relative; display:flex; align-items:center; justify-content:center; text-align:center; min-height:44px; padding:8px 10px; font-size:.86rem; font-weight:500; color:var(--text); background:var(--bg); border:1px solid rgba(110,84,56,.28); border-radius:50px; cursor:pointer; transition:background .2s, color .2s, border-color .2s; }
    .roles label:hover { border-color:var(--green); }
    .roles input { position:absolute; opacity:0; width:1px; height:1px; margin:0; }
    .roles label:has(input:checked) { background:var(--green); border-color:var(--green); color:#fff; }
    .roles label:has(input:focus-visible) { outline:2px solid rgba(47,93,69,.4); outline-offset:2px; }
    .istatus { font-size:.88rem; font-weight:600; color:var(--green); margin:12px 0 0; min-height:1.2em; }
    .istatus.err { color:#8a3f1e; }
    .istatus:empty { display:none; }
    .trap { position:absolute; left:-9999px; }

    /* floating notes on the hero photo */
    .chips { display:flex; flex-direction:column; align-items:flex-end; gap:14px; }
    .chip { background:rgba(250,246,238,.96); border:1px solid rgba(255,255,255,.6); border-radius:14px; padding:11px 14px; box-shadow:0 16px 40px rgba(20,13,7,.3); font-size:.8rem; color:var(--text); display:flex; align-items:center; gap:10px; animation:rise .9s 1s both, bob 5s 2s ease-in-out infinite; }
    .chip b { display:block; color:var(--ink); font-size:.84rem; font-weight:600; }
    .chip small { color:var(--soft); font-size:.74rem; }
    .chip .dot { width:34px; height:34px; border-radius:50%; background:#eef4ef; color:var(--green); display:flex; align-items:center; justify-content:center; flex:none; }
    .chip:nth-child(2) { margin-right:40px; animation-delay:1.15s, 3s; }
    .chip:nth-child(3) { animation-delay:1.3s, 4s; }
    @keyframes bob { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }
    .stars { color:#c08a2e; letter-spacing:2px; font-size:.8rem; }
    .ph { position:absolute; border-radius:22px; overflow:hidden; box-shadow:0 20px 50px rgba(44,26,14,.18); border:5px solid #fff; background:var(--cream); }
    .ph img { width:100%; height:100%; object-fit:cover; }

    /* glimpses */
    .glimpses { background:var(--cream); }
    .glimpses + .founders { padding-top:16px; }
    .g-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:28px; }
    .g-grid > *, .peek, .m-sit > div { min-width:0; }
    .g-card { background:#fff; border:1px solid var(--line); border-radius:22px; padding:28px; display:flex; flex-direction:column; gap:22px; box-shadow:0 1px 2px rgba(44,26,14,.04); transition:transform .3s ease, box-shadow .3s ease; }
    .g-card:hover { transform:translateY(-4px); box-shadow:0 16px 40px rgba(44,26,14,.08); }
    .g-card h3 { font-size:1.45rem; margin:0 0 8px; }
    .g-card p { margin:0; color:var(--soft); font-size:.94rem; line-height:1.7; }
    .peek { position:relative; background:var(--bg); border:1px solid var(--line); border-radius:16px; padding:18px; min-height:236px; overflow:hidden; }
    .peek::after { content:"Sneak peek"; position:absolute; top:12px; right:12px; font-family:'Lato',sans-serif; font-size:.6rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--brown); background:#fff; border:1px solid var(--line); border-radius:50px; padding:4px 9px; }

    /* mock: profile */
    .m-prof { display:flex; flex-direction:column; gap:12px; }
    .m-cover { height:104px; border-radius:12px; overflow:hidden; }
    .m-cover img { width:100%; height:100%; object-fit:cover; object-position:center 56%; }
    .m-id { display:flex; align-items:flex-start; gap:12px; margin-top:-30px; padding:0 10px; }
    .m-id > div:last-child { padding-top:36px; min-width:0; }
    .m-ava { width:62px; height:62px; border-radius:50%; border:3px solid #fff; overflow:hidden; flex:none; box-shadow:0 4px 12px rgba(44,26,14,.15); }
    .m-ava img { width:100%; height:100%; object-fit:cover; }
    .m-name { font-family:'Marcellus',serif; font-size:1.15rem; }
    .m-badge { display:inline-flex; align-items:center; gap:5px; font-size:.68rem; font-weight:600; color:var(--green); background:#eef4ef; border-radius:50px; padding:3px 9px; margin-left:6px; vertical-align:middle; }
    .m-meta { font-size:.76rem; color:var(--soft); padding:0 10px; }
    .m-tags { display:flex; gap:6px; flex-wrap:wrap; padding:0 10px; }
    .m-tags span { font-size:.7rem; background:#fff; border:1px solid var(--line); border-radius:50px; padding:4px 10px; color:var(--text); }
    .m-btn { align-self:flex-start; margin:2px 10px 0; font-size:.66rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fff; background:var(--green); border-radius:50px; padding:8px 16px; }

    /* mock: sit listing */
    .m-sit { display:grid; grid-template-columns:120px minmax(0,1fr); gap:14px; background:#fff; border:1px solid var(--line); border-radius:14px; padding:10px; }
    .m-sit + .m-sit { margin-top:10px; }
    .m-sit .img { border-radius:10px; overflow:hidden; height:96px; }
    .m-sit .img img { width:100%; height:100%; object-fit:cover; }
    .m-sit b { display:block; font-family:'Marcellus',serif; font-weight:400; font-size:1rem; margin:2px 0 4px; }
    .m-sit .where { font-size:.72rem; color:var(--soft); }
    .m-sit .facts { display:flex; gap:6px; flex-wrap:wrap; margin-top:8px; }
    .m-sit .facts span { font-size:.66rem; background:var(--cream); color:var(--brown); border-radius:50px; padding:3px 8px; font-weight:600; }

    /* mock: messages */
    .m-chat { display:flex; flex-direction:column; gap:9px; padding-top:28px; }
    .bub { max-width:82%; font-size:.8rem; line-height:1.5; padding:10px 13px; border-radius:16px; }
    .bub.them { background:#fff; border:1px solid var(--line); border-bottom-left-radius:5px; color:var(--text); }
    .bub.me { align-self:flex-end; background:var(--green); color:#fff; border-bottom-right-radius:5px; }
    .bub small { display:block; font-size:.64rem; opacity:.7; margin-top:3px; }
    .m-confirm { align-self:center; display:inline-flex; align-items:center; gap:7px; font-size:.72rem; font-weight:600; color:var(--green); background:#eef4ef; border:1px solid rgba(47,93,69,.25); border-radius:50px; padding:6px 12px; margin-top:4px; }

    /* mock: sit pack */
    .m-pack { display:flex; flex-direction:column; gap:8px; padding-top:28px; }
    .m-row { display:flex; align-items:center; gap:12px; background:#fff; border:1px solid var(--line); border-radius:12px; padding:10px 12px; font-size:.8rem; color:var(--text); }
    .m-row .ic { width:30px; height:30px; border-radius:9px; background:var(--cream); color:var(--brown); display:flex; align-items:center; justify-content:center; flex:none; }
    .m-row .r { margin-left:auto; font-size:.68rem; font-weight:600; color:var(--green); white-space:nowrap; }
    .m-row.locked { background:repeating-linear-gradient(135deg,#fff,#fff 8px,#fbf7f0 8px,#fbf7f0 16px); }
    .m-row.locked .r { color:var(--brown); display:inline-flex; align-items:center; gap:4px; }
    .blur { filter:blur(4px); user-select:none; }


    /* tabs: a look inside */
    .tabs { background:#fff; border:1px solid var(--line); border-radius:22px; padding:22px; box-shadow:0 1px 2px rgba(44,26,14,.04); }
    .tab-bar { display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding-bottom:4px; margin-bottom:22px; }
    .tab-bar::-webkit-scrollbar { display:none; }
    .tab-bar button { flex:none; font:inherit; font-size:.8rem; font-weight:600; letter-spacing:.06em; color:var(--text); background:var(--bg); border:1px solid rgba(110,84,56,.28); border-radius:50px; padding:10px 18px; cursor:pointer; min-height:44px; transition:background .2s, color .2s, border-color .2s; }
    .tab-bar button:hover { border-color:var(--green); }
    .tab-bar button[aria-selected="true"] { background:var(--green); border-color:var(--green); color:#fff; }
    .tab-bar button:focus-visible { outline:2px solid rgba(47,93,69,.4); outline-offset:2px; }
    .tab-panel { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:32px; align-items:center; }
    .tab-panel[hidden] { display:none; }
    .tp-text h3 { font-size:1.6rem; margin:0 0 10px; }
    .tp-text p { margin:0; color:var(--soft); font-size:.98rem; line-height:1.75; }
    .s-list { display:flex; flex-direction:column; gap:10px; padding-top:18px; }
    .s-list::after { display:none; }
    .s-item { display:flex; gap:12px; align-items:flex-start; background:#fff; border:1px solid var(--line); border-radius:12px; padding:10px 12px; font-size:.8rem; color:var(--soft); line-height:1.5; }
    .s-item .ic { width:32px; height:32px; border-radius:50%; background:#eef4ef; color:var(--green); display:flex; align-items:center; justify-content:center; flex:none; }
    .s-item .ic svg { width:16px; height:16px; }
    .s-item b { display:block; color:var(--ink); font-weight:600; font-size:.84rem; }

    /* both sides */
    .sides { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:28px; }
    .side { border-radius:22px; overflow:hidden; background:#fff; border:1px solid var(--line); display:flex; flex-direction:column; }
    .side .img { height:220px; overflow:hidden; }
    .side .img img { width:100%; height:100%; object-fit:cover; transition:transform .8s ease; }
    .side:hover .img img { transform:scale(1.04); }
    .side .body { padding:30px; }
    .side h3 { font-size:1.6rem; margin:6px 0 16px; }
    .side ol { list-style:none; padding:0; margin:0; display:grid; gap:14px; counter-reset:s; }
    .side li { counter-increment:s; display:flex; gap:14px; color:var(--text); font-size:.95rem; line-height:1.6; }
    .side li::before { content:counter(s); flex:none; width:28px; height:28px; border-radius:50%; background:var(--cream); color:var(--green); font-weight:600; font-size:.8rem; display:flex; align-items:center; justify-content:center; margin-top:1px; }
    .side .tag { font-family:'Lato',sans-serif; font-size:.7rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:var(--brown); }

    /* trust strip */
    .t-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:22px; }
    .t-item { text-align:center; padding:26px 18px; background:#fff; border:1px solid var(--line); border-radius:18px; }
    .t-item .ic { width:52px; height:52px; border-radius:50%; background:#eef4ef; color:var(--green); display:flex; align-items:center; justify-content:center; margin:0 auto 14px; }
    .t-item b { display:block; font-family:'Marcellus',serif; font-weight:400; font-size:1.15rem; margin-bottom:6px; }
    .t-item span { font-size:.86rem; color:var(--soft); line-height:1.6; }

    /* founders */
    .founders { background:var(--cream); }
    .f-wrap { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:56px; align-items:center; }
    .f-photos { position:relative; height:440px; }
    .f-photos .ph1 { left:0; top:0; width:50%; height:74%; }
    .f-photos .ph3 { right:0; top:9%; width:46%; height:66%; }
    .f-photos .ph2 { left:27%; bottom:0; width:42%; height:42%; z-index:2; }
    blockquote { margin:0 0 22px; font-family:'Marcellus',serif; font-size:1.5rem; line-height:1.45; color:var(--ink); }
    .f-sign { font-size:.86rem; color:var(--soft); margin:0 0 26px; }
    .f-stats { display:flex; gap:28px; flex-wrap:wrap; margin:0 0 28px; }
    .f-stats div b { display:block; font-family:'Marcellus',serif; font-weight:400; font-size:1.9rem; color:var(--green); }
    .f-stats div span { font-size:.78rem; color:var(--soft); }
    .btn-line { display:inline-flex; align-items:center; gap:8px; font-size:.76rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--green); text-decoration:none; border:1.5px solid var(--green); border-radius:50px; padding:14px 24px; background:#fff; }
    .btn-line:hover { background:var(--green); color:#fff; }

    /* final */
    .final { text-align:center; }
    .final .iform { margin:30px auto 0; text-align:left; }
    .final h2 { font-size:2.6rem; }

    footer { border-top:1px solid rgba(110,84,56,.2); padding:26px 48px 32px; }
    footer .bar { max-width:1140px; margin:0 auto; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:.76rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#8a6a4f; }
    footer a { color:var(--brown); text-decoration:none; }

    @media (max-width:980px) {
      .hero .wrap, .f-wrap { grid-template-columns:1fr; gap:44px; }
      .hero .wrap { gap:26px; }
      .chips { flex-direction:row; align-items:stretch; overflow-x:auto; scrollbar-width:none; margin:0 -48px; padding:4px 48px 8px; }
      .chips::-webkit-scrollbar { display:none; }
      .chip { flex:none; }
      .chip:nth-child(2) { margin-right:0; }
      .t-grid { grid-template-columns:repeat(2, minmax(0,1fr)); }
      .f-photos { max-width:520px; width:100%; margin:0 auto; height:380px; }
    }
    @media (max-width:760px) {
      .cs-top { padding:10px 16px; }
      .chips { margin:0 -16px; padding:4px 16px 8px; }
      .seal { width:76px; height:76px; right:16px; top:76px; }
      .seal svg { animation-duration:45s; }
      .seal img { width:26px; height:26px; }
      .seal::before { inset:15px; }
      /* Phone hero, same as the computer: the photo is the star. It fills the
         top of the screen with nothing over it but the heading at its foot;
         the rest sits below on the same dark ground (owner, 27 Oct 2026). */
      .hero { display:block; min-height:0; --ph:min(76svh,660px); }
      .hero .bg { position:absolute; top:0; left:0; right:0; height:var(--ph); overflow:hidden; }
      .hero .shade { bottom:auto; height:var(--ph); background:linear-gradient(180deg,rgba(20,13,7,.45) 0%,rgba(20,13,7,0) 18%,rgba(20,13,7,0) 52%,rgba(20,13,7,.78) 86%,var(--ink) 100%); }
      .hero .wrap { padding-top:calc(var(--ph) - 196px); padding-bottom:36px; gap:22px; }
      .pill { font-size:.6rem; letter-spacing:.14em; padding:6px 11px; margin-bottom:14px; }
      .hero h1 { margin-bottom:26px; }
      .trust { gap:10px 16px; font-size:.78rem; margin-top:16px; }
      .cs-logo img { height:36px; width:36px; }
      .cs-logo { font-size:1.2rem; }
      .cs-top-cta { padding:10px 18px; font-size:.66rem; }
      .cs-top-cta .lg { display:none; }
      .cs-top-cta .sm { display:inline; }
      .wrap { padding:0 16px; }
      .hero h1 { font-size:2.55rem; line-height:1.04; }
      .hero .lead { font-size:.95rem; line-height:1.7; margin-bottom:22px; }
        .sec { padding:64px 0; }
      h2, .final h2 { font-size:1.9rem; }
      .sec-head { margin-bottom:34px; }
      .g-grid, .sides { grid-template-columns:1fr; gap:20px; }
      .tabs { padding:14px; border-radius:18px; }
      .tab-bar { margin:0 -14px 16px; padding:0 14px 4px; }
      .tab-bar button { padding:9px 14px; font-size:.76rem; }
      .tab-panel { grid-template-columns:1fr; gap:16px; }
      .tp-text h3 { font-size:1.35rem; }
      .f-photos .ph1 { width:50%; height:72%; }
      .f-photos .ph3 { width:47%; height:64%; }
      .f-photos .ph2 { width:44%; height:42%; }
      .f-photos { height:320px !important; }
      .f-stats { margin-bottom:22px; }
      .g-card { padding:20px; }
      .chip { padding:9px 11px; font-size:.74rem; }
      .chip .dot { width:28px; height:28px; }
      .iform { padding:16px; display:flex; flex-direction:column; gap:12px; }
      .iform-row { display:contents; }
      .iform input[type=email] { order:1; }
      .iform .roles { order:2; margin-top:2px; }
      .iform button { order:3; padding:15px 20px; }
      .iform .istatus { order:4; margin:0; }
      .m-sit { grid-template-columns:96px minmax(0,1fr); }
      .m-sit .img { height:84px; }
      .side .body { padding:22px; }
      .side .img { height:180px; }
      .t-grid { gap:12px; }
      .t-item { padding:20px 12px; }
      blockquote { font-size:1.25rem; }
      .f-photos { height:300px; }
      footer { padding:22px 16px 28px; }
    }
    @media (max-width:380px) {
      .cs-top { padding:10px 12px; gap:10px; }
      .cs-logo { gap:10px; font-size:1.05rem; letter-spacing:.22em; }
      .cs-logo > span { padding-left:10px; }
      .cs-logo img { height:32px; width:32px; }
      .cs-top-cta { padding:9px 12px; font-size:.6rem; letter-spacing:.06em; }
    }
    @media (prefers-reduced-motion: reduce) {
      .chip, .pill i, .seal svg, .hero .bg img.on, .hero .copy > * { animation:none; }
      .reveal { opacity:1; transform:none; transition:none; }
    }
  </style>
</head>
<body>
  <header class="cs-top" data-top>
    <span class="cs-logo"><img class="lt" src="/images/logo-mark-white.png" alt="" /><img class="dk" src="/images/logo-mark.png" alt="" /><span><b>MYAH</b><small>Make Yourself At Home</small></span></span>
    <a class="cs-top-cta" href="#join"><span class="lg">Get early access</span><span class="sm">Join</span></a>
  </header>

  <main>
    <!-- Hero -->
    <section class="hero" data-hero>
      <div class="bg" aria-hidden="true">
        {heroPics.map(([f, pos], i) => i === 0
          ? <img class="on" src={`/images/${f}.jpg`} alt="" style={`object-position:${pos}`} fetchpriority="high" />
          : <img data-src={`/images/${f}.jpg`} alt="" style={`object-position:${pos}`} />)}
      </div>
      <div class="shade"></div>
      <div class="seal" aria-hidden="true">
        <svg viewBox="0 0 132 132"><defs><path id="cs-ring" d="M66,66 m-54,0 a54,54 0 1,1 108,0 a54,54 0 1,1 -108,0" /></defs><text><textPath href="#cs-ring" textLength="337" lengthAdjust="spacing">LAUNCHING SOON · MAKE YOURSELF AT HOME · </textPath></text></svg>
        <img src="/images/logo-mark-white.png" alt="" />
      </div>
      <div class="wrap">
        <div class="copy">
          <span class="pill"><i></i>Launching soon · Free to join</span>
          <h1>House &amp; pet sitting, <em>made simple.</em></h1>
          <p class="lead">MYAH brings trusted house &amp; pet sitters and home owners together in one place. Find the perfect sitter for your home and pets, or find your next sit, all in one beautiful, easy space.</p>
          <form class="iform" id="join" method="post" action="/api/interest" data-interest>
            <div class="iform-row">
              <input type="email" name="email" required autocomplete="email" placeholder="Your email address" aria-label="Your email address" />
              <button type="submit">Notify me</button>
            </div>
            <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="source" value="coming-soon" />
            <input type="hidden" name="ref" data-ref />
            <div class="roles" role="radiogroup" aria-label="I'm interested as a">
              <span>I'm a</span>
              <label><input type="radio" name="role" value="sitter" /> Sitter</label>
              <label><input type="radio" name="role" value="owner" /> Home owner</label>
              <label><input type="radio" name="role" value="both" /> Both</label>
            </div>
            <p class={'istatus' + (errText ? ' err' : '')} data-status role="status">{registered ? "Thank you, you're on the list. We'll email you the moment MYAH is live." : errText}</p>
          </form>
          <div class="trust">
            <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>Everyone ID checked</span>
            <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/></svg>Made by sitters</span>
            <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Free to join</span>
          </div>
        </div>

        <div class="chips" aria-hidden="true">
          <div class="chip"><span class="dot"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span><span><b>ID verified</b><small>Every member, every time</small></span></div>
          <div class="chip"><span class="dot"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V21H3z"/></svg></span><span><b>New sit in Cornwall</b><small>12–19 Nov · 2 dogs</small></span></div>
          <div class="chip"><span><span class="stars">★★★★★</span><b>"We came home to happy puppies"</b><small>Heather, home owner</small></span></div>
        </div>
      </div>
    </section>

    <!-- A look inside: one panel at a time instead of four long sections -->
    <section class="sec glimpses">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow c">A look inside</p>
          <h2>Everything a sit needs, <em>in one place</em></h2>
        </div>
        <div class="tabs" data-tabs>
          <div class="tab-bar" role="tablist" aria-label="What MYAH does">
            <button type="button" role="tab" id="tb-page" aria-controls="tp-page" aria-selected="true">Your page</button>
            <button type="button" role="tab" id="tb-sits" aria-controls="tp-sits" aria-selected="false" tabindex="-1">Finding sits</button>
            <button type="button" role="tab" id="tb-chat" aria-controls="tp-chat" aria-selected="false" tabindex="-1">Messages</button>
            <button type="button" role="tab" id="tb-pack" aria-controls="tp-pack" aria-selected="false" tabindex="-1">Sit pack</button>
            <button type="button" role="tab" id="tb-safe" aria-controls="tp-safe" aria-selected="false" tabindex="-1">Safety</button>
          </div>
          <div class="tab-panel" id="tp-page" role="tabpanel" aria-labelledby="tb-page">
            <div class="peek">
              <div class="m-prof">
                <div class="m-cover"><img src="/images/slideshow-dogs-lake.jpeg" alt="" /></div>
                <div class="m-id">
                  <div class="m-ava"><img src="/images/couple-field-1.jpg" alt="" /></div>
                  <div><span class="m-name">Callum &amp; Niamh</span><span class="m-badge">✓ ID verified</span></div>
                </div>
                <div class="m-meta"><span class="stars">★★★★★</span> {FOUNDERS_REVIEW_TOTAL}+ reviews · UK &amp; Australia</div>
                <div class="m-tags"><span>Dogs</span><span>Cats</span><span>Long stays</span><span>Garden care</span></div>
                <span class="m-btn">Book us</span>
              </div>
            </div>
            <div class="tp-text"><h3>Your own sitter page</h3><p>A beautiful page all about you: photos, reviews from past sits, the pets you love and when you're free. Share one link anywhere.</p></div>
          </div>
          <div class="tab-panel" id="tp-sits" role="tabpanel" aria-labelledby="tb-sits" hidden>
            <div class="peek">
              <div class="m-sit">
                <div class="img"><img src="/images/slideshow-garden-conservatory.jpeg" alt="" /></div>
                <div><span class="where">Cornwall · 12–19 Nov</span><b>Cottage by the sea</b><div class="facts"><span>2 dogs</span><span>Garden</span><span>Wifi</span></div></div>
              </div>
              <div class="m-sit">
                <div class="img"><img src="/images/slideshow-cat-bag.jpeg" alt="" /></div>
                <div><span class="where">Edinburgh · 3–10 Dec</span><b>City flat with Luna</b><div class="facts"><span>1 cat</span><span>Near station</span></div></div>
              </div>
            </div>
            <div class="tp-text"><h3>Find sits you'll love</h3><p>Browse homes and pets near and far, save your favourites and apply in a tap. Owners post a sit and choose from the sitters who apply.</p></div>
          </div>
          <div class="tab-panel" id="tp-chat" role="tabpanel" aria-labelledby="tb-chat" hidden>
            <div class="peek">
              <div class="m-chat">
                <div class="bub them">Hello. Would you be free 12–19 Nov for Bramble and Moss?<small>Owner</small></div>
                <div class="bub me">We would. We have looked after two spaniels before.<small>You</small></div>
                <div class="bub them">Perfect, confirming you now.<small>Owner</small></div>
                <span class="m-confirm">✓ Sit confirmed · 12–19 Nov</span>
              </div>
            </div>
            <div class="tp-text"><h3>Message &amp; confirm in one place</h3><p>Chat, agree the dates and confirm the sit without swapping numbers. Everything about each sit stays together.</p></div>
          </div>
          <div class="tab-panel" id="tp-pack" role="tabpanel" aria-labelledby="tb-pack" hidden>
            <div class="peek">
              <div class="m-pack">
                <div class="m-row"><span class="ic">🐕</span>Feeding: 8am &amp; 5pm, one scoop<span class="r">✓ Shared</span></div>
                <div class="m-row"><span class="ic">🩺</span>Vet: Harbour Vets, 01234…<span class="r">✓ Shared</span></div>
                <div class="m-row locked"><span class="ic">🏡</span><span class="blur">14 Harbour Road, St Ives</span><span class="r">🔒 Day before</span></div>
                <div class="m-row locked"><span class="ic">📶</span><span class="blur">Wifi: Bramble2026</span><span class="r">🔒 Day before</span></div>
              </div>
            </div>
            <div class="tp-text"><h3>A sit pack that keeps you safe</h3><p>Routines, vet details and house notes in one handy pack. The address and door codes stay hidden until the day before, unless the owner shares them sooner.</p></div>
          </div>
          <div class="tab-panel" id="tp-safe" role="tabpanel" aria-labelledby="tb-safe" hidden>
            <div class="peek s-list"><div class="s-item"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div><span><b>Everyone ID checked</b>Photo ID and a selfie, checked by us before anyone can apply or post.</span></div><div class="s-item"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div><span><b>Private stays private</b>Addresses and codes are only shared with your confirmed sitter.</span></div><div class="s-item"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.9 5.9 6.1.9-4.5 4.3 1.1 6.1L12 17.3 6.4 20.2l1.1-6.1L3 9.8l6.1-.9z"/></svg></div><span><b>Real reviews</b>Bring your reviews with you, and collect new ones after every sit.</span></div><div class="s-item"><div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/></svg></div><span><b>Free to join</b>No membership fees. Sign up as a sitter, an owner, or both.</span></div></div>
            <div class="tp-text"><h3>Safe for both sides</h3><p>Everyone is checked before they can apply, post or message, and private details stay private until a sit is confirmed.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Founders -->
    <section class="sec founders">
      <div class="wrap f-wrap">
        <div class="f-photos reveal" aria-hidden="true">
          <div class="ph ph1"><img src={ourPics[0]} alt="" style="object-position:center 30%" /></div>
          <div class="ph ph3"><img src={ourPics[2]} alt="" style="object-position:center 40%" /></div>
          <div class="ph ph2"><img src={ourPics[1]} alt="" style="object-position:center 30%" /></div>
        </div>
        <div class="reveal">
          <p class="eyebrow">Made by sitters</p>
          <h2 style="margin-bottom:22px">Hello, we're <em>Callum &amp; Niamh</em></h2>
          <p class="lead" style="margin:0 0 24px">We're house &amp; pet sitters ourselves, and we built MYAH to be the place we always wished existed: simple, safe and made for the people (and pets) who use it.</p>
          <blockquote>"Callum &amp; Niamh were amazing sitters! We came home to happy puppies and they went the extra mile."</blockquote>
          <p class="f-sign">Heather · home owner, Sydney</p>
          <div class="f-stats">
            <div><b>{FOUNDERS_REVIEW_TOTAL}+</b><span>reviews from home owners</span></div>
            <div><b>UK &amp; Australia</b><span>sits so far</span></div>
          </div>
          <a class="btn-line" href={founders}>Meet us &amp; book us as your sitters →</a>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="sec final">
      <div class="wrap reveal">
        <p class="eyebrow c">Be the first in</p>
        <h2>Make yourself <em>at home</em></h2>
        <p class="lead" style="max-width:560px;margin:14px auto 0">Register your interest and we'll email you the moment MYAH opens, so you can be one of the very first members.</p>
        <form class="iform" method="post" action="/api/interest" data-interest>
          <div class="iform-row">
            <input type="email" name="email" required autocomplete="email" placeholder="Your email address" aria-label="Your email address" />
            <button type="submit">Notify me</button>
          </div>
          <input class="trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="source" value="coming-soon-bottom" />
          <input type="hidden" name="ref" data-ref />
          <div class="roles" role="radiogroup" aria-label="I'm interested as a">
            <span>I'm a</span>
            <label><input type="radio" name="role" value="sitter" /> Sitter</label>
            <label><input type="radio" name="role" value="owner" /> Home owner</label>
            <label><input type="radio" name="role" value="both" /> Both</label>
          </div>
          <p class="istatus" data-status role="status"></p>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <div class="bar">
      <span>&copy; 2026 MYAH</span>
      <span><a href="/privacy">Privacy</a> &nbsp;·&nbsp; <a href="mailto:info@myahsits.com">info@myahsits.com</a></span>
    </div>
  </footer>

  <Welcome open={registered} role={Astro.url.searchParams.get('as') || ''} />

  <script is:inline>
  (() => {
    // How they found us: a ?utm_source= / ?ref= tag, else the page they came from.
    const sp = new URLSearchParams(location.search);
    const via = sp.get('utm_source') || sp.get('ref') || document.referrer || '';
    document.querySelectorAll('[data-ref]').forEach((i) => { i.value = via; });
    // Send the interest form without leaving the page.
    document.querySelectorAll('form[data-interest]').forEach((f) => {
      const st = f.querySelector('[data-status]');
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        st.className = 'istatus'; st.textContent = 'Sending…';
        fetch('/api/interest', { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } })
          .then((r) => r.json().then((j) => ({ ok: r.ok, j })))
          .then(({ ok, j }) => {
            if (ok) {
              const email = f.querySelector('input[type=email]').value.trim();
              f.reset(); st.textContent = "You're on the list. Check your inbox for a welcome email.";
              if (window.myahWelcome) window.myahWelcome({ role: j.role, position: j.position, email });
            }
            else { st.className = 'istatus err'; st.textContent = j.error === 'email' ? 'Please check your email address and try again.' : 'Something went wrong, please try again.'; }
          })
          .catch(() => { st.className = 'istatus err'; st.textContent = 'Something went wrong, please try again.'; });
      });
    });
    // "A look inside" tabs: click or use the arrow keys.
    document.querySelectorAll('[data-tabs]').forEach((box) => {
      const tabs = [...box.querySelectorAll('[role=tab]')];
      const show = (t) => {
        tabs.forEach((x) => { const on = x === t; x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1; box.querySelector('#' + x.getAttribute('aria-controls')).hidden = !on; });
        t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (d) { e.preventDefault(); const n = tabs[(i + d + tabs.length) % tabs.length]; show(n); n.focus(); }
        });
      });
    });
    // Header turns solid once you scroll past the photo; the photo slowly changes.
    const top = document.querySelector('[data-top]');
    const solid = () => top.classList.toggle('solid', window.scrollY > 40);
    solid(); window.addEventListener('scroll', solid, { passive: true });
    const pics = [...document.querySelectorAll('[data-hero] .bg img')];
    // Photos load one ahead of when they're shown, so the page stays quick.
    const load = (img) => { if (img && img.dataset.src) { img.src = img.dataset.src; delete img.dataset.src; } };
    if (pics.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let i = 0;
      window.addEventListener('load', () => load(pics[1]));
      setInterval(() => {
        const next = (i + 1) % pics.length;
        if (pics[next].dataset.src || !pics[next].complete) { load(pics[next]); return; }
        pics[i].classList.remove('on'); i = next; pics[i].classList.add('on');
        load(pics[(i + 1) % pics.length]);
      }, 6000);
    }
    // Fade sections in as they scroll into view.
    const els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('in')); return; }
    const io = new IntersectionObserver((entries) => entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { threshold: 0.12 });
    els.forEach((el) => io.observe(el));
  })();
  </script>
</body>
</html>
