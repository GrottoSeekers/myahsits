---
// Data: the signed-in
// member's `billing` row
// (src/lib/billing.ts) and
// the live Stripe prices
// (same for both sides). Buttons
// post to /api/billing/*.
// While PAYMENTS_ENABLED
// is off it just says
// MYAH is free.
export const prerender =
  false;
import AppNav from
  './_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../lib/account';
import {
  PAYMENTS_ENABLED,
  getBilling,
  hasAccess,
  tierOfPlan,
  prices as livePrices,
} from
  '../lib/billing';

const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'any',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const billing =
  PAYMENTS_ENABLED
    ? await getBilling(
      acct!.userId,
    )
    : null;
const member =
  PAYMENTS_ENABLED &&
  !!billing
    ?.stripe_subscription_id &&
  hasAccess(billing);
const prices =
  PAYMENTS_ENABLED &&
  !member
    ? await livePrices()
      .catch(() => ({ basic: {}, premium: {} }))
    : { basic: {}, premium: {} };
const editHref =
  acct!.side === 'owner'
    ? '/owner/profile/edit#page-style'
    : '/profile/edit#page-style';
// The two memberships: Basic is the classic one-page layout, Premium the
// founders' page design. Same features otherwise.
const TIERS = [
  {
    key: 'basic',
    name: 'Basic',
    blurb: 'Your page in our classic layout: banner photos, About, Reviews, Photos and an enquiry form, with your own headings and colours.',
  },
  {
    key: 'premium',
    name: 'Premium',
    blurb: 'Your page in our founders\u2019 design: one full-screen photo, a moving highlights strip, tabs for each section and gentle animations.',
  },
] as const;
const upgrade =
  Astro.url.searchParams
    .get('upgrade') === 'premium';

const money = (p: any) =>
  p
    ? new Intl.NumberFormat(
      'en-GB',
      {
        style: 'currency',
        currency:
          p.currency
            .toUpperCase(),
      },
    ).format(
      p.unit_amount / 100,
    )
    : '';
const fmt = (v: any) =>
  v
    ? new Date(v)
      .toLocaleDateString(
        'en-GB',
        {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        },
      )
    : '';
const planName =
  (tierOfPlan(billing?.plan) === 'premium' ? 'Premium' : 'Basic') +
  (billing?.plan
    ?.endsWith('annual')
    ? ' · Yearly'
    : ' · Monthly');
const sideName =
  acct!.side === 'owner'
    ? 'Owner'
    : 'Sitter';
const welcome =
  Astro.url.searchParams
    .has('welcome');
const card =
  'background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:14px;padding:30px 30px 28px';
const btn =
  'display:inline-block;background:#2f5d45;color:#fff;border:0;border-radius:999px;padding:13px 26px;font:600 .82rem Montserrat,sans-serif;letter-spacing:.1em;text-transform:uppercase;cursor:pointer';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Membership — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    [data-billing][disabled] { opacity: .6; cursor: wait !important; }
    @media (max-width: 1000px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 34px 20px 80px !important; }
      [data-plans] { grid-template-columns: minmax(0,1fr) !important; }
    }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
  <AppNav side={acct!.side} active="billing" />

  <main data-pad="1" style="padding:52px 48px 90px">
    <div style="max-width:880px;margin:0 auto">
      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:28px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px">MYAH {sideName.toLowerCase()}</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;line-height:1.15;margin:0">Your <em style="color:#2f5d45">membership</em></h1>
      </div>

      {!PAYMENTS_ENABLED && (
        <section style={card}>
          <p style="margin:0 0 12px;color:#6b4e35;line-height:1.75">MYAH is free while we grow. There's nothing to pay, and we'll give everyone plenty of notice before memberships begin.</p>
          <p style="margin:0;color:#6b4e35;line-height:1.75">There will be two memberships: <strong>Basic</strong>, our classic page layout, and <strong>Premium</strong>, our founders&rsquo; page design. Until then you can use either. <a href={editHref}>Choose your page design</a></p>
        </section>
      )}

      {member && (
        <section style={card}>
          {welcome && <p style="margin:0 0 14px;color:#2f5d45;font-weight:600">Welcome aboard — your membership is active.</p>}
          <h2 style="font-family:'Marcellus',serif;font-weight:400;font-size:1.5rem;margin:0 0 8px">MYAH membership · {planName}</h2>
          <p style="margin:0 0 22px;color:#6b4e35;line-height:1.75">
            {billing!.status === 'past_due'
              ? 'Your last payment didn’t go through. Please update your card to keep your membership.'
              : billing!.cancel_at_period_end
                ? `Ends on ${fmt(billing!.current_period_end)}. You can restart it any time before then.`
                : `Renews on ${fmt(billing!.current_period_end)}.`}
          </p>
          {tierOfPlan(billing?.plan) === 'basic' && <p style="margin:0 0 18px;color:#6b4e35;line-height:1.75">{upgrade && <strong>Premium needs a Premium membership. </strong>}Want the founders&rsquo; page design? Switch to Premium under &ldquo;Manage membership&rdquo;.</p>}
          <button type="button" data-billing="portal" style={btn}>Manage membership &amp; invoices</button>
        </section>
      )}

      {PAYMENTS_ENABLED && !member && (
        <div>
          {welcome && <p style="margin:0 0 18px;color:#6b4e35">Thanks! We're confirming your payment — refresh in a moment.</p>}
          {upgrade && <p style="margin:0 0 18px;color:#2f5d45;font-weight:600">The founders&rsquo; page design comes with Premium.</p>}
          <div data-plans="1" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px">
            {TIERS.map((t) => (
              <section style={card + (t.key === 'premium' ? ';border-color:#2f5d45;box-shadow:0 0 0 1px #2f5d45' : '')}>
                <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 10px">{t.name}</p>
                <p style="margin:0 0 18px;color:#6b4e35;font-size:.9rem;line-height:1.7">{t.blurb}</p>
                {(['month', 'year'] as const).map((iv) => (
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 0;border-top:1px solid rgba(110,84,56,.15)">
                    <p style="font-family:'Marcellus',serif;font-size:1.5rem;margin:0">{money((prices as any)[t.key][iv]) || '—'}<span style="font-size:.9rem;color:#6b4e35"> / {iv}</span></p>
                    <button type="button" data-billing="checkout" data-tier={t.key} data-interval={iv} style={btn} disabled={!(prices as any)[t.key][iv]}>Choose</button>
                  </div>
                ))}
                <p style="margin:8px 0 0;color:#6b4e35;font-size:.82rem">Including VAT where it applies. Cancel any time.</p>
              </section>
            ))}
          </div>
          {billing?.stripe_customer_id && (
            <p style="margin:22px 0 0"><button type="button" data-billing="portal" style="background:none;border:0;padding:0;color:#2f5d45;text-decoration:underline;cursor:pointer;font:inherit">Past invoices</button></p>
          )}
        </div>
      )}
      <p data-billing-error style="color:#a33;margin:18px 0 0"></p>
    </div>
  </main>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-billing]').forEach((b) => {
      b.addEventListener('click', async () => {
        const err = document.querySelector('[data-billing-error]')!;
        err.textContent = '';
        b.disabled = true;
        try {
          const res = await fetch(`/api/billing/${b.dataset.billing}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ interval: b.dataset.interval, tier: b.dataset.tier }),
          });
          const out = await res.json();
          if (out.url) { location.href = out.url; return; }
          err.textContent = 'Something went wrong. Please try again.';
        } catch {
          err.textContent = 'Something went wrong. Please try again.';
        }
        b.disabled = false;
      });
    });
  </script>
</body>
</html>
