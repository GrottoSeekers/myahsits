---
// An owner's public page — what a sitter sees at myahsits.com/<slug>.
// /[slug] hands owners over to this page (Astro.rewrite), so the address stays
// myahsits.com/<slug>; opening /owner-page/<slug> directly redirects there.
// Built from the "Page preview" on Edit owner profile: home, pets, amenities,
// what they are looking for, photos, open sits and a way to get in touch.
// Handover details stay private and are never shown here.
export const prerender = false;
import { supabase } from '../../lib/supabase';
import { getAccount } from '../../lib/account';
import { jsonArr, jsonObj } from '../../lib/db';
import { PAYMENTS_ENABLED, getBilling } from '../../lib/billing';
import { layoutOf } from '../../lib/tier';
import OwnerSignature from '../../components/OwnerSignature.astro';

const { slug } = Astro.params;
if (!slug) return new Response('Not found', { status: 404 });
if (Astro.originPathname.startsWith('/owner-page/')) {
  return Astro.redirect('/' + slug, 301);
}

let p: any = null;
try {
  const res = await supabase.from('profiles').select('*').eq('slug', slug).limit(1);
  p = Array.isArray(res.data) && res.data.length ? res.data[0] : null;
} catch {}
if (!p) return new Response('Not found', { status: 404 });

// Open sits from this owner, soonest first.
const today = new Date().toISOString().slice(0, 10);
let sits: any[] = [];
try {
  const lr = await supabase
    .from('listings')
    .select('id, title, date_from, date_to, status')
    .eq('profile_id', p.id)
    .eq('status', 'active')
    .gte('date_to', today)
    .order('date_from', { ascending: true });
  sits = lr.data ?? [];
} catch {}

// Who is looking: the owner themselves, a signed-in sitter, or a visitor.
const viewer = await getAccount(Astro.request);
const isMe = !!viewer?.profile && viewer.profile.id === p.id;
const canMessage = !!viewer?.profile && viewer.side === 'sitter';

const esc = (v: unknown) => String(v ?? '').trim();
const local = (s: string) => esc(s).replace(/^public\//, '/');
const name = esc(p.name) || 'MYAH owner';
const first = name.split(/\s+/)[0];
const location = esc(p.location);
const tagline = esc(p.tagline);
const bio = esc(p.bio).split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
const lookingFor = esc(p.looking_for).split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
const pets = jsonArr(p.pets_json).filter((x: any) => x && x.name);
const amenities = jsonArr(p.amenities_json).map(esc).filter(Boolean);
const gallery = jsonArr(p.gallery_json).filter((g: any) => g && g.src).map((g: any) => ({ src: local(g.src), alt: esc(g.alt), cap: esc(g.cap) }));
const aboutPics = jsonArr(p.about_images_json).filter((g: any) => g && g.src).map((g: any) => ({ src: local(g.src), alt: esc(g.alt) }));
const heroPics = jsonArr(p.hero_images_json).filter((g: any) => g && g.src).map((g: any) => ({ src: local(g.src), pos: esc(g.pos) || 'center' }));
const hero = heroPics.length
  ? heroPics
  : gallery.length
    ? [{ src: gallery[0].src, pos: 'center' }]
    : [{ src: '/images/slideshow-living-room.jpeg', pos: 'center' }];
const about = aboutPics.length ? aboutPics : p.profile_pic ? [{ src: local(p.profile_pic), alt: name }] : [];

const h = jsonObj(p.headings_json);
const head = {
  aboutLabel: esc(h.about_label) || 'About our home',
  aboutTitle: esc(h.about_title) || 'A great place to stay — for you and the pets.',
  petsLabel: esc(h.pets_label) || 'Meet the pets',
  petsTitle: esc(h.pets_title) || 'Who you would be — looking after',
  galleryLabel: esc(h.gallery_label) || 'Our home',
  galleryTitle: esc(h.gallery_title) || 'Room — by room',
  enquiryLabel: esc(h.enquiry_label) || 'Get in touch',
  enquiryTitle: esc(h.enquiry_title) || 'Contact — ' + name,
};

const t = jsonObj(p.theme_json);
const hex = (v: unknown, d: string) => (/^#[0-9a-fA-F]{6}$/.test(String(v)) ? String(v) : d);
const theme = {
  bg: hex(t.background, '#faf6ee'),
  accent: hex(t.accent, '#2f5d45'),
  light: hex(t.accent_light, '#c4ab8a'),
  text: hex(t.text, '#2c1a0e'),
  soft: hex(t.text_soft, '#6b4e35'),
};

// A title is split at " — ": the second half shows in italics (as on sitter pages).
const split = (t: string) => {
  const i = t.indexOf(' — ');
  return i < 0 ? [t, ''] : [t.slice(0, i), t.slice(i + 3)];
};
// Colours as CSS variables on <html> (define:vars on a global style left them unset).
const vars = `--bg:${theme.bg};--accent:${theme.accent};--light:${theme.light};--ink:${theme.text};--soft:${theme.soft}`;
// Photos shown before "Show all" (keeps the page short), as on sitter pages.
const GAL_FIRST = 6;
const fmt = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const nights = (a: string, b: string) =>
  Math.max(1, Math.round((new Date(b + 'T00:00:00').getTime() - new Date(a + 'T00:00:00').getTime()) / 86400000));
const sitCards = sits.map((s) => ({
  id: s.id,
  title: esc(s.title) || 'House sit',
  dates: fmt(s.date_from) + ' — ' + fmt(s.date_to),
  length: nights(s.date_from, s.date_to) + ' nights',
}));

const waNum = esc(p.whatsapp_number).replace(/[^0-9]/g, '');
const petLine = (x: any) => [esc(x.type), esc(x.breed), esc(x.age)].filter(Boolean).join(' · ');
const initials = (n: string) => n.split(/\s+/).map((w) => w[0] || '').join('').slice(0, 2).toUpperCase();
const description = name + (location ? ' — ' + location : '') + '. ' + (tagline || 'Looking for a trusted house & pet sitter on MYAH.');
const sections = [
  { id: 'about', label: 'Home', show: bio.length > 0 || about.length > 0 },
  { id: 'pets', label: 'Pets', show: pets.length > 0 },
  { id: 'photos', label: 'Photos', show: gallery.length > 0 },
  { id: 'sits', label: 'Sits', show: sitCards.length > 0 },
].filter((s) => s.show);
// Page design: Basic (below) or Premium (OwnerSignature), see lib/tier.ts.
// ?layout=basic|premium lets the owner preview either design.
let PREMIUM = layoutOf(p, PAYMENTS_ENABLED ? await getBilling(p.user_id).catch(() => null) : null) === 'premium';
const want = Astro.url.searchParams.get('layout');
if (isMe && (want === 'basic' || want === 'premium')) PREMIUM = want === 'premium';
const premiumProps = {
  name, first, location, tagline, badge: esc(p.badge_text),
  hero, about: aboutPics, bio, lookingFor, amenities,
  pets: pets.map((x: any) => ({ name: esc(x.name), line: petLine(x), temperament: esc(x.temperament), needs: esc(x.special_needs), photo: x.photo_url ? local(x.photo_url) : '', initials: initials(esc(x.name)) })),
  gallery, sits: sitCards, waNum, slug, ownerId: p.id, isMe, canMessage, signedIn: !!viewer,
  head, theme, description, ogImage: hero[0].src.startsWith('http') ? hero[0].src : '/images/logo-tile.png',
};
---

<!doctype html>
{PREMIUM ? <OwnerSignature {...premiumProps} /> : (
<html lang="en" style={vars}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{name} — MYAH</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content={hero[0].src.startsWith('http') ? hero[0].src : '/images/logo-tile.png'} />
  <link rel="canonical" href={'https://www.myahsits.com/' + slug} />
  <meta property="og:url" content={'https://www.myahsits.com/' + slug} />
  <meta property="og:site_name" content="MYAH" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    body { margin:0; background:var(--bg); color:var(--ink); font-family:"Montserrat",sans-serif; overflow-x:hidden; }
    * { box-sizing:border-box; }
    a { color:var(--accent); }
    @keyframes gs-ring { to { transform:rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }

    .op-top { position:fixed; top:0; left:0; right:0; z-index:210; padding:16px 48px; display:flex; justify-content:space-between; align-items:center; gap:40px; background:rgba(250,246,238,.97); backdrop-filter:blur(12px); box-shadow:0 1px 0 rgba(110,84,56,.2); }
    .op-logo { display:inline-flex; align-items:center; gap:14px; text-decoration:none; line-height:1; margin-left:-4px; font-weight:500; font-size:1.4rem; letter-spacing:.28em; flex-shrink:0; }
    .op-logo img { height:46px; width:46px; display:block; object-fit:contain; }
    .op-logo > span { display:flex; flex-direction:column; gap:5px; padding-left:14px; border-left:1px solid rgba(110,84,56,.4); }
    .op-logo b { color:#2f5d45; font-weight:500; line-height:1; }
    .op-logo small { font-family:'Lato',sans-serif; font-weight:700; font-size:.5rem; letter-spacing:.2em; text-transform:uppercase; color:#8a6a4f; line-height:1; }
    .op-nav { display:flex; align-items:center; gap:30px; }
    .op-nav a.op-link { font-size:.8rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#5c3d20; text-decoration:none; white-space:nowrap; transition:color .2s; }
    .op-nav a.op-link:hover { color:var(--accent); }
    .op-btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; font-family:'Montserrat',sans-serif; font-size:.78rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:#fff; text-decoration:none; background:var(--accent); border:1.5px solid var(--accent); border-radius:50px; padding:13px 28px; cursor:pointer; white-space:nowrap; box-shadow:0 6px 20px rgba(110,84,56,.28); transition:filter .2s, transform .12s; }
    .op-btn:hover { filter:brightness(1.12); transform:translateY(-2px); color:#fff; }
    .op-ghost { display:inline-flex; align-items:center; justify-content:center; gap:8px; font-size:.76rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); text-decoration:none; background:#fff; border:1.5px solid rgba(110,84,56,.4); border-radius:50px; padding:12px 24px; white-space:nowrap; transition:border-color .2s; }
    .op-ghost:hover { border-color:var(--accent); }

    .op-mine { position:fixed; left:0; right:0; bottom:0; z-index:220; background:#fff; color:#2c1a0e; border-top:1px solid rgba(110,84,56,.28); box-shadow:0 -6px 24px rgba(44,26,14,.06); padding:14px 48px; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:.86rem; }
    .op-mine a { color:#2f5d45; font-weight:600; }

    .op-hero { min-height:78vh; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; padding:140px 48px 80px; text-align:center; }
    .op-hero .bg { position:absolute; inset:0; z-index:0; background:#2c1a0e; }
    .op-hero .bg img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:opacity 1.2s ease; }
    .op-hero .shade { position:absolute; inset:0; z-index:1; background:linear-gradient(180deg, rgba(44,26,14,.52) 0%, rgba(44,26,14,.66) 100%); }
    .op-hero .word { font-family:'Montserrat',sans-serif; font-weight:500; letter-spacing:.28em; font-size:4.6rem; color:#fff; line-height:1; margin:0 0 18px; }
    .op-hero .word em { color:var(--light); }
    .op-hero .who { font-size:1.1rem; color:#fff; font-weight:600; letter-spacing:.14em; text-transform:uppercase; margin:0 0 18px; }
    .op-hero .meta i { width:5px; height:5px; border-radius:50%; background:rgba(196,171,138,.6); display:block; }
    .op-scroll { position:absolute; bottom:30px; left:50%; transform:translateX(-50%); z-index:2; width:42px; height:42px; border-radius:50%; border:1px solid rgba(196,171,138,.5); background:rgba(250,246,238,.12); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; color:#fff; text-decoration:none; transition:background .2s; }
    .op-scroll:hover { background:rgba(250,246,238,.24); color:#fff; }
    .op-hero .inner { position:relative; z-index:2; max-width:720px; }
    .op-pill { display:inline-flex; align-items:center; gap:10px; background:rgba(250,246,238,.14); border:1px solid rgba(196,171,138,.45); backdrop-filter:blur(6px); color:#fff; padding:9px 20px; border-radius:50px; font-size:.76rem; font-weight:600; letter-spacing:.14em; text-transform:uppercase; margin:0 0 26px; }
    .op-hero h1 { font-family:'Marcellus',serif; font-weight:400; font-size:3.6rem; color:#fff; line-height:1.1; margin:0 0 18px; }
    .op-hero .tag { font-size:1.08rem; color:rgba(255,255,255,.88); line-height:1.75; max-width:560px; margin:0 auto 34px; }
    .op-hero .meta { display:flex; align-items:center; gap:20px; justify-content:center; flex-wrap:wrap; margin-top:30px; font-size:.78rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.8); }

    .op-sec { padding:100px 48px; background:var(--bg); }
    .op-wrap { max-width:1100px; margin:0 auto; }
    .op-label { font-size:.75rem; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:#6e5438; margin:0 0 18px; display:flex; align-items:center; gap:12px; }
    .op-label::before { content:""; width:26px; height:1px; background:#6e5438; display:block; flex-shrink:0; }
    .op-h2 { font-family:'Marcellus',serif; font-weight:400; font-size:2.5rem; color:var(--ink); line-height:1.2; margin:0; }
    .op-h2 em { color:var(--accent); }
    .op-rule { width:48px; height:2px; background:#6e5438; margin:24px 0 30px; }
    .op-p { color:var(--soft); line-height:1.85; font-size:.98rem; margin:0 0 16px; }
    .op-split { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:60px; align-items:center; }
    .op-about-pic { position:relative; aspect-ratio:4/5; border-radius:18px; overflow:hidden; background:#e9e0d2; box-shadow:0 20px 50px rgba(44,26,14,.12); }
    .op-about-pic img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; transition:opacity .5s ease; }
    .op-about-pic { border:1px solid rgba(110,84,56,.22); box-shadow:none; }
    .op-arrow { position:absolute; top:50%; transform:translateY(-50%); background:rgba(250,246,238,.9); border:1px solid rgba(110,84,56,.3); width:42px; height:42px; border-radius:50%; font-size:1.3rem; color:var(--ink); cursor:pointer; z-index:2; display:flex; align-items:center; justify-content:center; }
    .op-arrow:hover { background:#fff; }
    .op-dots { position:absolute; bottom:16px; left:50%; transform:translateX(-50%); display:flex; gap:8px; z-index:2; }
    .op-dots button { width:10px; height:10px; border-radius:50%; border:2px solid rgba(255,255,255,.85); background:transparent; cursor:pointer; padding:0; }
    .op-dots button.on { background:rgba(255,255,255,.9); }

    .op-pets { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:22px; }
    .op-pet { background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; overflow:hidden; display:flex; flex-direction:column; }
    .op-pet .pic { aspect-ratio:4/3; background:#e9e0d2; display:flex; align-items:center; justify-content:center; }
    .op-pet .pic img { width:100%; height:100%; object-fit:cover; display:block; }
    .op-pet .pic span { font-family:'Marcellus',serif; font-size:2.4rem; color:#8a6a4f; }
    .op-pet .body { padding:22px 22px 24px; display:flex; flex-direction:column; gap:8px; }
    .op-pet h3 { font-family:'Marcellus',serif; font-weight:400; font-size:1.4rem; margin:0; color:var(--ink); }
    .op-pet .line { font-size:.8rem; font-weight:600; color:var(--accent); letter-spacing:.04em; margin:0; }
    .op-pet .temp { font-size:.9rem; color:var(--soft); line-height:1.7; margin:0; }
    .op-pet .needs { font-size:.84rem; color:#a4442e; line-height:1.6; margin:4px 0 0; }

    .op-chips { display:flex; flex-wrap:wrap; gap:10px; }
    .op-chip { display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:50px; background:#fff; border:1px solid rgba(110,84,56,.28); font-size:.86rem; color:#5c3d20; }
    .op-chip::before { content:"✓"; color:var(--accent); font-weight:600; }
    .op-card { background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; padding:34px 36px; }

    .op-gal { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:14px; }
    .op-gal button { position:relative; border:none; padding:0; border-radius:14px; overflow:hidden; aspect-ratio:1; cursor:pointer; background:#e9e0d2; }
    .op-gal button.op-more { display:none; }
    .op-gal.all button.op-more { display:block; }
    .op-show-all { display:inline-flex; align-items:center; margin-top:22px; font-family:'Montserrat',sans-serif; font-size:.76rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); background:none; border:1.5px solid rgba(110,84,56,.35); border-radius:50px; padding:12px 26px; cursor:pointer; transition:background .2s, color .2s, border-color .2s; }
    .op-show-all:hover { background:var(--accent); border-color:var(--accent); color:#fff; }
    .op-gal img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease; }
    .op-gal button:hover img { transform:scale(1.04); }
    .op-gal .op-cap { position:absolute; left:0; right:0; bottom:0; padding:26px 16px 14px; background:linear-gradient(transparent,rgba(44,26,14,.78)); color:#fff; font-size:.82rem; font-weight:600; letter-spacing:.04em; text-align:left; pointer-events:none; }

    .op-sits { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:20px; }
    .op-sit { display:flex; flex-direction:column; gap:10px; background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; padding:26px 26px 24px; text-decoration:none; color:inherit; transition:box-shadow .3s, border-color .3s, transform .2s; }
    .op-sit:hover { box-shadow:0 14px 36px rgba(44,26,14,.08); border-color:rgba(110,84,56,.45); transform:translateY(-3px); }
    .op-sit h3 { font-family:'Marcellus',serif; font-weight:400; font-size:1.3rem; margin:0; color:var(--ink); }
    .op-sit .when { font-size:.88rem; color:var(--soft); margin:0; }
    .op-sit .len { align-self:flex-start; font-size:.72rem; font-weight:600; letter-spacing:.06em; color:#5c3d20; background:#e9e0d2; padding:5px 12px; border-radius:50px; }
    .op-sit .go { margin-top:6px; font-size:.74rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); }

    .op-form { display:flex; flex-direction:column; gap:18px; background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; padding:36px; }
    .op-form .row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
    .op-form label { min-width:0; display:flex; flex-direction:column; gap:8px; font-size:.74rem; font-weight:600; letter-spacing:.12em; color:#5c3d20; text-transform:uppercase; }
    .op-form input, .op-form textarea { width:100%; min-width:0; padding:12px 15px; border:1.5px solid rgba(110,84,56,.3); border-radius:10px; background:#faf6ee; color:#2c1a0e; font-family:'Montserrat',sans-serif; font-size:.95rem; outline:none; text-transform:none; letter-spacing:0; font-weight:400; transition:border-color .2s, box-shadow .2s; }
    .op-form input:focus, .op-form textarea:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(110,84,56,.15); }
    .op-form textarea { resize:vertical; min-height:110px; line-height:1.7; }
    .op-status { font-size:.86rem; text-align:center; min-height:1.2em; margin:0; font-weight:600; }
    .op-wa { display:inline-flex; align-items:center; gap:10px; padding:14px 28px; background:#25D366; color:#fff; border-radius:50px; font-size:.78rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; text-decoration:none; box-shadow:0 6px 20px rgba(37,211,102,.25); }
    .op-wa:hover { background:#1ebe5d; color:#fff; }

    .op-lb { position:fixed; inset:0; z-index:9998; background:rgba(44,26,14,.9); backdrop-filter:blur(10px); display:flex; align-items:center; justify-content:center; padding:48px; opacity:0; pointer-events:none; transition:opacity .25s ease; }
    .op-lb img { max-width:min(960px,100%); max-height:80vh; object-fit:contain; border-radius:16px; }
    .op-lb button { position:absolute; top:28px; right:32px; width:44px; height:44px; border-radius:50%; border:1px solid rgba(196,171,138,.45); background:rgba(250,246,238,.12); color:#fff; cursor:pointer; font-size:1.2rem; }

    footer.op-foot { background:var(--ink); color:rgba(255,255,255,.7); padding:0 48px 32px; border-top:3px solid var(--accent); }
    footer.op-foot .cols { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:minmax(0,1.6fr) minmax(0,1fr); gap:56px; padding:64px 0 44px; }
    footer.op-foot .brand { display:inline-flex; align-items:center; gap:14px; text-decoration:none; line-height:1; font-weight:500; font-size:1.7rem; letter-spacing:.28em; }
    footer.op-foot .brand img { height:46px; width:46px; }
    footer.op-foot .brand span { display:flex; flex-direction:column; gap:5px; padding-left:14px; border-left:1px solid rgba(255,255,255,.28); color:#fff; }
    footer.op-foot .brand small { font-family:'Lato',sans-serif; font-weight:700; font-size:.5rem; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.75); }
    footer.op-foot h4 { color:#fff; font-size:.76rem; font-weight:600; letter-spacing:.18em; text-transform:uppercase; margin:0 0 20px; padding-bottom:14px; border-bottom:1px solid rgba(196,171,138,.28); }
    footer.op-foot ul { list-style:none; padding:0; margin:0; }
    footer.op-foot li { margin-bottom:12px; }
    footer.op-foot a { color:rgba(255,255,255,.62); text-decoration:none; font-size:.92rem; }
    footer.op-foot a:hover { color:#fff; }
    footer.op-foot .bar { max-width:1100px; margin:0 auto; border-top:1px solid rgba(255,255,255,.1); padding-top:28px; display:flex; justify-content:space-between; align-items:center; gap:24px; flex-wrap:wrap; }
    footer.op-foot .bar > span:first-child { display:flex; align-items:center; gap:16px; font-size:.78rem; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:rgba(255,255,255,.45); }
    footer.op-foot .bar i { width:4px; height:4px; border-radius:50%; background:rgba(196,171,138,.5); display:block; }
    footer.op-foot .love { font-size:.82rem; color:rgba(255,255,255,.55); font-style:italic; }

    @media (max-width:1000px) {
      .op-top { padding:14px 24px; }
      .op-nav a.op-link { display:none; }
      .op-sec { padding:72px 24px; }
      .op-split { grid-template-columns:minmax(0,1fr); gap:36px; }
      .op-mine { padding:12px 24px; }
    }
    @media (max-width:640px) {
      .op-top { padding:10px 16px; gap:12px; }
      .op-logo img { height:36px; width:36px; }
      .op-logo { gap:10px; font-size:1.1rem; letter-spacing:.24em; }
      .op-logo > span { padding-left:10px; gap:4px; }
      .op-logo small { font-size:.44rem; letter-spacing:.16em; white-space:nowrap; }
      .op-btn { padding:11px 18px; font-size:.7rem; }
      .op-hero { padding:104px 20px 56px; min-height:64vh; }
      .op-hero h1 { font-size:2.4rem; }
      .op-sec { padding:56px 16px; }
      .op-h2 { font-size:1.8rem; }
      .op-gal { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
      .op-form { padding:22px 18px; }
      .op-form .row { grid-template-columns:minmax(0,1fr); }
      .op-card { padding:22px 18px; }
      footer.op-foot { padding:0 20px 28px; }
      footer.op-foot .cols { grid-template-columns:minmax(0,1fr); gap:32px; padding:44px 0 32px; }
      .op-hero .word { font-size:2.7rem; letter-spacing:.16em; margin-bottom:14px; }
      .op-scroll { display:none; }
      .op-hero { min-height:70vh; }
      .op-gal { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
      .op-gal .op-cap { font-size:.72rem; padding:20px 10px 10px; }
    }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <header class="op-top">
    <a href="/" class="op-logo">
      <img src="/images/logo-mark.png" alt="" />
      <span><b>MYAH</b><small>Make Yourself At Home</small></span>
    </a>
    <nav class="op-nav">
      {sections.map((s) => <a href={'#' + s.id} class="op-link">{s.label}</a>)}
      <a href="#contact" class="op-btn">Get in touch</a>
    </nav>
  </header>

  <section class="op-hero">
    <div class="bg">
      {hero.map((img, i) => (
        <img data-hero-slide="1" src={img.src} alt="" style={`object-position:${img.pos};opacity:${i === 0 ? 1 : 0}`} />
      ))}
    </div>
    <div class="shade"></div>
    <div class="inner">
      <p class="op-pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path></svg>
        Home owner{location ? ' · ' + location : ''}
      </p>
      <h1 class="word">MYAH<br /><em>Home</em></h1>
      <p class="who">{name}</p>
      {tagline && <p class="tag">{tagline}</p>}
      <a href="#contact" class="op-btn" style="padding:16px 36px;font-size:.82rem">Get in touch</a>
      <div class="meta">
        {[pets.length > 0 && `${pets.length} ${pets.length === 1 ? 'pet' : 'pets'}`, sitCards.length > 0 && `${sitCards.length} open ${sitCards.length === 1 ? 'sit' : 'sits'}`, location].filter(Boolean).map((t, i) => <>{i > 0 && <i></i>}<span>{t}</span></>)}
      </div>
    </div>
    <a href={sections[0] ? '#' + sections[0].id : '#contact'} aria-label="Scroll down" class="op-scroll"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></a>
  </section>

  {(bio.length > 0 || about.length > 0) && (
    <section id="about" class="op-sec">
      <div class={'op-wrap' + (about.length ? ' op-split' : '')}>
        {about.length > 0 && (
          <div class="op-about-pic">
            {about.map((a, i) => <img data-about-slide="1" src={a.src} alt={a.alt} style={`opacity:${i === 0 ? 1 : 0}`} />)}
            {about.length > 1 && <>
              <button type="button" class="op-arrow" style="left:14px" data-about-prev aria-label="Previous photo">&#8249;</button>
              <button type="button" class="op-arrow" style="right:14px" data-about-next aria-label="Next photo">&#8250;</button>
              <div class="op-dots">{about.map((_, i) => <button type="button" class={i === 0 ? 'on' : undefined} data-about-dot={i} aria-label={`Photo ${i + 1}`}></button>)}</div>
            </>}
          </div>
        )}
        <div>
          <p class="op-label">{head.aboutLabel}</p>
          <h2 class="op-h2">{split(head.aboutTitle)[0]}{split(head.aboutTitle)[1] && <>{' — '}<em>{split(head.aboutTitle)[1]}</em></>}</h2>
          <div class="op-rule"></div>
          {bio.length
            ? bio.map((b) => <p class="op-p">{b}</p>)
            : <p class="op-p">{first} hasn't written about their home yet — get in touch to ask.</p>}
        </div>
      </div>
    </section>
  )}

  {pets.length > 0 && (
    <section id="pets" class="op-sec">
      <div class="op-wrap">
        <p class="op-label">{head.petsLabel}</p>
        <h2 class="op-h2">{split(head.petsTitle)[0]}{split(head.petsTitle)[1] && <>{' '}<em>{split(head.petsTitle)[1]}</em></>}</h2>
        <div class="op-rule"></div>
        <div class="op-pets">
          {pets.map((x: any) => (
            <article class="op-pet">
              <div class="pic">
                {x.photo_url ? <img src={local(x.photo_url)} alt={esc(x.name)} /> : <span>{initials(esc(x.name))}</span>}
              </div>
              <div class="body">
                <h3>{esc(x.name)}</h3>
                {petLine(x) && <p class="line">{petLine(x)}</p>}
                {esc(x.temperament) && <p class="temp">{esc(x.temperament)}</p>}
                {esc(x.special_needs) && <p class="needs">⚠ {esc(x.special_needs)}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {(amenities.length > 0 || lookingFor.length > 0) && (
    <section id="home" class="op-sec">
      <div class={'op-wrap' + (amenities.length && lookingFor.length ? ' op-split' : '')} style="align-items:start">
        {amenities.length > 0 && (
          <div>
            <p class="op-label">The home</p>
            <h2 class="op-h2">Home <em>amenities</em></h2>
            <div class="op-rule"></div>
            <div class="op-chips">{amenities.map((a) => <span class="op-chip">{a}</span>)}</div>
          </div>
        )}
        {lookingFor.length > 0 && (
          <div>
            <p class="op-label">The right sitter</p>
            <h2 class="op-h2">What we're <em>looking for</em></h2>
            <div class="op-rule"></div>
            <div class="op-card">{lookingFor.map((l) => <p class="op-p">{l}</p>)}</div>
          </div>
        )}
      </div>
    </section>
  )}

  {gallery.length > 0 && (
    <section id="photos" class="op-sec">
      <div class="op-wrap">
        <p class="op-label">{head.galleryLabel}</p>
        <h2 class="op-h2">{split(head.galleryTitle)[0]}{split(head.galleryTitle)[1] && <>{' '}<em>{split(head.galleryTitle)[1]}</em></>}</h2>
        <div class="op-rule"></div>
        <div class="op-gal" data-gal>
          {gallery.map((g, gi) => (
            <button type="button" class={gi >= GAL_FIRST ? 'op-more' : undefined} data-lightbox={g.src} aria-label={g.cap || g.alt || 'Open photo'}><img src={g.src} alt={g.alt} loading="lazy" />{g.cap && <span class="op-cap">{g.cap}</span>}</button>
          ))}
        </div>
        {gallery.length > GAL_FIRST && <button type="button" class="op-show-all" data-show-all>Show all {gallery.length} photos</button>}
      </div>
    </section>
  )}

  {sitCards.length > 0 && (
    <section id="sits" class="op-sec">
      <div class="op-wrap">
        <p class="op-label">Open sits</p>
        <h2 class="op-h2">Dates {first} needs <em>covered</em></h2>
        <div class="op-rule"></div>
        <div class="op-sits">
          {sitCards.map((s) => (
            <a href={'/listings/' + s.id} class="op-sit">
              <h3>{s.title}</h3>
              <p class="when">{s.dates}</p>
              <span class="len">{s.length}</span>
              <span class="go">View the sit &amp; apply →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="contact" class="op-sec">
    <div class="op-wrap op-split" style="align-items:start">
      <div>
        <p class="op-label">{head.enquiryLabel}</p>
        <h2 class="op-h2">{split(head.enquiryTitle)[0]}{split(head.enquiryTitle)[1] && <>{' '}<em>{split(head.enquiryTitle)[1]}</em></>}</h2>
        <div class="op-rule"></div>
        <p class="op-p">Tell {first} a little about yourself, your experience with pets and the dates you're free.</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:22px">
          {canMessage && <button type="button" class="op-btn" data-chat={p.id}>Message {first} on MYAH</button>}
          {waNum && <a href={'https://wa.me/' + waNum} target="_blank" rel="noopener" class="op-wa">WhatsApp</a>}
          {!viewer && <a href={'/signup'} class="op-ghost">Join MYAH as a sitter</a>}
        </div>
      </div>
      {isMe ? (
        <div class="op-card">
          <p class="op-p" style="margin:0 0 14px"><strong>This is where sitters contact you.</strong> They can send an enquiry by email, message you on MYAH, or apply to one of your open sits.</p>
          <div style="display:flex;flex-wrap:wrap;gap:10px">
            <a href="/applications" class="op-btn">See applications</a>
            <a href="/messages" class="op-ghost">Messages</a>
          </div>
        </div>
      ) : (
      <form class="op-form" data-enquiry="1">
        <div class="row">
          <label>First name<input type="text" name="first_name" placeholder="Jane" required /></label>
          <label>Last name<input type="text" name="last_name" placeholder="Smith" /></label>
        </div>
        <label>Email<input type="email" name="email" placeholder="jane@example.com" required /></label>
        <div class="row">
          <label>Free from<input type="date" name="date_from" /></label>
          <label>Until<input type="date" name="date_to" /></label>
        </div>
        <label>Tell {first} about your experience<textarea name="message" rows="4" placeholder="Pets you've cared for, reviews, why you'd be a great fit…"></textarea></label>
        <button type="submit" class="op-btn" style="width:100%">Send enquiry</button>
        <p class="op-status" data-enquiry-status="1"></p>
      </form>
      )}
    </div>
  </section>

  <div class="op-lb" data-lb="1"><button type="button" data-lb-close="1" aria-label="Close">✕</button><img data-lb-img="1" alt="" /></div>

  <footer class="op-foot">
    <div class="cols">
      <div style="display:flex;flex-direction:column;gap:18px;align-items:flex-start">
        <a href="/" class="brand"><img src="/images/logo-mark-white.png" alt="" /><span>MYAH<small>Make Yourself At Home</small></span></a>
        <p style="line-height:1.8;font-size:.95rem;margin:0;max-width:340px">{description}</p>
      </div>
      <div>
        <h4>Quick links</h4>
        <ul>
          {sections.map((x) => <li><a href={'#' + x.id}>{x.label}</a></li>)}
          <li><a href="#contact">Get in touch</a></li>
        </ul>
      </div>
    </div>
    <div class="bar">
      <span><span>&copy; 2026 MYAH</span><i></i><span>{name}</span></span>
      <span class="love">Made with <span style="font-style:normal">&#9825;</span> for pet lovers everywhere</span>
    </div>
  </footer>

  {isMe && (
    <div class="op-mine" data-mine="1">
      <span>This is your public page — what sitters see.</span>
      <span style="display:flex;gap:18px"><a href="/owner/profile/edit">Edit your home</a><a href="/owner/dashboard">Dashboard</a></span>
    </div>
  )}

<script is:inline define:vars={{ slug }}>
(() => {
  const q = (s) => document.querySelector(s);
  const qa = (s) => Array.from(document.querySelectorAll(s));
  const loader = q('[data-loader]');
  const show = () => { if (loader) { loader.style.opacity = '1'; loader.style.pointerEvents = 'all'; } };

  // Hero and about slideshows
  const cycle = (sel, ms) => {
    const imgs = qa(sel);
    if (imgs.length < 2) return;
    let i = 0;
    setInterval(() => { imgs[i].style.opacity = '0'; i = (i + 1) % imgs.length; imgs[i].style.opacity = '1'; }, ms);
  };
  cycle('[data-hero-slide]', 5000);
  // About photos: arrows, dots and a gentle auto-advance (as on sitter pages)
  const as = qa('[data-about-slide]'), ad = qa('[data-about-dot]');
  let ai = 0, at;
  const showA = (n) => { if (!as.length) return; as[ai].style.opacity = '0'; ai = (n + as.length) % as.length; as[ai].style.opacity = '1'; ad.forEach((d, k) => d.classList.toggle('on', k === ai)); };
  const runA = () => { clearInterval(at); if (as.length > 1) at = setInterval(() => showA(ai + 1), 4500); };
  q('[data-about-prev]') && q('[data-about-prev]').addEventListener('click', () => { showA(ai - 1); runA(); });
  q('[data-about-next]') && q('[data-about-next]').addEventListener('click', () => { showA(ai + 1); runA(); });
  ad.forEach((d) => d.addEventListener('click', () => { showA(+d.getAttribute('data-about-dot')); runA(); }));
  runA();

  // Gallery: "Show all"
  const all = q('[data-show-all]');
  all && all.addEventListener('click', () => { const g = q('[data-gal]'); const open = g.classList.toggle('all'); all.textContent = open ? 'Show fewer' : 'Show all ' + qa('[data-gal] button').length + ' photos'; });

  // Smooth scroll past the fixed header
  qa('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
    const target = q(a.getAttribute('href'));
    if (!target) return;
    e.preventDefault();
    const off = (q('.op-top') ? q('.op-top').offsetHeight : 0) + 16;
    window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - off, behavior: 'smooth' });
  }));

  // Lightbox
  const lb = q('[data-lb]'), lbImg = q('[data-lb-img]');
  const close = () => { lb.style.opacity = '0'; lb.style.pointerEvents = 'none'; };
  document.addEventListener('click', (e) => {
    const b = e.target.closest && e.target.closest('[data-lightbox]');
    if (b) { lbImg.src = b.getAttribute('data-lightbox'); lb.style.opacity = '1'; lb.style.pointerEvents = 'all'; }
  });
  q('[data-lb-close]').addEventListener('click', close);
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  // Signed-in sitters: open a conversation with this owner
  const chat = q('[data-chat]');
  chat && chat.addEventListener('click', async () => {
    const label = chat.textContent;
    chat.disabled = true; chat.textContent = 'Opening chat…';
    try {
      const res = await fetch('/api/messages/start', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipient_profile_id: chat.getAttribute('data-chat') })
      });
      const data = await res.json();
      if (!data.conversation_id) throw new Error();
      show();
      window.location.href = '/messages/' + data.conversation_id;
    } catch {
      chat.textContent = 'Something went wrong';
      setTimeout(() => { chat.textContent = label; chat.disabled = false; }, 2000);
    }
  });

  // Enquiry form: emailed to the owner
  const form = q('[data-enquiry]'), status = q('[data-enquiry-status]');
  form && form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]');
    btn.disabled = true; status.textContent = ''; status.style.color = '#2f7d4f';
    const fd = new FormData(form); fd.append('slug', slug);
    try {
      const res = await fetch('/api/enquiry', { method: 'POST', body: fd });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Could not send right now.');
      status.textContent = 'Enquiry sent — you’ll hear back soon.';
      form.reset();
    } catch (err) {
      status.style.color = '#a4442e';
      status.textContent = err.message || 'Could not send right now.';
    }
    btn.disabled = false;
  });

  // Loader on page navigation
  qa('a[href^="/"]').forEach((a) => a.addEventListener('click', (e) => { if (!e.metaKey && !e.ctrlKey && !e.shiftKey) show(); }));
  window.addEventListener('pageshow', (e) => { if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; } });
})();
</script>
<nav data-page-dock data-items="about:About,pets:Pets,photos:Photos,sits:Sits,contact:Get in touch*"></nav>
<style is:global>
  @media (max-width: 640px) { section.op-sec { padding-top: 48px; padding-bottom: 48px; } }
</style>
<script is:inline src="/page-dock.js"></script>
</body>
</html>
)}
