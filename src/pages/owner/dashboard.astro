---
export const prerender =
  false;
import IdGate from
  '../_idgate.astro';
import YourSits from
  './_yoursits.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../../lib/account';
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';
import {
  arr,
  tx,
  clip,
  dateRange,
  durationLabel,
  strength,
  ownerSits,
} from
  '../../lib/dashboard';
import
  '../../styles/dash.css';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'owner',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

let profile: any = null;
try {
  const pr =
    await supabase
    .from('profiles')
    .select('*')
    .eq(
      'user_id',
      session.userId,
    )
    .single();
  profile = pr.data;
} catch {}
if (!profile) {
  return Astro.redirect(
    '/owner/profile/create',
  );
}

let listings: any[] = [];
try {
  const lr =
    await supabase
    .from('listings')
    .select('*')
    .eq(
      'profile_id',
      profile.id,
    )
    .order(
      'date_from',
      {
        ascending: false,
      },
    );
  listings =
    lr.data ?? [];
} catch {}

const pets = arr(
  profile.pets_json,
);
const heroImages =
  arr(
    profile.hero_images_json,
  );
const amenities: string[] =
  arr(
    profile.amenities_json,
  );
const active = listings
  .filter(
    (l: any) =>
      l.status ===
      'active',
  );
const past = listings
  .filter(
    (l: any) =>
      l.status !==
      'active',
  );

// Design copy — used
// when a field is empty.
const bioDef = tx(`
Stone cottage on the edge of the village, home to two cocker spaniels.
`);
const amenDef = tx(`
Wi-Fi, Walled garden, Log fire, Washing machine +3 more
`);

const name: string =
  profile.name || '';
const firstName =
  name.split(' ')[0] ||
  name;
const slug: string =
  profile.slug || '';
const pageUrl =
  'myahsits.com/' +
  slug;
const shareUrl =
  'https://' + pageUrl;
const publicHref =
  '/' + slug;
const pic: string =
  profile.profile_pic ||
  '/images/' +
  'solomon-1.jpg';
const location: string =
  profile.location ||
  '';
const bio: string =
  profile.bio
    ? clip(
        profile.bio,
        120,
      )
    : bioDef;
const nPhotos =
  heroImages.length;
const photosText =
  nPhotos +
  (nPhotos === 1
    ? ' main photo'
    : ' main photos') +
  ' uploaded';
const petsText =
  pets.length
    ? pets
      .map(
        (p: any) => p.name,
      )
      .join(', ')
    : 'No pets added yet';
const amenText =
  amenities.length
    ? amenities
      .slice(0, 4)
      .join(', ') +
      (amenities.length > 4
        ? ' +' +
          (amenities.length -
            4) +
          ' more'
        : '')
    : amenDef;

const items = [
  {
    label:
      'Home photos added',
    done: nPhotos > 0,
  },
  {
    label: 'Pets added',
    done: pets.length > 0,
  },
  {
    label: tx(`
Amenities selected
`),
    done:
      amenities.length >
      0,
  },
  {
    label: tx(`
About your home written
`),
    done: !!profile.bio,
  },
  {
    label: tx(`
Ideal sitter described
`),
    done:
      !!profile
      .looking_for,
  },
  {
    label:
      'Second sit posted',
    done:
      listings.length >= 2,
  },
];
const st =
  strength(items);
const strengthLabel =
  st.label;
const strengthBar =
  'height:100%;width:' +
  st.pct +
  '%;border-radius:' +
  '50px;background:' +
  'linear-gradient(' +
  '90deg,#2f5d45 0%,' +
  '#3e7a5b 100%);' +
  'transition:width ' +
  '.4s ease';
const markOn =
  'background:#2f5d45;' +
  'color:#fff;';
const markOff =
  'background:' +
  'transparent;' +
  'border:1.5px dashed' +
  ' rgba(110,84,56,.55);' +
  'color:#2f5d45;';
const markBase =
  'width:20px;' +
  'height:20px;' +
  'border-radius:50%;' +
  'flex-shrink:0;' +
  'display:flex;' +
  'align-items:center;' +
  'justify-content:' +
  'center;' +
  'font-size:.64rem;' +
  'font-weight:700;' +
  'line-height:1;';
const checklist = items
  .map((i) => ({
    label: i.label,
    mark:
      i.done ? '✓' : '',
    markStyle:
      markBase +
      (i.done
        ? markOn
        : markOff),
  }));

// Sit cards
const cardBase =
  'background:#fff;' +
  'border:1px solid ' +
  'rgba(110,84,56,.22);' +
  'border-radius:18px;' +
  'padding:26px;' +
  'box-shadow:0 1px 2px' +
  ' rgba(44,26,14,.04);' +
  'display:flex;' +
  'flex-direction:' +
  'column;gap:11px;';
const toneActive =
  'background:' +
  'rgba(47,125,79,.1);' +
  'color:#2f7d4f;' +
  'border:1px solid ' +
  'rgba(47,125,79,.3);';
const toneFilled =
  'background:' +
  'rgba(110,84,56,.12);' +
  'color:#2f5d45;' +
  'border:1px solid ' +
  'rgba(110,84,56,.38);';
const toneOther =
  'background:#fdeeee;' +
  'color:#b91c1c;' +
  'border:1px solid ' +
  '#f7cfcf;';
const statusBase =
  'display:inline-block;' +
  'font-size:.68rem;' +
  'font-weight:600;' +
  'text-transform:' +
  'uppercase;' +
  'letter-spacing:.12em;' +
  'padding:5px 13px;' +
  'border-radius:50px;' +
  'width:fit-content;';
const statusText = (
  s: string,
) => (
  s
    ? s.charAt(0)
      .toUpperCase() +
      s.slice(1)
    : ''
);
// Applicants per sit, so
// each card says who has
// applied.
const appsBy: Record<
  string,
  { all: number; fresh: number }
> = {};
try {
  const ids = listings
    .map((l: any) => l.id);
  if (ids.length) {
    const ar =
      await supabase
      .from('applications')
      .select(
        'listing_id, status',
      )
      .in('listing_id', ids);
    for (const a of
      ar.data ?? []) {
      const k =
        (a as any).listing_id;
      const st =
        (a as any).status;
      appsBy[k] ??= {
        all: 0,
        fresh: 0,
      };
      if (st !== 'declined')
        appsBy[k].all++;
      if (st === 'new')
        appsBy[k].fresh++;
    }
  }
} catch {}
const toCard = (
  l: any,
  isPast: boolean,
) => {
  const ap =
    appsBy[l.id] ??
    { all: 0, fresh: 0 };
  const status =
    statusText(l.status);
  const tone =
    status === 'Active'
      ? toneActive
      : status ===
        'Filled'
        ? toneFilled
        : toneOther;
  return {
    status,
    title: l.title,
    dates: dateRange(
      l.date_from,
      l.date_to,
    ),
    duration:
      durationLabel(
        l.date_from,
        l.date_to,
      ),
    desc: clip(
      l.description,
      120,
    ),
    viewHref:
      '/listings/' +
      l.id,
    editHref:
      '/owner/listings/' +
      l.id +
      '/edit',
    appsHref:
      '/applications' +
      '?listing=' + l.id,
    appsLabel:
      ap.all === 0
        ? 'No applications yet'
        : ap.all +
          (ap.all === 1
            ? ' applicant'
            : ' applicants') +
          (ap.fresh
            ? ' · ' + ap.fresh +
              ' new'
            : ''),
    appsOn: ap.all > 0,
    cardStyle:
      cardBase +
      (isPast
        ? 'opacity:.7;'
        : ''),
    statusStyle:
      statusBase + tone,
  };
};
// Confirmed sits: the
// next one for the strip
// and all of them for
// the Sits tab.
const mySits =
  await ownerSits(
  supabase,
  profile,
);
const nextSit =
  mySits.find(
    (c) => !c.past,
  ) || null;
const nextLine = nextSit
  ? [
    nextSit.dates,
    nextSit.who,
  ]
    .filter(Boolean)
    .join(' · ')
  : '';
const sitCardStyle =
  'display:flex;' +
  'flex-direction:' +
  'column;' +
  'background:#fff;' +
  'border:1px solid ' +
  'rgba(110,84,56,.22);' +
  'border-radius:18px;' +
  'overflow:hidden;' +
  'text-decoration:none;' +
  'color:inherit;' +
  'transition:transform' +
  ' .3s ease, ' +
  'box-shadow .3s ease,' +
  ' border-color .3s' +
  ' ease;';

// Open sits for the
// main tab (may be none).
const activeCards =
  active.map(
    (l: any) =>
      toCard(l, false),
  );
const groups = [
  {
    label: 'Active',
    items: active.map(
      (l: any) =>
        toCard(l, false),
    ),
  },
  {
    label: 'Past / closed',
    items: past.map(
      (l: any) =>
        toCard(l, true),
    ),
  },
].filter(
  (g) => g.items.length,
);

const icons = {
  dashboard: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect>',
  sits: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>',
  messages: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>',
  profile: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>'
};
const tabs = [
  {
    id: 'dashboard',
    label: 'Dashboard',
  },
  {
    id: 'sits',
    label: 'My sits',
  },
  {
    id: 'messages',
    label: 'Messages',
  },
  {
    id: 'profile',
    label: 'Profile',
  },
].map((t, i) => ({
  ...t,
  icon: (icons as any)[
    t.id
  ],
  style:
    'flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;padding:13px 4px 12px;border:none;background:none;cursor:pointer;position:relative;font-family:\'Montserrat\',sans-serif;color:' +
    (i === 0
      ? '#2f5d45'
      : '#8a6a4f') +
    ';transition:color' +
    ' .2s',
  underlineStyle:
    'position:absolute;bottom:0;left:22%;right:22%;height:3px;border-radius:3px 3px 0 0;background:' +
    (i === 0
      ? '#2f5d45'
      : 'transparent'),
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Dashboard — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 900px) {
      [data-topnav] { padding: 12px 24px !important; }
      [data-dash-pad] { padding: 28px 24px 60px !important; }
      [data-dash-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-stats] { flex-direction: row !important; }
      [data-overview] { grid-template-columns: minmax(0,1fr) !important; }
    }

    .db-nav-link:hover { color:#2f5d45 !important; }
    .db-pill:hover { background:#2f5d45 !important; color:#fff !important; border-color:#2f5d45 !important; }
    .db-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .db-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; color:#fff !important; }
    .db-btn:active { transform:translateY(0) scale(.98) !important; }
    .db-text-link:hover { color:#2c1a0e !important; }
    .db-next:hover { transform:translateY(-3px) !important; box-shadow:0 16px 40px rgba(44,26,14,.22) !important; }
    .db-sit:hover { transform:translateY(-6px) !important; box-shadow:0 20px 50px rgba(44,26,14,.12) !important; border-color:rgba(110,84,56,.45) !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <nav data-topnav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.18)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:#2f5d45;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
    </a>
    <button type="button" data-acct-toggle="1" aria-label="Menu" aria-expanded="false" onclick="var n=this.closest('[data-topnav]');var o=n.classList.toggle('acct-open');this.setAttribute('aria-expanded',o)"><span></span><span></span><span></span></button>
    <div data-acct-links="1" style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;justify-content:flex-end">
      <a href="/find-a-sitter" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Find a sitter</a>
      <a href="/applications" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Applications</a>
      <a href="/notifications" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Notifications</a>
      <a href="/api/auth/logout" class="db-nav-link" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;white-space:nowrap;transition:color .2s">Log out</a>
    </div>
  </nav>

  <div style="display:flex;background:#fff;border-bottom:1px solid rgba(44,26,14,.08);box-shadow:0 1px 4px rgba(0,0,0,.04);position:sticky;top:0;z-index:10">
    {tabs.map((t) => (
      <button type="button" data-tab={t.id} style={t.style}>
        <span style="display:flex;position:relative">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon}></svg>
          {t.id === 'messages' && (
            <span data-msg-badge="1" style="position:absolute;top:-5px;right:-10px;background:#a4442e;color:#fff;font-size:.55rem;font-weight:700;min-width:16px;height:16px;border-radius:8px;padding:0 4px;display:none;align-items:center;justify-content:center;line-height:1">0</span>
          )}
        </span>
        <span style="font-size:.7rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">{t.label}</span>
        <span data-tab-line="1" style={t.underlineStyle}></span>
      </button>
    ))}
  </div>

  <div data-msg-toasts="1" style="position:fixed;top:20px;right:20px;z-index:1000;display:flex;flex-direction:column;gap:10px;pointer-events:none"></div>

  <main data-dash-pad="1" style="flex:1;padding:44px 48px 70px">
    <div style="max-width:1100px;margin:0 auto">
      <IdGate profile={acct!.profile} what="post sits and message sitters" />

      <div data-panel="dashboard" style="display:flex;flex-direction:column;gap:24px">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:26px">
          <div>
            <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Your dashboard</p>
            <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;line-height:1.15;margin:0">Welcome back, <em style="color:#2f5d45;">{firstName}</em></h1>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
            <a href="/owner/profile/edit#photos" class="db-pill" style="display:inline-flex;align-items:center;gap:8px;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;background:#fff;border:1.5px solid rgba(110,84,56,.35);border-radius:50px;padding:11px 20px;transition:background .2s, color .2s, border-color .2s">Add photos</a>
            <a href="/owner/profile/edit#pets" class="db-pill" style="display:inline-flex;align-items:center;gap:8px;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;background:#fff;border:1.5px solid rgba(110,84,56,.35);border-radius:50px;padding:11px 20px;transition:background .2s, color .2s, border-color .2s">Add a pet</a>
            <a href="/owner/listings/new" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
              Post a sit
            </a>
          </div>
        </div>

        {nextSit && (
          <a href={nextSit.href} class="db-next" style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;background:#2c1a0e;border-radius:18px;padding:24px 28px;text-decoration:none;color:#fff;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:transform .3s ease, box-shadow .3s ease">
            {nextSit.pic ? (
              <img src={nextSit.pic} alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(196,171,138,.5)" />
            ) : (
              <span style="width:56px;height:56px;border-radius:50%;flex-shrink:0;background:rgba(196,171,138,.18);color:#c4ab8a;font-family:'Marcellus',serif;font-size:1.3rem;display:flex;align-items:center;justify-content:center">{nextSit.who.charAt(0)}</span>
            )}
            <div style="flex:1;min-width:220px">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#c4ab8a;margin:0 0 8px">{nextSit.when}</p>
              <p style="font-family:'Marcellus',serif;font-size:1.3rem;color:#fff;margin:0 0 4px;line-height:1.25">{nextSit.title}</p>
              <p style="font-size:.86rem;color:rgba(255,255,255,.7);margin:0">{nextLine}</p>
            </div>
            <span style="display:inline-flex;align-items:center;justify-content:center;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 26px;white-space:nowrap">Open sit pack</span>
          </a>
        )}
        <div data-dash-grid="1" style="display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:24px;align-items:start">
          <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="display:flex;gap:24px;align-items:flex-start;margin-bottom:26px">
              <img src={pic} alt={name} style="width:84px;height:84px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.35)" />
              <div style="min-width:0">
                <h2 style="font-family:'Marcellus',serif;font-size:1.5rem;color:#2c1a0e;margin:0 0 5px">{name}</h2>
                {location && (
                  <p style="font-size:.85rem;color:#2f5d45;font-weight:600;letter-spacing:.04em;margin:0 0 7px;display:flex;align-items:center;gap:8px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>{location}</p>
                )}
                <p style="font-size:.92rem;color:#6b4e35;line-height:1.6;margin:0 0 12px">{bio}</p>
                <a href={publicHref} style="display:inline-flex;align-items:center;gap:8px;font-size:.8rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.03em;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px">{pageUrl}</a>
              </div>
            </div>
            <div style="border-top:1px solid rgba(44,26,14,.08);padding-top:24px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
              <a href="/owner/profile/edit" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Edit profile</a>
              <a href={publicHref} class="db-text-link" style="font-size:.78rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px;transition:color .2s">View public page</a>
            </div>
          </div>

          <div data-stats="1" style="display:flex;flex-direction:column;gap:16px">
            <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;text-align:center;flex:1;display:flex;flex-direction:column;gap:7px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <span style="font-family:'Marcellus',serif;font-size:2.1rem;color:#6e5438;line-height:1">{pets.length}</span>
              <span style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35">Pets</span>
            </div>
            <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;text-align:center;flex:1;display:flex;flex-direction:column;gap:7px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <span style="font-family:'Marcellus',serif;font-size:2.1rem;color:#6e5438;line-height:1">{active.length}</span>
              <span style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35">Active sits</span>
            </div>
          </div>
        </div>

        <YourSits cards={activeCards} />

        <div data-overview="1" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px">
          <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:10px;transition:box-shadow .3s ease, border-color .3s ease">
            <span style="width:44px;height:44px;border-radius:12px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="14" rx="2"></rect><circle cx="12" cy="13" r="3.5"></circle><path d="M8 6l1.5-2h5L16 6"></path></svg></span>
            <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;margin:0;color:#2c1a0e">Home photos</h3>
            <p style="font-size:.88rem;color:#6b4e35;line-height:1.6;margin:0">{photosText}</p>
            <a href="/owner/profile/edit#photos" style="font-size:.76rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;margin-top:auto;padding-top:8px">Manage photos &rarr;</a>
          </div>
          <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:10px;transition:box-shadow .3s ease, border-color .3s ease">
            <span style="width:44px;height:44px;border-radius:12px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="9" r="2.2"></circle><circle cx="16" cy="9" r="2.2"></circle><circle cx="12" cy="15.5" r="3"></circle></svg></span>
            <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;margin:0;color:#2c1a0e">Pets</h3>
            <p style="font-size:.88rem;color:#6b4e35;line-height:1.6;margin:0">{petsText}</p>
            <a href="/owner/profile/edit#pets" style="font-size:.76rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;margin-top:auto;padding-top:8px">Manage pets &rarr;</a>
          </div>
          <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px;box-shadow:0 1px 2px rgba(44,26,14,.04);display:flex;flex-direction:column;gap:10px;transition:box-shadow .3s ease, border-color .3s ease">
            <span style="width:44px;height:44px;border-radius:12px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:flex;align-items:center;justify-content:center;margin-bottom:4px"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
            <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;margin:0;color:#2c1a0e">Amenities</h3>
            <p style="font-size:.88rem;color:#6b4e35;line-height:1.6;margin:0">{amenText}</p>
            <a href="/owner/profile/edit#amenities" style="font-size:.76rem;color:#2f5d45;font-weight:600;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;margin-top:auto;padding-top:8px">Edit amenities &rarr;</a>
          </div>
        </div>

        <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:16px">
            <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Listing strength</h3>
            <span style="font-size:.78rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45">{strengthLabel}</span>
          </div>
          <div style="height:8px;border-radius:50px;background:rgba(110,84,56,.15);overflow:hidden;margin-bottom:22px">
            <div style={strengthBar}></div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px">
            {checklist.map((c) => (
              <div style="display:flex;align-items:center;gap:11px;font-size:.88rem;color:#2c1a0e">
                <span style={c.markStyle}>{c.mark}</span>{c.label}
              </div>
            ))}
          </div>
        </div>

        <div class="db-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
          <h3 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 8px">Share your profile</h3>
          <p style="font-size:.93rem;color:#6b4e35;margin:0 0 20px;line-height:1.7;max-width:560px">Send this link so sitters can see your home, pets, and get in touch.</p>
          <div style="display:flex;gap:12px;flex-wrap:wrap">
            <input data-share="1" type="text" readonly="readonly" value={shareUrl} style="flex:1;min-width:240px;border:1.5px solid rgba(44,26,14,.15);border-radius:10px;padding:13px 16px;font-size:.92rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none" />
            <button type="button" data-copy="1" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:13px 28px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Copy</button>
          </div>
        </div>
      </div>

      <div data-panel="sits" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:26px;margin-bottom:34px">
          <div>
            <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Your listings</p>
            <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;margin:0 0 10px;line-height:1.2">My <em style="color:#2f5d45;">sits</em></h1>
            <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;max-width:520px;margin:0">Manage your sit listings. Active sits are visible to sitters browsing the platform.</p>
          </div>
          <a href="/owner/listings/new" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
            Post a sit
          </a>
        </div>

        {mySits.length > 0 && (
          <div style="margin-bottom:38px">
            <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 18px">Confirmed sits</p>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:22px">
              {mySits.map((c) => (
                <a href={c.href} class="db-sit" style={c.past ? sitCardStyle + 'opacity:.7;' : sitCardStyle}>
                  <div style="position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#e9e0d2">
                    {c.img && <img src={c.img} alt="" style="width:100%;height:100%;object-fit:cover;display:block" />}
                    <span style="position:absolute;top:14px;left:14px;background:#2f5d45;color:#fff;font-size:.7rem;font-weight:700;letter-spacing:.06em;padding:7px 15px;border-radius:50px">{c.when}</span>
                  </div>
                  <div style="padding:20px 22px 22px;display:flex;flex-direction:column;gap:8px">
                    <h3 style="font-family:'Marcellus',serif;font-size:1.12rem;color:#2c1a0e;line-height:1.3;margin:0">{c.title}</h3>
                    <div style="display:flex;align-items:center;gap:10px">
                      {c.pic && <img src={c.pic} alt="" style="width:30px;height:30px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.25)" />}
                      <span style="font-size:.84rem;color:#6b4e35">{c.who}</span>
                    </div>
                    <p style="font-size:.83rem;color:#5c3d20;font-weight:700;margin:0">{c.dates} &middot; {c.duration}</p>
                    <span style="font-size:.74rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;margin-top:6px">Open sit pack &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
        {groups.map((group) => (
          <div style="margin-bottom:38px">
            <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 18px">{group.label}</p>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px">
              {group.items.map((l) => (
                <div style={l.cardStyle}>
                  <span style={l.statusStyle}>{l.status}</span>
                  <h3 style="font-family:'Marcellus',serif;font-size:1.18rem;color:#2c1a0e;line-height:1.3;margin:0">{l.title}</h3>
                  <p style="font-size:.86rem;color:#5c3d20;font-weight:600;margin:0">{l.dates}</p>
                  <span style="display:inline-block;background:rgba(110,84,56,.12);color:#2f5d45;font-size:.74rem;font-weight:600;padding:5px 14px;border-radius:50px;width:fit-content;letter-spacing:.04em">{l.duration}</span>
                  <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0">{l.desc}</p>
                  <a href={l.appsHref} data-apps-link="1" style={'display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;border-radius:12px;text-decoration:none;font-size:.84rem;font-weight:600;' + (l.appsOn ? 'background:rgba(47,93,69,.1);color:#2f5d45;border:1px solid rgba(47,93,69,.3)' : 'background:#faf6ee;color:#8a6a4f;border:1px dashed rgba(110,84,56,.3)')}><span>{l.appsLabel}</span><span aria-hidden="true">&rarr;</span></a>
                  <div style="display:flex;gap:10px;margin-top:8px;flex-wrap:wrap">
                    <a href={l.viewHref} class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 22px;border-radius:50px;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;transition:background .2s, border-color .2s, transform .12s">View listing</a>
                    <a href={l.editHref} class="db-pill" style="display:inline-flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;padding:11px 22px;border-radius:50px;color:#5c3d20;background:#fff;border:1.5px solid rgba(110,84,56,.35);transition:background .2s, color .2s, border-color .2s">Edit</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div data-panel="messages" class="db-card" style="display:none;background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
        <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></span>
        <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">No messages yet</h2>
        <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0">When a sitter applies for one of your sits, the conversation will appear here.</p>
      </div>

      <div data-panel="profile" class="db-card" style="display:none;background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:80px 48px;text-align:center;max-width:540px;margin:0 auto;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
        <span style="width:58px;height:58px;border-radius:16px;background:#faf6ee;border:1px solid rgba(110,84,56,.28);color:#6e5438;display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span>
        <h2 style="font-family:'Marcellus',serif;font-size:1.6rem;color:#2c1a0e;margin:0 0 12px">Your home &amp; pets</h2>
        <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 28px">Update your home photos, pet details and amenities. This information is reused across all your sit listings — you only set it up once.</p>
        <a href="/owner/profile/edit" class="db-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Set up home &amp; pets</a>
      </div>

    </div>
  </main>
</div>

<script>
  import { initDashboard } from '../../scripts/dashboard';
  initDashboard();
</script>
</body>
</html>
