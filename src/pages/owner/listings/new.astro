---
export const prerender =
  false;
import IdGate from
  '../../_idgate.astro';
import AppNav from
  '../../_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../../../lib/account';
import {
  getSession,
} from '../../../lib/auth';
import {
  supabase,
} from
  '../../../lib/supabase';
import {
  arr,
} from
  '../../../lib/dashboard';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'owner',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const pr =
  await supabase
  .from('profiles')
  .select(
    'id, name,' +
    ' location,' +
    ' profile_pic,' +
    ' hero_images_json,' +
    ' gallery_json,' +
    ' pets_json,' +
    ' amenities_json',
  )
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const profile: any =
  pr.data;
if (!profile) {
  return Astro.redirect(
    '/owner/profile/create',
  );
}

const heroImages = arr(
  profile.hero_images_json,
);
const gallery = arr(
  profile.gallery_json,
);
const pets = arr(
  profile.pets_json,
);
const amenities = arr(
  profile.amenities_json,
);
const photoCount =
  heroImages.length +
  gallery.length;
const petNames = pets
  .map(
    (p: any) => p.name,
  )
  .filter(Boolean)
  .join(', ');
const nAmen =
  amenities.length;
const plural = (
  n: number,
  one: string,
  many: string,
) => n +
  ' ' +
  (n === 1 ? one : many);

// Cover photo for the preview card (round 3).
const coverPic = String((arr(profile.hero_images_json)[0] as any)?.src || (arr(profile.gallery_json)[0] as any)?.src || '/images/slideshow-living-room.jpeg').replace(/^public\//, '/');
const pic: string =
  profile.profile_pic ||
  '/images/' +
  'avatar-cream.png';
const ownerLine =
  (profile.name || '') +
  (profile.location
    ? ' · ' +
      profile.location
    : '');

const markOn =
  'background:#2f5d45;';
const markOff =
  'background:' +
  'rgba(110,84,56,.25);';
const pulled = [
  {
    ok: photoCount > 0,
    text: photoCount
      ? plural(
          photoCount,
          'home photo',
          'home photos',
        )
      : 'No home photos',
  },
  {
    ok: pets.length > 0,
    text: pets.length
      ? plural(
          pets.length,
          'pet',
          'pets',
        ) +
        ' — ' +
        petNames
      : 'No pets yet',
  },
  {
    ok: nAmen > 0,
    text: nAmen
      ? plural(
          nAmen,
          'amenity',
          'amenities',
        )
      : 'No amenities yet',
  },
].map((r) => ({
  ...r,
  markBg: r.ok
    ? markOn
    : markOff,
  mark: r.ok ? '✓' : '!',
}));
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Post a sit — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 900px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 36px 24px 70px !important; }
      [data-form-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
      [data-card] { padding: 26px !important; }
      [data-date-row] { grid-template-columns: minmax(0,1fr) !important; }
    }

    /* Field focus — same treatment as Log in */
    [data-listing] input:focus, [data-listing] textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }

    .ps-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .ps-logout:hover { color:#2c1a0e !important; }
    .ps-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .ps-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .ps-btn:active { transform:translateY(0) scale(.98) !important; }
    .ps-cancel:hover { color:#2c1a0e !important; }
    .ps-pulled:hover { border-color:rgba(110,84,56,.5) !important; }
    .ps-edit:hover { gap:12px !important; color:#2c1a0e !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <link rel="stylesheet" href="/listing-form.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={'owner'} active="post" />

  <main data-pad="1" style="flex:1;padding:52px 48px 80px">
    <div style="max-width:1100px;margin:0 auto">
      <IdGate profile={acct!.profile} what="post a sit" />

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:32px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>New listing</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">Post a <em style="color:#2f5d45;">sit</em></h1>
        <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:580px;margin:0">Your home details and pets from your profile are shown automatically. Just add the dates and anything specific to this sit.</p>
      </div>

      <div data-form-error="1" role="alert" style="display:none;margin-bottom:24px;padding:14px 18px;border-radius:12px;background:#fdeeee;border:1px solid #f7cfcf;font-size:.86rem;font-weight:600;color:#a4442e"></div>

      <div data-form-grid="1" style="display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:28px;align-items:start">

        <form data-listing="1" class="lf-wiz" method="POST" action="/api/owner/listings" style="display:flex;flex-direction:column;gap:24px">
          <input type="hidden" name="_action" value="create" />
          <div data-card="1" class="ps-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div class="lf-steps"><div><p data-step-n>Step 1 of 3</p><h3 data-step-t>Give your sit a name</h3></div></div>
            <div class="lf-bar"><i data-step-bar></i></div>

            <div data-step="1" style="margin-bottom:26px">
              <label for="title" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Title <span style="color:#2f5d45">*</span></label>
              <input data-title="1" type="text" id="title" name="title" placeholder="e.g. 2 weeks in Sydney with 2 friendly dogs" required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">A short summary sitters will see when browsing.</p>
            </div>

            <div data-step="2" hidden>
            <div data-date-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:26px">
              <div>
                <label for="date_from" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">From <span style="color:#2f5d45">*</span></label>
                <input data-from="1" type="date" id="date_from" name="date_from" required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>
              <div>
                <label for="date_to" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">To <span style="color:#2f5d45">*</span></label>
                <input data-to="1" type="date" id="date_to" name="date_to" required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>
            </div>

            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:-8px 0 26px">
              <span style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin-right:4px">Quick length</span>
              <button type="button" data-preset="7">1 week</button>
              <button type="button" data-preset="14">2 weeks</button>
              <button type="button" data-preset="21">3 weeks</button>
              <button type="button" data-preset="30">1 month</button>
            </div>

            <div data-duration="1" style="display:none">
              <span style="display:flex;align-items:center;gap:10px;font-size:.86rem;font-weight:600;color:#5c3d20;letter-spacing:.02em">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                <span data-duration-text="1"></span>
              </span>
            </div>

            </div>

            <div data-step="3" hidden>
              <label for="description" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Details</label>
              <textarea data-desc="1" id="description" name="description" rows="6" placeholder="Anything specific to this sit — daily routine, special instructions, house rules, what sitters should know." style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s"></textarea>
            </div>

            <div class="lf-nav"><button type="button" class="lf-back" data-step-back disabled>Back</button><button type="button" class="lf-next" data-step-next>Next</button></div>
          </div>

          <div data-submit-row style="display:flex;align-items:center;gap:24px;flex-wrap:wrap">
            <button type="submit" class="ps-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">Post listing</button>
            <a href="/owner/dashboard" class="ps-cancel" style="font-size:.8rem;color:#6b4e35;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;font-weight:600;transition:color .2s">Cancel</a>
          </div>
        </form>

        <aside data-aside="1" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:20px">
          <div class="ps-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="padding:20px 24px;border-bottom:1px solid rgba(110,84,56,.2)">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0">How sitters will see it</p>
            </div>
            <div class="lf-cover"><img src={coverPic} alt="" /><span class="lf-tag">Sit in the home</span><img class="lf-host" src={pic} alt="" /></div>
            <div style="padding:22px 24px 26px;background:#faf6ee;display:flex;flex-direction:column;gap:16px">
              <div style="display:flex;gap:14px;align-items:flex-start">
                <img src={pic} alt="" style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.35)" />
                <div style="flex:1;min-width:0">
                  <p data-pv-title="1" style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;margin:0 0 4px;line-height:1.3">Your listing title appears here</p>
                  <p style="font-size:.8rem;color:#2f5d45;font-weight:600;margin:0">{ownerLine}</p>
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:9px;font-size:.84rem;color:#6b4e35;padding-top:14px;border-top:1px solid rgba(44,26,14,.08)">
                <span style="display:flex;align-items:center;gap:9px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg><span data-pv-dates="1">Add your dates</span></span>
                {petNames && (
                  <span style="display:flex;align-items:center;gap:9px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="8" cy="9" r="2.2"></circle><circle cx="16" cy="9" r="2.2"></circle><circle cx="12" cy="15.5" r="3"></circle></svg>{petNames}</span>
                )}
              </div>
              <span data-pv-chip="1" style="display:inline-block;width:fit-content;background:rgba(110,84,56,.12);color:#2f5d45;font-size:.74rem;font-weight:700;letter-spacing:.06em;padding:6px 15px;border-radius:50px;background:rgba(44,26,14,.06);color:#6b4e35;">Dates to confirm</span>
            </div>
          </div>

          <div class="ps-pulled" style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:24px 26px;transition:border-color .3s ease, background .3s ease">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 14px">Pulled from your profile</p>
            <div style="display:flex;flex-direction:column;gap:11px;font-size:.88rem;color:#6b4e35;line-height:1.6">
              {pulled.map((r) => (
                <span style="display:flex;align-items:center;gap:11px"><span style={`width:20px;height:20px;border-radius:50%;${r.markBg}color:#fff;font-size:.64rem;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0`}>{r.mark}</span>{r.text}</span>
              ))}
            </div>
            <a href="/owner/profile/edit" class="ps-edit" style="display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-size:.74rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px;transition:gap .2s, color .2s">Edit home &amp; pets &rarr;</a>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<script is:inline>
(() => {
  // One step at a time, Airbnb style (round 3).
  const form = document.querySelector('form[data-listing]');
  const steps = [...document.querySelectorAll('[data-step]')];
  const TITLES = ['Give your sit a name', 'When do you need a sitter?', 'Anything sitters should know?'];
  let at = 0;
  const go = (n) => {
    at = Math.max(0, Math.min(steps.length - 1, n));
    steps.forEach((st, i) => { st.hidden = i !== at; });
    document.querySelector('[data-step-n]').textContent = 'Step ' + (at + 1) + ' of ' + steps.length;
    document.querySelector('[data-step-t]').textContent = TITLES[at];
    document.querySelector('[data-step-bar]').style.width = ((at + 1) / steps.length * 100) + '%';
    document.querySelector('[data-step-back]').disabled = at === 0;
    form.classList.toggle('last', at === steps.length - 1);
    const f = steps[at].querySelector('input, textarea'); if (f) f.focus({ preventScroll: true });
  };
  const ok = () => {
    const bad = [...steps[at].querySelectorAll('input[required]')].find((el) => !el.checkValidity());
    if (bad) { bad.reportValidity(); return false; }
    return true;
  };
  document.querySelector('[data-step-next]').addEventListener('click', () => { if (ok()) go(at + 1); });
  document.querySelector('[data-step-back]').addEventListener('click', () => go(at - 1));
  steps.forEach((st) => st.addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.target.tagName === 'INPUT' && at < steps.length - 1) { e.preventDefault(); if (ok()) go(at + 1); } }));
  form.addEventListener('invalid', (e) => { const i = steps.findIndex((st) => st.contains(e.target)); if (i >= 0 && i !== at) go(i); }, true);
  go(0);
})();
(() => {
  // Live listing preview — ported from the design's script (state → DOM).
  const state = { title: '', from: '', to: '' };
  const q = s => document.querySelector(s);

  const fmt = d => {
    if (!d) return '';
    return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };

  const days = () => {
    const { from, to } = state;
    if (!from || !to) return 0;
    return Math.ceil((new Date(to + 'T00:00:00') - new Date(from + 'T00:00:00')) / 86400000);
  };

  const presetDefs = [
    { label: '1 week', n: 7 },
    { label: '2 weeks', n: 14 },
    { label: '3 weeks', n: 21 },
    { label: '1 month', n: 30 }
  ];

  const render = () => {
    const { title, from, to } = state;
    const d = days();
    const valid = d > 0;
    const banner = 'display:flex;margin-bottom:26px;padding:14px 18px;border-radius:12px;transition:background .3s ease, border-color .3s ease;' +
      (!from || !to
        ? 'display:none;'
        : valid
          ? 'background:rgba(110,84,56,.09);border:1px solid rgba(110,84,56,.32);'
          : 'background:#fdeeee;border:1px solid #f7cfcf;');

    document.querySelectorAll('[data-preset]').forEach(b => {
      const n = Number(b.getAttribute('data-preset'));
      b.style.cssText = 'font-family:\'Montserrat\',sans-serif;font-size:.76rem;font-weight:700;letter-spacing:.06em;padding:9px 18px;border-radius:50px;cursor:pointer;transition:background .25s ease, color .25s ease, border-color .25s ease, transform .15s ease;' +
        (valid && d === n
          ? 'background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;'
          : 'background:#fff;color:#5c3d20;border:1.5px solid rgba(110,84,56,.35);');
    });

    q('[data-duration]').style.cssText = banner;
    q('[data-duration-text]').textContent = valid
      ? d + (d === 1 ? ' day' : ' days') + ' — ' + fmt(from) + ' to ' + fmt(to)
      : 'End date must be after the start date.';
    q('[data-pv-title]').textContent = title.trim() || 'Your listing title appears here';
    q('[data-pv-dates]').textContent = valid ? fmt(from) + ' — ' + fmt(to) : 'Add your dates';
    const chip = q('[data-pv-chip]');
    chip.textContent = valid ? d + (d === 1 ? ' day' : ' days') : 'Dates to confirm';
    chip.style.cssText = 'display:inline-block;width:fit-content;background:rgba(110,84,56,.12);color:#2f5d45;font-size:.74rem;font-weight:700;letter-spacing:.06em;padding:6px 15px;border-radius:50px;' +
      (valid ? '' : 'background:rgba(44,26,14,.06);color:#6b4e35;');
  };

  const setState = patch => { Object.assign(state, patch); render(); };

  document.querySelectorAll('[data-preset]').forEach(b => b.addEventListener('click', () => {
    const p = presetDefs.find(x => x.n === Number(b.getAttribute('data-preset')));
    const start = state.from || new Date().toISOString().slice(0, 10);
    const end = new Date(new Date(start + 'T00:00:00').getTime() + p.n * 86400000).toISOString().slice(0, 10);
    const fromEl = q('[data-from]');
    const toEl = q('[data-to]');
    if (fromEl) fromEl.value = start;
    if (toEl) toEl.value = end;
    setState({ from: start, to: end });
  }));

  const loader = q('[data-loader]');
  let hideT;
  const show = () => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http')) return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; show(); });
  });

  const bind = (sel, key) => {
    const el = q(sel);
    el && el.addEventListener('input', () => setState({ [key]: el.value }));
    el && el.addEventListener('change', () => setState({ [key]: el.value }));
  };
  bind('[data-title]', 'title');
  bind('[data-from]', 'from');
  bind('[data-to]', 'to');

  // The form posts to /api/owner/listings as before; only the loader shows.
  const form = q('[data-listing]');
  form && form.addEventListener('submit', () => { show(); });

  // Server-side validation errors come back as ?error=…
  const params = new URLSearchParams(location.search);
  const err = params.get('error');
  const detail = params.get('detail');
  const messages = {
    missing: 'Please fill in all required fields.',
    dates: 'End date must be after start date.',
    id_required: 'Verify your ID before posting a sit — go to Verification in the menu.',
    server: detail ? 'Something went wrong: ' + detail : 'Something went wrong. Please try again.'
  };
  const errEl = q('[data-form-error]');
  if (err && messages[err] && errEl) { errEl.textContent = messages[err]; errEl.style.display = 'block'; }

  render();
})();
</script>
</body>
</html>
