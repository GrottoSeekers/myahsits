---
export const prerender =
  false;
import AppNav from
  '../../../_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../../../../lib/account';
import {
  getSession,
} from
  '../../../../lib/auth';
import {
  supabase,
} from
  '../../../../lib/supabase';

const arr = (
  v: unknown,
): any[] => (
  Array.isArray(v)
    ? v : []
);
const fmtDate = (
  d: string,
) => new Date(
  d + 'T00:00:00',
).toLocaleDateString(
  'en-GB',
  {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  },
);

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'owner',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const { id } =
  Astro.params;

const pr =
  await supabase
  .from('profiles')
  .select(
    'id, name,' +
    ' location,' +
    ' profile_pic,' +
    ' pets_json',
  )
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const profile: any =
  pr.data;
if (!profile) {
  return Astro.redirect(
    '/owner/profile/create',
  );
}

const lr =
  await supabase
  .from('listings')
  .select('*')
  .eq('id', id)
  .eq(
    'profile_id',
    profile.id,
  )
  .single();
const listing: any =
  lr.data;
if (!listing) {
  return Astro.redirect(
    '/owner/dashboard',
  );
}

// Enquiry count — the
// table may not exist.
let enquiries = 0;
try {
  const ar =
    await supabase
    .from('applications')
    .select('*', {
      count: 'exact',
      head: true,
    })
    .eq(
      'listing_id',
      listing.id,
    );
  enquiries =
    ar.count ?? 0;
} catch {}

const pets = arr(
  profile.pets_json,
);
const petNames = pets
  .map(
    (p: any) => p.name,
  )
  .filter(Boolean)
  .join(', ');
// Cover photo for the preview card (round 3).
const coverPic = String((arr(profile.hero_images_json)[0] as any)?.src || (arr(profile.gallery_json)[0] as any)?.src || '/images/slideshow-living-room.jpeg').replace(/^public\//, '/');
const pic: string =
  profile.profile_pic ||
  '/images/' +
  'avatar-cream.png';

// Design copy — used
// when name and
// location are empty.
const ownerDef = `
Thomas James · Woolley, near Bath
`.trim();
const ownerLine =
  profile.name ||
  profile.location
    ? (profile.name ||
        '') +
      (profile.location
        ? ' · ' +
          profile.location
        : '')
    : ownerDef;

const posted =
  listing.created_at
    ? fmtDate(
        String(
          listing
          .created_at,
        ).slice(0, 10),
      )
    : '';
const enquiryText =
  enquiries === 1
    ? 'enquiry received'
    : 'enquiries received';

const status: string =
  listing.status ||
  'active';
const keys: string =
  listing.keys ||
  'Handed over in person';
const initial = {
  title:
    listing.title || '',
  from:
    listing.date_from ||
    '',
  to:
    listing.date_to || '',
  status,
};
const listingId =
  listing.id;
const statuses = [
  'active',
  'filled',
  'cancelled',
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Edit listing — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 900px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 36px 24px 70px !important; }
      [data-form-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
      [data-card] { padding: 26px !important; }
      [data-date-row] { grid-template-columns: minmax(0,1fr) !important; }
    }

    /* Field focus — same treatment as Log in */
    [data-listing] input:focus, [data-listing] textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }
    [data-listing] select:focus { border-color:#2f5d45 !important; outline:none; }

    .ps-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .ps-logout:hover { color:#2c1a0e !important; }
    .ps-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .ps-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .ps-btn:active { transform:translateY(0) scale(.98) !important; }
    .ps-cancel:hover { color:#2c1a0e !important; }
    .ps-pulled:hover { border-color:rgba(110,84,56,.5) !important; }
    .ps-edit:hover { gap:12px !important; color:#2c1a0e !important; }
    .el-danger:hover { border-color:rgba(185,28,28,.38) !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <link rel="stylesheet" href="/listing-form.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={'owner'} active="" />

  <main data-pad="1" style="flex:1;padding:52px 48px 80px">
    <div style="max-width:1100px;margin:0 auto">

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:32px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Edit listing</p>
        <h1 data-headline="1" style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">{initial.title}</h1>
        <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:580px;margin:0">Change the dates, details or status of this sit. Sitters who&rsquo;ve already enquired keep their conversation with you.</p>
      </div>

      <div data-form-error="1" role="alert" style="display:none;margin-bottom:24px;padding:14px 18px;border-radius:12px;background:#fdeeee;border:1px solid #f7cfcf;font-size:.86rem;font-weight:600;color:#a4442e"></div>

      <div data-form-grid="1" style="display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:28px;align-items:start">

        <form data-listing="1" method="POST" action="/api/owner/listings" style="display:flex;flex-direction:column;gap:24px">
          <input type="hidden" name="_action" value="update" />
          <input type="hidden" name="listing_id" value={listingId} />
          <input type="hidden" name="status" data-status-input="1" value={status} />

          <div data-card="1" class="ps-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 8px">Sit details</h2>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 28px"></div>

            <div style="margin-bottom:26px">
              <label for="title" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Title <span style="color:#2f5d45">*</span></label>
              <input data-title="1" type="text" id="title" name="title" value={initial.title} required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
            </div>

            <div data-date-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:26px">
              <div>
                <label for="date_from" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">From <span style="color:#2f5d45">*</span></label>
                <input data-from="1" type="date" id="date_from" name="date_from" value={initial.from} required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>
              <div>
                <label for="date_to" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">To <span style="color:#2f5d45">*</span></label>
                <input data-to="1" type="date" id="date_to" name="date_to" value={initial.to} required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>
            </div>

            <div data-duration="1" style="display:none">
              <span style="display:flex;align-items:center;gap:10px;font-size:.86rem;font-weight:600;color:#5c3d20;letter-spacing:.02em">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                <span data-duration-text="1"></span>
              </span>
            </div>

            <div style="margin-bottom:26px">
              <span style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:12px">Status</span>
              <div style="display:flex;gap:10px;flex-wrap:wrap">
                {statuses.map((s) => (
                  <button type="button" data-status={s}><span data-status-dot="1"></span><span data-status-label="1"></span></button>
                ))}
              </div>
              <p data-status-hint="1" style="font-size:.82rem;color:#6b4e35;margin:12px 0 0;line-height:1.6"></p>
            </div>

            <div>
              <label for="description" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Details</label>
              <textarea data-desc="1" id="description" name="description" rows="6" placeholder="Anything specific to this sit — daily routine, special instructions, house rules." style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s">{listing.description ?? ''}</textarea>
            </div>
          </div>

          <div data-card="1" class="ps-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 8px">Handover for this sit</h2>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 26px;max-width:480px">Only the parts that change sit to sit. Your address, wifi, vet and house notes come from your profile.</p>

            <div data-date-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:26px">
              <div>
                <label for="arrival" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Sitter arrives</label>
                <input data-arrival="1" type="text" id="arrival" name="arrival" value={listing.arrival ?? ''} placeholder="e.g. Sat 3 Oct, 6pm" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">Most owners hand over the evening before.</p>
              </div>
              <div>
                <label for="keys" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Keys</label>
                <select data-keys="1" id="keys" name="keys" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s">
                  <option value="Handed over in person" selected={keys === 'Handed over in person'}>Handed over in person</option>
                  <option value="Left with a neighbour" selected={keys === 'Left with a neighbour'}>Left with a neighbour</option>
                  <option value="Key safe — code shared on confirmation" selected={keys.startsWith('Key safe')}>Key safe — code on confirmation</option>
                </select>
              </div>
            </div>

            <div style="display:flex;align-items:flex-start;gap:13px;background:rgba(110,84,56,.1);border:1px solid rgba(110,84,56,.32);border-radius:12px;padding:16px 18px">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
              <p style="font-size:.9rem;color:#5c3d20;line-height:1.65;margin:0">Address, wifi, vet, neighbour and house notes stay private until you confirm a sitter &mdash; then all of it appears on their sit page. <a href="/owner/profile/edit" style="font-weight:600">Edit handover details &rarr;</a></p>
            </div>
          </div>

          <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap">
            <button type="submit" data-save="1" class="ps-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">Save changes</button>
            <a href="/owner/dashboard" class="ps-cancel" style="font-size:.8rem;color:#6b4e35;text-decoration:none;letter-spacing:.1em;text-transform:uppercase;font-weight:600;transition:color .2s">Cancel</a>
          </div>

          <div data-card="1" class="el-danger" style="background:#fff;border:1px solid rgba(185,28,28,.2);border-radius:18px;padding:30px 36px;transition:border-color .3s ease">
            <h3 style="font-family:'Marcellus',serif;font-size:1.05rem;color:#b91c1c;margin:0 0 8px">Delete this listing</h3>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.65;margin:0 0 18px;max-width:420px">It disappears from browse results straight away. Messages stay in your inbox. This cannot be undone.</p>
            <div data-confirm-row="1" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
              <button type="button" data-delete="1">Delete listing</button>
              <button type="button" data-keep="1">Keep listing</button>
            </div>
          </div>
        </form>

        <aside data-aside="1" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:20px">
          <div class="ps-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;overflow:hidden;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="padding:20px 24px;border-bottom:1px solid rgba(110,84,56,.2);display:flex;align-items:center;justify-content:space-between;gap:12px">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0">How sitters see it</p>
              <span data-status-pill="1"></span>
            </div>
            <div class="lf-cover"><img src={coverPic} alt="" /><span class="lf-tag">Sit in the home</span><img class="lf-host" src={pic} alt="" /></div>
            <div style="padding:22px 24px 26px;background:#faf6ee;display:flex;flex-direction:column;gap:16px">
              <div style="display:flex;gap:14px;align-items:flex-start">
                <img src={pic} alt="" style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.35)" />
                <div style="flex:1;min-width:0">
                  <p data-pv-title="1" style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;margin:0 0 4px;line-height:1.3"></p>
                  <p style="font-size:.8rem;color:#2f5d45;font-weight:600;margin:0">{ownerLine}</p>
                </div>
              </div>
              <div style="display:flex;flex-direction:column;gap:9px;font-size:.84rem;color:#6b4e35;padding-top:14px;border-top:1px solid rgba(44,26,14,.08)">
                <span style="display:flex;align-items:center;gap:9px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg><span data-pv-dates="1"></span></span>
                {petNames && (
                  <span style="display:flex;align-items:center;gap:9px"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="8" cy="9" r="2.2"></circle><circle cx="16" cy="9" r="2.2"></circle><circle cx="12" cy="15.5" r="3"></circle></svg>{petNames}</span>
                )}
              </div>
              <span data-pv-chip="1"></span>
            </div>
          </div>

          <div class="ps-pulled" style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:24px 26px;transition:border-color .3s ease">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 14px">This listing so far</p>
            <div style="display:flex;flex-direction:column;gap:11px;font-size:.88rem;color:#6b4e35;line-height:1.6">
              <span style="display:flex;align-items:center;gap:11px"><span style="width:20px;height:20px;border-radius:50%;background:#2f5d45;color:#fff;font-size:.64rem;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0">{enquiries}</span>{enquiryText}</span>
              {posted && (
                <span style="display:flex;align-items:center;gap:11px"><span style="width:20px;height:20px;border-radius:50%;background:#2f5d45;color:#fff;font-size:.64rem;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0">✓</span>Posted {posted}</span>
              )}
            </div>
            <a href="/messages" class="ps-edit" style="display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-size:.74rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px;transition:gap .2s, color .2s">View enquiries &rarr;</a>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<script is:inline define:vars={{ initial, listingId }}>
(() => {
  // Ported from the design's script (state → DOM render).
  const state = Object.assign({ confirmingDelete: false, saved: false }, initial);
  const q = s => document.querySelector(s);

  const fmt = d => {
    if (!d) return '';
    return new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };
  const days = () => {
    const { from, to } = state;
    if (!from || !to) return 0;
    return Math.ceil((new Date(to + 'T00:00:00') - new Date(from + 'T00:00:00')) / 86400000);
  };

  const defs = [
    { key: 'active', label: 'Active', colour: '#2f5d45', hint: 'Live in browse results — sitters can find it and enquire.' },
    { key: 'filled', label: 'Filled', colour: '#2f7d4f', hint: 'Hidden from browse. Kept on your dashboard for your records.' },
    { key: 'cancelled', label: 'Cancelled', colour: '#8a6a4f', hint: 'Hidden from browse and marked cancelled to anyone who enquired.' }
  ];

  const render = () => {
    const { title, from, to, status, confirmingDelete, saved } = state;
    const d = days();
    const valid = d > 0;
    const current = defs.find(s => s.key === status) || defs[0];

    document.querySelectorAll('[data-status]').forEach(b => {
      const s = defs.find(x => x.key === b.getAttribute('data-status'));
      b.style.cssText = 'display:inline-flex;align-items:center;gap:9px;font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.06em;padding:10px 20px;border-radius:50px;cursor:pointer;transition:background .25s ease, color .25s ease, border-color .25s ease, transform .15s ease;' +
        (status === s.key
          ? 'background:' + s.colour + ';color:#fff;border:1.5px solid ' + s.colour + ';'
          : 'background:#fff;color:#5c3d20;border:1.5px solid rgba(110,84,56,.35);');
      b.querySelector('[data-status-dot]').style.cssText = 'width:8px;height:8px;border-radius:50%;display:block;flex-shrink:0;background:' + (status === s.key ? '#fff' : s.colour) + ';';
      b.querySelector('[data-status-label]').textContent = s.label;
    });
    q('[data-status-input]').value = current.key;

    q('[data-headline]').textContent = title.trim() || 'Untitled listing';
    q('[data-status-hint]').textContent = current.hint;
    const pill = q('[data-status-pill]');
    pill.textContent = current.label;
    pill.style.cssText = 'font-size:.66rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:5px 12px;border-radius:50px;white-space:nowrap;color:#fff;background:' + current.colour + ';';

    q('[data-duration]').style.cssText = 'display:flex;margin-bottom:26px;padding:14px 18px;border-radius:12px;transition:background .3s ease, border-color .3s ease;' +
      (!from || !to
        ? 'display:none;'
        : valid
          ? 'background:rgba(110,84,56,.09);border:1px solid rgba(110,84,56,.32);'
          : 'background:#fdeeee;border:1px solid #f7cfcf;');
    q('[data-duration-text]').textContent = valid
      ? d + (d === 1 ? ' day' : ' days') + ' — ' + fmt(from) + ' to ' + fmt(to)
      : 'End date must be after the start date.';

    q('[data-save]').textContent = saved ? 'Changes saved' : 'Save changes';
    q('[data-pv-title]').textContent = title.trim() || 'Your listing title appears here';
    q('[data-pv-dates]').textContent = valid ? fmt(from) + ' — ' + fmt(to) : 'Add your dates';
    const chip = q('[data-pv-chip]');
    chip.textContent = valid ? d + (d === 1 ? ' day' : ' days') : 'Dates to confirm';
    chip.style.cssText = 'display:inline-block;width:fit-content;background:rgba(110,84,56,.12);color:#2f5d45;font-size:.74rem;font-weight:700;letter-spacing:.06em;padding:6px 15px;border-radius:50px;' +
      (valid ? '' : 'background:rgba(44,26,14,.06);color:#6b4e35;');

    q('[data-confirm-row]').style.cssText = 'display:flex;align-items:center;gap:16px;flex-wrap:wrap';
    const del = q('[data-delete]');
    del.textContent = confirmingDelete ? 'Yes, delete it' : 'Delete listing';
    del.style.cssText = 'font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:13px 28px;border-radius:50px;cursor:pointer;transition:background .25s ease, color .25s ease, transform .15s ease, box-shadow .25s ease;' +
      (confirmingDelete
        ? 'background:#b91c1c;color:#fff;border:1.5px solid #b91c1c;box-shadow:0 6px 18px rgba(185,28,28,.26);'
        : 'background:#fff;color:#b91c1c;border:1.5px solid rgba(185,28,28,.4);');
    q('[data-keep]').style.cssText = 'font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;background:none;border:none;cursor:pointer;padding:6px 2px;transition:color .2s;' +
      (confirmingDelete ? '' : 'display:none;');
  };

  const setState = patch => { Object.assign(state, patch); render(); };

  let hideT;
  const showLoader = () => {
    const loader = q('[data-loader]');
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };

  document.querySelectorAll('[data-status]').forEach(b => b.addEventListener('click', () => setState({ status: b.getAttribute('data-status'), saved: false })));

  // Delete: first click asks to confirm, second click posts the existing delete action.
  q('[data-delete]').addEventListener('click', () => {
    if (!state.confirmingDelete) { setState({ confirmingDelete: true }); return; }
    setState({ confirmingDelete: false });
    showLoader();
    const f = document.createElement('form');
    f.method = 'POST';
    f.action = '/api/owner/listings';
    [['_action', 'delete'], ['listing_id', listingId]].forEach(([n, v]) => {
      const i = document.createElement('input');
      i.type = 'hidden'; i.name = n; i.value = v;
      f.appendChild(i);
    });
    document.body.appendChild(f);
    f.submit();
  });
  q('[data-keep]').addEventListener('click', () => setState({ confirmingDelete: false }));
  q('[data-keep]').addEventListener('mouseenter', e => { e.target.style.color = '#2c1a0e'; });
  q('[data-keep]').addEventListener('mouseleave', e => { e.target.style.color = '#6b4e35'; });

  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http')) return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; showLoader(); });
  });

  const bind = (sel, key) => {
    const el = q(sel);
    if (!el) return;
    const on = () => setState({ [key]: el.value, saved: false });
    el.addEventListener('input', on);
    el.addEventListener('change', on);
  };
  bind('[data-title]', 'title');
  bind('[data-from]', 'from');
  bind('[data-to]', 'to');

  // Saves through the existing POST; only the label and loader change here.
  const form = q('[data-listing]');
  form && form.addEventListener('submit', () => { setState({ saved: true }); showLoader(); });

  const params = new URLSearchParams(location.search);
  const err = params.get('error');
  const detail = params.get('detail');
  const messages = {
    missing: 'Please fill in all required fields.',
    dates: 'End date must be after start date.',
    server: detail ? 'Something went wrong: ' + detail : 'Something went wrong. Please try again.'
  };
  const errEl = q('[data-form-error]');
  if (err && messages[err] && errEl) { errEl.textContent = messages[err]; errEl.style.display = 'block'; }

  render();
})();
</script>
</body>
</html>
