---
// Data: the
// `notifications` table
// for the signed-in
// profile (written by
// src/lib/notify.ts), the
// next confirmed sit from
// `sits`, and the
// profile's notify prefs.
export const prerender =
  false;
import AppNav from
  './_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../lib/account';
import {
  getSession,
} from '../lib/auth';
import {
  supabase,
} from '../lib/supabase';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'any',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const pr =
  await supabase
  .from('profiles')
  .select('*')
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const me: any = pr.data;
// Side comes from the
// account (sign-up).
if (me && acct)
  me.profile_type =
    acct.side;
if (!me) {
  return Astro.redirect(
    '/login',
  );
}
const isOwner =
  me.profile_type ===
  'owner';
const dashUrl = isOwner
  ? '/owner/dashboard'
  : '/dashboard';

let rows: any[] = [];
try {
  const nr =
    await supabase
    .from('notifications')
    .select(
      'id, kind, title,' +
      ' body, link, cta,' +
      ' read, created_at',
    )
    .eq(
      'profile_id',
      me.id,
    )
    .order(
      'created_at',
      { ascending: false },
    )
    .limit(100);
  rows = nr.data ?? [];
} catch {}

// Today / This week /
// Earlier, and "when".
const now = new Date();
const dayStart = new Date(
  now.getFullYear(),
  now.getMonth(),
  now.getDate(),
).getTime();
const weekAgo =
  dayStart -
  6 * 86400000;
const when = (
  d: Date,
) => {
  const ms =
    now.getTime() -
    d.getTime();
  if (
    d.getTime() >=
    dayStart
  ) {
    const h =
      Math.floor(
        ms / 3600000,
      );
    if (h < 1) {
      return 'Just now';
    }
    return (
      h +
      (h === 1
        ? ' hour ago'
        : ' hours ago')
    );
  }
  if (
    d.getTime() >= weekAgo
  ) {
    return d
      .toLocaleDateString(
        'en-GB',
        {
          weekday: 'long',
        },
      );
  }
  return d
    .toLocaleDateString(
      'en-GB',
      {
        day: 'numeric',
        month: 'long',
      },
    );
};
const kinds = [
  'urgent',
  'message',
  'sit',
  'review',
  'match',
  'account',
];
const items = rows.map(
  (r) => {
    const d = new Date(
      r.created_at,
    );
    return {
      id: r.id,
      kind: kinds.includes(
        r.kind,
      )
        ? r.kind
        : 'account',
      group:
        d.getTime() >=
        dayStart
          ? 'Today'
          : d.getTime() >=
              weekAgo
            ? 'This week'
            : 'Earlier',
      title: r.title || '',
      body: r.body || '',
      when: when(d),
      cta:
        r.cta || 'Open',
      href:
        r.link || dashUrl,
      read: !!r.read,
    };
  },
);

// Next confirmed sit for
// this sitter, if any.
let next: any = null;
if (!isOwner) {
  try {
    const sr =
      await supabase
      .from('sits')
      .select(
        'id, listings!inner(' +
        'title, date_from,' +
        ' date_to,' +
        ' profiles!inner(' +
        'name, location))',
      )
      .eq(
        'sitter_user_id',
        session.userId,
      );
    const today = now
      .toISOString()
      .slice(0, 10);
    next =
      (sr.data ?? [])
      .filter(
        (s: any) =>
          s.listings
            ?.date_from >=
          today,
      )
      .sort(
        (a: any, b: any) =>
          a.listings
            .date_from <
          b.listings
            .date_from
            ? -1
            : 1,
      )[0] || null;
  } catch {}
}

// Design copy — used if
// the sit has no title or
// owner details.
const sitTitleDef = `
Cosy cottage with two spaniels
`.trim();
const sitLineDef = `
Thomas James · Woolley, near Bath. 4 – 18 Oct 2026, 20 days away.
`.trim();
const fmt = (
  s: string,
  year: boolean,
) => new Date(
  s + 'T00:00:00',
).toLocaleDateString(
  'en-GB',
  year
    ? {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      }
    : {
        day: 'numeric',
        month: 'short',
      },
);
let sitTitle =
  sitTitleDef;
let sitLine = sitLineDef;
let sitHref = '/dashboard';
if (next) {
  const l = next.listings;
  const o =
    l.profiles || {};
  const days = Math.ceil(
    (new Date(
      l.date_from +
        'T00:00:00',
    ).getTime() -
      dayStart) /
      86400000,
  );
  sitTitle =
    l.title ||
    sitTitleDef;
  sitLine =
    (o.name || 'Owner') +
    (o.location
      ? ' · ' + o.location
      : '') +
    '. ' +
    fmt(
      l.date_from,
      false,
    ) +
    ' – ' +
    fmt(l.date_to, true) +
    ', ' +
    days +
    (days === 1
      ? ' day away.'
      : ' days away.');
  sitHref =
    '/sits/' + next.id;
}

const np =
  me.notify_prefs_json ||
  {};
const prefs = {
  applications:
    np.applications !==
    false,
  messages:
    np.messages !== false,
  sit: np.sit !== false,
  matches: !!np.matches,
  product: !!np.product,
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Notifications — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 1000px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 34px 20px 80px !important; }
      [data-two-col] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
      [data-row] { grid-template-columns: minmax(0,1fr) !important; }
      [data-row] [data-actions] { padding: 0 22px 20px !important; justify-content: flex-start !important; }
      [data-safety] { grid-template-columns: minmax(0,1fr) !important; }
    }

    .nt-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .nt-msgs:hover { color:#2c1a0e !important; }
    .nt-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .nt-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <style is:global>
    /* iPhone-style notifications (round 3) */
    .ios-seg { display:inline-flex; padding:3px; gap:2px; border-radius:12px; background:#ede5d8; max-width:100%; overflow-x:auto; scrollbar-width:none; }
    .ios-seg button { flex:none; border:0; background:none; border-radius:9px; padding:8px 14px; font:600 .8rem 'Montserrat',sans-serif; color:#6b4e35; cursor:pointer; white-space:nowrap; transition:background .2s, box-shadow .2s, color .2s; }
    .ios-seg button small { font-size:.68rem; color:#2f5d45; margin-left:3px; }
    .ios-seg button[aria-pressed="true"] { background:#fff; color:#2c1a0e; box-shadow:0 2px 8px rgba(44,26,14,.12); }
    [data-tabs] { min-width:0; max-width:100%; }
    .nt-soon .nt-btn { color:#fff !important; }
    .ios-clear { border:0; background:none; font:600 .84rem 'Montserrat',sans-serif; color:#2f5d45; cursor:pointer; padding:8px 4px; }
    .ios-clear.off { color:#b39c80; }
    .ios-g + .ios-g { margin-top:6px; }
    .ios-gh { margin:0 0 10px 4px; font:700 1.25rem 'Montserrat',sans-serif; letter-spacing:-.01em; color:#2c1a0e; }
    .ios-list { display:flex; flex-direction:column; gap:8px; }
    .ios-n { position:relative; display:flex; align-items:center; border-radius:22px; background:rgba(255,255,255,.72); backdrop-filter:saturate(1.6) blur(18px); -webkit-backdrop-filter:saturate(1.6) blur(18px); border:1px solid rgba(255,255,255,.7); box-shadow:0 6px 24px rgba(44,26,14,.08), 0 1px 2px rgba(44,26,14,.06); animation:ios-in .45s cubic-bezier(.2,.8,.2,1) both; transition:transform .2s, box-shadow .2s; }
    @keyframes ios-in { from { opacity:0; transform:translateY(-10px) scale(.98); } to { opacity:1; transform:none; } }
    .ios-n:hover { transform:translateY(-1px); box-shadow:0 10px 30px rgba(44,26,14,.12); }
    .ios-main { flex:1; min-width:0; display:flex; gap:12px; align-items:flex-start; padding:14px 6px 14px 14px; text-decoration:none; color:#2c1a0e; }
    .ios-app { flex:none; width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; background:linear-gradient(160deg,#3e7a5b,#2f5d45); color:#fff; font-size:1rem; box-shadow:0 2px 6px rgba(47,93,69,.3); }
    .ios-app svg { width:20px; height:20px; }
    .ios-urgent { background:linear-gradient(160deg,#c45a3e,#a4442e); }
    .ios-body { flex:1; min-width:0; display:flex; flex-direction:column; gap:1px; }
    .ios-top { display:flex; justify-content:space-between; gap:10px; font-size:.7rem; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:#8a6a4f; }
    .ios-top time { flex:none; text-transform:none; letter-spacing:0; font-weight:500; }
    .ios-body b { font-size:.95rem; font-weight:600; color:#2c1a0e; line-height:1.35; margin-top:2px; }
    .ios-txt { font-size:.88rem; color:#4a3726; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .ios-n:not(.unread) { background:rgba(255,255,255,.45); }
    .ios-n:not(.unread) .ios-body b { font-weight:500; color:#6b4e35; }
    .ios-dot { flex:none; width:34px; align-self:stretch; border:0; background:none; cursor:pointer; position:relative; }
    .ios-dot::after { content:""; position:absolute; top:50%; left:50%; width:10px; height:10px; margin:-5px 0 0 -5px; border-radius:50%; background:transparent; border:1.5px solid rgba(110,84,56,.3); transition:background .2s, border-color .2s; }
    .ios-n.unread .ios-dot::after { background:#2f5d45; border-color:#2f5d45; }
    .nt-fold > summary { list-style:none; display:flex; justify-content:space-between; align-items:center; cursor:pointer; }
    .nt-fold > summary::-webkit-details-marker { display:none; }
    .nt-fold-i::after { content:"+"; font-size:1.3rem; color:#2f5d45; }
    .nt-fold[open] .nt-fold-i::after { content:"–"; }
    .nt-fold[open] > summary { margin-bottom:6px; }
    @media (max-width:700px) {
      [data-pad] { padding:18px 14px 60px !important; }
      [data-pad] h1 { font-size:1.9rem !important; margin-bottom:8px !important; }
      [data-pad] > div > div:first-child { padding-bottom:16px !important; margin-bottom:16px !important; }
      [data-safety] { grid-template-columns:minmax(0,1fr) !important; gap:10px !important; }
      [data-safety] a { padding:16px 18px !important; }
      .nt-quiet { display:none; }
      .ios-main { padding:12px 4px 12px 12px; }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={acct!.side} active="notifications" />

  <main data-pad="1" style="flex:1;padding:52px 48px 90px">
    <div style="max-width:1180px;margin:0 auto">

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Your account</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">What&rsquo;s <em style="color:#2f5d45;">happened</em></h1>
        <p data-intro="1" style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:620px;margin:0"></p>
      </div>

      <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:28px;align-items:start">

        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px">
            <div data-tabs="1" style="display:flex;gap:9px;flex-wrap:wrap"></div>
            <button type="button" data-read-all="1">Mark all read</button>
          </div>

          <div data-groups="1" style="display:flex;flex-direction:column;gap:22px"></div>

          <div data-empty="1" style="display:none">
            <p style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 10px">All caught up</p>
            <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0;max-width:420px">Nothing unread. Anything new lands here and, if you want it to, in your inbox.</p>
          </div>

          <details data-card="1" class="nt-card nt-fold" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:22px 26px;margin-top:28px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <summary><h2 style="font-family:'Marcellus',serif;font-size:1.2rem;color:#2c1a0e;margin:0">If something goes wrong</h2><span class="nt-fold-i" aria-hidden="true"></span></summary>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.93rem;color:#6b4e35;line-height:1.75;margin:0 0 26px;max-width:520px">Sits mostly go fine. When they don&rsquo;t, here is exactly what to do &mdash; no hunting through a help centre at eleven at night.</p>

            <div data-safety="1" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <a href="/messages" style="display:block;text-decoration:none;background:#faf6ee;border-radius:14px;padding:22px 24px;transition:border-color .25s ease, transform .2s ease;border:1px solid rgba(185,28,28,.22);">
                <p style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;margin:0 0 8px;line-height:1.3">The owner has cancelled on you</p>
                <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0 0 12px">Tell us and we will surface sits matching your dates straight away, and flag the cancellation on their side.</p>
                <span style="font-size:.74rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#b91c1c;">Report a cancellation
                  &rarr;</span>
              </a>
              <a href="/messages" style="display:block;text-decoration:none;background:#faf6ee;border-radius:14px;padding:22px 24px;transition:border-color .25s ease, transform .2s ease;border:1px solid rgba(185,28,28,.22);">
                <p style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;margin:0 0 8px;line-height:1.3">Something happened to a pet</p>
                <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0 0 12px">Vet first, always. Then log it here so both sides have a written record of what happened and when.</p>
                <span style="font-size:.74rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#b91c1c;">Log an incident &rarr;</span>
              </a>
              <a href="/messages" style="display:block;text-decoration:none;background:#faf6ee;border-radius:14px;padding:22px 24px;transition:border-color .25s ease, transform .2s ease;border:1px solid rgba(110,84,56,.25);">
                <p style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;margin:0 0 8px;line-height:1.3">Someone made you uncomfortable</p>
                <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0 0 12px">Block them, and tell us why. We read every report and the person is never told who raised it.</p>
                <span style="font-size:.74rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#2f5d45;">Report a person &rarr;</span>
              </a>
              <a href={sitHref} style="display:block;text-decoration:none;background:#faf6ee;border-radius:14px;padding:22px 24px;transition:border-color .25s ease, transform .2s ease;border:1px solid rgba(110,84,56,.25);">
                <p style="font-family:'Marcellus',serif;font-size:1.08rem;color:#2c1a0e;margin:0 0 8px;line-height:1.3">Pulling out of a sit</p>
                <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0 0 12px">Life happens. More than two weeks out and it does not touch your record — later than that and the owner is told.</p>
                <span style="font-size:.74rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#2f5d45;">Read the policy &rarr;</span>
              </a>
            </div>

            <div style="display:flex;align-items:flex-start;gap:14px;background:#fdeeee;border:1px solid #f7cfcf;border-radius:14px;padding:18px 20px;margin-top:20px">
              <span style="width:26px;height:26px;border-radius:50%;background:#b91c1c;color:#fff;font-size:.8rem;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0">!</span>
              <p style="font-size:.92rem;color:#5c3d20;line-height:1.7;margin:0">If an animal is hurt or someone is in danger, call a vet or the emergency services first. Tell us afterwards &mdash; we are not an emergency service and we would rather you got help fast.</p>
            </div>
          </details>
        </div>

        <aside data-aside="1" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:20px">
          <details class="nt-card nt-fold nt-set" open data-fold style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:22px 24px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <summary><p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0">What reaches you</p><span class="nt-fold-i" aria-hidden="true"></span></summary>
            <p style="font-size:.86rem;color:#6b4e35;line-height:1.7;margin:10px 0 18px">Everything shows on this page. Choose what also leaves it.</p>
            <div data-prefs="1" style="display:flex;flex-direction:column;gap:14px"></div>
          </details>

          {next && (
            <div class="nt-soon" style="background:linear-gradient(140deg,#fff 0%,#eef4ef 100%);border:1px solid rgba(47,93,69,.25);border-left:4px solid #2f5d45;border-radius:18px;padding:24px">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#2f5d45;margin:0 0 10px">Your sit starts soon</p>
              <p style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 6px;line-height:1.25">{sitTitle}</p>
              <p style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0 0 18px">{sitLine}</p>
              <a href={sitHref} class="nt-btn" style="display:flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2c1a0e;background:#2f5d45;border-radius:50px;padding:11px 22px;text-decoration:none;transition:background .25s ease, transform .15s ease">Open the sit</a>
            </div>
          )}

          <div class="nt-quiet" style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:22px 24px">
            <p data-quiet="1" style="font-size:.86rem;color:#6b4e35;line-height:1.7;margin:0"></p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<script is:inline define:vars={{ items, prefs }}>
(() => {
  // Ported from the design's script. Read/unread, mark all read and
  // preferences are saved via /api/notifications.
  const ITEMS = items;
  const s = { tab: 'all', read: {}, prefs: Object.assign({}, prefs) };
  ITEMS.forEach(i => { s.read[i.id] = i.read; });
  const q = sel => document.querySelector(sel);
  const esc = v => { const d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; };
  const post = body => fetch('/api/notifications', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .then(r => { if (!r.ok) throw new Error(); });

  const svg = paths => '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' + paths.map(d => '<path d="' + d + '"></path>').join('') + '</svg>';
  const ICONS = {
    urgent: svg(['M20 6.5 9.5 17 4 11.5']),
    message: svg(['M3.5 6h17v12h-17z', 'm4 6.8 8 5.6 8-5.6']),
    sit: svg(['M4 10.5 12 4l8 6.5V20a.5.5 0 0 1-.5.5h-15A.5.5 0 0 1 4 20z', 'M10 20.5v-6h4v6']),
    review: svg(['M4 5.5h16v10H9l-5 4z', 'M8.5 10.5h7']),
    match: svg(['M18 9a6 6 0 1 0-12 0c0 5-2 6.5-2 6.5h16S18 14 18 9z', 'M10.4 19a1.9 1.9 0 0 0 3.2 0']),
    account: svg(['M12 3.5 5 6v6c0 4.2 3 7.3 7 8.5 4-1.2 7-4.3 7-8.5V6z', 'm9.3 12.2 1.9 1.9 3.5-3.6'])
  };
  const tagFor = {
    urgent: { label: 'Application', bg: '#2f5d45', colour: '#fff' },
    message: { label: 'Message', bg: 'rgba(110,84,56,.16)', colour: '#2f5d45' },
    sit: { label: 'Your sit', bg: '#2c1a0e', colour: '#fff' },
    review: { label: 'Review', bg: 'rgba(110,84,56,.16)', colour: '#2f5d45' },
    match: { label: 'Alert', bg: 'rgba(44,26,14,.08)', colour: '#6b4e35' },
    account: { label: 'Account', bg: 'rgba(44,26,14,.08)', colour: '#6b4e35' }
  };
  const PREFS = [
    { key: 'applications', label: 'Sit decisions', note: 'An owner shortlists or confirms you' },
    { key: 'messages', label: 'Messages', note: 'A reply in a conversation' },
    { key: 'sit', label: 'Sit reminders', note: 'A week before, then the day before' },
    { key: 'matches', label: 'Saved search alerts', note: 'New sits matching your searches' },
    { key: 'product', label: 'News from us', note: 'Occasional, never more than monthly' }
  ];

  const render = () => {
    const unread = ITEMS.filter(i => !s.read[i.id]);
    const tabDefs = [
      { key: 'all', label: 'Everything', count: ITEMS.length },
      { key: 'unread', label: 'Unread', count: unread.length },
      { key: 'sits', label: 'My sits', count: ITEMS.filter(i => i.kind === 'sit' || i.kind === 'urgent').length },
      { key: 'messages', label: 'Messages', count: ITEMS.filter(i => i.kind === 'message').length }
    ];
    let list = ITEMS;
    if (s.tab === 'unread') list = ITEMS.filter(i => !s.read[i.id]);
    if (s.tab === 'sits') list = ITEMS.filter(i => i.kind === 'sit' || i.kind === 'urgent');
    if (s.tab === 'messages') list = ITEMS.filter(i => i.kind === 'message');

    q('[data-intro]').textContent = unread.length
      ? unread.length + (unread.length === 1 ? ' thing needs' : ' things need') + ' your attention. The rest is here for the record.'
      : 'Nothing unread. Everything that has happened on your account is kept here.';

    q('[data-tabs]').innerHTML = '<span class="ios-seg">' + tabDefs.map(t =>
      '<button type="button" data-tab="' + t.key + '" aria-pressed="' + (s.tab === t.key) + '">' + t.label + (t.count ? ' <small>' + t.count + '</small>' : '') + '</button>').join('') + '</span>';

    q('[data-read-all]').className = 'ios-clear' + (unread.length ? '' : ' off');

    const groups = ['Today', 'This week', 'Earlier'].map(label => ({
      label, items: list.filter(i => i.group === label)
    })).filter(g => g.items.length);

    // iPhone-style notifications (round 3): app icon, "MYAH · kind" and the
    // time on top, a bold title and two lines of text. Tap to open; the dot
    // marks it read.
    q('[data-groups]').innerHTML = groups.map(g =>
      '<div class="ios-g"><p class="ios-gh">' + g.label + '</p>' +
      '<div class="ios-list">' + g.items.map((i, n) => {
        const isRead = s.read[i.id];
        const tag = tagFor[i.kind];
        return '<article data-row="1" class="ios-n' + (isRead ? '' : ' unread') + '" style="animation-delay:' + Math.min(n, 8) * 50 + 'ms">' +
          '<a href="' + esc(i.href) + '" data-open="' + esc(i.id) + '" class="ios-main">' +
            '<span class="ios-app ios-' + esc(i.kind) + '">' + ICONS[i.kind] + '</span>' +
            '<span class="ios-body">' +
              '<span class="ios-top"><span>MYAH · ' + tag.label + '</span><time>' + esc(i.when) + '</time></span>' +
              '<b>' + esc(i.title) + '</b>' +
              (i.body ? '<span class="ios-txt">' + esc(i.body) + '</span>' : '') +
            '</span>' +
          '</a>' +
          '<button type="button" data-read="' + esc(i.id) + '" class="ios-dot" aria-label="' + (isRead ? 'Mark as unread' : 'Mark as read') + '" title="' + (isRead ? 'Mark as unread' : 'Mark as read') + '"></button>' +
        '</article>';
      }).join('') + '</div></div>'
    ).join('');

    q('[data-empty]').style.cssText = 'flex-direction:column;align-items:flex-start;background:#fff;border:1px dashed rgba(110,84,56,.45);border-radius:18px;padding:44px 40px;' + (groups.length ? 'display:none;' : 'display:flex;');

    q('[data-prefs]').innerHTML = PREFS.map(p => {
      const on = s.prefs[p.key];
      const switchStyle = 'position:relative;width:44px;height:25px;border-radius:50px;border:none;cursor:pointer;flex-shrink:0;padding:0;transition:background .25s ease;background:' + (on ? '#2f5d45' : 'rgba(44,26,14,.16)') + ';';
      const knobStyle = 'position:absolute;top:3px;left:' + (on ? '22px' : '3px') + ';width:19px;height:19px;border-radius:50%;background:#fff;display:block;transition:left .22s ease;box-shadow:0 1px 3px rgba(44,26,14,.25)';
      return '<div style="display:flex;align-items:center;gap:14px">' +
        '<div style="flex:1;min-width:0"><p style="font-size:.92rem;font-weight:600;color:#2c1a0e;margin:0 0 2px">' + p.label + '</p><p style="font-size:.79rem;color:#6b4e35;margin:0">' + p.note + '</p></div>' +
        '<button type="button" data-pref="' + p.key + '" style="' + switchStyle + '"><span style="' + knobStyle + '"></span></button></div>';
    }).join('');

    q('[data-quiet]').textContent = Object.values(s.prefs).filter(Boolean).length <= 2
      ? 'Quiet setup. Worth keeping sit decisions on at least — owners move quickly once they choose.'
      : 'We never email during a sit unless it is about that sit.';
  };

  const loader = q('[data-loader]');
  let hideT;
  const show = () => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };

  document.addEventListener('click', e => {
    const el = e.target.closest && e.target.closest('[data-tab],[data-read],[data-read-all],[data-pref],a[href]');
    if (!el) return;
    if (el.hasAttribute('data-tab')) { s.tab = el.getAttribute('data-tab'); render(); return; }
    if (el.hasAttribute('data-read')) {
      const id = el.getAttribute('data-read');
      const prev = s.read[id];
      s.read[id] = !prev; render();
      post({ action: 'read', id, read: !prev }).catch(() => { s.read[id] = prev; render(); });
      return;
    }
    if (el.hasAttribute('data-read-all')) {
      const before = Object.assign({}, s.read);
      ITEMS.forEach(i => { s.read[i.id] = true; }); render();
      post({ action: 'read-all' }).catch(() => { s.read = before; render(); });
      return;
    }
    if (el.hasAttribute('data-pref')) {
      const key = el.getAttribute('data-pref');
      s.prefs[key] = !s.prefs[key]; render();
      post({ action: 'prefs', prefs: s.prefs }).catch(() => { s.prefs[key] = !s.prefs[key]; render(); });
      return;
    }
    if (e.metaKey || e.ctrlKey || e.shiftKey) return;
    // Opening an item marks it read.
    const openId = el.getAttribute('data-open');
    if (openId && !s.read[openId]) post({ action: 'read', id: openId, read: true }).catch(() => {});
    const href = el.getAttribute('href') || '';
    if (!href.startsWith('#') && !href.startsWith('http')) show();
  });

  render();
})();
</script>
<script is:inline>
  if (matchMedia('(max-width:700px)').matches) document.querySelectorAll('[data-fold]').forEach(function (d) { d.open = false; });
</script>
</body>
</html>
