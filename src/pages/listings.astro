---
export const prerender =
  false;
import AppNav from
  './_nav.astro';
import {
  getAccount,
} from
  '../lib/account';
import {
  getSession,
} from '../lib/auth';
import {
  supabase,
} from '../lib/supabase';
const sess =
  await getSession(
    Astro.request,
  );
// Browsing sits is for
// sitters: owners manage
// their own sits from
// their dashboard.
const acct =
  await getAccount(
    Astro.request,
  );
if (
  acct?.side === 'owner'
) {
  return Astro.redirect(
    '/owner/dashboard',
  );
}
const qr =
  await supabase
  .from('listings')
  .select(
    'id, title,' +
    ' description,' +
    ' date_from,' +
    ' date_to,' +
    ' profiles!inner(' +
    'name, location,' +
    ' slug,' +
    ' profile_pic,' +
    ' pets_json,' +
    ' gallery_json,' +
    ' reviews_json,' +
    ' hero_images_json)'
  )
  .eq('status', 'active')
  .gte(
    'date_to',
    new Date()
    .toISOString()
    .slice(0, 10),
  )
  .order(
    'date_from',
    { ascending: true },
  );
const rawListings =
  qr.data;
function daysBetween(
  from: string,
  to: string,
) {
  const a =
    new Date(
      to + 'T00:00:00'
    ).getTime();
  const b =
    new Date(
      from + 'T00:00:00'
    ).getTime();
  const ms = a - b;
  return Math.ceil(
    ms / 86400000,
  );
}
function fmtDate(
  d: string,
) {
  const opts = {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  } as const;
  return new Date(
    d + 'T00:00:00'
  ).toLocaleDateString(
    'en-GB', opts,
  );
}
// Card details in the Airbnb style (round 3): photos, pets, short dates.
function cardBits(l: any, lp: any, pets: any[], hero: any[], days: number) {
  const gal = Array.isArray(lp?.gallery_json) ? lp.gallery_json : [];
  const photos = [...hero, ...gal].map((x: any) => String(x?.src || '').replace(/^public\//, '/')).filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).slice(0, 5);
  const names = pets.map((p: any) => p?.name).filter(Boolean);
  const kinds: Record<string, number> = {};
  pets.forEach((p: any) => { const t = String(p?.type || 'pet').toLowerCase(); kinds[t] = (kinds[t] || 0) + 1; });
  const count = Object.entries(kinds).map(([t, n]) => n + ' ' + (n === 1 ? t : t === 'puppy' ? 'puppies' : t + 's')).join(', ');
  const petLine = [names.length ? (names.length > 1 ? names.slice(0, -1).join(', ') + ' & ' + names[names.length - 1] : names[0]) : '', count].filter(Boolean).join(' · ');
  const a = new Date(l.date_from + 'T00:00:00'), b = new Date(l.date_to + 'T00:00:00');
  const sameMonth = a.getMonth() === b.getMonth() && a.getFullYear() === b.getFullYear();
  const short = sameMonth
    ? a.getDate() + '–' + b.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })
    : a.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) + ' – ' + b.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
  const until = Math.ceil((a.getTime() - Date.now()) / 86400000);
  const revs = Array.isArray(lp?.reviews_json) ? lp.reviews_json.filter((r: any) => r && r.text).length : 0;
  return {
    photos, petLine, short,
    nights: days + (days === 1 ? ' night' : ' nights'),
    badge: until <= 14 ? 'Starts soon' : days >= 21 ? 'Long stay' : '',
    rating: revs ? '5.0 (' + revs + ')' : '',
  };
}
const listings =
  (rawListings ?? [])
  .map((l: any) => {
    const lp = l.profiles;
    const pj =
      lp?.pets_json;
    const hj =
      lp?.hero_images_json;
    const pets: any[] =
      Array.isArray(pj)
      ? pj : [];
    const hero: any[] =
      Array.isArray(hj)
      ? hj : [];
    const days =
      daysBetween(
        l.date_from,
        l.date_to,
      );
    const pStr =
      pets.map(
        (p: any) =>
        p.name +
        (p.type
          ? ' (' +
            p.type + ')'
          : '')
      ).join(', ');
    const pTypes =
      pets.map(
        (p: any) =>
        (p.type || '')
        .toLowerCase()
      );
    const hi =
      hero.length > 0
      ? hero[0].src
      : '';
    const dur =
      days +
      (days === 1
        ? ' day'
        : ' days');
    return {
      id: l.id,
      title: l.title,
      description:
        l.description
        || '',
      owner:
        lp?.name || '',
      location:
        lp?.location
        || '',
      slug:
        lp?.slug || '',
      pic:
        lp?.profile_pic
        || '',
      heroImg: hi,
      pets: pStr,
      petTypes: pTypes,
      dates:
        fmtDate(
          l.date_from,
        ) + ' — ' +
        fmtDate(
          l.date_to,
        ),
      dateFrom:
        l.date_from,
      days,
      duration: dur,
      ...cardBits(l, lp, pets, hero, days),
    };
  });
// Saved sits for the heart on each card.
let savedIds: string[] = [];
if (acct?.profile?.id) {
  try {
    const sv = await supabase.from('saved_sits').select('listing_id').eq('profile_id', acct.profile.id);
    savedIds = (sv.data ?? []).map((r: any) => r.listing_id);
  } catch {}
}
const canSave = !!acct?.profile;
