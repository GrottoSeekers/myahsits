            <li style="margin-bottom:12px"><a href="/listings" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;transition:color .2s">Browse sits</a></li>
          </ul>
        </div>
        <div>
          <h4 style="color:#fff;font-size:.76rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin:0 0 20px;padding-bottom:14px;border-bottom:1px solid rgba(196,171,138,.28)">Example profile</h4>
          <ul style="list-style:none;padding:0;margin:0">
            <li style="margin-bottom:12px"><a href="/callumandniamh" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;transition:color .2s">Callum &amp; Niamh</a></li>
          </ul>
        </div>
      </div>
      <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:28px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
        <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.45)">
          <span>&copy; 2026 MYAH</span>
          <span style="width:4px;height:4px;border-radius:50%;background:rgba(196,171,138,.5);display:block"></span>
          <a href="/privacy" style="color:rgba(255,255,255,.45);text-decoration:none;transition:color .2s">Privacy</a>
          <span style="width:4px;height:4px;border-radius:50%;background:rgba(196,171,138,.5);display:block"></span>
          <a href="/terms" style="color:rgba(255,255,255,.45);text-decoration:none;transition:color .2s">Terms</a>
        </div>
        <span style="display:flex;align-items:center;gap:9px;font-size:.82rem;color:rgba(255,255,255,.55);font-style:italic">Made with <span style="font-style:normal">&#9825;</span><!-- the design file has a mangled entity here (&#2f7d4f;), shown as the heart Home uses --> for house &amp; pet sitters everywhere</span>
      </div>
    </div>
  </footer>
</div>

<style is:global>
  input:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }
  select:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }
  .sit-card:hover { transform:translateY(-6px); box-shadow:0 20px 50px rgba(44,26,14,.1) !important; border-color:rgba(110,84,56,.45) !important; }
  #filter-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
  #emptyState:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
  #nav-getstarted:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px); box-shadow:0 12px 28px rgba(110,84,56,.36); }
  #nav-getstarted:active { transform:translateY(0) scale(.98); }
  #footer-signup:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px); box-shadow:0 12px 28px rgba(110,84,56,.36); }
  #footer-signup:active { transform:translateY(0) scale(.98); }
  footer a:hover { color:#c4ab8a !important; }
</style>

<script is:inline src="/sitcard.js"></script>
<script define:vars={{ listings, savedIds, canSave }}>
  const ALL = listings;
  let state = { q: '', place: 'all', pet: 'all', len: 'any', sort: 'soonest' };

  const grid = document.getElementById('grid');
  const empty = document.getElementById('emptyState');
  const countLabel = document.getElementById('countLabel');

  const SAVED = new Set(savedIds);
  function chipStyle(on) {
    return on
      ? 'font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.06em;padding:9px 18px;border-radius:50px;cursor:pointer;transition:background .2s, color .2s, border-color .2s;background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;'
      : 'font-family:\'Montserrat\',sans-serif;font-size:.78rem;font-weight:700;letter-spacing:.06em;padding:9px 18px;border-radius:50px;cursor:pointer;transition:background .2s, color .2s, border-color .2s;background:#fff;color:#5c3d20;border:1.5px solid rgba(110,84,56,.35);';
  }

  function render() {
    const { q, place, pet, len, sort } = state;
    const needle = q.trim().toLowerCase();
    let rows = ALL.filter(s => {
      if (needle && !(s.title + ' ' + s.owner + ' ' + s.pets + ' ' + s.location + ' ' + s.description).toLowerCase().includes(needle)) return false;
      if (place !== 'all') {
        const loc = (s.location || '').toLowerCase();
        if (place === 'UK' && !loc.includes('uk') && !loc.includes('england') && !loc.includes('scotland') && !loc.includes('wales') && !loc.includes('bath') && !loc.includes('edinburgh') && !loc.includes('london') && !loc.includes('manchester') && !loc.includes('peak')) return false;
        if (place === 'AU' && !loc.includes('au') && !loc.includes('australia') && !loc.includes('sydney') && !loc.includes('byron') && !loc.includes('bondi')) return false;
      }
      if (pet !== 'all') {
        const types = (s.petTypes || []).join(' ');
        if (!types.includes(pet)) return false;
      }
      if (len === 'week' && s.days > 7) return false;
      if (len === 'fortnight' && (s.days <= 7 || s.days > 14)) return false;
      if (len === 'long' && s.days <= 14) return false;
      return true;
    });

    if (sort === 'longest') rows = [...rows].sort((a, b) => b.days - a.days);
    else if (sort === 'shortest') rows = [...rows].sort((a, b) => a.days - b.days);

    if (countLabel) {
      countLabel.textContent = rows.length === ALL.length
        ? ALL.length + (ALL.length === 1 ? ' sit' : ' sits') + ' available'
        : rows.length + ' of ' + ALL.length + ' sits';
    }

    if (!grid || !empty) return;
    if (rows.length === 0) {
      grid.style.display = 'none';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    grid.style.display = 'grid';
    grid.innerHTML = rows.map((sit, i) => window.sitCard(Object.assign({ canSave }, sit), SAVED.has(sit.id), i)).join('');
    window.sitCardWire(grid);
  }
  document.addEventListener('sitcard:saved', (e) => { if (e.detail.on) SAVED.add(e.detail.id); else SAVED.delete(e.detail.id); });

  document.querySelectorAll('.len-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      state.len = btn.dataset.len;
      document.querySelectorAll('.len-chip').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.len === state.len)));
      render();
    });
  });

  document.getElementById('q')?.addEventListener('input', e => { state.q = (e.target).value; render(); });
  document.getElementById('place')?.addEventListener('change', e => { state.place = (e.target).value; render(); });
  document.getElementById('pet')?.addEventListener('change', e => { state.pet = (e.target).value; render(); });
  document.getElementById('sort')?.addEventListener('change', e => { state.sort = (e.target).value; render(); });
  document.getElementById('clearBtn')?.addEventListener('click', () => {
    state = { q: '', place: 'all', pet: 'all', len: 'any', sort: 'soonest' };
    (document.getElementById('q')).value = '';
    (document.getElementById('place')).value = 'all';
    (document.getElementById('pet')).value = 'all';
    (document.getElementById('sort')).value = 'soonest';
    document.querySelectorAll('.len-chip').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.len === 'any')));
    render();
  });

  const loader = document.querySelector('[data-loader]');
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel')) return;
    a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (loader) { loader.style.opacity = '1'; loader.style.pointerEvents = 'all'; }
    });
  });
  window.addEventListener('pageshow', e => {
    if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
  });

  render();
</script>
</body>
</html>
