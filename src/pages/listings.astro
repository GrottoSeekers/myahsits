      )}
    </nav>
  </header>
)}

  <main data-page-pad="1" class="bs-main">
    <div class="bs-wrap">
      <div class="bs-head">
        <p class="bs-eye">Available sits</p>
        <h1>Find your <em>next sit</em></h1>
      </div>

