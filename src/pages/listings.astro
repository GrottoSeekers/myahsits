<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Browse Sits — MYAH</title>
  <link rel="canonical" href={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:url" content={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:site_name" content="MYAH" />
  <style>
    body { margin:0; background:#faf6ee; color:#2c1a0e; font-family:"Montserrat",sans-serif; }
    * { box-sizing:border-box; }
    a { color:#2f5d45; }
    a:hover { color:#2c1a0e; }
    input::placeholder { color:rgba(44,26,14,.35); }
    select { color:#2c1a0e; }
    @keyframes gs-ring { to { transform:rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
    @media (max-width:1000px) {
      [data-header-nav] { display:none !important; }
      [data-page-pad] { padding-left:24px !important; padding-right:24px !important; }
      [data-topbar] { padding: 16px 24px !important; }
    }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <link rel="stylesheet" href="/sitcard.css" />
  <style is:global>
    .bs-main { flex:1; padding:44px 48px 100px; }
    .bs-wrap { max-width:1240px; margin:0 auto; }
    .bs-head { text-align:center; margin:0 0 26px; }
    .bs-eye { font:700 .7rem 'Lato',sans-serif; letter-spacing:.2em; text-transform:uppercase; color:#6e5438; margin:0 0 10px; }
    .bs-head h1 { font:400 2.6rem/1.1 'Marcellus',serif; margin:0; }
    .bs-head h1 em { font-style:italic; color:#2f5d45; }
    .bs-search { position:sticky; top:72px; z-index:40; max-width:880px; margin:0 auto 22px; display:flex; align-items:center; background:#fff; border:1px solid rgba(110,84,56,.2); border-radius:50px; padding:6px 6px 6px 10px; box-shadow:0 10px 30px rgba(44,26,14,.1); }
    .bs-seg { flex:1; min-width:0; display:flex; flex-direction:column; gap:2px; padding:8px 18px; border-radius:50px; cursor:pointer; transition:background .2s; position:relative; }
    .bs-seg + .bs-seg::before { content:""; position:absolute; left:0; top:22%; bottom:22%; width:1px; background:rgba(110,84,56,.2); }
    .bs-seg:hover { background:#f6f0e6; }
    .bs-seg span { font-size:.68rem; font-weight:700; letter-spacing:.06em; color:#2c1a0e; }
    .bs-seg input, .bs-seg select { border:0 !important; outline:none; background:transparent; padding:0; font:400 .88rem 'Montserrat',sans-serif; color:#6b4e35; width:100%; appearance:none; -webkit-appearance:none; cursor:pointer; box-shadow:none !important; }
    .bs-q { flex:1.4; }
    .bs-go { flex:none; width:46px; height:46px; border-radius:50%; background:#2f5d45; color:#fff; display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(47,93,69,.35); }
    .bs-cats { display:flex; align-items:center; gap:8px; overflow-x:auto; scrollbar-width:none; padding:6px 0 18px; margin:0 0 26px; border-bottom:1px solid rgba(110,84,56,.16); }
    .bs-cats::-webkit-scrollbar { display:none; }
    .bs-cats .len-chip { flex:none; display:flex; flex-direction:column; align-items:center; gap:6px; padding:8px 14px 10px; border:0; border-bottom:2px solid transparent; background:none; font:600 .72rem 'Montserrat',sans-serif; color:#8a6a4f; cursor:pointer; transition:color .2s, border-color .2s; }
    .bs-cats .len-chip svg { width:24px; height:24px; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; }
    .bs-cats .len-chip:hover { color:#2c1a0e; border-bottom-color:rgba(110,84,56,.3); }
    .bs-cats .len-chip[aria-pressed="true"] { color:#2c1a0e; border-bottom-color:#2c1a0e; }
    .bs-count { margin-left:auto; flex:none; font-size:.76rem; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:#6b4e35; }
    .bs-clear { flex:none; background:#fff; border:1px solid rgba(110,84,56,.3); border-radius:50px; padding:9px 16px; font:600 .72rem 'Montserrat',sans-serif; color:#2f5d45; cursor:pointer; }
    .bs-empty { background:#fff; border:1px solid rgba(110,84,56,.22); border-radius:18px; padding:60px 32px; text-align:center; max-width:520px; margin:0 auto; }
    .bs-empty > span { width:56px; height:56px; border-radius:16px; background:#faf6ee; color:#6e5438; display:inline-flex; align-items:center; justify-content:center; margin-bottom:16px; }
    .bs-empty h2 { font:400 1.5rem 'Marcellus',serif; margin:0 0 10px; }
    .bs-empty p { margin:0; color:#6b4e35; line-height:1.7; }
    @media (max-width:760px) {
      .bs-main { padding:18px 16px 70px !important; }
      .bs-head { text-align:left; margin-bottom:16px; }
      .bs-head h1 { font-size:1.9rem; }
      .bs-search { top:84px; flex-wrap:wrap; border-radius:22px; padding:6px; }
      .bs-q { flex:1 1 calc(100% - 56px); }
      .bs-seg { padding:7px 12px; }
      .bs-seg:not(.bs-q) { flex:1 1 30%; }
      .bs-seg:nth-child(2)::before { display:none; }
      .bs-go { width:42px; height:42px; order:1; }
      .bs-q { order:0; }
      .bs-seg:not(.bs-q) { order:2; }
      .bs-count { display:none; }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
