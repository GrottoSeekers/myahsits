---
// Data: the `sits` row
// (listing, sitter,
// conversation and
// checklist), its
// listing (dates,
// arrival, keys,
// handover_json) and
// the owner's profile
// (location, pets).
// Checklist ticks save
// to /api/sits/checklist.
export const prerender =
  false;
import PrivateNote from
  './_private.astro';
import AppNav from
  '../_nav.astro';
import {
  getAccount,
} from
  '../../lib/account';
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';
import {
  arr,
} from
  '../../lib/dashboard';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
const { id } =
  Astro.params;

let sit: any = null;
try {
  const r =
    await supabase
    .from('sits')
    .select(
      '*, listings!inner(' +
      '*, profiles!inner(*))',
    )
    .eq('id', id)
    .single();
  sit = r.data;
} catch {}

const listing: any =
  sit?.listings || null;
const owner: any =
  listing?.profiles ||
  null;
const isOwner =
  owner?.user_id ===
  session.userId;
const isSitter =
  sit?.sitter_user_id ===
  session.userId;
const dashUrl = isOwner
  ? '/owner/dashboard'
  : '/dashboard';
if (
  !sit ||
  !listing ||
  (!isOwner && !isSitter)
) {
  return Astro.redirect(
    dashUrl,
  );
}

let sitter: any = null;
try {
  const q = supabase
    .from('profiles')
    .select('*');
  const r =
    sit.sitter_profile_id
      ? await q
        .eq(
          'id',
          sit
            .sitter_profile_id,
        )
        .single()
      : await q
        .eq(
          'user_id',
          sit.sitter_user_id,
        )
        .single();
  sitter = r.data;
} catch {}

let sitterSits = 0;
try {
  const c =
    await supabase
    .from('sits')
    .select('id', {
      count: 'exact',
      head: true,
    })
    .eq(
      'sitter_user_id',
      sit.sitter_user_id,
    );
  sitterSits =
    c.count ?? 0;
} catch {}

// ── Formatting
const D = (s: string) =>
  new Date(
    s + 'T00:00:00Z',
  );
const fmtLong = (
  s: string,
) =>
  s
    ? D(s)
      .toLocaleDateString(
        'en-GB',
        {
          weekday: 'short',
          day: 'numeric',
          month: 'short',
          timeZone: 'UTC',
        },
      )
      .replace(',', '')
    : '';
const yr = (s: string) =>
  s ? s.slice(0, 4) : '';
const from: string =
  listing.date_from || '';
const to: string =
  listing.date_to || '';
const nights =
  from && to
    ? Math.round(
      (+D(to) - +D(from)) /
        86400000,
    )
    : 0;
const todayKey =
  new Date()
  .toISOString()
  .slice(0, 10);
const started =
  !!from &&
  todayKey >= from;
const countTo = started
  ? to
  : from;
const daysLeft = countTo
  ? Math.max(
    0,
    Math.round(
      (+D(countTo) -
        +D(todayKey)) /
        86400000,
    ),
  )
  : 0;
const countLabel = started
  ? 'days left'
  : 'days to go';

// ── Names
const ownerName: string =
  owner.name || 'Owner';
const ownerFirst =
  ownerName.split(' ')[0];
const sitterName: string =
  sitter?.name ||
  'Your sitter';
const ownerLoc: string =
  owner.location || '';
// Handover: the owner's
// profile details (set
// on Edit owner profile),
// overridden by anything
// on the listing itself.
const lh: any =
  listing.handover_json ||
  {};
const ph: any =
  owner.handover_json ||
  {};
const split = (
  v: string,
) => {
  const [first, ...rest] =
    String(v || '')
      .split(' · ');
  return {
    value: first.trim(),
    note: rest
      .join(' · ')
      .trim(),
  };
};
const phNotes = [
  ph.wifiName
    ? {
      label: 'Wifi',
      value: [
        ph.wifiName,
        ph.wifiPass,
      ]
        .filter(Boolean)
        .join(' · '),
    }
    : null,
  ph.access
    ? {
      label: 'Parking',
      value: ph.access,
    }
    : null,
  ...arr(ph.notes),
].filter(Boolean);
const phHelp = [
  ['Vet', ph.vet],
  [
    'Out of hours vet',
    ph.vetOoh,
  ],
  [
    'Neighbour',
    ph.neighbour,
  ],
]
  .filter(([, v]) => v)
  .map(([label, v]) => ({
    label,
    ...split(v),
  }));
const lhNotes = arr(
  lh.house_notes,
);
const lhHelp = arr(
  lh.emergency,
);
const hand: any = {
  ...lh,
  address:
    lh.address ||
    ph.address ||
    '',
  house_notes:
    lhNotes.length
      ? lhNotes
      : phNotes,
  emergency:
    lhHelp.length
      ? lhHelp
      : phHelp,
};

// Private details: the
// owner always; the
// sitter from the day
// before (or once the
// owner shares them).
const unlockAt =
  D(listing.date_from)
  .getTime() -
  86400000;
const releasedEarly =
  !!(
    sit.checklist_json ||
    {}
  )._released;
const sitterCanSee =
  releasedEarly ||
  Date.now() >= unlockAt;
const unlocked =
  isOwner ||
  sitterCanSee;
const unlockLabel =
  new Date(unlockAt)
  .toLocaleDateString(
    'en-GB',
    {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    },
  );
if (!unlocked) {
  hand.address = '';
  hand.address_note =
    'Full address on ' +
    unlockLabel;
  hand.house_notes = [];
  hand.emergency = arr(
    hand.emergency,
  ).filter((e: any) =>
    /vet/i.test(
      e?.label || '',
    ),
  );
}
const keysText =
  unlocked
    ? listing.keys || ''
    : listing.keys
      ? 'On ' + unlockLabel
      : '';

// ── Hero. Format, as
// in the design:
/*
Sun 4 Oct – Sun 18 Oct 2026 · 14 days · Thomas James & Callum and Niamh
*/
const heroTitle: string =
  listing.title || '';
const heroWhere =
  ownerLoc;
const heroSep =
  heroWhere ? ', ' : '';
const dayWord =
  nights === 1
    ? ' day'
    : ' days';
const heroLine = [
  fmtLong(from) +
    ' – ' +
    fmtLong(to) +
    ' ' +
    yr(to),
  nights + dayWord,
  ownerName +
    ' & ' +
    sitterName,
].join(' · ');

// ── 01 The basics
const named = (
  s: string,
) =>
  s
    .trim()
    .replace(
      'Thomas',
      ownerFirst,
    );
const basicsNote = named(`
Dates, arrival and keys from the listing · address from Thomas’s profile
`);
const pets = arr(
  owner.pets_json,
);
const petNames = pets
  .map((p: any) => p.name)
  .filter(Boolean);
const petKinds = [
  ...new Set(
    pets
      .map(
        (p: any) =>
          p.breed || p.type,
      )
      .filter(Boolean),
  ),
];
const nightWord =
  nights === 1
    ? ' night'
    : ' nights';
const factRows = [
  {
    label: 'Dates',
    value: from
      ? fmtLong(from) +
        ' — ' +
        fmtLong(to) +
        ' ' + yr(to)
      : '',
    note: nights
      ? nights + nightWord
      : '',
  },
  {
    label: 'Arrival',
    value:
      listing.arrival ||
      '',
    note: '',
  },
  {
    label: 'Address',
    value:
      hand.address ||
      ownerLoc,
    note:
      hand.address_note ||
      '',
  },
  {
    label: 'Keys',
    value: keysText,
    note: listing.keys
      ? 'Set on the listing'
      : '',
  },
  {
    label: 'Pets',
    value: petNames.length
      ? petNames.join(
        ' & ',
      ) +
        (petKinds.length
          ? ' — ' +
            petKinds.join(
              ', ',
            )
          : '')
      : '',
    note: '',
  },
  {
    label:
      'Owner away in',
    value:
      hand.owner_away ||
      '',
    note:
      hand.owner_away_note
      || '',
  },
];
const facts = factRows
  .filter((f) => f.value)
  .map(f => ({ ...f, noteStyle: 'font-size:.86rem;color:#6b4e35;line-height:1.6;margin:5px 0 0;' + (f.note ? '' : 'display:none;') }));

// ── 02 Care routine
const careNote = named(`
Pets and their routines from Thomas’s profile
`);
const petCards = pets.map(
  (p: any) => {
    const meta = [
      p.breed || p.type,
      p.age,
      p.temperament,
    ]
      .filter(Boolean)
      .join(' · ');
    const lines = arr(
      p.routine,
    ).filter(
      (l: any) =>
        l && l.what,
    );
    const warn =
      p.special_needs ||
      '';
    return {
      name: p.name || '',
      photo:
        p.photo_url ||
        '/images/solomon-1.jpg',
      meta,
      lines,
      warn,
      warnStyle:
        'font-size:.88rem;color:#b91c1c;font-weight:600;line-height:1.65;margin:14px 0 0;' +
        (warn
          ? ''
          : 'display:none;'),
    };
  },
);

// ── 03 The house
const houseNote = named(`
House notes from Thomas’s handover details
`);
const houseNotes = arr(
  hand.house_notes,
).filter(
  (n: any) =>
    n && n.label &&
    n.value,
);

// ── 04 Emergencies
const helpNote = named(`
Vet, neighbour and contact numbers from Thomas’s handover details
`);
const ownerReach = (
  unlocked ? [
    ph.mobile,
    owner.whatsapp_number,
    owner.contact_email,
  ] : []
)
  .filter(Boolean)
  .join(' · ');
const emergency = [
  ...arr(
    hand.emergency,
  ).filter(
    (e: any) =>
      e && e.label &&
      e.value,
  ),
  {
    label: 'Owner',
    value: ownerName,
    note: ownerReach,
  },
];

// ── Aside
const CHECKS = [
  'Handover call booked',
  'Arrival time agreed',
  'Keys arranged',
  'Vet details confirmed',
  'Wifi password shared',
  'Emergency contact swapped'
];
const doneRaw: any =
  sit.checklist_json ||
  {};
const done: Record<
  string,
  boolean
> = {};
CHECKS.forEach((_, i) => {
  if (doneRaw[i]) {
    done[i] = true;
  }
});

const sitWord =
  sitter?.account_type ===
  'joint'
    ? 'Sitters'
    : 'Sitter';
const people = [
  {
    name: ownerName,
    role: ownerLoc
      ? 'Owner · ' +
        ownerLoc
      : 'Owner',
    photo:
      owner.profile_pic ||
      '/images/' +
        'couple-dinner-1.jpg',
  },
  {
    name: sitterName,
    role: sitterSits
      ? sitWord +
        ' · ' +
        sitterSits +
        (sitterSits === 1
          ? ' sit'
          : ' sits')
      : sitWord,
    photo:
      sitter?.profile_pic ||
      '/images/couple-bw-1.jpg',
  },
];

const msgUrl =
  sit.conversation_id
    ? '/messages?c=' +
      sit.conversation_id
    : '/messages';
// Owner reviews the
// sitter on their page;
// sitter asks for one
// from the dashboard.
const reviewUrl =
  isOwner && sitter?.slug
    ? '/' + sitter.slug
    : '/dashboard';
const sitId = sit.id;
const navAcct =
  await getAccount(
    Astro.request,
  );
const navSide =
  navAcct?.side ||
  'sitter';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Confirmed sit — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 1000px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 34px 20px 80px !important; }
      [data-two-col] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
      [data-card] { padding: 26px 22px !important; }
      [data-facts] { grid-template-columns: minmax(0,1fr) !important; }
      [data-pet] { grid-template-columns: minmax(0,1fr) !important; }
    }
    @media print {
      [data-topnav], [data-noprint] { display: none !important; }
      body { background: #fff; }
    }

    .cs-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .cs-msgs:hover { color:#2c1a0e !important; }
    .cs-review:hover { color:#2f5d45 !important; }
    .cs-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .cs-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .cs-print:hover { background:rgba(110,84,56,.1) !important; border-color:#2f5d45 !important; }
    .cs-cancel:hover { color:#2c1a0e !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <style is:global>
    /* Sit pack as tabs, one part at a time (round 3: less scrolling) */
    .cs-tabs { display:flex; gap:8px; overflow-x:auto; scrollbar-width:none; padding:2px; margin-bottom:-8px; }
    .cs-tabs::-webkit-scrollbar { display:none; }
    .cs-tabs button { flex:none; border:1px solid rgba(110,84,56,.28); background:#fff; border-radius:50px; padding:11px 18px; font:600 .78rem 'Montserrat',sans-serif; color:#5c3d20; cursor:pointer; transition:background .2s, color .2s, border-color .2s; }
    .cs-tabs button small { font-size:.7rem; color:#2f5d45; margin-left:4px; }
    .cs-tabs button[aria-selected="true"] { background:#2f5d45; border-color:#2f5d45; color:#fff; }
    .cs-tabs button[aria-selected="true"] small { color:#dcebdf; }
    .cs-tabs button.sos { color:#a4442e; border-color:rgba(164,68,46,.3); }
    .cs-tabs button.sos[aria-selected="true"] { background:#a4442e; border-color:#a4442e; color:#fff; }
    [data-pane] { animation:cs-in .35s ease both; }
    [data-pane][hidden] { display:none !important; }
    @keyframes cs-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
    @media (max-width:700px) {
      [data-pad] { padding:16px 14px 60px !important; }
      .cs-hero { padding:22px 20px !important; gap:14px !important; }
      .cs-hero h1 { font-size:1.6rem !important; }
      .cs-hero > div:last-child { text-align:left !important; display:flex; align-items:baseline; gap:10px; }
      .cs-hero > div:last-child p:first-child { font-size:2.2rem !important; }
      [data-card] { padding:20px 18px !important; }
      [data-pet] { grid-template-columns:64px minmax(0,1fr) !important; gap:14px !important; padding:16px !important; }
      [data-pet] img { width:56px !important; height:56px !important; }
      [data-pet] span[style*="width:82px"] { width:64px !important; }
      [data-facts] { grid-template-columns:minmax(0,1fr) minmax(0,1fr) !important; gap:14px 16px !important; }
      [data-facts] p { font-size:.9rem !important; }
      [data-private-note] { padding:14px 16px !important; gap:12px !important; margin-bottom:16px !important; }
      [data-private-note] p { font-size:.84rem !important; line-height:1.55 !important; }
      [data-private-note] > span:first-child { display:none !important; }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={navSide} active="sits" />

  <main data-pad="1" data-screen-label="Confirmed sit" style="flex:1;padding:52px 48px 90px">
    <div style="max-width:1120px;margin:0 auto">

      <div class="cs-hero" style="background:linear-gradient(135deg,#fff 0%,#fbf7f0 55%,#f3ece0 100%);border:1px solid rgba(110,84,56,.2);border-radius:22px;padding:34px 38px;margin-bottom:22px;display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;box-shadow:0 14px 40px rgba(44,26,14,.07);position:relative;overflow:hidden">
        <div style="min-width:0">
          <p style="font-size:.72rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Confirmed sit</p>
          <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;line-height:1.15;margin:0 0 12px">{heroTitle}{heroSep}
            {heroWhere && (
              <em style="color:#2f5d45;font-style:italic">{heroWhere}</em>
            )}</h1>
          <p style="font-size:1rem;color:#6b4e35;line-height:1.7;margin:0">{heroLine}</p>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <p style="font-family:'Marcellus',serif;font-size:3.4rem;color:#2f5d45;margin:0;line-height:1">{daysLeft}</p>
          <p style="font-size:.74rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:6px 0 0">{countLabel}</p>
        </div>
      </div>

      <PrivateNote isOwner={isOwner} unlocked={sitterCanSee} releasedEarly={releasedEarly} unlockLabel={unlockLabel} ownerFirst={ownerFirst} sitterFirst={sitterName.split(' ')[0]} sitId={sitId} />

      <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:26px;align-items:start">

        <div style="display:flex;flex-direction:column;gap:24px">

          <div class="cs-tabs" role="tablist" aria-label="Sit pack">
            <button type="button" role="tab" data-pack="basics" aria-selected="true">The basics</button>
            {petCards.length > 0 && <button type="button" role="tab" data-pack="pets" aria-selected="false">Pets <small>{petCards.length}</small></button>}
            {houseNotes.length > 0 && <button type="button" role="tab" data-pack="home" aria-selected="false">House notes</button>}
            <button type="button" role="tab" data-pack="help" aria-selected="false" class="sos">If something goes wrong</button>
          </div>
          <section data-card="1" data-pane="basics" class="cs-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:34px 36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px"><span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">01</span><h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">The basics</h2></div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 26px"></div>
            <p style="font-size:.82rem;color:#8a6a4f;line-height:1.6;margin:-18px 0 24px">{basicsNote}</p>
            <div data-facts="1" style="display:grid;grid-template-columns:1fr 1fr;gap:22px 30px">
              {facts.map((f) => (
                <div>
                  <p style="font-size:.72rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:#2f5d45;margin:0 0 7px">{f.label}</p>
                  <p style="font-size:.98rem;color:#2c1a0e;line-height:1.6;margin:0">{f.value}</p>
                  <p style={f.noteStyle}>{f.note}</p>
                </div>
              ))}
            </div>
          </section>

          {petCards.length > 0 && (
            <section data-card="1" data-pane="pets" hidden class="cs-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:34px 36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px"><span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">02</span><h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Care routine</h2></div>
              <div style="width:40px;height:2px;background:#6e5438;margin:0 0 26px"></div>
              <p style="font-size:.82rem;color:#8a6a4f;line-height:1.6;margin:-18px 0 24px">{careNote}</p>
              <div style="display:flex;flex-direction:column;gap:18px">
                {petCards.map((p) => (
                  <div data-pet="1" style="display:grid;grid-template-columns:96px minmax(0,1fr);gap:20px;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:14px;padding:22px 24px">
                    <div style="display:flex;flex-direction:column;align-items:center;gap:10px">
                      <img src={p.photo} alt="" style="width:76px;height:76px;border-radius:50%;object-fit:cover;border:2px solid rgba(110,84,56,.35)" />
                      <p style="font-family:'Marcellus',serif;font-size:1.05rem;color:#2c1a0e;margin:0;text-align:center">{p.name}</p>
                    </div>
                    <div style="min-width:0">
                      <p style="font-size:.8rem;color:#2f5d45;font-weight:600;margin:0 0 14px">{p.meta}</p>
                      <div style="display:flex;flex-direction:column;gap:10px">
                        {p.lines.map((l: any) => (
                          <div style="display:flex;gap:14px;align-items:baseline">
                            <span style="font-size:.76rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#8a6a4f;width:82px;flex-shrink:0">{l.when}</span>
                            <span style="font-size:.93rem;color:#6b4e35;line-height:1.65">{l.what}</span>
                          </div>
                        ))}
                      </div>
                      <p style={p.warnStyle}>{p.warn}</p>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {houseNotes.length > 0 && (
            <section data-card="1" data-pane="home" hidden class="cs-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:34px 36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px"><span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">03</span><h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">The house</h2></div>
              <div style="width:40px;height:2px;background:#6e5438;margin:0 0 26px"></div>
              <p style="font-size:.82rem;color:#8a6a4f;line-height:1.6;margin:-18px 0 24px">{houseNote}</p>
              <div style="display:flex;flex-direction:column;gap:14px">
                {houseNotes.map((n) => (
                  <div style="display:flex;gap:14px;align-items:baseline;padding-bottom:14px;border-bottom:1px solid rgba(44,26,14,.07)">
                    <span style="font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;width:110px;flex-shrink:0">{n.label}</span>
                    <span style="font-size:.95rem;color:#6b4e35;line-height:1.7">{n.value}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          <section data-card="1" data-pane="help" hidden style="background:#fff;border:1px solid rgba(185,28,28,.22);border-radius:18px;padding:34px 36px;box-shadow:0 1px 2px rgba(44,26,14,.04)">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px"><span style="font-family:'Marcellus',serif;font-size:.92rem;color:#b91c1c;letter-spacing:.08em">04</span><h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">If something goes wrong</h2></div>
            <div style="width:40px;height:2px;background:#b91c1c;margin:0 0 26px"></div>
            <p style="font-size:.82rem;color:#8a6a4f;line-height:1.6;margin:-18px 0 24px">{helpNote}</p>
            <div data-facts="1" style="display:grid;grid-template-columns:1fr 1fr;gap:20px 30px">
              {emergency.map((e) => (
                <div>
                  <p style="font-size:.72rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:#b91c1c;margin:0 0 7px">{e.label}</p>
                  <p style="font-size:.98rem;color:#2c1a0e;line-height:1.6;margin:0 0 3px">{e.value}</p>
                  <p style="font-size:.86rem;color:#6b4e35;line-height:1.6;margin:0">{e.note}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <aside data-aside="1" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:20px">
          <div class="cs-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px 26px 28px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:6px">
              <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0">Before the handover</p>
              <span data-check-count style="font-size:.78rem;color:#6b4e35"></span>
            </div>
            <div style="height:6px;border-radius:50px;background:rgba(44,26,14,.08);overflow:hidden;margin:12px 0 20px">
              <div data-check-bar></div>
            </div>
            <div data-checklist style="display:flex;flex-direction:column;gap:11px"></div>
          </div>

          <div data-noprint="1" style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:24px 26px">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 16px">Both of you</p>
            <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:20px">
              {people.map((p) => (
                <div style="display:flex;gap:13px;align-items:center">
                  <img src={p.photo} alt="" style="width:44px;height:44px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.35)" />
                  <div style="min-width:0">
                    <p style="font-size:.95rem;font-weight:600;color:#2c1a0e;margin:0 0 2px">{p.name}</p>
                    <p style="font-size:.8rem;color:#6b4e35;margin:0">{p.role}</p>
                  </div>
                </div>
              ))}
            </div>
            <a href={msgUrl} class="cs-btn" style="display:flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:11px 22px;text-decoration:none;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease">Message</a>
            <button type="button" data-print class="cs-print" style="width:100%;margin-top:10px;font-family:'Montserrat',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:14px 20px;cursor:pointer;transition:background .25s ease, border-color .25s ease">Print this pack</button>
          </div>

          <div data-noprint="1" style="background:#fff;border:1px solid rgba(44,26,14,.1);border-radius:18px;padding:22px 24px">
            <p style="font-size:.86rem;color:#6b4e35;line-height:1.7;margin:0 0 14px">Plans changed?</p>
            <a href={msgUrl} class="cs-cancel" style="font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#b91c1c;text-decoration:none;border-bottom:1px solid rgba(185,28,28,.35);padding-bottom:2px;transition:color .2s">Cancel this sit</a>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<script is:inline define:vars={{ CHECKS, done, sitId }}>
(() => {
  const state = { done: Object.assign({}, done) };
  const esc = v => { const d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; };

  const render = () => {
    const count = CHECKS.filter((_, i) => state.done[i]).length;
    document.querySelector('[data-check-count]').textContent = count + ' of ' + CHECKS.length + ' done';
    document.querySelector('[data-check-bar]').setAttribute('style', 'height:100%;width:' + Math.round((count / CHECKS.length) * 100) + '%;border-radius:50px;background:linear-gradient(90deg,#2f5d45,#c4ab8a);transition:width .4s ease');
    document.querySelector('[data-checklist]').innerHTML = CHECKS.map((label, i) => {
      const on = !!state.done[i];
      const style = 'display:flex;align-items:center;gap:12px;width:100%;text-align:left;font-family:\'Montserrat\',sans-serif;background:none;border:none;padding:2px 0;cursor:pointer';
      const boxStyle = 'width:22px;height:22px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:.68rem;flex-shrink:0;transition:background .2s ease, color .2s ease, border-color .2s ease;' +
        (on ? 'background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;' : 'background:#fff;color:transparent;border:1.5px solid rgba(44,26,14,.18);');
      const labelStyle = 'font-size:.93rem;line-height:1.5;transition:color .2s ease;' + (on ? 'color:#8a6a4f;text-decoration:line-through;' : 'color:#2c1a0e;');
      return '<button type="button" data-check="' + i + '" aria-pressed="' + on + '" style="' + style + '">' +
        '<span style="' + boxStyle + '">✓</span>' +
        '<span style="' + labelStyle + '">' + esc(label) + '</span>' +
      '</button>';
    }).join('');
  };

  document.querySelector('[data-checklist]').addEventListener('click', e => {
    const b = e.target.closest('[data-check]');
    if (!b) return;
    const i = b.getAttribute('data-check');
    const before = Object.assign({}, state.done);
    if (state.done[i]) delete state.done[i]; else state.done[i] = true;
    render();
    fetch('/api/sits/checklist', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ sit_id: sitId, done: state.done })
    })
      .then(r => { if (!r.ok) throw new Error(); })
      .catch(() => { state.done = before; render(); });
  });

  document.querySelector('[data-print]').addEventListener('click', () => window.print());

  const loader = document.querySelector('[data-loader]');
  let hideT;
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || !loader) return;
    a.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      loader.style.opacity = '1';
      loader.style.pointerEvents = 'all';
      clearTimeout(hideT);
      hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
    });
  });

  render();
})();
</script>
<script is:inline>
(() => {
  const tabs = [...document.querySelectorAll('[data-pack]')];
  const show = (k) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.pack === k)));
    document.querySelectorAll('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== k; });
  };
  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.pack)));
  const h = location.hash.slice(1);
  if (h && tabs.some((t) => t.dataset.pack === h)) show(h);
})();
</script>
</body>
</html>
