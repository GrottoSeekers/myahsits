---
// Data: the profile's
// availability_json
// (day map, "free" or
// "maybe"), its
// availability_prefs_json,
// booked days from
// confirmed `sits`, and
// open `listings` dates.
// Saves via the
// profile API.
export const prerender =
  false;
import AppNav from
  './_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../lib/account';
import {
  getSession,
} from '../lib/auth';
import {
  supabase,
} from '../lib/supabase';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'sitter',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const pr =
  await supabase
  .from('profiles')
  .select('*')
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const me: any = pr.data;
// Side comes from the
// account (sign-up).
if (me && acct)
  me.profile_type =
    acct.side;
if (!me) {
  return Astro.redirect(
    '/profile/create',
  );
}
const isOwner =
  me.profile_type ===
  'owner';
const dashUrl = isOwner
  ? '/owner/dashboard'
  : '/dashboard';
const pageUrl = me.slug
  ? '/' + me.slug
  : dashUrl;

// Saved day map.
const days: Record<
  string,
  string
> = {};
const rawDays =
  me.availability_json;
if (
  rawDays &&
  typeof rawDays ===
    'object' &&
  !Array.isArray(rawDays)
) {
  for (const k of
    Object.keys(rawDays)) {
    const v = rawDays[k];
    if (
      v === 'free' ||
      v === 'maybe' ||
      v === 'no'
    ) {
      days[k] = v;
    }
  }
}

// Saved preferences.
const rp: any =
  me.availability_prefs_json
  || {};
const prefs = {
  lengths:
    Array.isArray(
      rp.lengths,
    )
      ? rp.lengths
      : [],
  pets:
    Array.isArray(rp.pets)
      ? rp.pets
      : [],
  notice:
    typeof rp.notice ===
      'string'
      ? rp.notice
      : 'Any time',
};

// Booked days from
// confirmed sits.
const booked: Record<
  string,
  number
> = {};
let sitCount = 0;
const dayKey = (
  d: Date,
) =>
  d.toISOString()
  .slice(0, 10);
try {
  const sr =
    await supabase
    .from('sits')
    .select(
      'id, listings!inner(' +
      'date_from,' +
      ' date_to)',
    )
    .eq(
      'sitter_user_id',
      session.userId,
    );
  const rows =
    sr.data ?? [];
  sitCount = rows.length;
  for (const s of
    rows as any[]) {
    const l = s.listings;
    if (
      !l?.date_from ||
      !l?.date_to
    ) {
      continue;
    }
    const d = new Date(
      l.date_from +
        'T00:00:00Z',
    );
    const end = new Date(
      l.date_to +
        'T00:00:00Z',
    );
    let guard = 0;
    while (
      d <= end &&
      guard++ < 400
    ) {
      booked[dayKey(d)] =
        1;
      d.setUTCDate(
        d.getUTCDate() + 1,
      );
    }
  }
} catch {}

// Open sits, for the
// "fit your dates" link.
let openSits: {
  from: string;
  to: string;
}[] = [];
try {
  const lr =
    await supabase
    .from('listings')
    .select(
      'date_from, date_to',
    )
    .eq(
      'status',
      'active',
    )
    .limit(500);
  openSits = (
    lr.data ?? []
  )
    .filter(
      (l: any) =>
        l.date_from &&
        l.date_to,
    )
    .map((l: any) => ({
      from: l.date_from,
      to: l.date_to,
    }));
} catch {}

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Availability — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 1000px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 34px 20px 130px !important; }
      [data-two-col] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
      [data-card] { padding: 26px 22px !important; }
      [data-months] { grid-template-columns: minmax(0,1fr) !important; }
    }

    .av-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .av-page:hover { color:#2c1a0e !important; }
    .av-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .av-match:hover { gap:12px !important; color:#2c1a0e !important; }
    [data-months] button { user-select:none; -webkit-user-select:none; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <style is:global>
    /* iPhone-style calendar (round 3) */
    .ic-seg { display:inline-flex; padding:3px; border-radius:12px; background:#f0e9dd; gap:2px; }
    .ic-seg button { display:inline-flex; align-items:center; gap:7px; border:0; background:none; border-radius:9px; padding:8px 14px; font:600 .78rem 'Montserrat',sans-serif; color:#6b4e35; cursor:pointer; transition:background .2s, color .2s, box-shadow .2s; }
    .ic-seg button[aria-pressed="true"] { background:#fff; color:#2c1a0e; box-shadow:0 2px 8px rgba(44,26,14,.12); }
    .ic-sw { width:10px; height:10px; border-radius:50%; display:block; }
    .ic-sw-free { background:#2f5d45; } .ic-sw-maybe { background:#d99a2b; } .ic-sw-no { background:#c0533f; } .ic-sw-booked { background:#2c1a0e; }
    .ic-key { display:inline-flex; align-items:center; gap:7px; font:600 .78rem 'Montserrat',sans-serif; color:#6b4e35; padding:8px 4px; }
    .ic-month { min-width:0; }
    .ic-title { margin:0 0 12px; font:400 1.5rem 'Marcellus',serif; color:#2c1a0e; }
    .ic-title b { font-weight:400; color:#2f5d45; }
    .ic-wk { display:grid; grid-template-columns:repeat(7,1fr); padding-bottom:8px; margin-bottom:6px; border-bottom:1px solid rgba(44,26,14,.08); }
    .ic-wk span { text-align:center; font-size:.68rem; font-weight:600; color:#8a6a4f; }
    .ic-wk span.we { color:#b39c80; }
    .ic-grid { display:grid; grid-template-columns:repeat(7,1fr); row-gap:4px; }
    .ic-d { position:relative; height:46px; border:0; background:none; padding:0; display:flex; align-items:center; justify-content:center; cursor:pointer; -webkit-tap-highlight-color:transparent; touch-action:pan-y; }
    .ic-d span { position:relative; z-index:1; width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center; font:500 .98rem 'Montserrat',sans-serif; color:#2c1a0e; transition:background .15s, color .15s, transform .15s; }
    .ic-d:hover span { background:#f3ece0; }
    .ic-d:active span { transform:scale(.9); }
    .ic-past span { color:#c2b29d; }
    .ic-today span { color:#2f5d45; font-weight:700; box-shadow:inset 0 0 0 1.5px #2f5d45; }
    .ic-free::before, .ic-maybe::before, .ic-no::before, .ic-booked::before { content:""; position:absolute; top:4px; bottom:4px; left:50%; right:50%; }
    .ic-free.ic-l::before, .ic-maybe.ic-l::before, .ic-no.ic-l::before, .ic-booked.ic-l::before { left:0; }
    .ic-free.ic-r::before, .ic-maybe.ic-r::before, .ic-no.ic-r::before, .ic-booked.ic-r::before { right:0; }
    .ic-free::before { background:#dfeae2; }
    .ic-maybe::before { background:#f7e6c4; }
    .ic-no::before { background:#f4d9d3; }
    .ic-booked::before { background:#e3dbd2; }
    .ic-free span { background:#2f5d45 !important; color:#fff; font-weight:600; }
    .ic-free.ic-l.ic-r span { background:transparent !important; color:#2f5d45; }
    .ic-maybe span { background:#d99a2b !important; color:#fff; font-weight:600; }
    .ic-maybe.ic-l.ic-r span { background:transparent !important; color:#8a5a0c; }
    .ic-no span { background:#c0533f !important; color:#fff; font-weight:600; }
    .ic-no.ic-l.ic-r span { background:transparent !important; color:#9b3a28; }
    .ic-booked span { background:#2c1a0e !important; color:#fff; }
    .ic-booked.ic-l.ic-r span { background:transparent !important; color:#2c1a0e; }
    .ic-booked { cursor:not-allowed; }
    .ic-blank { pointer-events:none; }
    [data-months] { gap:40px !important; }
    @media (max-width:700px) {
      [data-pad] { padding:20px 16px 120px !important; }
      [data-pad] h1 { font-size:1.9rem !important; margin-bottom:10px !important; }
      [data-pad] > div > div:first-child { padding-bottom:18px !important; margin-bottom:18px !important; }
      [data-pad] > div > div:first-child > p:last-child { font-size:.9rem !important; }
      [data-card] { padding:18px 16px !important; }
      .ic-d { height:48px; }
      .ic-d span { width:40px; height:40px; font-size:1.02rem; }
      .ic-title { font-size:1.35rem; }
      .ic-seg button { padding:8px 11px; }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={'sitter'} active="availability" />

  <main data-pad="1" data-screen-label="Availability" style="flex:1;padding:52px 48px 130px">
    <div style="max-width:1180px;margin:0 auto">

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>MYAH sitter</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">When you&rsquo;re <em style="color:#2f5d45;">free</em></h1>
        <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:620px;margin:0">Pick a colour, then tap or drag across days. Owners see it on your page.</p>
      </div>

      <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:28px;align-items:start">

        <div style="display:flex;flex-direction:column;gap:24px">

          <div data-card="1" class="av-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:32px 34px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:24px">
              <div data-brushes style="display:flex;gap:9px;flex-wrap:wrap;align-items:center"></div>
              <div style="display:flex;gap:9px;align-items:center;margin-left:auto">
                <button type="button" data-prev aria-label="Previous months">&#8249;</button>
                <span data-range class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)"></span>
                <button type="button" data-next aria-label="Next months">&#8250;</button>
              </div>
            </div>

            <div data-months="1" style="display:grid;grid-template-columns:1fr 1fr;gap:30px"></div>
          </div>

        </div>

        <aside data-aside="1" style="position:sticky;top:28px;display:flex;flex-direction:column;gap:20px">
          <div class="av-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:26px 26px 28px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 18px">Your available dates</p>
            <div data-stretches style="display:flex;flex-direction:column;gap:12px"></div>
            <p data-stretch-empty style="font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0;">None yet.</p>
            <a href="/listings" class="av-match" style="display:inline-flex;align-items:center;gap:8px;margin-top:18px;font-size:.76rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border-bottom:1px solid rgba(110,84,56,.4);padding-bottom:2px;transition:gap .2s, color .2s"><span data-match-count></span> &rarr;</a>
          </div>

        </aside>
      </div>
    </div>
  </main>

  <div data-save-bar>
    <div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
      <p data-save-text style="font-size:.88rem;color:#6b4e35;margin:0;line-height:1.5"></p>
      <button type="button" data-save></button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ days, prefs, booked, openSits }}>
(() => {
  const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const WEEKDAYS = ['M','T','W','T','F','S','S'];
  const BOOKED = booked;

  const key = (y, m, d) => y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
  const fmt = k => {
    const [y, m, d] = k.split('-').map(Number);
    return d + ' ' + MONTH_NAMES[m - 1].slice(0, 3);
  };
  const esc = v => { const d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; };
  const q = sel => document.querySelector(sel);

  const now = new Date();
  const state = {
    offset: 0,
    brush: 'free',
    days: Object.assign({}, days),
    saved: true,
    saving: false
  };
  const P = { lengths: prefs.lengths.slice(), pets: prefs.pets.slice(), notice: prefs.notice };

  // Tapping a day already in the chosen colour clears it (no separate "Clear").
  // A drag keeps whatever the first day did: paint, or clear.
  let erase = false;
  const startPaint = k => { erase = !BOOKED[k] && state.days[k] === state.brush; paint(k); };
  const paint = k => {
    if (BOOKED[k]) return;
    const prev = state.days[k];
    if (erase) { if (prev === state.brush) delete state.days[k]; } else state.days[k] = state.brush;
    if (prev !== state.days[k]) { state.saved = false; render(); }
  };

  const buildMonth = (year, monthIdx) => {
    const first = new Date(year, monthIdx, 1);
    const startDow = (first.getDay() + 6) % 7;
    const total = new Date(year, monthIdx + 1, 0).getDate();
    const cells = [];
    for (let i = 0; i < startDow; i++) cells.push({ blank: true });
    for (let d = 1; d <= total; d++) cells.push({ day: d, k: key(year, monthIdx, d) });
    return { label: MONTH_NAMES[monthIdx] + ' ' + year, cells };
  };

  const stretches = () => {
    const keys = Object.keys(state.days).filter(k => state.days[k] === 'free').sort();
    const out = [];
    let run = [];
    const dayNum = k => Math.round(new Date(k + 'T00:00:00').getTime() / 86400000);
    keys.forEach(k => {
      if (run.length && dayNum(k) - dayNum(run[run.length - 1]) !== 1) { out.push(run); run = []; }
      run.push(k);
    });
    if (run.length) out.push(run);
    return out.sort((a, b) => b.length - a.length);
  };

  // Open sits that sit wholly inside a free stretch.
  const fitCount = () => {
    const runs = stretches().map(r => ({ from: r[0], to: r[r.length - 1] }));
    return openSits.filter(l => runs.some(r => l.from >= r.from && l.to <= r.to)).length;
  };

  const brushDefs = [
    { key: 'free', label: 'Available' },
    { key: 'maybe', label: 'Maybe' },
    { key: 'no', label: 'Unavailable' }
  ];
  const navBtnStyle = 'width:38px;height:38px;border-radius:50%;background:#f3ece0;border:0;color:#2f5d45;font-size:1.2rem;cursor:pointer;transition:background .2s ease';
  q('[data-prev]').setAttribute('style', navBtnStyle);
  q('[data-next]').setAttribute('style', navBtnStyle);


  const render = () => {
    const s = state;

    q('[data-brushes]').innerHTML = '<span class="ic-seg" role="group" aria-label="Mark days as">' + brushDefs.map(b =>
      '<button type="button" data-brush="' + b.key + '" aria-pressed="' + (s.brush === b.key) + '"><i class="ic-sw ic-sw-' + b.key + '"></i>' + esc(b.label) + '</button>').join('') + '</span>' +
      '<span class="ic-key"><i class="ic-sw ic-sw-booked"></i>Booked sit</span>';

    // iPhone-style months (round 3): plain numbers, round days, free days
    // joined into one band, today ringed. Phones show one month at a time.
    const one = matchMedia('(max-width:700px)').matches;
    const base = new Date(now.getFullYear(), now.getMonth() + s.offset, 1);
    const m1 = buildMonth(base.getFullYear(), base.getMonth());
    const second = new Date(base.getFullYear(), base.getMonth() + 1, 1);
    const m2 = buildMonth(second.getFullYear(), second.getMonth());
    q('[data-range]').textContent = one ? m1.label : m1.label.split(' ')[0].slice(0, 3) + ' — ' + m2.label.split(' ')[0].slice(0, 3) + ' ' + m2.label.split(' ')[1];
    const todayK = key(now.getFullYear(), now.getMonth(), now.getDate());
    const stateOf = k => (BOOKED[k] ? 'booked' : s.days[k] || '');
    const shift = (k, d) => { const t = new Date(k + 'T00:00:00'); t.setDate(t.getDate() + d); return key(t.getFullYear(), t.getMonth(), t.getDate()); };

    const cellFor = (c, i) => {
      if (c.blank) return '<span class="ic-d ic-blank" aria-hidden="true"></span>';
      const v = stateOf(c.k);
      const col = i % 7;
      const L = v && col > 0 && stateOf(shift(c.k, -1)) === v && c.day > 1;
      const R = v && col < 6 && stateOf(shift(c.k, 1)) === v && !c.last;
      const cls = ['ic-d', v ? 'ic-' + v : '', L ? 'ic-l' : '', R ? 'ic-r' : '', c.k === todayK ? 'ic-today' : '', c.k < todayK ? 'ic-past' : ''].filter(Boolean).join(' ');
      return '<button type="button" data-day="' + c.k + '" class="' + cls + '" aria-pressed="' + (v === 'free') + '" aria-label="' + c.day + ' ' + ({ free: 'available', maybe: 'maybe', no: 'unavailable', booked: 'booked sit' }[v] || 'not marked') + '"><span>' + c.day + '</span></button>';
    };
    q('[data-months]').innerHTML = (one ? [m1] : [m1, m2]).map(m => {
      m.cells.forEach((c, i) => { if (!c.blank && i === m.cells.length - 1) c.last = true; });
      return '<div class="ic-month">' +
        '<p class="ic-title"><b>' + esc(m.label.split(' ')[0]) + '</b> ' + esc(m.label.split(' ')[1]) + '</p>' +
        '<div class="ic-wk">' + WEEKDAYS.map((w, i) => '<span' + (i > 4 ? ' class="we"' : '') + '>' + w + '</span>').join('') + '</div>' +
        '<div class="ic-grid">' + m.cells.map(cellFor).join('') + '</div>' +
      '</div>';
    }).join('');


    const stretchList = stretches().slice(0, 3);
    const longest = stretchList[0] ? stretchList[0].length : 0;
    const freeCount = Object.values(s.days).filter(v => v === 'free').length;

    q('[data-stretches]').innerHTML = stretchList.map(run => {
      const pillStyle = 'font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:5px 12px;border-radius:50px;white-space:nowrap;flex-shrink:0;' +
        (run.length >= 14 ? 'background:#2f5d45;color:#fff;' : 'background:rgba(110,84,56,.14);color:#2f5d45;');
      return '<div style="display:flex;align-items:center;justify-content:space-between;gap:14px;background:#faf6ee;border:1px solid rgba(110,84,56,.22);border-radius:12px;padding:14px 16px">' +
        '<div style="min-width:0">' +
          '<p style="font-size:.92rem;font-weight:600;color:#2c1a0e;margin:0 0 3px">' + fmt(run[0]) + ' — ' + fmt(run[run.length - 1]) + '</p>' +
          '<p style="font-size:.8rem;color:#6b4e35;margin:0">' + run.length + (run.length === 1 ? ' day' : ' days') + '</p>' +
        '</div>' +
        '<span style="' + pillStyle + '">' + (run.length >= 14 ? 'Long sit' : run.length >= 7 ? 'A week+' : 'Short') + '</span>' +
      '</div>';
    }).join('');
    q('[data-stretch-empty]').setAttribute('style', 'font-size:.88rem;color:#6b4e35;line-height:1.65;margin:0;' + (stretchList.length ? 'display:none;' : ''));

    const fits = fitCount();
    q('[data-match-count]').textContent = freeCount ? fits + ' open sit' + (fits === 1 ? '' : 's') + ' fit your dates' : 'Browse all open sits';

    q('[data-save-bar]').setAttribute('style', 'position:fixed;left:0;right:0;bottom:0;z-index:40;padding:16px 48px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-top:1px solid rgba(110,84,56,.28);box-shadow:0 -6px 24px rgba(44,26,14,.06);transition:transform .3s ease, opacity .3s ease;' +
      (s.saved ? 'transform:translateY(100%);opacity:0;pointer-events:none;' : 'transform:translateY(0);opacity:1;'));
    q('[data-save-text]').textContent = 'Not saved yet.';
    const saveBtn = q('[data-save]');
    saveBtn.textContent = s.saving ? 'Saving…' : s.saved ? 'Saved' : 'Save availability';
    saveBtn.disabled = s.saving;
    saveBtn.setAttribute('style', 'font-family:\'Montserrat\',sans-serif;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease');
  };

  // Paint by clicking or dragging across days.
  const months = q('[data-months]');
  // Touch: tap a day, or slide sideways across days to paint them.
  let touchPaint = false;
  months.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') { const b = e.target.closest('[data-day]'); if (b) { touchPaint = true; startPaint(b.getAttribute('data-day')); } } });
  months.addEventListener('pointermove', e => {
    if (!touchPaint || e.pointerType === 'mouse') return;
    const el = document.elementFromPoint(e.clientX, e.clientY);
    const b = el && el.closest && el.closest('[data-day]');
    if (b) paint(b.getAttribute('data-day'));
  });
  ['pointerup', 'pointercancel'].forEach(t => months.addEventListener(t, () => { touchPaint = false; }));
  // Swipe left or right on a phone to change month.
  let sx = null;
  months.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
  months.addEventListener('touchend', e => {
    if (sx == null) return; const dx = e.changedTouches[0].clientX - sx; sx = null;
    if (Math.abs(dx) > 70 && !touchPaint) { state.offset += dx < 0 ? 1 : -1; render(); }
  }, { passive: true });
  window.addEventListener('resize', () => render());
  months.addEventListener('mousedown', e => {
    const b = e.target.closest('[data-day]');
    if (!b || e.button !== 0) return;
    e.preventDefault();
    startPaint(b.getAttribute('data-day'));
  });
  months.addEventListener('mouseover', e => {
    const b = e.target.closest('[data-day]');
    if (b && e.buttons === 1) paint(b.getAttribute('data-day'));
  });
  months.addEventListener('click', e => {
    // Keyboard activation (mouse clicks are handled on mousedown).
    const b = e.target.closest('[data-day]');
    if (b && e.detail === 0 && e.pointerType !== 'touch') startPaint(b.getAttribute('data-day'));
  });

  q('[data-prev]').addEventListener('click', () => { state.offset -= 1; render(); });
  q('[data-next]').addEventListener('click', () => { state.offset += 1; render(); });

  document.addEventListener('click', e => {
    const br = e.target.closest('[data-brush]');
    if (br) { state.brush = br.getAttribute('data-brush'); render(); return; }
  });

  q('[data-save]').addEventListener('click', () => {
    if (state.saving) return;
    state.saving = true; render();
    fetch('/api/profile/availability', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ days: state.days, prefs: P })
    })
      .then(r => { if (!r.ok) throw new Error(); state.saved = true; })
      .catch(() => {})
      .finally(() => { state.saving = false; render(); });
  });

  window.addEventListener('beforeunload', e => { if (!state.saved) { e.preventDefault(); e.returnValue = ''; } });

  const loader = q('[data-loader]');
  let hideT;
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || !loader) return;
    a.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      if (!state.saved) return;
      loader.style.opacity = '1';
      loader.style.pointerEvents = 'all';
      clearTimeout(hideT);
      hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
    });
  });

  render();
})();
</script>
</body>
</html>
