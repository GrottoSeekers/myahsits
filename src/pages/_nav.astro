---
// Shared header: see
// src/lib/appnav.ts
import { buildNav } from
  '../lib/appnav';
import { getAccount } from
  '../lib/account';
import {
  PAYMENTS_ENABLED,
} from '../lib/billing';
const me =
  await getAccount(
    Astro.request,
  );
const n = buildNav(
  Astro.props.side,
  Astro.props.active,
  !!me?.isAdmin,
  PAYMENTS_ENABLED,
);
---
<nav data-topnav="1" data-app-nav="1" style="display:flex;justify-content:space-between;align-items:center;padding:16px 48px;background:#fff;border-bottom:1px solid rgba(110,84,56,.14)">
  <a href={n.home} style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.35rem;letter-spacing:.28em">
    <img src="/images/logo-mark.png" alt="" style="height:44px;width:44px;display:block;object-fit:contain" />
    <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:#2f5d45;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
  </a>
  <button type="button" data-acct-toggle="1" aria-label="Menu" aria-expanded="false" onclick="var n=this.closest('[data-topnav]');var o=n.classList.toggle('acct-open');this.setAttribute('aria-expanded',o)"><span></span><span></span><span></span></button>
  <div data-acct-links="1" style="display:flex;align-items:center;gap:22px;flex-wrap:wrap;justify-content:flex-end">
    {n.links.map((l) => (
      <a href={l.href} class="app-nav-link" aria-current={l.on ? 'page' : undefined} style={`display:inline-flex;align-items:center;gap:9px;font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;white-space:nowrap;transition:color .2s;padding-bottom:4px;color:${l.on ? '#2f5d45' : '#5c3d20'};border-bottom:2px solid ${l.on ? '#2f5d45' : 'transparent'}`}>{l.label}</a>
    ))}
    <a href="/api/auth/logout" class="app-nav-link" style="font-size:.76rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;white-space:nowrap;padding-bottom:4px;border-bottom:2px solid transparent">Log out</a>
  </div>
</nav>

<link rel="stylesheet" href="/apptabs.css" />
<div data-app-tabs="1" class="apt">
  <div class="apt-in">
    {n.tabs.map((t) => (
      <a href={t.href} class="app-tab apt-t" aria-current={t.on ? 'page' : undefined}>
        <span class="apt-ic">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon}></svg>
          {t.key === 'messages' && <span data-app-badge="1" class="apt-badge">0</span>}
        </span>
        <span>{t.label}</span>
      </a>
    ))}
  </div>
</div>

<style is:global>
  .app-nav-link:hover { color: #2f5d45 !important; }
</style>

<script is:inline>
  (function () {
    var badge = document.querySelector('[data-app-badge]');
    if (!badge) return;
    fetch('/api/messages/unread').then(function (r) { return r.json(); }).then(function (d) {
      var n = (d && d.count) || 0;
      if (n > 0) { badge.textContent = n > 9 ? '9+' : String(n); badge.style.display = 'flex'; }
    }).catch(function () {});
  })();
</script>
