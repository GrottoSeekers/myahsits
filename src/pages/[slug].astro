<script is:inline define:vars={{ pageSlug }}>
(() => {
  let hideT, heroT, aboutT;

  document.querySelectorAll('form[data-go]').forEach(f => f.addEventListener('submit', e => {
    e.preventDefault(); e.stopImmediatePropagation();
    // Deliver the enquiry before navigating away (the design navigates on submit).
    const fd = new FormData(f);
    fd.append('slug', pageSlug);
    navigator.sendBeacon('/api/enquiry', fd);
    const target = f.getAttribute('data-go');
    const l = document.querySelector('[data-loader]');
    if (l) { l.style.opacity = '1'; l.style.pointerEvents = 'all'; }
    setTimeout(() => { window.location.href = target; }, l ? 700 : 150);
  }, true));
  const q = s => document.querySelector(s);
  const qa = s => Array.from(document.querySelectorAll(s));

  const loader = q('[data-loader]');
  const show = () => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };
  qa('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel') || a.target === '_blank') return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; show(); });
  });

  const form = q('[data-enquiry]');
  const status = q('[data-enquiry-status]');
  form && form.addEventListener('submit', e => {
    e.preventDefault();
    if (!form.hasAttribute('data-go')) {
      // Before launch: send it here and stay on the page.
      const fd = new FormData(form);
      fd.append('slug', pageSlug);
      if (status) status.textContent = 'Sending…';
      fetch('/api/enquiry', { method: 'POST', body: fd })
        .then(r => r.json().catch(() => ({})).then(j => ({ ok: r.ok, j })))
        .then(({ ok, j }) => {
          if (status) status.textContent = ok ? "Enquiry sent! You'll hear back soon." : (j.error || 'Sorry, that did not send. Please try again.');
          if (ok) form.reset();
        })
        .catch(() => { if (status) status.textContent = 'Sorry, that did not send. Please try again.'; });
      return;
    }
    show();
    if (status) status.textContent = "Enquiry sent! You'll hear back soon.";
    form.reset();
  });

  // smooth scroll past the fixed header
  qa('a[href^="#"]').forEach(a => a.addEventListener('click', e => {
    const target = document.querySelector(a.getAttribute('href'));
    if (!target) return;
    e.preventDefault();
    const off = (q('[data-topbar]') ? q('[data-topbar]').offsetHeight : 0) + 20;
    window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - off, behavior: 'smooth' });
  }));

  // hero slideshow
  const hero = qa('[data-hero-slide]');
  let hi = 0;
  if (hero.length > 1) {
    heroT = setInterval(() => {
      hero[hi].style.opacity = '0';
      hi = (hi + 1) % hero.length;
      hero[hi].style.opacity = '1';
    }, 5000);
  }

  // about carousel
  const slides = qa('[data-about-slide]');
  const dots = qa('[data-about-dot]');
  let ai = 0;
  const goAbout = i => {
    slides[ai].style.opacity = '0';
    if (dots[ai]) dots[ai].style.background = 'transparent';
    ai = (i + slides.length) % slides.length;
    slides[ai].style.opacity = '1';
    if (dots[ai]) dots[ai].style.background = 'rgba(255,255,255,.9)';
  };
  const resetAbout = () => {
    clearInterval(aboutT);
    aboutT = setInterval(() => goAbout(ai + 1), 4500);
  };
  q('[data-about-prev]') && q('[data-about-prev]').addEventListener('click', () => { goAbout(ai - 1); resetAbout(); });
  q('[data-about-next]') && q('[data-about-next]').addEventListener('click', () => { goAbout(ai + 1); resetAbout(); });
  dots.forEach(d => d.addEventListener('click', () => { goAbout(Number(d.getAttribute('data-about-dot'))); resetAbout(); }));
  if (slides.length > 1) resetAbout();

  // reviews carousel
  const track = q('[data-rev-track]');
  const dotsEl = q('[data-rev-dots]');
  const setupRev = () => {
    const cards = qa('[data-rev-card]');
    if (!track || !cards.length || !dotsEl) return;
    let ri = 0;
    const visible = () => window.innerWidth >= 1100 ? 3 : window.innerWidth >= 760 ? 2 : 1;
    const cardW = () => cards[0].offsetWidth + 24;
    const maxIdx = () => Math.max(0, cards.length - visible());
    const paint = () => {
      track.style.transform = 'translateX(-' + (ri * cardW()) + 'px)';
      Array.from(dotsEl.children).forEach((d, j) => {
        d.style.background = j === ri ? 'var(--ac)' : '#e9e0d2';
      });
    };
    const go = i => { ri = Math.max(0, Math.min(i, maxIdx())); paint(); };
    const build = () => {
      dotsEl.innerHTML = '';
      for (let i = 0; i <= maxIdx(); i++) {
        const d = document.createElement('div');
        Object.assign(d.style, { width: '8px', height: '8px', borderRadius: '50%', background: '#e9e0d2', cursor: 'pointer', transition: 'background .2s' });
        d.addEventListener('click', () => go(i));
        dotsEl.appendChild(d);
      }
      paint();
    };
    q('[data-rev-prev]').onclick = () => go(ri - 1);
    q('[data-rev-next]').onclick = () => go(ri + 1);
    // Swipe on touch screens
    let sx = null;
    track.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', e => {
      if (sx === null) return;
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 40) go(ri + (dx < 0 ? 1 : -1));
      sx = null;
    });
    const onResize = () => { build(); go(ri); };
    window.addEventListener('resize', onResize);
    build();
  };
  setTimeout(setupRev, 60);

  // gallery lightbox
  const lb = q('[data-lb]');
  const lbImg = q('[data-lb-img]');
  const lbCap = q('[data-lb-cap]');
  const openLb = (src, alt) => {
    if (!lb) return;
    lbImg.src = src;
    lbImg.alt = alt || '';
    lbCap.textContent = alt || '';
    lb.style.opacity = '1';
    lb.style.pointerEvents = 'all';
  };
  const closeLb = () => {
    if (!lb) return;
    lb.style.opacity = '0';
    lb.style.pointerEvents = 'none';
  };
  document.addEventListener('click', e => {
    const btn = e.target.closest && e.target.closest('[data-lightbox]');
    if (btn) openLb(btn.getAttribute('data-lightbox'), btn.getAttribute('data-lightbox-alt'));
  });
  q('[data-lb-close]') && q('[data-lb-close]').addEventListener('click', closeLb);
  lb && lb.addEventListener('click', e => { if (e.target === lb) closeLb(); });
  const onKey = e => { if (e.key === 'Escape') closeLb(); };
  document.addEventListener('keydown', onKey);
})();
</script>

