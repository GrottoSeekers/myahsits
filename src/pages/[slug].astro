---
export const prerender =
  false;
import {
  supabase,
} from '../lib/supabase';
import {
  LAUNCHED,
} from '../lib/launch';
import LaunchSoon
  from './_launchsoon.astro';
import SignatureProfile
  from '../components/SignatureProfile.astro';
import {
  FOUNDERS_SLUG,
  FOUNDERS_REVIEW_TOTAL,
  foundersReviews,
  foundersGallery,
} from '../data/founders';
import { regionOnly } from '../lib/region';
import { offSite, privateLabel, scrubOffSite } from '../lib/offsite';
import { getAccount } from '../lib/account';
import { getBilling, PAYMENTS_ENABLED } from '../lib/billing';
import { jsonObj } from '../lib/db';
import { layoutOf } from '../lib/tier';

const { slug } =
  Astro.params;
let p: any = null;
if (slug) {
  try {
    const res =
      await supabase
      .from('profiles')
      .select('*')
      .eq('slug', slug)
      .single();
    if (!res.error) {
      p = res.data;
    }
  } catch {}
}
if (!p) {
  return new Response(
    'Not found',
    { status: 404 },
  );
}

// Owners have their own
// public page: home, pets
// and open sits. The side
// is what they picked at
// sign-up (users.role).
let side = '';
try {
  const ur =
    await supabase
    .from('users')
    .select('role')
    .eq('id', p.user_id)
    .limit(1);
  side =
    ur.data?.[0]?.role ||
    '';
} catch {}
side =
  side ||
  p.profile_type ||
  'sitter';
if (side === 'owner') {
  return Astro.rewrite(
    '/owner-page/' +
    p.slug +
    Astro.url.search,
  );
}

// Design copy — used
// when a profile field
// is empty.
const tx = (
  s: string,
) => s.trim();
const at = (
  f: string,
) => '/images/' + f;
// Image paths: design
// "public/…" paths and
// old grottositters.com
// links both become this
// site's own /images/.
const OLD = new RegExp(
  '^https?://(www\\.)?' +
  'grottositters' +
  '\\.com/',
);
const local = (
  s: string,
) => String(s || '')
  .replace(
    /^public\//,
    '/',
  )
  .replace(OLD, '/');

type Pic = {
  src: string;
  pos?: string;
  alt?: string;
};

const heroDef: Pic[] = [
  {
    src: at(
      'couple-villa-1.jpg',
    ),
    pos: 'center 30%',
  },
  {
    src: at(
      'couple-boat-1.jpg',
    ),
    pos: 'center 30%',
  },
  {
    src: at(
      'couple-field-1.jpg',
    ),
    pos: 'center 25%',
  },
  {
    src: at(
      'couple-night-1.jpg',
    ),
    pos: 'center 30%',
  },
];

const aboutDef: Pic[] = [
  {
    src: at(
      'couple-dinner-1.jpg',
    ),
    alt: tx(`
Callum and Niamh at dinner
`),
  },
  {
    src: at(
      'couple-airport-1.jpg',
    ),
    alt: tx(`
Callum and Niamh at the airport
`),
  },
  {
    src: at(
      'couple-bw-1.jpg',
    ),
    alt: tx(`
Callum and Niamh
`),
  },
];

const badgeDef = tx(`
Experienced sitters worldwide
`);
const taglineDef = tx(`
Experienced house & pet sitters available worldwide — passionate about caring for homes and animals wherever they go.
`);
const bioDef = tx(`
We're Callum and Niamh. We've cared for all sorts of animals. From cats and dogs to horses and bearded lizards. We've stayed in just as many kinds of home. From high-rise city apartments to farmhouses on a hundred acres.

We treat every sit like it's our own home: daily walks, feeding routines kept to the minute, plants watered, bins out, and regular photo updates so you can relax while you're away.
`);
const blurbDef = tx(`
Callum & Niamh — experienced house and pet sitters.
`);

const revDef = [
        { text: 'Super lovely couple who took great care of our cat Rocco! Regular updates, spotless apartment on return. Rocco was extremely happy when we got home.', name: 'Jess & Sam', initials: 'JS', platform: 'Private' },
        { text: "We couldn't have asked for better pet sitters — reliable, trustworthy, and incredibly caring. They left our home spotless and exceeded every expectation.", name: 'Libby', initials: 'L', platform: 'Private' },
        { text: "Callum and Niamh have looked after Solomon for four years. They are reliable, trustworthy, and clearly care about his wellbeing. I couldn't recommend them highly enough.", name: 'Thomas James', initials: 'TJ', platform: 'Private' },
        { text: 'Came back to a tidy house, a very happy dog and a fridge full of the food we left. Booked them again for the summer before we had even unpacked.', name: 'Angela', initials: 'A', platform: 'Private' },
        { text: 'Daily photos, walks rain or shine, and the garden looked better than when we left. Genuinely the easiest holiday we have had since getting the dogs.', name: 'Deb', initials: 'D', platform: 'Private' }
];

const galDef = [
        { src: 'public/images/alfie-1.jpg', alt: 'Alfie the cockapoo' },
        { src: 'public/images/solomon-1.jpg', alt: 'Solomon the labradoodle' },
        { src: 'public/images/chester-1.jpg', alt: 'Chester the cocker spaniel' },
        { src: 'public/images/travis-1.jpg', alt: 'Travis the Vizsla' },
        { src: 'public/images/bailey-1.jpg', alt: 'Bailey' },
        { src: 'public/images/zeus-1.jpg', alt: 'Zeus the Weimaraner' },
        { src: 'public/images/orca-3.jpg', alt: 'Orca' },
        { src: 'public/images/solomon-4.jpg', alt: 'Solomon in the snow' }
];

const platDef: any[] = [];

// Profile values
// JSON columns can come
// back as text: parse it.
const arrOf = (v: any) => {
  if (Array.isArray(v))
    return v;
  const t = typeof v;
  if (t === 'string') {
    try {
      const j = JSON.parse(v);
      return Array.isArray(j)
        ? j : [];
    } catch { return []; }
  }
  return [];
};
const list = (
  v: any,
  d: any[],
) => {
  const a = arrOf(v);
  return a.length ? a : d;
};
// The founders' page keeps
// its own reviews/photos
// plus anything added.
const isFounders =
  (p.slug || slug) ===
  FOUNDERS_SLUG;
const keyOf = (x: any) =>
  String(x || '')
  .toLowerCase().trim();
const mergeBy = (
  a: any[],
  b: any[],
  k: (x: any) => string,
) => {
  const seen = new Set();
  return [...a, ...b]
  .filter((x) => {
    const id = k(x);
    if (!id || seen.has(id))
      return false;
    seen.add(id);
    return true;
  });
};
const name: string =
  p.name ||
  'Callum & Niamh';
const ampAt =
  name.indexOf(' & ');
const nameA =
  ampAt < 0
    ? name
    : name.slice(0, ampAt);
const nameB =
  ampAt < 0
    ? ''
    : name.slice(ampAt + 1);
// Callum & Niamh's own
// words and photos fill
// gaps on their page only;
// other sitters show just
// what they have added.
const F = isFounders;
const badge =
  scrubOffSite(p.badge_text || '') ||
  (F ? badgeDef : '');
const tagline =
  scrubOffSite(p.tagline || "") ||
  (F ? taglineDef : '');
const bioSrc: string =
  scrubOffSite(p.bio || '') ||
  (F ? bioDef : '') ||
  tagline ||
  name + ' has not' +
  ' added a bio yet.';
const bioParas =
  bioSrc
  .split(/\r?\n\s*\r?\n/)
  .map(tx)
  .filter(Boolean);
const bio = bioParas
  .map((t, i) => ({
    t,
    m: i ===
      bioParas.length - 1
      ? '0'
      : '0 0 16px',
  }));
const ownPic: Pic[] =
  p.profile_pic
    ? [{
      src: p.profile_pic,
      pos: 'center 30%',
      alt: name,
    }]
    : [];
const plainHero: Pic[] = [{
  src: at(
    'slideshow-' +
    'living-room.jpeg',
  ),
  pos: 'center',
}];
// Where our faces sit in each founders photo (from the top), so a wide,
// short frame crops to the faces instead of the sky (owner, 26 Oct 2026).
const FOCUS: Record<string, string> = {
  'couple-airport-1.jpg': 'center 28%',
  'couple-boat-1.jpg': 'center 20%',
  'couple-bw-1.jpg': 'center 25%',
  'couple-dinner-1.jpg': 'center 42%',
  'couple-field-1.jpg': 'center 48%',
  'couple-night-1.jpg': 'center 30%',
  'couple-villa-1.jpg': 'center 26%',
};
const focusOf = (src: string) => FOCUS[String(src || '').split('/').pop() || ''];
// Photos where we stand far apart: a narrow phone crop would cut one of us off.
const WIDE = new Set(['couple-dinner-1.jpg']);
const hero = list(
  p.hero_images_json,
  F ? heroDef
    : ownPic.length
      ? ownPic
      : plainHero,
).map((h: Pic) => ({
  src: local(h.src),
  pos:
    focusOf(h.src) ||
    h.pos ||
    'center 30%',
  wide: WIDE.has(String(h.src || '').split('/').pop() || ''),
}));
const about = list(
  p.about_images_json,
  F ? aboutDef : ownPic,
).map((a: Pic) => ({
  src: local(a.src),
  pos: focusOf(a.src) || a.pos || 'center top',
  alt: a.alt || '',
}));
const reviews = (isFounders
  ? mergeBy(
    arrOf(p.reviews_json),
    foundersReviews,
    (r) => keyOf(r && r.name),
  )
  : arrOf(
    p.reviews_json,
  )).map((r: any) => (r && r.platform ? { ...r, platform: privateLabel(regionOnly(String(r.platform))) } : r));
const gallery = (isFounders
  ? foundersGallery
  : arrOf(
    p.gallery_json,
  )).map((g: Pic) => ({
  src: local(g.src),
  alt: g.alt || '',
  cap: (g as any).cap || '',
}));
const platforms = list(
  p.platforms_json,
  F ? platDef : [],
).filter((x: any) => !offSite.test(String(x && x.name || '') + ' ' + String(x && x.url || '')));
const ownRevs = isFounders
  ? reviews.length
  : arrOf(p.reviews_json)
    .length;
// review_total: reviews
// across every platform
// (more than are written
// out on the page).
const totalRevs = Math.max(
  ownRevs,
  Number(
    p.review_total,
  ) || 0,
  isFounders
    ? FOUNDERS_REVIEW_TOTAL
    : 0,
);
const revCount =
  totalRevs
    ? totalRevs +
      (F ? '+' : '')
    : '0';
const hasRevs =
  reviews.length > 0;
// The stats band has
// founder-only figures.
const showStats = F;
const plats = platforms
  .map((x: any) => ({
    ...x,
    initial: String(
      x.name || '',
    )
    .charAt(0)
    .toUpperCase(),
  }));
const platCount =
  String(
    platforms.length,
  );
const rating = '5.0';
const location =
  p.location ||
  (F ? 'UK & Australia'
    : '');
const waNum = String(
  p.whatsapp_number ||
  '',
).replace(
  /[^0-9]/g,
  '',
);
const waHref =
  'https://wa.me/' +
  waNum;
const blurb =
  p.name
    ? name +
      ' — experienced' +
      ' house and pet' +
      ' sitters.'
    : blurbDef;
const pageSlug =
  p.slug || slug;
const ogSrc =
  hero[0]?.src ||
  '/images/logo-tile.png';
const ogImage =
  ogSrc.startsWith('http')
    ? ogSrc
    : Astro.site +
      ogSrc.slice(1);
const title =
  name + ' — MYAH';
// Photos shown before "Show all" (keeps the page short).
const GAL_FIRST = 6;
// Page design: Basic is the classic layout below, Premium the 'Signature'
// design (the founders' page, owner 26 Oct 2026). The founders always get
// Premium; everyone else gets what they picked on their edit page (Premium
// needs a Premium membership once payments are on, see lib/tier.ts).
// ?layout=basic|premium lets the page's own member preview either design;
// ?layout=classic still shows the founders' old page.
const want = Astro.url.searchParams.get('layout');
let SIGNATURE = isFounders
  ? want !== 'classic'
  : layoutOf(p, PAYMENTS_ENABLED ? await getBilling(p.user_id).catch(() => null) : null) === 'premium';
if (!isFounders && (want === 'basic' || want === 'premium')) {
  const viewer = await getAccount(Astro.request).catch(() => null);
  if (viewer?.profile?.id === p.id) SIGNATURE = want === 'premium';
}
// "We" for couples, "I" for solo sitters, in the wording the member can't edit.
const joint = !!nameB || p.account_type === 'joint';
// Section headings from the edit page; blank keeps these defaults. A title is
// split at " — " so the second half shows in italics.
const hj = jsonObj(p.headings_json);
const hv = (k: string, d: string) => String(hj[k] || '').trim() || d;
const head = {
  aboutLabel: hv('about_label', joint ? 'Who we are' : 'Who I am'),
  aboutTitle: hv('about_title', 'A home away from home — for you and your pets.'),
  reviewsLabel: hv('reviews_label', 'What pet owners say'),
  reviewsTitle: hv('reviews_title', revCount + ' — five-star reviews'),
  galleryLabel: hv('gallery_label', joint ? "Pets we've loved" : "Pets I've loved"),
  galleryTitle: hv('gallery_title', joint ? 'Our — sits' : 'My — sits'),
  platformsLabel: hv('platforms_label', joint ? 'Find us online' : 'Find me online'),
  platformsTitle: hv('platforms_title', 'Verified profiles'),
  enquiryLabel: hv('enquiry_label', 'Get in touch'),
  enquiryTitle: hv('enquiry_title', 'Book ' + nameA + (nameB ? ' — ' + nameB.replace(/^&\s*/, '& ') : '')),
};
const split = (t: string) => {
  const i = t.indexOf(' — ');
  return i < 0 ? [t, ''] : [t.slice(0, i), t.slice(i + 3)];
};
// Colours from the edit page (defaults are MYAH's own).
const tj = jsonObj(p.theme_json);
const hex = (v: unknown, d: string) => (/^#[0-9a-fA-F]{6}$/.test(String(v)) ? String(v) : d);
const theme = {
  bg: hex(tj.background, '#faf6ee'),
  accent: hex(tj.accent, '#2f5d45'),
  light: hex(tj.accent_light, '#c4ab8a'),
  text: hex(tj.text, '#2c1a0e'),
  soft: hex(tj.text_soft, '#6b4e35'),
};
const themeVars = `--bg:${theme.bg};--ac:${theme.accent};--hl:${theme.light};--tx:${theme.text};--tx2:${theme.soft}`;
const sigProps = { name, nameA, nameB, tagline, badge, hero, about, bio: bioParas, reviews, revCount, rating, gallery, plats, waNum, waHref, location, launched: LAUNCHED, pageSlug, title, blurb, ogImage, isFounders, joint, head, theme };
---

<!doctype html>
{SIGNATURE ? <SignatureProfile {...sigProps} /> : (
<html lang="en" style={themeVars}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={blurb} />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={blurb} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
  <link rel="canonical" href={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:url" content={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:site_name" content="MYAH" />
  <style is:global>
    body { margin:0; background:var(--bg); color:var(--tx); font-family:"Montserrat",sans-serif; overflow-x:hidden; }
    * { box-sizing:border-box; }
    a { color:var(--ac); }
    a:hover { color:var(--tx); }
    input::placeholder, textarea::placeholder { color:rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform:rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }

    .sp-nav-link:hover { color:var(--ac) !important; }
    .sp-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; color:#fff !important; }
    .sp-btn:active { transform:translateY(0) scale(.98) !important; }
    .sp-scroll:hover { background:rgba(250,246,238,.25) !important; transform:translateX(-50%) translateY(3px) !important; color:#fff !important; }
    .sp-about-btn:hover { background:#fff !important; }
    .sp-rev-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .sp-rev-btn:hover { background:var(--ac) !important; color:#fff !important; border-color:var(--ac) !important; }
    .sp-gal-cap:hover { opacity:1 !important; }
    .sp-plat:hover { transform:translateY(-6px) !important; box-shadow:0 20px 50px rgba(44,26,14,.1) !important; border-color:rgba(110,84,56,.45) !important; }
    .sp-wa:hover { background:#1ebe5d !important; transform:translateY(-2px) !important; color:#fff !important; }
    .sp-wa:active { transform:translateY(0) scale(.98) !important; }
    .sp-field:focus { border-color:var(--ac) !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; }
    .sp-lb-close:hover { background:rgba(250,246,238,.25) !important; }
    .sp-foot-link:hover { color:var(--hl) !important; }

    @media (max-width: 1000px) {
      [data-header-nav] { display: none !important; }
      [data-topbar] { padding: 14px 24px !important; }
      [data-sec] { padding-left: 24px !important; padding-right: 24px !important; }
      [data-split] { grid-template-columns: minmax(0,1fr) !important; gap: 40px !important; }
    }
    @media (max-width: 640px) {
      [data-topbar] { padding: 10px 16px !important; }
      [data-hero] { padding: 104px 20px 56px !important; min-height: 70vh !important; }
      [data-hero-title] { font-size: 2.7rem !important; letter-spacing: .16em !important; margin-bottom: 14px !important; }
      [data-sec] { padding: 64px 18px !important; }
      [data-stats] { grid-template-columns: repeat(2, minmax(0,1fr)) !important; }
      [data-stats] > div { padding: 22px 10px !important; border-bottom: 1px solid rgba(196,171,138,.18) !important; }
      [data-rev-card] { min-width: 100% !important; max-width: 100% !important; padding: 24px 20px !important; }
      [data-gal] { grid-template-columns: repeat(2, minmax(0,1fr)) !important; gap: 10px !important; }
      .sp-gal-cap { font-size: .72rem !important; padding: 10px !important; }
      .sp-scroll { display: none !important; }
      [data-stats] { padding: 0 !important; }
    }
    /* Phones and tablets have no hover: show photo captions all the time */
    @media (hover: none) {
      .sp-gal-cap { opacity: 1 !important; background: linear-gradient(to top, rgba(44,26,14,.72) 0%, transparent 55%) !important; }
    }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
<div style="background:var(--bg)">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:var(--ac);border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <header data-topbar="1" style="position:fixed;top:0;left:0;right:0;z-index:210;padding:16px 48px;display:flex;justify-content:space-between;align-items:center;gap:40px;background:rgba(250,246,238,.97);backdrop-filter:blur(12px);box-shadow:0 1px 0 rgba(110,84,56,.2)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.4rem;flex-shrink:0;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:46px;width:46px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:var(--ac);line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
    </a>
    <nav data-header-nav="1" style="display:flex;align-items:center;gap:30px;flex-wrap:nowrap">
      <a href="#about" class="sp-nav-link" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">About</a>
{hasRevs && (
      <a href="#reviews" class="sp-nav-link" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Reviews</a>
)}
{gallery.length > 0 && (
      <a href="#gallery" class="sp-nav-link" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Gallery</a>
)}
{LAUNCHED ? (
      <a href="/listings" class="sp-nav-link" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Profiles</a>
) : (
      <a href="#launch" class="sp-nav-link" style="font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Launching soon</a>
)}
