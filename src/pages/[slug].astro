<script is:inline>
  (function () {
    // Gallery: first photos only until "Show all".
    var all = document.querySelector('[data-show-all]');
    if (all) all.addEventListener('click', function () {
      var g = document.querySelector('[data-gal]'); var open = g.classList.toggle('sp-open');
      all.setAttribute('aria-expanded', String(open));
      all.textContent = open ? 'Show fewer photos' : 'Show all ' + g.children.length + ' photos';
      if (!open) g.scrollIntoView({ block: 'start' });
    });
    // Long bio on phones: fold behind "Read more".
    var bio = document.querySelector('[data-bio]'), more = document.querySelector('[data-read-more]');
    function fold() {
      if (!bio || !more) return;
      var phone = window.matchMedia('(max-width: 640px)').matches;
      if (!phone) { bio.classList.remove('sp-clamp'); more.hidden = true; return; }
      if (more.dataset.open) return;
      bio.classList.add('sp-clamp'); more.hidden = bio.scrollHeight <= bio.clientHeight + 8;
      if (more.hidden) bio.classList.remove('sp-clamp');
    }
    if (more) more.addEventListener('click', function () {
      var open = !more.dataset.open; if (open) { more.dataset.open = '1'; bio.classList.remove('sp-clamp'); more.textContent = 'Read less'; }
      else { delete more.dataset.open; more.textContent = 'Read more'; fold(); bio.scrollIntoView({ block: 'nearest' }); }
    });
    fold(); window.addEventListener('resize', fold);
    // Booking form opens from "Send an enquiry" or any "Book" link.
    var enq = document.querySelector('.sp-enq');
    function openEnq(focus) {
      if (!enq || enq.classList.contains('open')) return;
      enq.classList.add('open');
      if (focus) { var f = enq.querySelector('input'); if (f) setTimeout(function () { f.focus({ preventScroll: true }); }, 350); }
    }
    var eo = document.querySelector('[data-enq-open]');
    if (eo) eo.addEventListener('click', function () { openEnq(true); enq.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    document.querySelectorAll('a[href="#enquiry"]').forEach(function (a) { a.addEventListener('click', function () { openEnq(false); }); });
    if (location.hash === '#enquiry') openEnq(false);
    // Phone dock: appears once the visitor is past the top photo.
    var dock = document.querySelector('[data-dock]'), hero = document.querySelector('[data-hero]');
    if (dock && hero) {
      var tick = function () { dock.classList.toggle('on', hero.getBoundingClientRect().bottom < 80); };
      window.addEventListener('scroll', tick, { passive: true }); tick();
    }
  })();
</script>
