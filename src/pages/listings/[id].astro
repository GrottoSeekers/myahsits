---
// Data: the active
// listing and its
// owner's profile (pets,
// amenities, photos,
// looking_for). Guests
// enquire by email via
// /api/enquiry; signed-in
// users open a chat via
// /api/messages/start.
export const prerender =
  false;
import IdGate from
  '../_idgate.astro';
import AppNav from
  '../_nav.astro';
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';
import {
  arr,
} from
  '../../lib/dashboard';
import {
  getAccount,
} from
  '../../lib/account';
import HomeDetails from '../../components/HomeDetails.astro';
import OwnerReviews from '../../components/OwnerReviews.astro';
import { homeOf, homeFacts } from '../../lib/home';
import OwnSitPanel from
  './_own.astro';

const session =
  await getSession(
    Astro.request,
  );
// Who is looking, and on
// which side they are.
const acct =
  await getAccount(
    Astro.request,
  );
const viewer: any =
  acct?.profile
    ? {
      ...acct.profile,
      profile_type:
        acct.side,
    }
    : null;
const viewerIsOwner =
  acct?.side === 'owner';

const { id } =
  Astro.params;
const lr =
  await supabase
  .from('listings')
  .select(
    '*, profiles!inner(*)',
  )
  .eq('id', id)
  .single();
const listing: any =
  lr.data;
// An owner looking at
// their own sit gets the
// owner view (even once
// it is filled); other
// owners' sits are for
// sitters, so owners go
// back to their dashboard.
const isMine = !!(
  listing &&
  viewer &&
  listing.profile_id ===
    viewer.id
);
if (
  listing &&
  viewerIsOwner &&
  !isMine
) {
  return Astro.redirect(
    '/owner/dashboard',
  );
}
if (
  !listing ||
  (listing.status !==
    'active' &&
    !isMine)
) {
  return Astro.redirect(
    '/listings',
  );
}
let applicants: any[] = [];
if (isMine) {
  try {
    const ar =
      await supabase
      .from('applications')
      .select(
        'id, status,' +
        ' created_at,' +
        ' profiles(' +
        'name, profile_pic)',
      )
      .eq(
        'listing_id',
        listing.id,
      )
      .order(
        'created_at',
        {
          ascending: false,
        },
      );
    applicants = (
      ar.data ?? []
    ).map((a: any) => ({
      id: a.id,
      status: a.status,
      name:
        a.profiles?.name ||
        'A sitter',
      pic:
        a.profiles
          ?.profile_pic ||
        null,
      when: new Date(
        a.created_at,
      ).toLocaleDateString(
        'en-GB',
        {
          day: 'numeric',
          month: 'short',
        },
      ),
    }));
  } catch {}
}

const owner: any =
  listing.profiles;
const pets = arr(
  owner?.pets_json,
);
const amenities: string[] =
  arr(
    owner?.amenities_json,
  );
const heroImages = arr(
  owner?.hero_images_json,
).filter(
  (i: any) => i?.src,
);
const gallery = arr(
  owner?.gallery_json,
).filter(
  (i: any) => i?.src,
);
const allPhotos = [
  ...heroImages,
  ...gallery,
];
// Airbnb-style details (round 3): the home in detail, reviews, a photo mosaic.
const home = homeOf(owner);
const facts = homeFacts(home);
const ownerReviews = arr(owner?.reviews_json).filter((r: any) => r && r.text).map((r: any) => ({ text: String(r.text), name: String(r.name || '').split(/\s+/)[0] || 'Sitter', initials: r.initials, platform: r.platform }));
const mosaic = allPhotos.slice(0, 5).map((p: any) => String(p.src).replace(/^public\//, '/'));
const heroSrc =
  heroImages[0]?.src ||
  '/images/' +
  'slideshow-living-' +
  'room.jpeg';

const fmt = (
  d: string,
  long: boolean,
) =>
  new Date(
    d + 'T00:00:00Z',
  ).toLocaleDateString(
    'en-GB',
    long
      ? {
        weekday: 'short',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }
      : {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      },
  ).replace(',', '');
const days = Math.max(
  1,
  Math.round(
    (+new Date(
      listing.date_to,
    ) -
      +new Date(
        listing.date_from,
      )) /
      86400000,
  ),
);
const dayLabel =
  days +
  (days === 1
    ? ' day'
    : ' days');
const dateRange =
  fmt(
    listing.date_from,
    false,
  ) +
  ' — ' +
  fmt(
    listing.date_to,
    false,
  );
const fromLong = fmt(
  listing.date_from,
  true,
);
const toLong = fmt(
  listing.date_to,
  true,
);

// Sample copy, as in
// the design:
/*
Cosy cottage with two spaniels
We're away for two weeks in October and looking for a couple or solo sitter to look after the cottage and our two spaniels, Solomon and Chester.
The house is a three-bedroom stone cottage on the edge of the village, with a walled garden the dogs can come and go from. The pub is a five-minute walk and Bath is twenty minutes by bus, so there's no need for a car.
Sitters who are happy to be home most evenings, comfortable with two energetic dogs, and able to keep us updated with the odd photo. Previous sitting references appreciated but not essential.
*/
const paras = (
  v: string,
) =>
  String(v || '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
const aboutParas = paras(
  listing.description,
);
const wantParas = paras(
  owner?.looking_for,
);

const ownerName: string =
  owner?.name || 'the owner';
const ownerFirst =
  ownerName.split(' ')[0];
const ownerLoc: string =
  owner?.location || '';
const ownerHref =
  owner?.slug
    ? '/' + owner.slug
    : '#enquiry';
const initial = (
  s: string,
) =>
  (s || '?')
    .trim()
    .charAt(0)
    .toUpperCase();
const sendLine = `
Send a message to Thomas James about this sit.
`
  .trim()
  .replace(
    'Thomas James',
    ownerName,
  );
const msgLabel =
  'Message ' + ownerFirst;

const petCards = pets.map(
  (p: any) => ({
    name: p?.name || '',
    photo:
      p?.photo_url || '',
    meta: [
      p?.type,
      p?.breed,
      p?.age,
    ]
      .filter(Boolean)
      .join(' · '),
    temperament:
      p?.temperament || '',
    needs:
      p?.special_needs ||
      '',
  }),
);

// At a glance. As in
// the design:
/*
Two spaniels — Solomon & Chester
Three-bed cottage, walled garden
*/
const petNames = pets
  .map((p: any) => p?.name)
  .filter(Boolean);
const glancePets =
  petNames.length > 2
    ? petNames
      .slice(0, 2)
      .join(' & ') +
      ' +' +
      (petNames.length -
        2) +
      ' more'
    : petNames.join(' & ');
const glanceHome =
  amenities
    .slice(0, 3)
    .join(', ') +
  (amenities.length > 3
    ? ' +' +
      (amenities.length -
        3) +
      ' more'
    : '');

const isLoggedIn =
  !!session;
// ID approved: needed to
// apply and to message.
const idOk =
  viewer?.verified_id ===
  true;
const canMessage = !!(
  viewer &&
  viewer.verified_id ===
    true &&
  !viewerIsOwner &&
  viewer.id !== owner.id
);
// Signed-in sitters can
// apply; show their
// status if they have.
const canApply = !!(
  viewer &&
  viewer.profile_type ===
    'sitter' &&
  viewer.id !== owner.id
);
let applied = '';
if (canApply) {
  try {
    const ar =
      await supabase
      .from('applications')
      .select('status')
      .eq(
        'listing_id',
        listing.id,
      )
      .eq(
        'profile_id',
        viewer.id,
      )
      .maybeSingle();
    applied =
      ar.data?.status || '';
  } catch {}
}
const APPLIED: Record<
  string,
  string
> = {
  new: 'Applied',
  shortlisted:
    'Shortlisted',
  declined:
    'Not this time',
  confirmed: 'Confirmed',
};
const appliedLabel =
  APPLIED[applied] || '';
const appliedNote =
  ownerFirst +
  ' has your' +
  ' application';
const dashUrl =
  acct?.home ||
  '/dashboard';
const backHref = isMine
  ? '/owner/dashboard'
  : '/listings';
const backDash =
  '← Back to' +
  ' dashboard';
const waNumber = String(
  owner?.whatsapp_number ||
    '',
).replace(/[^0-9]/g, '');
const waHref =
  'https://wa.me/' +
  waNumber;
const ownerId = owner.id;
const listingId =
  listing.id;
const ownerSlug =
  owner.slug || '';
const dateFrom =
  listing.date_from;
const dateTo =
  listing.date_to;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>{listing.title} — MYAH</title>
  <link rel="canonical" href={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:url" content={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:site_name" content="MYAH" />
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 1000px) {
      [data-header-nav] { display: none !important; }
      [data-topbar] { padding: 16px 24px !important; }
      [data-page-pad] { padding: 28px 24px 80px !important; }
      [data-detail-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
    }
    @media (max-width: 700px) {
      [data-eq-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-foot-grid] { grid-template-columns: minmax(0,1fr) !important; gap: 36px !important; }
    }

    [data-enquiry] input:focus, [data-enquiry] textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; }
    .sd-nav:hover { color:#2f5d45 !important; }
    .sd-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .sd-btn:active { transform:translateY(0) scale(.98) !important; }
    .sd-back:hover { gap:13px !important; color:#2c1a0e !important; }
    .sd-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .sd-photo:hover { transform:scale(1.03) !important; }
    .sd-wa:hover { background:#1da851 !important; transform:translateY(-2px) !important; }
    .sd-wa:active { transform:translateY(0) scale(.98) !important; }
    .sd-foot:hover { color:#c4ab8a !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <style is:global>
    .ld-head { margin:0 0 18px; }
    .ld-head h1 { font:400 2.3rem/1.15 'Marcellus',serif; margin:0 0 10px; color:#2c1a0e; }
    .ld-sub { display:flex; flex-wrap:wrap; align-items:center; gap:6px 16px; font-size:.9rem; color:#2c1a0e; }
    .ld-sub a { color:#2c1a0e; text-decoration:underline; }
    .ld-pill { padding:5px 12px; border-radius:50px; background:#2f5d45; color:#fff; font-size:.74rem; font-weight:600; }
    .ld-mosaic { position:relative; display:grid; gap:8px; height:440px; margin:0 0 34px; border-radius:20px; overflow:hidden; grid-template-columns:2fr 1fr 1fr; grid-template-rows:1fr 1fr; }
    .ld-mosaic > button[class^="ld-m"] { border:0; padding:0; background:#e9e0d2; cursor:zoom-in; overflow:hidden; }
    .ld-mosaic img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease, filter .3s; }
    .ld-mosaic > button:hover img { transform:scale(1.03); filter:brightness(.92); }
    .ld-m0 { grid-row:1 / 3; }
    .ld-mosaic.n1 { grid-template-columns:1fr; } .ld-mosaic.n1 .ld-m0 { grid-row:auto; }
    .ld-mosaic.n2 { grid-template-columns:2fr 1fr; } .ld-mosaic.n2 .ld-m1 { grid-row:1 / 3; }
    .ld-mosaic.n3 { grid-template-columns:2fr 1fr; }
    .ld-mosaic.n4 { grid-template-columns:2fr 1fr 1fr; } .ld-mosaic.n4 .ld-m3 { grid-column:2 / 4; }
    .ld-all { position:absolute; right:16px; bottom:16px; display:inline-flex; align-items:center; gap:8px; padding:10px 16px; border-radius:10px; background:#fff; border:1px solid #2c1a0e; font:600 .8rem 'Montserrat',sans-serif; color:#2c1a0e; cursor:pointer; }
    .ld-count { display:none; }
    .ld-shots { position:fixed; inset:0; z-index:9000; background:#faf6ee; overflow-y:auto; animation:ld-up .35s ease both; }
    @keyframes ld-up { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:none; } }
    .ld-shots-bar { position:sticky; top:0; display:flex; justify-content:space-between; align-items:center; padding:16px 24px; background:rgba(250,246,238,.96); backdrop-filter:blur(10px); border-bottom:1px solid rgba(110,84,56,.15); font-size:.86rem; color:#6b4e35; }
    .ld-shots-bar button { border:0; background:none; font:600 .86rem 'Montserrat',sans-serif; color:#2c1a0e; cursor:pointer; }
    .ld-shots-grid { max-width:860px; margin:0 auto; padding:24px; display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .ld-shots-grid img { width:100%; border-radius:12px; display:block; }
    .ld-shots-grid img:nth-child(3n+1) { grid-column:1 / -1; }
    .ld-host { display:flex; align-items:center; gap:16px; padding:0 0 22px; border-bottom:1px solid rgba(110,84,56,.16); }
    .ld-host > img, .ld-host > span { width:56px; height:56px; border-radius:50%; object-fit:cover; flex:none; background:#e9e0d2; display:flex; align-items:center; justify-content:center; font:400 1.4rem 'Marcellus',serif; color:#2f5d45; }
    .ld-host b { display:block; font:400 1.25rem 'Marcellus',serif; color:#2c1a0e; }
    .ld-host b a { color:#2f5d45; text-decoration:none; }
    .ld-host small { font-size:.86rem; color:#6b4e35; }
    .ld-verified { margin-left:auto; flex:none; font-style:normal; font-size:.72rem; font-weight:600; color:#2f5d45; background:#eef4ef; border-radius:50px; padding:6px 12px; }
    .ld-hl { list-style:none; margin:0; padding:4px 0 22px; display:grid; gap:14px; border-bottom:1px solid rgba(110,84,56,.16); }
    .ld-hl li { display:flex; align-items:center; gap:14px; font-size:.96rem; color:#2c1a0e; }
    .ld-hl span { width:36px; height:36px; border-radius:50%; flex:none; display:flex; align-items:center; justify-content:center; background:#eef4ef; color:#2f5d45; font-size:.75rem; }
    .ld-dates { display:grid; grid-template-columns:1fr 1fr; border:1px solid rgba(110,84,56,.35); border-radius:12px; overflow:hidden; }
    .ld-dates > div { padding:10px 12px; display:flex; flex-direction:column; gap:3px; }
    .ld-dates > div + div { border-left:1px solid rgba(110,84,56,.35); }
    .ld-dates small { font-size:.6rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#2c1a0e; }
    .ld-dates b { font-size:.82rem; font-weight:500; color:#2c1a0e; }
    @media (max-width:900px) {
      .ld-head h1 { font-size:1.7rem; }
      .ld-mosaic { display:flex; height:auto; aspect-ratio:4/3; margin:0 -24px 24px; border-radius:0; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; gap:0; }
      .ld-mosaic::-webkit-scrollbar { display:none; }
      .ld-mosaic > button[class^="ld-m"] { flex:none; width:100%; scroll-snap-align:start; }
      .ld-all { display:none; }
      .ld-count { display:block; position:sticky; left:calc(100% - 70px); align-self:flex-end; margin:0 0 14px -64px; flex:none; padding:5px 11px; border-radius:50px; background:rgba(20,13,7,.6); color:#fff; font-size:.72rem; font-weight:600; }
      .ld-shots-grid { grid-template-columns:1fr; padding:12px; }
      .ld-verified { display:none; }
    }
    @media (max-width:640px) {
      .ld-mosaic { margin:0 -16px 20px; }
      .sd-card { padding:20px !important; }
      .sd-card h2 { font-size:1.25rem !important; }
      #sit-pets [style*="minmax(270px"] { display:flex !important; overflow-x:auto; scrollbar-width:none; gap:10px !important; margin:0 -20px; padding:0 20px; scroll-snap-type:x mandatory; }
      #sit-pets [style*="minmax(270px"] > div { flex:none; width:82%; scroll-snap-align:start; padding:14px !important; }
      [data-aside] > div:last-child { display:none !important; }
      #enquiry { padding:22px 20px !important; }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  {acct ? (
<AppNav side={acct.side} active={viewerIsOwner ? "sits" : "browse"} />
) : (
<header data-topbar="1" data-screen-label="Header" style="position:sticky;top:0;z-index:210;padding:16px 48px;display:flex;justify-content:space-between;align-items:center;gap:40px;background:rgba(250,246,238,.97);backdrop-filter:blur(12px);box-shadow:0 1px 0 rgba(110,84,56,.2)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.4rem;flex-shrink:0;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:46px;width:46px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:#2f5d45;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
    </a>
    <nav data-header-nav="1" style="display:flex;align-items:center;gap:32px;flex-wrap:nowrap">
      <a href="/" class="sd-nav" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Home</a>
{!viewerIsOwner && (
      <a href="/listings" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;white-space:nowrap;border-bottom:2px solid #2f5d45;padding-bottom:3px">Browse sits</a>
)}
      {isLoggedIn ? (
        <a href={dashUrl} class="sd-nav" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Dashboard</a>
      ) : (
        <a href="/login" class="sd-nav" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Log in</a>
      )}
      {!isLoggedIn && (
        <a href="/signup" class="sd-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 4px 14px rgba(44,26,14,.18);transition:background .2s, border-color .2s, transform .12s">Get started</a>
      )}
    </nav>
  </header>
)}

  <main data-screen-label="Sit detail" data-page-pad="1" style="flex:1;padding:40px 48px 100px">
    <div style="max-width:1100px;margin:0 auto">
{isMine ? (
      <a href="/owner/dashboard" class="sd-back" style="display:inline-flex;align-items:center;gap:9px;margin-bottom:28px;font-size:.78rem;color:#2f5d45;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:gap .2s, color .2s">{backDash}</a>
) : (
      <a href="/listings" class="sd-back" style="display:inline-flex;align-items:center;gap:9px;margin-bottom:28px;font-size:.78rem;color:#2f5d45;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:gap .2s, color .2s">&larr; Back to all sits</a>
)}
      {isMine && <OwnSitPanel variant="banner" listing={listing} applicants={applicants} />}

