        {allPhotos.length > 1 && <button type="button" class="ld-all" data-shot="0"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Show all {allPhotos.length} photos</button>}
        {allPhotos.length > 1 && <span class="ld-count" data-count-pill>1 / {allPhotos.length}</span>}
      </div>
      <div class="ld-shots" data-shots hidden>
        <div class="ld-shots-bar"><button type="button" data-shots-close aria-label="Close">&larr; Back</button><span>{allPhotos.length} photos</span></div>
        <div class="ld-shots-grid">{allPhotos.map((p: any) => <img src={String(p.src).replace(/^public\//, '/')} alt={p.alt || ''} loading="lazy" />)}</div>
