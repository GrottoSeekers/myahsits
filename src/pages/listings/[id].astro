              ))}
            </section>
          )}

          {petCards.length > 0 && (
            <section id="sit-pets" class="sd-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
