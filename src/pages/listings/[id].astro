              )}
              {glanceHome && (
                <span style="display:flex;align-items:center;gap:10px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>{glanceHome}</span>
              )}
              <span style="display:flex;align-items:center;gap:10px"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>{dayLabel}</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <footer data-screen-label="Footer" style="background:#2c1a0e;color:rgba(255,255,255,.7);padding:0 48px 32px;border-top:3px solid #2f5d45">
    <div style="max-width:1100px;margin:0 auto">
      <div data-foot-grid="1" style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr) minmax(0,1fr);gap:56px;padding:64px 0 44px">
        <div style="display:flex;flex-direction:column;gap:18px;align-items:flex-start">
          <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.7rem;letter-spacing:.28em">
            <img src="/images/logo-mark-white.png" alt="" style="height:46px;width:46px;display:block;object-fit:contain" />
            <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(255,255,255,.28)"><span style="color:#fff;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.75);line-height:1">Make Yourself At Home</span></span>
          </a>
          <div style="display:flex;flex-direction:column;gap:12px;max-width:340px"><p style="font-family:'Lato',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:#c4ab8a;margin:0">Make Yourself At Home</p><p style="line-height:1.8;font-size:.95rem;margin:0;color:rgba(255,255,255,.7)">Premium pet &amp; home care for peace of mind while you travel.</p></div>
          <a href="/signup" class="sd-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;margin-top:6px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Sign up for free</a>
        </div>
        <div>
          <h4 style="color:#fff;font-size:.76rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin:0 0 20px;padding-bottom:14px;border-bottom:1px solid rgba(196,171,138,.28)">Platform</h4>
          <ul style="list-style:none;padding:0;margin:0">
            <li style="margin-bottom:12px"><a href="/signup" class="sd-foot" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;transition:color .2s">Get started</a></li>
            <li style="margin-bottom:12px"><a href="/login" class="sd-foot" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;transition:color .2s">Log in</a></li>
            <li style="margin-bottom:12px"><a href="/listings" class="sd-foot" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;transition:color .2s">Browse sits</a></li>
          </ul>
        </div>
        <div>
          <h4 style="color:#fff;font-size:.76rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;margin:0 0 20px;padding-bottom:14px;border-bottom:1px solid rgba(196,171,138,.28)">Example profile</h4>
          <ul style="list-style:none;padding:0;margin:0">
            <li style="margin-bottom:12px"><a href="/callumandniamh" class="sd-foot" style="color:rgba(255,255,255,.62);text-decoration:none;font-size:.92rem;transition:color .2s">Callum &amp; Niamh</a></li>
