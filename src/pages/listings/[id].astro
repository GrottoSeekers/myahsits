                    <textarea id="eq_message" name="message" rows="5" required="required" placeholder="Tell them about your experience, availability, and why you'd be a great fit for this sit." style="border:1.5px solid rgba(44,26,14,.2);border-radius:10px;padding:12px 15px;font-size:.95rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s"></textarea>
                  </div>
                </div>
                <button type="submit" class="sd-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;align-self:flex-start;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .2s, border-color .2s, transform .12s">Send message</button>
