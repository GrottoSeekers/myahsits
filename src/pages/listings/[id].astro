                <span style="font-size:.85rem;color:#6b4e35">or</span>
                <a href={waHref} target="_blank" rel="noopener noreferrer" class="sd-wa" style="display:inline-flex;align-items:center;justify-content:center;gap:9px;background:#25D366;color:#fff;text-decoration:none;padding:13px 26px;border-radius:50px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;box-shadow:0 6px 20px rgba(37,211,102,.25);transition:background .2s, transform .12s">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
