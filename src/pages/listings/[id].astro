---
// Data: the active
// listing and its
// owner's profile (pets,
// amenities, photos,
// looking_for). Guests
// enquire by email via
// /api/enquiry; signed-in
// users open a chat via
// /api/messages/start.
export const prerender =
  false;
import IdGate from
  '../_idgate.astro';
import AppNav from
  '../_nav.astro';
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';
import {
  arr,
} from
  '../../lib/dashboard';
import {
  getAccount,
} from
  '../../lib/account';
import OwnSitPanel from
  './_own.astro';

const session =
  await getSession(
    Astro.request,
  );
// Who is looking, and on
// which side they are.
const acct =
  await getAccount(
    Astro.request,
  );
const viewer: any =
  acct?.profile
    ? {
      ...acct.profile,
      profile_type:
        acct.side,
    }
    : null;
const viewerIsOwner =
  acct?.side === 'owner';

const { id } =
  Astro.params;
const lr =
  await supabase
  .from('listings')
  .select(
    '*, profiles!inner(*)',
  )
  .eq('id', id)
  .single();
const listing: any =
  lr.data;
// An owner looking at
// their own sit gets the
// owner view (even once
// it is filled); other
// owners' sits are for
// sitters, so owners go
// back to their dashboard.
const isMine = !!(
  listing &&
  viewer &&
  listing.profile_id ===
    viewer.id
);
if (
  listing &&
  viewerIsOwner &&
  !isMine
) {
  return Astro.redirect(
    '/owner/dashboard',
  );
}
if (
  !listing ||
  (listing.status !==
    'active' &&
    !isMine)
) {
  return Astro.redirect(
    '/listings',
  );
}
let applicants: any[] = [];
if (isMine) {
  try {
    const ar =
      await supabase
      .from('applications')
      .select(
        'id, status,' +
        ' created_at,' +
        ' profiles(' +
        'name, profile_pic)',
      )
      .eq(
        'listing_id',
        listing.id,
      )
      .order(
        'created_at',
        {
          ascending: false,
        },
      );
    applicants = (
      ar.data ?? []
    ).map((a: any) => ({
      id: a.id,
      status: a.status,
      name:
        a.profiles?.name ||
        'A sitter',
      pic:
        a.profiles
          ?.profile_pic ||
        null,
      when: new Date(
        a.created_at,
      ).toLocaleDateString(
        'en-GB',
        {
          day: 'numeric',
          month: 'short',
        },
      ),
    }));
  } catch {}
}

const owner: any =
  listing.profiles;
const pets = arr(
  owner?.pets_json,
);
const amenities: string[] =
  arr(
    owner?.amenities_json,
  );
const heroImages = arr(
  owner?.hero_images_json,
).filter(
  (i: any) => i?.src,
);
const gallery = arr(
  owner?.gallery_json,
).filter(
  (i: any) => i?.src,
);
const allPhotos = [
  ...heroImages,
  ...gallery,
];
const heroSrc =
  heroImages[0]?.src ||
  '/images/' +
  'slideshow-living-' +
  'room.jpeg';

const fmt = (
  d: string,
  long: boolean,
) =>
  new Date(
    d + 'T00:00:00Z',
  ).toLocaleDateString(
    'en-GB',
    long
      ? {
        weekday: 'short',
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }
      : {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      },
  ).replace(',', '');
const days = Math.max(
  1,
  Math.round(
    (+new Date(
      listing.date_to,
    ) -
      +new Date(
        listing.date_from,
      )) /
      86400000,
  ),
);
const dayLabel =
  days +
  (days === 1
    ? ' day'
    : ' days');
const dateRange =
  fmt(
    listing.date_from,
    false,
  ) +
  ' — ' +
  fmt(
    listing.date_to,
    false,
  );
const fromLong = fmt(
  listing.date_from,
  true,
);
const toLong = fmt(
  listing.date_to,
  true,
);

// Sample copy, as in
// the design:
/*
Cosy cottage with two spaniels
We're away for two weeks in October and looking for a couple or solo sitter to look after the cottage and our two spaniels, Solomon and Chester.
The house is a three-bedroom stone cottage on the edge of the village, with a walled garden the dogs can come and go from. The pub is a five-minute walk and Bath is twenty minutes by bus, so there's no need for a car.
Sitters who are happy to be home most evenings, comfortable with two energetic dogs, and able to keep us updated with the odd photo. Previous sitting references appreciated but not essential.
*/
const paras = (
  v: string,
) =>
  String(v || '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
const aboutParas = paras(
  listing.description,
);
const wantParas = paras(
  owner?.looking_for,
);

const ownerName: string =
  owner?.name || 'the owner';
const ownerFirst =
  ownerName.split(' ')[0];
const ownerLoc: string =
  owner?.location || '';
const ownerHref =
  owner?.slug
    ? '/' + owner.slug
    : '#enquiry';
const initial = (
  s: string,
) =>
  (s || '?')
    .trim()
    .charAt(0)
    .toUpperCase();
const sendLine = `
Send a message to Thomas James about this sit.
`
  .trim()
  .replace(
    'Thomas James',
    ownerName,
  );
const msgLabel =
  'Message ' + ownerFirst;

const petCards = pets.map(
  (p: any) => ({
    name: p?.name || '',
    photo:
      p?.photo_url || '',
    meta: [
      p?.type,
      p?.breed,
      p?.age,
    ]
      .filter(Boolean)
      .join(' · '),
    temperament:
      p?.temperament || '',
    needs:
      p?.special_needs ||
      '',
  }),
);

// At a glance. As in
// the design:
/*
Two spaniels — Solomon & Chester
Three-bed cottage, walled garden
*/
const petNames = pets
  .map((p: any) => p?.name)
  .filter(Boolean);
const glancePets =
  petNames.length > 2
    ? petNames
      .slice(0, 2)
      .join(' & ') +
      ' +' +
      (petNames.length -
        2) +
      ' more'
    : petNames.join(' & ');
const glanceHome =
  amenities
    .slice(0, 3)
    .join(', ') +
  (amenities.length > 3
    ? ' +' +
      (amenities.length -
        3) +
      ' more'
    : '');

const isLoggedIn =
  !!session;
// ID approved: needed to
// apply and to message.
const idOk =
  viewer?.verified_id ===
  true;
const canMessage = !!(
  viewer &&
  viewer.verified_id ===
    true &&
  !viewerIsOwner &&
  viewer.id !== owner.id
);
// Signed-in sitters can
// apply; show their
// status if they have.
const canApply = !!(
  viewer &&
  viewer.profile_type ===
    'sitter' &&
  viewer.id !== owner.id
);
let applied = '';
if (canApply) {
  try {
    const ar =
      await supabase
      .from('applications')
      .select('status')
      .eq(
        'listing_id',
        listing.id,
      )
      .eq(
        'profile_id',
        viewer.id,
      )
      .maybeSingle();
    applied =
      ar.data?.status || '';
  } catch {}
}
const APPLIED: Record<
  string,
  string
> = {
  new: 'Applied',
  shortlisted:
    'Shortlisted',
  declined:
    'Not this time',
  confirmed: 'Confirmed',
};
const appliedLabel =
  APPLIED[applied] || '';
const appliedNote =
  ownerFirst +
  ' has your' +
  ' application';
const dashUrl =
  acct?.home ||
  '/dashboard';
const backHref = isMine
  ? '/owner/dashboard'
  : '/listings';
const backDash =
  '← Back to' +
  ' dashboard';
const waNumber = String(
  owner?.whatsapp_number ||
    '',
).replace(/[^0-9]/g, '');
const waHref =
  'https://wa.me/' +
  waNumber;
const ownerId = owner.id;
const listingId =
  listing.id;
const ownerSlug =
  owner.slug || '';
const dateFrom =
  listing.date_from;
const dateTo =
  listing.date_to;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>{listing.title} — MYAH</title>
  <link rel="canonical" href={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:url" content={'https://www.myahsits.com' + Astro.url.pathname} />
  <meta property="og:site_name" content="MYAH" />
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 1000px) {
      [data-header-nav] { display: none !important; }
      [data-topbar] { padding: 16px 24px !important; }
      [data-page-pad] { padding: 28px 24px 80px !important; }
      [data-detail-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
    }
    @media (max-width: 700px) {
      [data-eq-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-foot-grid] { grid-template-columns: minmax(0,1fr) !important; gap: 36px !important; }
    }

    [data-enquiry] input:focus, [data-enquiry] textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; }
    .sd-nav:hover { color:#2f5d45 !important; }
    .sd-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .sd-btn:active { transform:translateY(0) scale(.98) !important; }
    .sd-back:hover { gap:13px !important; color:#2c1a0e !important; }
    .sd-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .sd-photo:hover { transform:scale(1.03) !important; }
    .sd-wa:hover { background:#1da851 !important; transform:translateY(-2px) !important; }
    .sd-wa:active { transform:translateY(0) scale(.98) !important; }
    .sd-foot:hover { color:#c4ab8a !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  {acct ? (
<AppNav side={acct.side} active={viewerIsOwner ? "sits" : "browse"} />
) : (
<header data-topbar="1" data-screen-label="Header" style="position:sticky;top:0;z-index:210;padding:16px 48px;display:flex;justify-content:space-between;align-items:center;gap:40px;background:rgba(250,246,238,.97);backdrop-filter:blur(12px);box-shadow:0 1px 0 rgba(110,84,56,.2)">
    <a href="/" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;line-height:1;margin-left:-4px;font-family:'Montserrat',sans-serif;font-weight:500;font-size:1.4rem;flex-shrink:0;letter-spacing:.28em">
      <img src="/images/logo-mark.png" alt="" style="height:46px;width:46px;display:block;object-fit:contain" />
      <span style="display:flex;flex-direction:column;gap:5px;padding-left:14px;border-left:1px solid rgba(110,84,56,.4)"><span style="color:#2f5d45;line-height:1">MYAH</span><span style="font-family:'Lato',sans-serif;font-weight:700;font-size:.5rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f;line-height:1">Make Yourself At Home</span></span>
    </a>
    <nav data-header-nav="1" style="display:flex;align-items:center;gap:32px;flex-wrap:nowrap">
      <a href="/" class="sd-nav" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Home</a>
{!viewerIsOwner && (
      <a href="/listings" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;white-space:nowrap;border-bottom:2px solid #2f5d45;padding-bottom:3px">Browse sits</a>
)}
      {isLoggedIn ? (
        <a href={dashUrl} class="sd-nav" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Dashboard</a>
      ) : (
        <a href="/login" class="sd-nav" style="font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;text-decoration:none;white-space:nowrap;transition:color .2s">Log in</a>
      )}
      {!isLoggedIn && (
        <a href="/signup" class="sd-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-decoration:none;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:13px 28px;cursor:pointer;white-space:nowrap;box-shadow:0 4px 14px rgba(44,26,14,.18);transition:background .2s, border-color .2s, transform .12s">Get started</a>
      )}
    </nav>
  </header>
)}

  <main data-screen-label="Sit detail" data-page-pad="1" style="flex:1;padding:40px 48px 100px">
    <div style="max-width:1100px;margin:0 auto">
{isMine ? (
      <a href="/owner/dashboard" class="sd-back" style="display:inline-flex;align-items:center;gap:9px;margin-bottom:28px;font-size:.78rem;color:#2f5d45;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:gap .2s, color .2s">{backDash}</a>
) : (
      <a href="/listings" class="sd-back" style="display:inline-flex;align-items:center;gap:9px;margin-bottom:28px;font-size:.78rem;color:#2f5d45;font-weight:600;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;transition:gap .2s, color .2s">&larr; Back to all sits</a>
)}
      {isMine && <OwnSitPanel variant="banner" listing={listing} applicants={applicants} />}

      <div data-detail-grid="1" style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:32px;align-items:start">

        <div style="display:flex;flex-direction:column;gap:24px">

          <div style="position:relative;border-radius:20px;overflow:hidden;border:1px solid rgba(110,84,56,.22)">
            <img src={heroSrc} alt={listing.title} style="width:100%;height:340px;object-fit:cover;display:block;background:#e9e0d2" />
            <div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(44,26,14,.78) 0%, rgba(44,26,14,.1) 55%, transparent 100%)"></div>
            <div style="position:absolute;left:0;right:0;bottom:0;padding:34px 34px 30px">
              <p style="font-size:.74rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#c4ab8a;margin:0 0 12px;display:flex;align-items:center;gap:10px"><span style="width:22px;height:1px;background:#c4ab8a;display:block"></span>Available sit</p>
              <h1 style="font-family:'Marcellus',serif;font-size:2.4rem;color:#fff;line-height:1.15;margin:0 0 18px;text-wrap:pretty">{listing.title}</h1>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                {ownerLoc && (
                  <span style="display:flex;align-items:center;gap:8px;background:rgba(250,246,238,.14);border:1px solid rgba(196,171,138,.4);backdrop-filter:blur(6px);color:#fff;padding:8px 16px;border-radius:50px;font-size:.78rem;font-weight:700;letter-spacing:.06em"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4ab8a" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>{ownerLoc}</span>
                )}
                <span style="display:flex;align-items:center;gap:8px;background:rgba(250,246,238,.14);border:1px solid rgba(196,171,138,.4);backdrop-filter:blur(6px);color:#fff;padding:8px 16px;border-radius:50px;font-size:.78rem;font-weight:700;letter-spacing:.06em"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4ab8a" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>{dateRange}</span>
                <span style="background:#2f5d45;color:#fff;padding:11px 22px;border-radius:50px;font-size:.74rem;font-weight:700;letter-spacing:.06em">{dayLabel}</span>
              </div>
            </div>
          </div>

          {aboutParas.length > 0 && (
            <section id="sit-about" class="sd-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <h2 style="font-family:'Marcellus',serif;font-size:1.5rem;color:#2c1a0e;margin:0 0 8px">About this sit</h2>
              <div style="width:40px;height:2px;background:#6e5438;margin:0 0 22px"></div>
              {aboutParas.map((p, i) => (
                <p style={i < aboutParas.length - 1 ? 'font-size:.97rem;color:#2c1a0e;line-height:1.85;margin:0 0 14px' : 'font-size:.97rem;color:#2c1a0e;line-height:1.85;margin:0'}>{p}</p>
              ))}
            </section>
          )}

          {petCards.length > 0 && (
            <section id="sit-pets" class="sd-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <h2 style="font-family:'Marcellus',serif;font-size:1.5rem;color:#2c1a0e;margin:0 0 8px">Meet the pets</h2>
              <div style="width:40px;height:2px;background:#6e5438;margin:0 0 24px"></div>
              <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:18px">
                {petCards.map((pet) => (
                  <div style="display:flex;gap:16px;align-items:flex-start;background:#faf6ee;border:1px solid rgba(110,84,56,.2);border-radius:14px;padding:20px">
                    {pet.photo ? (
                      <img src={pet.photo} alt={pet.name} style="width:84px;height:84px;border-radius:12px;object-fit:cover;flex-shrink:0" />
                    ) : (
                      <span style="width:84px;height:84px;border-radius:12px;flex-shrink:0;background:rgba(110,84,56,.14);color:#2f5d45;font-family:'Marcellus',serif;font-size:2rem;display:flex;align-items:center;justify-content:center">{initial(pet.name)}</span>
                    )}
                    <div style="min-width:0">
                      <h3 style="font-family:'Marcellus',serif;font-size:1.15rem;color:#2c1a0e;margin:0 0 5px">{pet.name}</h3>
                      <p style="font-size:.8rem;color:#2f5d45;font-weight:700;letter-spacing:.04em;margin:0 0 8px">{pet.meta}</p>
                      {pet.temperament && <p style="font-size:.87rem;color:#6b4e35;line-height:1.6;margin:0">{pet.temperament}</p>}
                      {pet.needs && <p style="font-size:.83rem;color:#b91c1c;line-height:1.55;margin:8px 0 0;display:flex;gap:7px"><span>⚠</span>{pet.needs}</p>}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {amenities.length > 0 && (
            <section class="sd-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <h2 style="font-family:'Marcellus',serif;font-size:1.5rem;color:#2c1a0e;margin:0 0 8px">Home amenities</h2>
              <div style="width:40px;height:2px;background:#6e5438;margin:0 0 24px"></div>
              <div style="display:flex;flex-wrap:wrap;gap:10px">
                {amenities.map((a) => (
                  <span style="background:rgba(110,84,56,.08);color:#5c3d20;border:1px solid rgba(110,84,56,.28);padding:9px 18px;border-radius:50px;font-size:.85rem">{a}</span>
                ))}
              </div>
            </section>
          )}

          {wantParas.length > 0 && (
            <section class="sd-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
              <h2 style="font-family:'Marcellus',serif;font-size:1.5rem;color:#2c1a0e;margin:0 0 8px">What they're looking for</h2>
