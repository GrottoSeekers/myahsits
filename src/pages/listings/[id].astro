<script is:inline define:vars={{ ownerId, listingId, ownerSlug, dateFrom, dateTo }}>
(() => {
  const loader = document.querySelector('[data-loader]');
  let hideT;
  const show = (stay) => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    if (!stay) hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http')) return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; show(); });
  });

  // Signed in: open (or reuse) the conversation about this listing.
  const chat = document.querySelector('[data-chat]');
  chat && chat.addEventListener('click', async () => {
    const label = chat.textContent;
    chat.disabled = true;
    chat.textContent = 'Opening chat…';
    try {
      const res = await fetch('/api/messages/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipient_profile_id: ownerId, listing_id: listingId })
      });
      const data = await res.json();
      if (!data.conversation_id) throw new Error();
      show(true);
      window.location.href = '/messages/' + data.conversation_id;
    } catch {
      chat.textContent = 'Something went wrong';
      setTimeout(() => { chat.textContent = label; chat.disabled = false; }, 2000);
    }
  });

  // Sitters: apply for the sit (saved via /api/applications).
  const apply = document.querySelector('[data-apply]');
  apply && apply.addEventListener('submit', async e => {
    e.preventDefault();
    const btn = apply.querySelector('button[type=submit]');
    const status = apply.querySelector('[data-apply-status]');
    btn.disabled = true; btn.textContent = 'Sending…'; status.textContent = '';
    try {
      const res = await fetch('/api/applications', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listing_id: listingId, message: apply.querySelector('textarea').value })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { const er = new Error(data.error || 'server'); er.detail = data.detail || ''; throw er; }
      apply.style.display = 'none';
      const done = document.querySelector('[data-applied]');
      done.style.cssText = 'display:flex;align-items:center;gap:12px;flex-wrap:wrap';
    } catch (err) {
      status.textContent = err.message === 'closed'
        ? 'This sit is no longer taking applications.'
        : err.message === 'no_profile'
          ? 'Create your sitter profile first, then apply.'
          : err.message === 'sitters_only'
            ? 'Only sitter accounts can apply for sits.'
            : 'Could not send — please try again.' + (err.detail ? ' (' + err.detail + ')' : '');
      btn.disabled = false; btn.textContent = 'Apply for this sit';
    }
  });

  // Guests: email the owner through /api/enquiry.
  const form = document.querySelector('[data-enquiry]');
  form && form.addEventListener('submit', async e => {
    e.preventDefault();
    const status = form.querySelector('[data-status]');
    const btn = form.querySelector('button[type=submit]');
    btn.disabled = true; btn.textContent = 'Sending…';
    status.textContent = ''; status.style.color = '#2f7d4f';
    const fd = new FormData(form);
    const body = new FormData();
    body.append('slug', ownerSlug);
    body.append('first_name', String(fd.get('name') || '').trim());
    body.append('email', String(fd.get('email') || '').trim());
    body.append('date_from', dateFrom);
    body.append('date_to', dateTo);
    body.append('message', String(fd.get('message') || '').trim());
    try {
      const res = await fetch('/api/enquiry', { method: 'POST', body });
      if (!res.ok) throw new Error();
      status.textContent = "Message sent! They'll be in touch soon.";
      form.reset();
    } catch {
      status.textContent = 'Could not send — please try again.';
      status.style.color = '#b91c1c';
    } finally {
      btn.disabled = false; btn.textContent = 'Send message';
    }
  });
})();
</script>
<nav data-page-dock data-items="sit-about:About,sit-pets:Pets,sit-photos:Photos,enquiry:Get in touch*"></nav>
<script is:inline src="/page-dock.js"></script>
<script is:inline>
(() => {
  const m = document.querySelector('[data-mosaic]'), shots = document.querySelector('[data-shots]');
  if (!m || !shots) return;
  const open = (i) => { shots.hidden = false; document.body.style.overflow = 'hidden'; const img = shots.querySelectorAll('img')[i]; if (img) setTimeout(() => img.scrollIntoView({ block: 'center' }), 50); };
  const close = () => { shots.hidden = true; document.body.style.overflow = ''; };
  m.querySelectorAll('[data-shot]').forEach((b) => b.addEventListener('click', () => open(Number(b.getAttribute('data-shot')))));
  shots.querySelector('[data-shots-close]').addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  const pill = m.querySelector('[data-count-pill]');
  if (pill) m.addEventListener('scroll', () => { const k = Math.round(m.scrollLeft / m.clientWidth) + 1; pill.textContent = k + ' / ' + pill.textContent.split('/ ')[1]; }, { passive: true });
})();
</script>
</body>
