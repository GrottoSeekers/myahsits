                      <span style="width:84px;height:84px;border-radius:12px;flex-shrink:0;background:rgba(110,84,56,.14);color:#2f5d45;font-family:'Marcellus',serif;font-size:2rem;display:flex;align-items:center;justify-content:center">{initial(pet.name)}</span>
                    )}
