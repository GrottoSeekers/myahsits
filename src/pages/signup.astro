---
export const prerender = false;
import { getSession } from '../lib/auth';
import AuthShell from '../components/AuthShell.astro';

const sess = await getSession(Astro.request);
if (sess) return Astro.redirect('/dashboard');

const sp = Astro.url.searchParams;
const e = sp.get('error');
const detail = sp.get('detail');
const sent = sp.has('sent');
const sentTo = sp.get('email') || 'your email';
const errTxt = !e ? null
  : e === 'missing' ? 'Please fill in all fields.'
  : e === 'short' ? 'Password must be at least 8 characters.'
  : e === 'mismatch' ? 'Passwords do not match.'
  : e === 'exists' ? 'An account with that email already exists.'
  : e === 'db' ? 'Database error: ' + (detail ?? 'unknown')
  : 'Something went wrong. Please try again.';
---
<AuthShell title="Sign up" pics={['/images/slideshow-dogs-lake.jpeg', '/images/slideshow-living-room.jpeg', '/images/slideshow-spaniel-walk.jpeg']} quote={{ text: 'The house was impeccable on our return and the animals were well looked after.', who: 'Janet · home owner, Hawkesbury' }}>
  {sent ? (
    <>
      <p class="au-eye">One more step</p>
      <h1>Check your <em>inbox</em></h1>
      <p class="au-lead">We've sent a link to <b style="color:var(--ink)">{sentTo}</b>. Tap it to confirm your email and you'll come back to log in and set up your page.</p>
      <div class="au-note ok"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Can't see it? Check your junk folder. The link works for 3 days.</span></div>
      <a class="au-btn" href="/login">Go to log in</a>
      <p class="au-alt">Wrong email? <a href="/signup">Start again</a></p>
    </>
  ) : (
    <>
      <p class="au-eye">Join MYAH</p>
      <h1>Create your <em>account</em></h1>
      <p class="au-lead">Join MYAH — whether you're offering house &amp; pet sitting services or looking for a trusted sitter.</p>

      {errTxt && <div class="au-note err" role="alert"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg><span>{errTxt}</span></div>}

      <form method="POST" action="/api/auth/signup" class="au-form" data-signup-form="1">
        <fieldset class="su-roles">
          <legend>I am a…</legend>
          <label><input type="radio" name="role" value="sitter" checked /><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><b>Pet Sitter</b><small>I look after pets &amp; homes</small></label>
          <label><input type="radio" name="role" value="owner" /><span class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></span><b>Pet Owner</b><small>I need a trusted sitter</small></label>
        </fieldset>
        <label class="au-f"><input type="email" name="email" required autocomplete="email" placeholder="Email address" /><span>Email address</span></label>
        <label class="au-f pw"><input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Password" /><span>Password (at least 8 characters)</span><button type="button" class="au-show" data-pw-toggle="1" aria-label="Show password">Show</button></label>
        <label class="au-f pw"><input type="password" name="confirm" required minlength="8" autocomplete="new-password" placeholder="Confirm password" /><span>Confirm password</span><button type="button" class="au-show" data-pw-toggle="1" aria-label="Show password">Show</button></label>
        <button type="submit" class="au-btn" style="margin-top:6px">Create account</button>
      </form>

      <p class="au-alt">Already have an account? <a href="/login">Log in</a></p>
      <div class="au-trust"><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>Everyone ID checked</span><span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Private details stay private</span></div>
    </>
  )}
</AuthShell>

<style is:global>
  .su-roles { border:0; margin:0 0 4px; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .su-roles legend { font-family:'Lato',sans-serif; font-size:.7rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--brown); margin:0 0 10px; padding:0; }
  .su-roles label { position:relative; display:flex; flex-direction:column; align-items:center; gap:4px; padding:18px 10px 16px; border:1.5px solid rgba(44,26,14,.14); border-radius:16px; background:#fff; text-align:center; cursor:pointer; transition:border-color .2s, background .2s, box-shadow .2s, transform .2s; }
  .su-roles label:hover { border-color:rgba(47,93,69,.5); transform:translateY(-2px); }
  .su-roles input { position:absolute; opacity:0; pointer-events:none; }
  .su-roles .ic { width:44px; height:44px; border-radius:50%; background:var(--cream); color:var(--brown); display:flex; align-items:center; justify-content:center; margin-bottom:6px; transition:background .2s, color .2s; }
  .su-roles b { font-family:'Marcellus',serif; font-weight:400; font-size:1.05rem; color:var(--ink); }
  .su-roles small { font-size:.74rem; color:var(--soft); line-height:1.4; }
  .su-roles label:has(input:checked) { border-color:var(--green); background:#f4f8f5; box-shadow:0 0 0 1px var(--green); }
  .su-roles label:has(input:checked) .ic { background:var(--green); color:#fff; }
  .su-roles label:has(input:focus-visible) { outline:2px solid rgba(47,93,69,.4); outline-offset:2px; }
</style>
