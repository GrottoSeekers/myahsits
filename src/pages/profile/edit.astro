---
export const prerender =
  false;
import AppNav from
  '../_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../../lib/account';
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'sitter',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const pr =
  await supabase
  .from('profiles')
  .select('*')
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const profile: any =
  pr.data;
if (!profile) {
  return Astro.redirect(
    '/profile/create',
  );
}

const arr = (
  v: unknown,
): any[] => (
  Array.isArray(v)
    ? v : []
);
const hero = arr(
  profile.hero_images_json,
);
const about = arr(
  profile.about_images_json,
);
const gallery = arr(
  profile.gallery_json,
);
const reviews = arr(
  profile.reviews_json,
);
const platforms = arr(
  profile.platforms_json,
);
const plats = platforms
  .map((p: any) => ({
    ...p,
    letter: String(
      p.name || '',
    )
    .charAt(0)
    .toUpperCase(),
  }));
const h: Record<
  string,
  string
> =
  profile.headings_json ??
  {};
const t: Record<
  string,
  string
> =
  profile.theme_json ??
  {};

const joint =
  profile.account_type ===
  'joint';
const slug: string =
  profile.slug || '';
const publicHref =
  '/' + slug;
const newToken =
  Astro.url.searchParams
  .get('new_token') ||
  '';
const pic: string =
  profile.profile_pic ||
  '/images/' +
  'avatar-cream.png';

const photoGroups = [
  {
    cat: 'hero',
    title:
      'Banner photos',
    images: hero,
    last: false,
  },
  {
    cat: 'about',
    title: tx(`
Photos beside your bio
`),
    images: about,
    last: false,
  },
  {
    cat: 'gallery',
    title: 'Gallery',
    images: gallery,
    last: true,
  },
];
function tx(s: string) {
  return s.trim();
}
const plural = (
  n: number,
) => n +
  (n === 1
    ? ' photo'
    : ' photos');

const theme = {
  background:
    t.background ||
    '#faf6ee',
  accent:
    t.accent ||
    '#2f5d45',
  accent_light:
    t.accent_light ||
    '#c4ab8a',
  text:
    t.text ||
    '#2c1a0e',
  text_soft:
    t.text_soft ||
    '#6b4e35',
};
const swatches = [
  {
    name: 'background',
    label: 'Background',
  },
  {
    name: 'accent',
    label: 'Accent',
  },
  {
    name: 'accent_light',
    label: 'Highlight',
  },
  {
    name: 'text',
    label: 'Text',
  },
  {
    name: 'text_soft',
    label: 'Soft text',
  },
].map((s) => ({
  ...s,
  value: (theme as any)[
    s.name
  ],
}));

const pvData = {
  name:
    profile.name || '',
  tagline:
    profile.tagline ||
    '',
  badge:
    profile.badge_text ||
    '',
  bio: profile.bio || '',
  type: joint
    ? 'joint'
    : 'solo',
  theme,
  heroN: hero.length,
  aboutN: about.length,
  galleryN:
    gallery.length,
  reviews: reviews
    .slice(0, 2)
    .map((r: any) => ({
      text: r.text || '',
      name: r.name || '',
    })),
  reviewsN:
    reviews.length,
  platformsN:
    platforms.length,
  token: newToken,
};
const heroSrc: string =
  hero[0]?.src ||
  '/images/' +
  'couple-villa-1.jpg';
const aboutSrc: string =
  about[0]?.src ||
  '/images/' +
  'couple-field-1.jpg';
const pvGallery = gallery
  .slice(0, 8)
  .map(
    (g: any) => g.src,
  );
const aboutLabelPh =
  joint
    ? 'Who We Are'
    : 'Who I Am';
const galleryLabelPh =
  joint
    ? "Pets We've Loved"
    : "Pets I've Loved";
const galleryTitlePh =
  joint
    ? 'Our Sits'
    : 'My Sits';
const enquiryTitlePh =
  'Book ' +
  (profile.name || 'us');
// Reviews shown before "Show all" in the Reviews section.
const REV_FIRST = 6;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Edit your profile — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder, textarea::placeholder { color: rgba(44,26,14,.35); }
    input[type="color"] { -webkit-appearance: none; appearance: none; padding: 2px; }
    input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    input[type="color"]::-webkit-color-swatch { border: none; border-radius: 50%; }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 960px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 32px 20px 90px !important; }
      [data-two-col] { grid-template-columns: minmax(0,1fr) !important; }
      [data-aside] { position: static !important; }
      [data-card] { padding: 26px 22px !important; }
      [data-field-row] { grid-template-columns: minmax(0,1fr) !important; }
      [data-save-bar] { padding: 14px 24px !important; }
    }
    section[id] { scroll-margin-top: 24px; }

    /* Field focus — same treatment as Log in */
    [data-two-col] input[type=text]:focus, [data-two-col] input[type=email]:focus, [data-two-col] input[type=tel]:focus, [data-two-col] input[type=url]:focus, [data-two-col] textarea:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; outline:none; }

    .ep-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .ep-view:hover { color:#2c1a0e !important; }
    .ep-jump:hover { background:rgba(110,84,56,.1) !important; color:#2f5d45 !important; border-color:rgba(110,84,56,.5) !important; }
    .ep-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .ep-photo-btn:hover, .ep-photo-wrap:hover .ep-photo-btn { background:rgba(110,84,56,.1) !important; border-color:#2f5d45 !important; color:#2f5d45 !important; }
    .ep-thumb:hover { transform:translateY(-2px) !important; box-shadow:0 8px 20px rgba(44,26,14,.14) !important; }
    .ep-thumb-x:hover { background:#b91c1c !important; }
    .ep-add:hover { background:rgba(110,84,56,.12) !important; border-color:#2f5d45 !important; }
    .ep-row:hover { border-color:rgba(110,84,56,.45) !important; }
    .ep-row-x:hover { background:#b91c1c !important; color:#fff !important; }
    .ep-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .ep-btn:active { transform:translateY(0) scale(.98) !important; }
    .ep-ghost:hover { background:rgba(110,84,56,.1) !important; border-color:#2f5d45 !important; transform:translateY(-1px) !important; }
    .ep-cancel:hover { color:#2c1a0e !important; }
    .ep-open:hover { gap:11px !important; color:#2c1a0e !important; }
    .ep-swatch:hover { border-color:#2f5d45 !important; transform:scale(1.08) !important; }
    .ep-reset:hover { border-color:#2f5d45 !important; color:#2c1a0e !important; }
    .ep-strength:hover { border-color:rgba(110,84,56,.5) !important; }
    .ep-queue { display:flex; flex-wrap:wrap; gap:8px; margin:12px 0 0; }
    .ep-queue:empty { display:none; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={'sitter'} active="profile" />

  <main data-pad="1" style="flex:1;padding:52px 48px 140px">
    <div style="max-width:1180px;margin:0 auto">

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>MYAH sitter</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">Edit your <em style="color:#2f5d45;">profile</em></h1>
        <p style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:600px;margin:0">Choose a section to edit. Don&rsquo;t forget to save your changes.</p>
      </div>

      <div data-form-msg="1" role="status" style="display:none;margin-bottom:24px;padding:14px 18px;border-radius:12px;font-size:.86rem;font-weight:600"></div>

      <div data-section-tabs="1" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:34px">
        <a href="#details" class="ep-jump" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Name &amp; bio</a>
        <a href="#photos" class="ep-jump" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Photos</a>
        <a href="#reviews" class="ep-jump" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Reviews</a>
        <a href="#platforms" class="ep-jump" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Other profiles</a>
        <a href="#headings" class="ep-jump" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Headings</a>
        <a href="#preview" class="ep-jump" style="font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;text-decoration:none;padding:8px 16px;border-radius:50px;background:#fff;border:1px solid rgba(110,84,56,.28);transition:background .2s, color .2s, border-color .2s">Preview &amp; colours</a>
      </div>

      <div data-two-col="1" style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:28px;align-items:start">

        <div style="display:flex;flex-direction:column;gap:24px">

          <section id="details" data-card="1" class="ep-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
            <div style="display:flex;align-items:baseline;gap:14px;margin:0 0 8px"><span style="font-family:'Marcellus',serif;font-size:.92rem;color:#6e5438;letter-spacing:.08em">01</span><h2 style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0">Your name &amp; bio</h2></div>
            <div style="width:40px;height:2px;background:#6e5438;margin:0 0 12px"></div>
            <p style="font-size:.9rem;color:#6b4e35;line-height:1.7;margin:0 0 28px;max-width:460px">Your name, a short line about you, and the story pet owners read first.</p>

            <form data-details-form="1" action="/api/profile/update" method="POST" enctype="multipart/form-data">
              <div style="margin-bottom:26px">
                <span style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:12px">Profile type</span>
                <div data-keep-two="1" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:420px">
                  <button type="button" data-type-btn="solo">
                    <span style="font-size:1.3rem;line-height:1">🧍</span>
                    <span style="font-size:.85rem;font-weight:600">Solo sitter</span>
                  </button>
                  <button type="button" data-type-btn="joint">
                    <span style="font-size:1.3rem;line-height:1">🧑‍🤝‍🧑</span>
                    <span style="font-size:.85rem;font-weight:600">Joint / couple</span>
                  </button>
                </div>
                <input type="hidden" name="account_type" data-type-input="1" value={pvData.type} />
              </div>

              <div style="margin-bottom:24px">
                <label for="name" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Your name <span style="color:#2f5d45">*</span></label>
                <input data-name="1" type="text" id="name" name="name" value={profile.name ?? ''} required="required" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
              </div>

              <div style="margin-bottom:24px">
                <label for="tagline" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Short description</label>
                <input data-tagline="1" type="text" id="tagline" name="tagline" value={profile.tagline ?? ''} placeholder="e.g. Experienced pet sitters based in Bath" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">One line under your name on the banner.</p>
              </div>

              <div style="margin-bottom:24px">
                <label for="badge" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Highlight badge</label>
                <input data-badge="1" type="text" id="badge" name="badge_text" value={profile.badge_text ?? ''} placeholder="e.g. 5★ rated on TrustedHousesitters" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                <p style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6">A small pill on your banner photo. Leave blank to hide it.</p>
              </div>

              <div style="margin-bottom:26px">
                <label for="bio" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">About you</label>
                <textarea data-bio="1" id="bio" name="bio" rows="7" placeholder="Your experience, what you offer, and why pets settle with you." style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;resize:vertical;line-height:1.7;transition:border-color .2s, box-shadow .2s">{profile.bio ?? ''}</textarea>
                <p data-bio-count="1" style="font-size:.82rem;color:#6b4e35;margin:8px 0 0;line-height:1.6"></p>
              </div>

              <div style="margin-bottom:30px">
                <span style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:12px">Profile photo</span>
                <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap">
                  <img data-pic-preview="1" src={pic} alt="" style="width:74px;height:74px;border-radius:50%;object-fit:cover;border:2px solid rgba(110,84,56,.35);flex-shrink:0" />
                  <span class="ep-photo-wrap" style="position:relative;display:inline-flex">
                    <input data-pic="1" type="file" name="profile_pic" accept="image/*" style="position:absolute;inset:0;opacity:0;cursor:pointer;z-index:2;width:100%;height:100%" />
                    <button type="button" tabindex="-1" class="ep-photo-btn" style="display:inline-flex;align-items:center;gap:10px;font-family:'Montserrat',sans-serif;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;background:#faf6ee;border:1.5px dashed rgba(110,84,56,.5);border-radius:50px;padding:13px 26px;cursor:pointer;transition:background .25s ease, border-color .25s ease, color .25s ease">Change photo</button>
                  </span>
                </div>
                <p style="font-size:.82rem;color:#6b4e35;margin:12px 0 0;line-height:1.6">JPG or PNG, up to 5&nbsp;MB.</p>
              </div>

              <div style="border-top:1px solid rgba(44,26,14,.08);padding-top:26px">
                <p style="font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35;margin:0 0 20px">Where enquiries go</p>
                <div data-field-row="1" style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
                  <div>
                    <label for="email" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">Enquiry email <span style="color:#2f5d45">*</span></label>
                    <input type="email" id="email" name="contact_email" required value={profile.contact_email ?? ''} style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                  </div>
                  <div>
                    <label for="whatsapp" style="display:block;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#5c3d20;margin-bottom:10px">WhatsApp number</label>
                    <input type="tel" id="whatsapp" name="whatsapp_number" value={profile.whatsapp_number ?? ''} placeholder="+447700900000" style="width:100%;border:1.5px solid rgba(44,26,14,.18);border-radius:10px;padding:13px 16px;font-size:.97rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
                  </div>
                </div>
                <p style="font-size:.82rem;color:#6b4e35;margin:12px 0 0;line-height:1.6">Neither is shown publicly. With a number set, a WhatsApp button appears on your page.</p>
              </div>
            </form>
            <div class="ep-sec-save" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:26px;padding-top:22px;border-top:1px solid rgba(44,26,14,.07)">
              <button type="button" data-save="1" class="ep-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">Save changes</button>
            </div>
          </section>

          <section id="photos" data-card="1" class="ep-card" style="background:#fff;border:1px solid rgba(110,84,56,.22);border-radius:18px;padding:36px;box-shadow:0 1px 2px rgba(44,26,14,.04);transition:box-shadow .3s ease, border-color .3s ease">
