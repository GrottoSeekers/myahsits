                </div>
              </div>

              <div style="padding:18px 20px">
                <p data-pv-label="1" data-pv-about-label="1"></p>
                <div style="display:flex;gap:12px;align-items:flex-start">
                  <img src={aboutSrc} alt="" style="width:62px;height:62px;border-radius:10px;object-fit:cover;flex-shrink:0" />
                  <p data-pv-bio="1"></p>
                </div>
              </div>

              <div data-pv-reviews-wrap="1" style="padding:0 20px 18px">
                <p data-pv-label="1">What Pet Owners Say</p>
                <div data-pv-reviews="1" style="display:flex;gap:8px"></div>
              </div>

              {pvGallery.length > 0 && (
                <div style="padding:0 20px 18px">
                  <p data-pv-label="1" data-pv-gallery-label="1"></p>
                  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px">
                    {pvGallery.map((src) => (
                      <div style="aspect-ratio:1;border-radius:4px;overflow:hidden"><img src={src} alt="" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
                    ))}
                  </div>
                </div>
              )}

              <div style="padding:0 20px 20px">
                <p data-pv-label="1">Get In Touch</p>
                <div style="display:flex;flex-direction:column;gap:5px;max-width:210px">
                  <div style="height:17px;background:rgba(44,26,14,.05);border:1px solid rgba(44,26,14,.09);border-radius:3px"></div>
                  <div style="height:17px;background:rgba(44,26,14,.05);border:1px solid rgba(44,26,14,.09);border-radius:3px"></div>
                  <div style="height:30px;background:rgba(44,26,14,.05);border:1px solid rgba(44,26,14,.09);border-radius:3px"></div>
                  <div data-pv-mock-btn="1">Send Enquiry</div>
                </div>
              </div>

              <div data-pv-footer="1">
                <p style="font-family:'Montserrat',sans-serif;font-weight:500;letter-spacing:.24em;font-size:.68rem;margin:0;color:rgba(255,255,255,.75)">MYAH</p>
                <span data-pv-footer-name="1" style="font-size:.6rem;color:rgba(255,255,255,.45)"></span>
              </div>
            </div>

            <div style="padding:18px 20px 20px;background:#fff;border-top:1px solid rgba(110,84,56,.2)">
              <form id="colours" data-theme-form="1" action="/api/profile/theme" method="POST" style="margin:0">
                <div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-bottom:14px">
                  {swatches.map((s) => (
                    <label style="display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer">
                      <input type="color" name={s.name} value={s.value} data-swatch={s.name} class="ep-swatch" style="width:38px;height:38px;border:2px solid rgba(44,26,14,.15);border-radius:50%;cursor:pointer;background:#faf6ee;transition:border-color .2s, transform .15s" />
                      <span style="font-size:.64rem;font-weight:600;color:#6b4e35;letter-spacing:.03em">{s.label}</span>
                    </label>
                  ))}
                </div>
                <div style="display:flex;justify-content:center">
                  <button type="button" data-reset="1" class="ep-reset" style="font-family:'Montserrat',sans-serif;font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#6b4e35;background:none;border:1.5px solid rgba(44,26,14,.15);border-radius:50px;padding:9px 22px;cursor:pointer;transition:border-color .2s, color .2s">Reset colours</button>
                </div>
                <div style="display:flex;justify-content:center;margin-top:14px">
                  <button type="button" data-save="1" class="ep-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;box-shadow:0 6px 20px rgba(110,84,56,.28);padding:16px 36px;cursor:pointer;font-family:'Montserrat',sans-serif;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease, box-shadow .25s ease">Save changes</button>
                </div>
              </form>
            </div>
          </div>

          <div class="ep-strength" style="background:#faf6ee;border:1px solid rgba(110,84,56,.28);border-radius:18px;padding:22px 24px;transition:border-color .3s ease">
            <p style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6e5438;margin:0 0 14px">Profile strength</p>
            <div style="height:7px;border-radius:50px;background:rgba(44,26,14,.08);overflow:hidden;margin-bottom:12px">
              <div data-strength-bar="1"></div>
            </div>
            <p data-strength-text="1" style="font-size:.86rem;color:#6b4e35;line-height:1.65;margin:0"></p>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <div data-save-bar="1">
    <div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap">
      <p style="font-size:.88rem;color:#6b4e35;margin:0;line-height:1.5">Unsaved changes — your public page still shows the old version.</p>
      <button type="button" data-save="1" data-save-bar-btn="1">Save changes</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ pvData }}>
(() => {
  // Ported from the design's script: live preview, wording, bio count, strength,
  // colours and the save bar. Saving uses the existing API endpoints.
  const DEFAULT_THEME = { background: '#faf6ee', accent: '#2f5d45', accent_light: '#c4ab8a', text: '#2c1a0e', text_soft: '#6b4e35' };
  const s = Object.assign({ copied: false, saved: false, dirty: false }, pvData);
  const q = sel => document.querySelector(sel);
  const qa = sel => Array.from(document.querySelectorAll(sel));

  const render = () => {
    const t = s.theme;
    const joint = s.type === 'joint';

    // profile type
    qa('[data-type-btn]').forEach(b => {
      const on = b.getAttribute('data-type-btn') === s.type;
      b.style.cssText = 'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;font-family:\'Montserrat\',sans-serif;padding:18px 12px;border-radius:14px;cursor:pointer;transition:background .25s ease, border-color .25s ease, color .25s ease, transform .15s ease;' +
        (on
          ? 'background:rgba(110,84,56,.12);border:1.5px solid #2f5d45;color:#2c1a0e;'
          : 'background:#faf6ee;border:1.5px solid rgba(44,26,14,.14);color:#5c3d20;');
    });
    q('[data-type-input]').value = s.type;
    const bio = s.bio.trim();
    q('[data-bio-count]').textContent = bio.length + ' characters — around ' + Math.max(1, Math.round(bio.split(/\s+/).length / 200 * 60)) + ' seconds to read.';

    // review link
    const box = q('[data-link-box]');
    box.style.cssText = 'display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px;' + (s.token ? '' : 'opacity:.55;pointer-events:none;');
    q('[data-review-link]').value = s.token ? 'myahsits.com/review/' + s.token : 'Generate a link to send to a pet owner';
    q('[data-copy-link]').textContent = s.copied ? 'Copied' : 'Copy';

    // save
    qa('[data-save]').forEach(b => { if (!b.disabled) b.textContent = s.saved ? 'Changes saved' : 'Save changes'; });
    const bar = q('[data-save-bar]');
    const showBar = s.dirty && !s.saved;
    bar.style.cssText = 'position:fixed;left:0;right:0;bottom:0;z-index:40;padding:16px 48px;background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-top:1px solid rgba(110,84,56,.28);box-shadow:0 -6px 24px rgba(44,26,14,.06);transition:transform .3s ease, opacity .3s ease;' +
      (showBar ? 'transform:translateY(0);opacity:1;' : 'transform:translateY(100%);opacity:0;pointer-events:none;');
    q('[data-save-bar-btn]').style.cssText = 'font-family:\'Montserrat\',sans-serif;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;cursor:pointer;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease';

    // preview
    const pvLabel = 'font-size:.58rem;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin:0 0 9px;color:' + t.accent + ';';
    qa('[data-pv-label]').forEach(el => { el.style.cssText = pvLabel; });
    q('[data-pv-body]').style.cssText = 'background:' + t.background + ';transition:background .3s ease';
    const badge = q('[data-pv-badge]');
    badge.textContent = s.badge.trim() || 'Available this autumn';
    badge.style.cssText = 'font-size:.55rem;background:rgba(255,255,255,.18);color:#fff;padding:4px 11px;border-radius:50px;font-weight:700;letter-spacing:.07em;' + (s.badge.trim() ? '' : 'opacity:.45;');
    q('[data-pv-name]').textContent = s.name.trim() || 'Your name';
    q('[data-pv-footer-name]').textContent = s.name.trim() || 'Your name';
    const tag = q('[data-pv-tagline]');
    tag.textContent = s.tagline.trim() || 'Your one-line description';
    tag.style.cssText = 'font-size:.62rem;color:rgba(255,255,255,.7);margin:0;' + (s.tagline.trim() ? '' : 'font-style:italic;opacity:.6;');
    const btn = q('[data-pv-btn]');
    btn.textContent = joint ? 'Book Us Today' : 'Book Me Today';
    btn.style.cssText = 'display:inline-block;margin-top:6px;background:' + t.accent + ';color:#fff;font-size:.55rem;font-weight:600;padding:6px 15px;border-radius:6px;letter-spacing:.07em;text-transform:uppercase;';
    q('[data-pv-about-label]').textContent = joint ? 'Who We Are' : 'Who I Am';
    const pvBio = q('[data-pv-bio]');
    pvBio.textContent = bio ? (bio.length > 130 ? bio.slice(0, 130) + '…' : bio) : 'No bio yet';
    pvBio.style.cssText = 'font-size:.66rem;line-height:1.65;margin:0;color:' + t.text_soft + ';' + (bio ? '' : 'font-style:italic;opacity:.5;');
    const gl = q('[data-pv-gallery-label]');
    if (gl) gl.textContent = joint ? "Pets We've Loved" : "Pets I've Loved";

    const revWrap = q('[data-pv-reviews-wrap]');
    revWrap.style.display = s.reviews.length ? '' : 'none';
    const esc = v => { const d = document.createElement('div'); d.textContent = v; return d.innerHTML; };
    q('[data-pv-reviews]').innerHTML = s.reviews.map(r => {
      const text = r.text.length > 52 ? r.text.slice(0, 52) + '…' : r.text;
      return '<div style="flex:1;min-width:0;border-radius:8px;padding:10px;background:rgba(255,255,255,.55);border:1px solid ' + t.accent_light + '40;">' +
        '<span style="display:block;margin-bottom:4px;font-size:.5rem;color:' + t.accent + ';">★★★★★</span>' +
        '<p style="font-size:.58rem;line-height:1.5;font-style:italic;margin:0 0 5px;color:' + t.text_soft + ';">“' + esc(text) + '”</p>' +
        '<span style="font-size:.52rem;font-weight:700;color:' + t.accent + ';">— ' + esc(r.name.split(',')[0]) + '</span></div>';
    }).join('');
    q('[data-pv-mock-btn]').style.cssText = 'text-align:center;padding:6px;border-radius:4px;font-size:.52rem;font-weight:700;color:#fff;background:' + t.accent + ';';
    q('[data-pv-footer]').style.cssText = 'padding:12px 20px;display:flex;justify-content:space-between;align-items:center;background:' + t.text + ';';

    // strength
    const filled = [s.name.trim(), s.tagline.trim(), bio.length > 80, s.heroN > 0, s.aboutN > 0, s.galleryN >= 4, s.reviewsN >= 2, s.platformsN > 0].filter(Boolean).length;
    const pct = Math.round((filled / 8) * 100);
    q('[data-strength-bar]').style.cssText = 'height:100%;width:' + pct + '%;border-radius:50px;background:linear-gradient(90deg,#2f5d45,#c4ab8a);transition:width .4s ease';
    q('[data-strength-text]').textContent = pct === 100
      ? 'Everything is filled in. Owners see a complete page — that is the version that gets replies.'
      : pct + '% complete. ' + (s.galleryN < 4 ? 'A fuller gallery is the quickest win.' : s.reviewsN < 2 ? 'One more review would round it out.' : 'Add a little more to each section.');
  };

  const setState = patch => { Object.assign(s, patch); render(); };
  const dirty = () => setState({ dirty: true, saved: false });

  // loader
  const loader = q('[data-loader]');
  let hideT;
  const showLoader = (stay) => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    if (!stay) hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };
  qa('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http') || a.target === '_blank') return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; showLoader(); });
  });
  qa('form[action]').forEach(f => f.addEventListener('submit', () => showLoader(true)));
  window.addEventListener('pageshow', e => { if (e.persisted && loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; } });

  // inputs
  qa('[data-type-btn]').forEach(b => b.addEventListener('click', () => setState({ type: b.getAttribute('data-type-btn'), dirty: true, saved: false })));
  [['[data-name]', 'name'], ['[data-tagline]', 'tagline'], ['[data-badge]', 'badge'], ['[data-bio]', 'bio']].forEach(([sel, key]) => {
    const el = q(sel);
    el && el.addEventListener('input', () => setState({ [key]: el.value, dirty: true, saved: false }));
  });
  ['#email', '#whatsapp'].forEach(sel => { const el = q(sel); el && el.addEventListener('input', dirty); });
  qa('[data-headings-form] input').forEach(el => el.addEventListener('input', dirty));

  // colours
  qa('[data-swatch]').forEach(inp => {
    const on = () => setState({ theme: Object.assign({}, s.theme, { [inp.getAttribute('data-swatch')]: inp.value }), dirty: true, saved: false });
    inp.addEventListener('input', on);
    inp.addEventListener('change', on);
  });
  q('[data-reset]').addEventListener('click', () => {
    qa('[data-swatch]').forEach(inp => { inp.value = DEFAULT_THEME[inp.getAttribute('data-swatch')]; });
    setState({ theme: Object.assign({}, DEFAULT_THEME), dirty: true, saved: false });
  });

  // review link copy
  let copyT;
  q('[data-copy-link]').addEventListener('click', () => {
    if (navigator.clipboard) navigator.clipboard.writeText('https://www.myahsits.com/review/' + s.token);
    setState({ copied: true });
    clearTimeout(copyT);
    copyT = setTimeout(() => setState({ copied: false }), 2000);
  });

  // images
  const compressImage = (file, maxW, maxH, quality) => new Promise(resolve => {
    const img = new Image();
    img.onload = () => {
      let { width, height } = img;
      if (width > maxW || height > maxH) {
        const ratio = Math.min(maxW / width, maxH / height);
        width = Math.round(width * ratio);
        height = Math.round(height * ratio);
      }
      const canvas = document.createElement('canvas');
      canvas.width = width; canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) { resolve(file); return; }
      ctx.drawImage(img, 0, 0, width, height);
      canvas.toBlob(blob => {
        if (!blob) { resolve(file); return; }
        resolve(new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' }));
      }, 'image/jpeg', quality);
    };
    img.onerror = () => resolve(file);
    img.src = URL.createObjectURL(file);
  });

  const pic = q('[data-pic]');
  pic && pic.addEventListener('change', () => {
    const f = pic.files && pic.files[0];
    if (!f) return;
    q('[data-pic-preview]').src = URL.createObjectURL(f);
    dirty();
  });

  const queues = new Map();
  qa('input[data-upload-cat]').forEach(input => {
    input.addEventListener('change', () => {
      const cat = input.getAttribute('data-upload-cat');
      if (!input.files || !input.files.length) return;
      const list = (queues.get(cat) || []).concat(Array.from(input.files));
      input.value = '';
      queues.set(cat, list);
      const box = q('[data-queue-for="' + cat + '"]');
      if (box) {
        box.innerHTML = '';
        list.forEach(f => {
          const th = document.createElement('div');
          th.style.cssText = 'position:relative;width:80px;height:60px;border-radius:6px;overflow:hidden;border:2px solid rgba(47,93,69,.3);flex-shrink:0';
          const im = document.createElement('img');
          im.src = URL.createObjectURL(f);
          im.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
          th.appendChild(im);
          box.appendChild(th);
        });
      }
      dirty();
    });
  });

  // save — existing endpoints, in order
  const saveBtns = qa('[data-save]');
  const label = txt => saveBtns.forEach(b => { b.textContent = txt; });
  const saveAll = async () => {
    saveBtns.forEach(b => { b.disabled = true; });
    label('Saving…');
    showLoader(true);
    const errors = [];
    try {
      const details = q('[data-details-form]');
      const fd = new FormData(details);
      if (pic && pic.files && pic.files[0]) {
        const c = await compressImage(pic.files[0], 1200, 1200, 0.85);
        fd.set('profile_pic', c, c.name);
      }
      let r = await fetch('/api/profile/update', { method: 'POST', body: fd });
      if (r.url.includes('error=')) errors.push('Failed to save details.');

      for (const [cat, files] of queues.entries()) {
        if (!files.length) continue;
        label('Uploading ' + cat + ' photos…');
        const max = cat === 'hero' ? 1600 : 1000;
        const pfd = new FormData();
        pfd.set('_action', 'upload');
        pfd.set('category', cat);
        const done = await Promise.all(files.map(f => compressImage(f, max, max, 0.82)));
        done.forEach(f => pfd.append('files', f, f.name));
        r = await fetch('/api/profile/images', { method: 'POST', body: pfd });
        if (r.url.includes('error=')) errors.push('Failed to upload ' + cat + ' photos.');
      }

      label('Saving headings…');
      r = await fetch('/api/profile/headings', { method: 'POST', body: new FormData(q('[data-headings-form]')) });
      if (r.url.includes('error=')) errors.push('Failed to save headings.');

      label('Saving colours…');
      r = await fetch('/api/profile/theme', { method: 'POST', body: new FormData(q('[data-theme-form]')) });
      if (r.url.includes('error=')) errors.push('Failed to save colours.');
    } catch {
      errors.push('Something went wrong. Please try again.');
    }
    if (errors.length) {
      saveBtns.forEach(b => { b.disabled = false; });
      if (loader) { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }
      showMsg(errors.join(' '), true);
      render();
    } else {
      // A fresh query each time so the page always reloads (a change of #tab alone would not).
      window.location.href = '/profile/edit?saved=' + Date.now() + (location.hash || '');
    }
  };
  saveBtns.forEach(b => b.addEventListener('click', saveAll));

  // messages from the server (?saved=1, ?error=…)
  const msgEl = q('[data-form-msg]');
  const showMsg = (text, bad) => {
    msgEl.textContent = text;
    msgEl.style.display = 'block';
    msgEl.style.background = bad ? '#fdeeee' : 'rgba(110,84,56,.09)';
    msgEl.style.border = '1px solid ' + (bad ? '#f7cfcf' : 'rgba(110,84,56,.32)');
    msgEl.style.color = bad ? '#a4442e' : '#2f5d45';
  };
  const params = new URLSearchParams(location.search);
  const detail = params.get('detail');
  const errs = {
    missing: 'Please fill in the required fields.',
    file_too_large: 'Image must be under 5 MB.',
    upload: 'Upload error: ' + (detail || 'unknown'),
    server: 'Something went wrong. Please try again.'
  };
  const err = params.get('error');
  if (err && errs[err]) showMsg(errs[err], true);
  if (params.get('saved')) s.saved = true;

  render();
})();
</script>
<script is:inline>
  // Just created a profile (?welcome=1): say what to do next.
  (function () {
    if (new URLSearchParams(location.search).get('welcome') !== '1') return;
    var main = document.querySelector('main[data-pad]');
    if (!main) return;
    var box = document.createElement('div');
    box.setAttribute('data-welcome', '1');
    box.setAttribute('style', 'max-width:1100px;margin:0 auto 28px;background:#fff;color:#2c1a0e;border:1px solid rgba(110,84,56,.28);border-left:4px solid #2f5d45;border-radius:18px;padding:24px 26px;display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between');
    box.innerHTML =
      '<div style="flex:1 1 320px;min-width:0">' +
        '<p style="margin:0 0 6px;font-family:Lato,sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#8a6a4f">Your profile is live</p>' +
        '<h2 style="margin:0 0 8px;font-family:Marcellus,serif;font-size:1.5rem;font-weight:400;line-height:1.25;color:#2c1a0e">Next: make your page stand out</h2>' +
        '<p style="margin:0;font-size:.92rem;line-height:1.65;color:#6b4e35">Add photos of you and the pets you have looked after, and any reviews you already have. Save at the bottom, then browse sits and apply from your dashboard.</p>' +
      '</div>' +
      '<div style="display:flex;flex-wrap:wrap;gap:10px">' +
        '<a href="#photos" style="display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;border-radius:50px;background:#2f5d45;color:#fff;text-decoration:none;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">Add photos</a>' +
        '<a href="/dashboard" style="display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;border-radius:50px;border:1.5px solid rgba(110,84,56,.4);background:#fff;color:#2f5d45;text-decoration:none;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase">Go to my dashboard</a>' +
      '</div>';
    main.insertBefore(box, main.firstChild);
  })();
</script>
  <script is:inline src="/section-tabs.js"></script>

  <style is:global>
    /* Reviews in Edit profile: small cards, two lines each, first few only. */
    .ep-rev-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
    .ep-rev { padding:12px 14px !important; gap:10px !important; border-radius:12px !important; }
    .ep-rev-text { font-size:.82rem !important; line-height:1.5 !important; margin:0 0 4px !important; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; cursor:pointer; }
    .ep-rev.open .ep-rev-text { display:block; -webkit-line-clamp:unset; }
    .ep-rev-name { font-size:.74rem !important; }
    .ep-rev .ep-row-x { width:22px !important; height:22px !important; font-size:13px !important; }
    .ep-rev.more { display:none !important; }
    .ep-rev-list.all .ep-rev.more { display:flex !important; }
    @media (max-width:640px) { .ep-rev-list { grid-template-columns:minmax(0,1fr); gap:8px; } }
  </style>
  <script is:inline>
    (function () {
      document.addEventListener('click', function (e) {
        var t = e.target.closest && e.target.closest('.ep-rev-text');
        if (t) { t.closest('.ep-rev').classList.toggle('open'); return; }
        var b = e.target.closest && e.target.closest('[data-rev-all]');
        if (!b) return;
        var list = document.querySelector('[data-rev-list]'); var open = list.classList.toggle('all');
        b.setAttribute('aria-expanded', String(open));
        b.textContent = open ? 'Show fewer reviews' : 'Show all ' + list.children.length + ' reviews';
      });
    })();
  </script>
</body>
</html>
