---
// Data: the `applications`
// table (see schema.sql)
// for one of the owner's
// listings, joined to the
// sitter's profile.
export const prerender =
  false;
import IdGate from
  './_idgate.astro';
import AppNav from
  './_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../lib/account';
import {
  getSession,
} from '../lib/auth';
import {
  supabase,
} from '../lib/supabase';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'owner',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const pr =
  await supabase
  .from('profiles')
  .select(
    'id, profile_type',
  )
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const owner: any =
  pr.data;
// Side comes from the
// account (sign-up).
if (owner && acct)
  owner.profile_type =
    acct.side;
if (!owner) {
  return Astro.redirect(
    '/owner/profile/create',
  );
}
if (
  owner.profile_type !==
  'owner'
) {
  return Astro.redirect(
    '/dashboard',
  );
}

// Which listing: ?listing=
// or the next upcoming
// active one, else latest.
const want =
  Astro.url.searchParams
  .get('listing');
const lr =
  await supabase
  .from('listings')
  .select(
    'id, title, status,' +
    ' date_from, date_to',
  )
  .eq(
    'profile_id',
    owner.id,
  )
  .order('date_from', {
    ascending: true,
  });
const all: any[] =
  lr.data ?? [];
const today = new Date()
  .toISOString()
  .slice(0, 10);
const listing =
  all.find(
    (l) => l.id === want,
  ) ||
  all.find(
    (l) =>
      l.status ===
        'active' &&
      l.date_to >= today,
  ) ||
  all[all.length - 1];
if (!listing) {
  return Astro.redirect(
    '/owner/listings/new',
  );
}

let rows: any[] = [];
try {
  const ar =
    await supabase
    .from('applications')
    .select(
      'id, created_at,' +
      ' status, message,' +
      ' date_fit,' +
      ' tags_json,' +
      ' profile_id,' +
      ' profiles(id,' +
      ' name, slug,' +
      ' profile_pic,' +
      ' location,' +
      ' account_type,' +
      ' hero_images_json,' +
      ' gallery_json,' +
      ' reviews_json)',
    )
    .eq(
      'listing_id',
      listing.id,
    )
    .order(
      'created_at',
      { ascending: true },
    );
  rows = ar.data ?? [];
} catch {}

const ago = (
  iso: string,
) => {
  const days =
    Math.floor(
      (Date.now() -
        new Date(
          iso,
        ).getTime()) /
        86400000,
    );
  if (days <= 0) {
    return 'today';
  }
  if (days === 1) {
    return 'yesterday';
  }
  if (days < 14) {
    return (
      days + ' days ago'
    );
  }
  return (
    Math.floor(
      days / 7,
    ) + ' weeks ago'
  );
};

// The confirmed sit for
// this listing, if any.
let sitId = '';
try {
  const sr =
    await supabase
    .from('sits')
    .select('id')
    .eq(
      'listing_id',
      listing.id,
    )
    .maybeSingle();
  sitId =
    sr.data?.id || '';
} catch {}

const applicants = rows
  .map((a) => {
    const p =
      a.profiles || {};
    const revs =
      Array.isArray(
        p.reviews_json,
      )
        ? p.reviews_json
          .length
        : 0;
    const joint =
      p.account_type ===
      'joint';
    const tags =
      Array.isArray(
        a.tags_json,
      )
        ? a.tags_json
        : [];
    return {
      id: a.id,
      profileId:
        a.profile_id,
      name:
        p.name ||
        'Sitter',
      photo:
        p.profile_pic ||
        '',
      // Cover photo for the card (round 3, Airbnb feel).
      cover: String((Array.isArray(p.hero_images_json) && p.hero_images_json[0]?.src) || (Array.isArray(p.gallery_json) && p.gallery_json[0]?.src) || '').replace(/^public\//, '/'),
      slug: p.slug || '',
      meta: joint
        ? 'Joint sitters'
        : 'Solo sitter',
      message:
        a.message || '',
      rating: revs
        ? 5
        : 0,
      reviews: revs,
      dateFit:
        a.date_fit ||
        'Dates to confirm',
      location:
        p.location ||
        'Location not set',
      applied: ago(
        a.created_at,
      ),
      badge:
        revs >= 5
          ? '★'
          : '',
      tags,
      status:
        a.status || 'new',
    };
  });

// "4–18 Oct 2026"
const d = (
  s: string,
) => new Date(
  s + 'T00:00:00',
);
const mon = (
  x: Date,
) => x.toLocaleDateString(
  'en-GB',
  { month: 'short' },
);
const f = d(
  listing.date_from,
);
const t = d(
  listing.date_to,
);
const sameMonth =
  f.getMonth() ===
    t.getMonth() &&
  f.getFullYear() ===
    t.getFullYear();
const sameYear =
  f.getFullYear() ===
  t.getFullYear();
const range = sameMonth
  ? f.getDate() +
    '–' +
    t.getDate() +
    ' ' +
    mon(t) +
    ' ' +
    t.getFullYear()
  : sameYear
    ? f.getDate() +
      ' ' +
      mon(f) +
      ' – ' +
      t.getDate() +
      ' ' +
      mon(t) +
      ' ' +
      t.getFullYear()
    : f.getDate() +
      ' ' +
      mon(f) +
      ' ' +
      f.getFullYear() +
      ' – ' +
      t.getDate() +
      ' ' +
      mon(t) +
      ' ' +
      t.getFullYear();
// Design copy — used
// if a listing has no
// title.
const eyebrowDef = `
Cosy cottage with two spaniels · 4–18 Oct 2026
`.trim();
const eyebrow =
  listing.title
    ? listing.title +
      ' · ' +
      range
    : eyebrowDef;
const listingId =
  listing.id;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Applications — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; min-height: 100vh; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @media (max-width: 1000px) {
      [data-topnav] { padding: 14px 24px !important; }
      [data-pad] { padding: 34px 20px 80px !important; }
      [data-row] { grid-template-columns: minmax(0,1fr) !important; }
      [data-rowmeta] { border-left: none !important; border-top: 1px solid rgba(44,26,14,.08) !important; padding-top: 20px !important; }
    }

    .ap-back:hover { gap:13px !important; color:#2f5d45 !important; }
    .ap-msgs:hover { color:#2c1a0e !important; }
    .ap-ghost:hover { background:rgba(110,84,56,.1) !important; border-color:#2f5d45 !important; }
    .ap-btn:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; color:#fff !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <style is:global>
    .ap-row { animation:ap-in .5s cubic-bezier(.2,.7,.2,1) both; }
    @keyframes ap-in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
    .ap-row:hover { box-shadow:0 18px 44px rgba(44,26,14,.1) !important; }
    .ap-cover { position:relative; display:block; overflow:hidden; background:#e9e0d2; }
    .ap-cover img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .6s ease; }
    .ap-row:hover .ap-cover img { transform:scale(1.04); }
    @media (max-width:900px) {
      .ap-row { grid-template-columns:minmax(0,1fr) !important; }
      .ap-cover { height:150px; }
      [data-rowmeta] { border-left:0 !important; border-top:1px solid rgba(44,26,14,.08); }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={'owner'} active="applications" />

  <main data-pad="1" style="flex:1;padding:52px 48px 90px">
    <div style="max-width:1120px;margin:0 auto">
      <IdGate profile={acct!.profile} what="confirm a sitter" />

      <div style="border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:30px;margin-bottom:26px">
        <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 16px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>{eyebrow}</p>
        <h1 style="font-family:'Marcellus',serif;font-size:2.5rem;color:#2c1a0e;line-height:1.15;margin:0 0 18px">Who&rsquo;s <em style="color:#2f5d45;">applied</em></h1>
        <p data-intro="1" style="color:#6b4e35;font-size:1rem;line-height:1.75;max-width:600px;margin:0"></p>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:26px">
        <div data-tabs="1" style="display:flex;gap:9px;flex-wrap:wrap"></div>
        <div style="display:flex;gap:9px;flex-wrap:wrap;align-items:center">
          <span style="font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#6b4e35">Sort</span>
          <span data-sorts="1" style="display:contents"></span>
        </div>
      </div>

      <div data-list="1" style="display:flex;flex-direction:column;gap:16px"></div>

      <div data-empty="1" style="display:none">
        <p style="font-family:'Marcellus',serif;font-size:1.3rem;color:#2c1a0e;margin:0 0 10px">Nothing in this list</p>
        <p style="font-size:.95rem;color:#6b4e35;line-height:1.7;margin:0 0 20px;max-width:420px">Shortlist someone from the new applications and they&rsquo;ll gather here.</p>
        <button type="button" data-show-all="1" class="ap-ghost" style="font-family:'Montserrat',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;background:#fff;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:12px 28px;cursor:pointer;transition:background .25s ease, border-color .25s ease">See all applicants</button>
      </div>

      <div data-decide="1" style="display:none">
        <p data-decide-text="1" style="font-size:.92rem;color:#2c1a0e;margin:0;line-height:1.6;max-width:520px"></p>
        <a href="/messages" data-offer="1" class="ap-btn" style="display:inline-flex;align-items:center;justify-content:center;font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;border-radius:50px;padding:16px 36px;text-decoration:none;white-space:nowrap;box-shadow:0 6px 20px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease">Offer the sit</a>
      </div>
    </div>
  </main>
</div>

<script is:inline define:vars={{ applicants, listingId, sitId }}>
(() => {
  // Ported from the design's script: tabs, sort, shortlist/decline, empty state
  // and decide bar. Status changes are saved via /api/owner/applications.
  const APPLICANTS = applicants;
  const state = { tab: 'new', sort: 'best', status: {}, sitId, confirming: false };
  APPLICANTS.forEach(a => { state.status[a.id] = a.status; });
  const statusOf = id => state.status[id] || 'new';
  const q = s => document.querySelector(s);
  const esc = v => { const d = document.createElement('div'); d.textContent = v == null ? '' : String(v); return d.innerHTML; };

  const render = () => {
    const { tab, sort } = state;

    const counts = { all: APPLICANTS.length, new: 0, shortlist: 0, declined: 0 };
    const onList = st => st === 'shortlisted' || st === 'confirmed';
    APPLICANTS.forEach(a => { counts[onList(statusOf(a.id)) ? 'shortlist' : statusOf(a.id) === 'declined' ? 'declined' : 'new']++; });

    const tabDefs = [
      { key: 'new', label: 'New', count: counts.new },
      { key: 'shortlist', label: 'Shortlisted', count: counts.shortlist },
      { key: 'declined', label: 'Declined', count: counts.declined },
      { key: 'all', label: 'Everyone', count: counts.all }
    ];
    const sortDefs = [
      { key: 'best', label: 'Best fit' },
      { key: 'reviews', label: 'Most reviewed' },
      { key: 'near', label: 'Nearest' }
    ];

    let list = APPLICANTS.filter(a => {
      const st = statusOf(a.id);
      if (tab === 'all') return true;
      if (tab === 'shortlist') return onList(st);
      if (tab === 'declined') return st === 'declined';
      return st === 'new';
    });
    const miles = a => parseInt(a.location, 10) || 0;
    if (sort === 'reviews') list = [...list].sort((x, y) => y.reviews - x.reviews);
    else if (sort === 'near') list = [...list].sort((x, y) => miles(x) - miles(y));
    else list = [...list].sort((x, y) => (y.dateFit.indexOf('all') > -1) - (x.dateFit.indexOf('all') > -1) || y.reviews - x.reviews);

    const shortlisted = APPLICANTS.filter(a => statusOf(a.id) === 'shortlisted');
    const confirmed = APPLICANTS.find(a => statusOf(a.id) === 'confirmed');

    // Just the heading and the filter bubbles: no summary sentence.
    q('[data-intro]').style.display = 'none';

    q('[data-tabs]').innerHTML = tabDefs.map(t => {
      const style = 'display:inline-flex;align-items:center;gap:9px;font-family:\'Montserrat\',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:11px 20px;border-radius:50px;cursor:pointer;transition:background .25s ease, color .25s ease, border-color .25s ease;' +
        (tab === t.key ? 'background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;' : 'background:#fff;color:#5c3d20;border:1.5px solid rgba(110,84,56,.32);');
      const countStyle = 'font-size:.7rem;letter-spacing:.06em;padding:2px 8px;border-radius:50px;' + (tab === t.key ? 'background:rgba(255,255,255,.25);color:#fff;' : 'background:rgba(110,84,56,.14);color:#2f5d45;');
      return '<button type="button" data-tab="' + t.key + '" style="' + style + '">' + t.label + ' <span style="' + countStyle + '">' + t.count + '</span></button>';
    }).join('');

    q('[data-sorts]').innerHTML = sortDefs.map(s => {
      const style = 'font-family:\'Montserrat\',sans-serif;font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:9px 16px;border-radius:50px;cursor:pointer;transition:background .2s ease, color .2s ease, border-color .2s ease;' +
        (sort === s.key ? 'background:rgba(110,84,56,.14);color:#2f5d45;border:1.5px solid rgba(110,84,56,.45);' : 'background:#fff;color:#6b4e35;border:1.5px solid rgba(44,26,14,.1);');
      return '<button type="button" data-sort="' + s.key + '" style="' + style + '">' + s.label + '</button>';
    }).join('');

    q('[data-list]').innerHTML = list.map(a => {
      const st = statusOf(a.id);
      const initials = a.name.split(/[^A-Za-z]+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('');
      const photoStyle = 'width:76px;height:76px;border-radius:50%;object-fit:cover;border:2px solid rgba(110,84,56,.35);' + (a.photo ? 'display:block;' : 'display:none;');
      const initialsStyle = 'width:76px;height:76px;border-radius:50%;background:rgba(110,84,56,.14);border:2px solid rgba(110,84,56,.35);color:#2f5d45;font-family:\'Marcellus\',serif;font-size:1.5rem;align-items:center;justify-content:center;' + (a.photo ? 'display:none;' : 'display:flex;');
      const badgeStyle = 'position:absolute;right:-2px;bottom:-2px;width:24px;height:24px;border-radius:50%;background:#2f5d45;color:#fff;font-size:.7rem;display:flex;align-items:center;justify-content:center;border:2px solid #fff;' + (a.badge ? '' : 'display:none;');
      const statusLabel = st === 'confirmed' ? 'Confirmed' : st === 'shortlisted' ? 'Shortlisted' : st === 'declined' ? 'Declined' : 'New';
      const statusStyle = 'font-size:.64rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:4px 11px;border-radius:50px;' +
        (st === 'shortlisted' || st === 'confirmed' ? 'background:#2f5d45;color:#fff;' : st === 'declined' ? 'background:rgba(44,26,14,.1);color:#6b4e35;' : 'background:rgba(110,84,56,.14);color:#2f5d45;');
      const tagStyle = 'font-size:.74rem;font-weight:600;color:#6b4e35;background:#faf6ee;border:1px solid rgba(110,84,56,.28);padding:5px 13px;border-radius:50px;';
      const wrapStyle = 'display:grid;grid-template-columns:' + (a.cover ? '200px ' : '') + 'minmax(0,1.6fr) minmax(0,1fr);background:#fff;border-radius:18px;overflow:hidden;transition:border-color .3s ease, box-shadow .3s ease, opacity .3s ease;' +
        (st === 'shortlisted' || st === 'confirmed'
          ? 'border:1.5px solid #2f5d45;box-shadow:0 10px 30px rgba(110,84,56,.16);'
          : st === 'declined'
            ? 'border:1px solid rgba(44,26,14,.1);opacity:.5;'
            : 'border:1px solid rgba(110,84,56,.22);box-shadow:0 1px 2px rgba(44,26,14,.04);');
      const shortlistStyle = 'font-family:\'Montserrat\',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border-radius:50px;padding:13px 20px;cursor:pointer;width:100%;transition:background .25s ease, color .25s ease, border-color .25s ease, transform .15s ease;' +
        (st === 'shortlisted' || st === 'confirmed'
          ? 'background:#2f5d45;color:#fff;border:1.5px solid #2f5d45;box-shadow:0 6px 18px rgba(110,84,56,.28);'
          : 'background:#fff;color:#2f5d45;border:1.5px solid rgba(110,84,56,.45);');
      const declineStyle = 'flex:1;font-family:\'Montserrat\',sans-serif;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border-radius:50px;padding:11px 10px;cursor:pointer;background:none;color:#6b4e35;border:1.5px solid rgba(44,26,14,.15);transition:border-color .2s ease, color .2s ease';
      const stars = '★★★★★'.slice(0, a.rating) + '☆☆☆☆☆'.slice(0, 5 - a.rating);
      const reviewLine = a.reviews + (a.reviews === 1 ? ' review' : ' reviews');
      return '<article data-row="1" class="ap-row" style="' + wrapStyle + '">' +
        (a.cover ? '<a class="ap-cover" href="' + (a.slug ? '/' + esc(a.slug) : '#') + '" data-profile-link="1" aria-hidden="true" tabindex="-1"><img src="' + esc(a.cover) + '" alt="" loading="lazy" /></a>' : '') +
        '<div style="padding:26px 28px;display:flex;gap:20px;align-items:flex-start;min-width:0">' +
          (a.slug ? '<a href="/' + esc(a.slug) + '" data-profile-link="1" title="View ' + esc(a.name) + '\u2019s profile" style="position:relative;flex-shrink:0;display:block;text-decoration:none">' : '<div style="position:relative;flex-shrink:0">') +
            '<img src="' + esc(a.photo || '/images/logo-mark.png') + '" alt="" style="' + photoStyle + '" />' +
            '<span style="' + initialsStyle + '">' + esc(initials) + '</span>' +
            '<span style="' + badgeStyle + '">' + esc(a.badge) + '</span>' +
          (a.slug ? '</a>' : '</div>') +
          '<div style="flex:1;min-width:0">' +
            '<div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:6px">' +
              '<h2 style="font-family:\'Marcellus\',serif;font-size:1.28rem;color:#2c1a0e;margin:0;line-height:1.25">' + (a.slug ? '<a href="/' + esc(a.slug) + '" data-profile-link="1" style="color:inherit;text-decoration:none;border-bottom:1px solid rgba(110,84,56,.35)">' + esc(a.name) + '</a>' : esc(a.name)) + '</h2>' +
              '<span style="' + statusStyle + '">' + statusLabel + '</span>' +
            '</div>' +
            '<p style="font-size:.84rem;color:#2f5d45;font-weight:600;margin:0 0 14px">' + esc(a.meta) + (a.slug ? ' &middot; <a href="/' + esc(a.slug) + '" data-profile-link="1" style="color:#2f5d45;font-size:.74rem;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid rgba(47,93,69,.4)">View profile &rarr;</a>' : '') + '</p>' +
            (a.message ? '<p style="font-size:.95rem;color:#6b4e35;line-height:1.75;margin:0 0 16px;max-width:520px">“' + esc(a.message) + '”</p>' : '') +
            '<div style="display:flex;gap:8px;flex-wrap:wrap">' + a.tags.map(tg => '<span style="' + tagStyle + '">' + esc(tg) + '</span>').join('') + '</div>' +
          '</div>' +
        '</div>' +
        '<div data-rowmeta="1" style="padding:26px 28px;border-left:1px solid rgba(44,26,14,.08);display:flex;flex-direction:column;gap:18px;justify-content:space-between">' +
          '<div style="display:flex;flex-direction:column;gap:12px">' +
            '<div style="display:flex;align-items:center;gap:10px"><span style="font-size:.9rem;color:#2f5d45;letter-spacing:.08em">' + stars + '</span><span style="font-size:.82rem;color:#6b4e35">' + reviewLine + '</span></div>' +
            '<div style="display:flex;align-items:center;gap:9px;font-size:.85rem;color:#6b4e35"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>' + esc(a.dateFit) + '</div>' +
            '<div style="display:flex;align-items:center;gap:9px;font-size:.85rem;color:#6b4e35"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2f5d45" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M12 21s-7-4.6-7-10a7 7 0 0 1 14 0c0 5.4-7 10-7 10z"></path><circle cx="12" cy="11" r="2.4"></circle></svg>' + esc(a.location) + '</div>' +
            '<p style="font-size:.78rem;color:#8a6a4f;margin:0">Applied ' + esc(a.applied) + '</p>' +
          '</div>' +
          '<div style="display:flex;flex-direction:column;gap:10px">' +
            (st === 'confirmed'
              ? '<a href="/sits/' + esc(state.sitId) + '" class="ap-btn" style="' + shortlistStyle + 'display:block;text-align:center;text-decoration:none;box-sizing:border-box;">Open sit pack</a>'
              : '<button type="button" data-shortlist="' + esc(a.id) + '" style="' + shortlistStyle + '">' + (st === 'shortlisted' ? '✓ Shortlisted' : 'Shortlist') + '</button>' +
                (st === 'shortlisted' && !confirmed
                  ? '<button type="button" data-confirm="' + esc(a.id) + '" class="ap-btn"' + (state.confirming ? ' disabled' : '') + ' style="font-family:\'Montserrat\',sans-serif;font-size:.76rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;border-radius:50px;padding:13px 20px;cursor:pointer;width:100%;color:#fff;background:#2f5d45;border:1.5px solid #2f5d45;box-shadow:0 6px 18px rgba(110,84,56,.28);transition:background .25s ease, border-color .25s ease, transform .15s ease">Confirm sitter</button>'
                  : '')) +
            '<div style="display:flex;gap:10px">' +
              '<a href="/messages" data-message="' + esc(a.profileId) + '" class="ap-ghost" style="flex:1;text-align:center;font-size:.74rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border:1.5px solid rgba(110,84,56,.45);border-radius:50px;padding:11px 10px;transition:background .25s ease, border-color .25s ease">Message</a>' +
              (st === 'confirmed' ? '' : '<button type="button" data-decline="' + esc(a.id) + '" style="' + declineStyle + '">' + (st === 'declined' ? 'Undo' : 'Decline') + '</button>') +
            '</div>' +
          '</div>' +
        '</div>' +
      '</article>';
    }).join('');

    q('[data-empty]').style.cssText = 'flex-direction:column;align-items:flex-start;background:#fff;border:1px dashed rgba(110,84,56,.45);border-radius:18px;padding:44px 40px;' + (list.length === 0 ? 'display:flex;' : 'display:none;');
    q('[data-decide]').style.cssText = 'margin-top:28px;padding:24px 30px;border-radius:18px;background:rgba(110,84,56,.1);border:1px solid rgba(110,84,56,.35);align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;' +
      (shortlisted.length || confirmed ? 'display:flex;' : 'display:none;');
    const offer = q('[data-offer]');
    if (confirmed) {
      q('[data-decide-text]').textContent = confirmed.name + ' is confirmed for this sit. Their sit pack is ready, and you can both see it.';
      offer.textContent = 'Open sit pack';
      offer.setAttribute('href', '/sits/' + state.sitId);
      return;
    }
    offer.textContent = 'Offer the sit';
    offer.setAttribute('href', '#');
    q('[data-decide-text]').textContent = shortlisted.length === 1
      ? 'One name on the shortlist — ' + shortlisted[0].name + '. Offer them the sit and the others are told politely.'
      : shortlisted.length + ' on the shortlist: ' + shortlisted.map(a => a.name).join(', ') + '. Pick one to offer and the rest are told politely.';
  };

  const setStatus = (id, next) => {
    const prev = statusOf(id);
    state.status[id] = next;
    render();
    fetch('/api/owner/applications', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status: next })
    }).then(r => { if (!r.ok) throw new Error(); }).catch(() => { state.status[id] = prev; render(); });
  };

  // Confirm one sitter: creates their sit pack and tells everyone else politely.
  const confirmSitter = async id => {
    const a = APPLICANTS.find(x => x.id === id);
    if (!a || state.confirming) return;
    if (!window.confirm('Confirm ' + a.name + ' for this sit? Anyone else still waiting will be told it has gone.')) return;
    state.confirming = true; render(); show();
    try {
      const r = await fetch('/api/owner/applications', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, action: 'confirm' })
      });
      const data = await r.json().catch(() => ({}));
      if (!r.ok || !data.sit_id) throw new Error(data.error || 'server');
      state.sitId = data.sit_id;
      APPLICANTS.forEach(x => {
        const st = statusOf(x.id);
        if (x.id === id) state.status[x.id] = 'confirmed';
        else if (st === 'new' || st === 'shortlisted') state.status[x.id] = 'declined';
      });
      state.tab = 'shortlist';
    } catch (err) {
      window.alert(err.message === 'id_required'
        ? 'Verify your ID before confirming a sitter — go to Verification in the menu.'
        : err.message === 'already_confirmed'
        ? 'Someone is already confirmed for this sit.'
        : 'Could not confirm — please try again.');
    } finally {
      state.confirming = false;
      loader.style.opacity = '0'; loader.style.pointerEvents = 'none';
      render();
    }
  };

  const loader = q('[data-loader]');
  let hideT;
  const show = () => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };

  document.addEventListener('click', async e => {
    const el = e.target.closest && e.target.closest('[data-tab],[data-sort],[data-shortlist],[data-decline],[data-confirm],[data-offer],[data-show-all],[data-message],a[href]');
    if (!el) return;
    if (el.hasAttribute('data-tab')) { state.tab = el.getAttribute('data-tab'); render(); return; }
    if (el.hasAttribute('data-sort')) { state.sort = el.getAttribute('data-sort'); render(); return; }
    if (el.hasAttribute('data-show-all')) { state.tab = 'all'; render(); return; }
    if (el.hasAttribute('data-shortlist')) { const id = el.getAttribute('data-shortlist'); setStatus(id, statusOf(id) === 'shortlisted' ? 'new' : 'shortlisted'); return; }
    if (el.hasAttribute('data-confirm')) { confirmSitter(el.getAttribute('data-confirm')); return; }
    if (el.hasAttribute('data-offer') && el.getAttribute('href') === '#') {
      e.preventDefault();
      const sl = APPLICANTS.filter(a => statusOf(a.id) === 'shortlisted');
      if (sl.length === 1) confirmSitter(sl[0].id);
      else { state.tab = 'shortlist'; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
      return;
    }
    if (el.hasAttribute('data-decline')) { const id = el.getAttribute('data-decline'); setStatus(id, statusOf(id) === 'declined' ? 'new' : 'declined'); return; }
    if (e.metaKey || e.ctrlKey || e.shiftKey) return;
    if (el.hasAttribute('data-message')) {
      // Open (or start) the conversation with this sitter about this listing.
      e.preventDefault();
      show();
      try {
        const r = await fetch('/api/messages/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipient_profile_id: el.getAttribute('data-message'), listing_id: listingId })
        });
        const data = await r.json();
        location.href = data.conversation_id ? '/messages/' + data.conversation_id : '/messages';
      } catch { location.href = '/messages'; }
      return;
    }
    const href = el.getAttribute('href') || '';
    if (!href.startsWith('#') && !href.startsWith('http')) show();
  });

  render();
})();
</script>
</body>
</html>
