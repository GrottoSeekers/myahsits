---
export const prerender =
  false;
import IdGate from
  '../_idgate.astro';
import AppNav from
  '../_nav.astro';
import {
  getAccount,
  wrongPlace,
} from
  '../../lib/account';
import {
  getSession,
} from '../../lib/auth';
import {
  supabase,
} from
  '../../lib/supabase';
import
  '../../styles/dash.css';

const session =
  await getSession(
    Astro.request,
  );
if (!session) {
  return Astro.redirect(
    '/login',
  );
}
// Keep each account on its
// own side of the site.
const acct =
  await getAccount(
    Astro.request,
  );
const away =
  wrongPlace(
    acct,
    'any',
  );
if (away) {
  return Astro.redirect(
    away,
  );
}

const pr =
  await supabase
  .from('profiles')
  .select(
    'id, profile_type,' +
    ' name, profile_pic',
  )
  .eq(
    'user_id',
    session.userId,
  )
  .single();
const profile: any =
  pr.data;
// Side comes from the
// account (sign-up).
if (profile && acct)
  profile.profile_type =
    acct.side;
if (!profile) {
  return Astro.redirect(
    session.role ===
      'owner'
      ? '/owner/profile/create'
      : '/profile/create',
  );
}

const isOwner =
  profile.profile_type ===
  'owner';
const dashUrl = isOwner
  ? '/owner/dashboard'
  : '/dashboard';
const sitsUrl = isOwner
  ? '/owner/dashboard'
  : '/listings';
const profileUrl =
  isOwner
    ? '/owner/profile/edit'
    : '/profile/edit';
// Set by /messages/[id]
const initialConv =
  Astro.url.searchParams
  .get('c') || '';
const myProfileId =
  profile.id;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/app-tile.png" />
  <meta property="og:image" content="/images/logo-tile.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  <title>Messages — MYAH</title>
  <style is:global>
    body { margin: 0; background: #faf6ee; color: #2c1a0e; font-family: "Montserrat", sans-serif; }
    * { box-sizing: border-box; }
    a { color: #2f5d45; }
    a:hover { color: #2c1a0e; }
    input::placeholder { color: rgba(44,26,14,.4); }
    @keyframes gs-ring { to { transform: rotate(360deg); } }
    @keyframes gs-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
    @keyframes msg-pop { from { opacity: 0; transform: translateY(12px) scale(.97); } to { opacity: 1; transform: none; } }
    @media (max-width: 900px) {
      [data-topnav] { padding: 12px 24px !important; }
      [data-msg-pad] { padding: 24px !important; }
      [data-msg-grid] { grid-template-columns: minmax(0,1fr) !important; }
      [data-thread] { min-height: 560px !important; }
    }

    /* ── Phones: list first; a conversation opens full screen ─────────────── */
    .mx-back { display:none; }
    @media (max-width: 760px) {
      [data-msg-pad] { padding: 18px 14px 28px !important; }
      [data-msg-head] { padding-bottom: 16px !important; margin-bottom: 16px !important; }
      [data-msg-head] h1 { font-size: 1.9rem !important; }
      body:not(.mx-open) [data-thread] { display: none !important; }
      body.mx-open { overflow: hidden; }
      body.mx-open [data-thread] {
        position: fixed !important; inset: 0 !important; z-index: 400 !important;
        height: 100dvh !important; min-height: 0 !important;
        border: none !important; border-radius: 0 !important; box-shadow: none !important;
      }
      body.mx-open [data-thread] > div:first-child { padding: 10px 14px !important; gap: 10px !important; padding-top: max(10px, env(safe-area-inset-top)) !important; }
      body.mx-open [data-scroll] { padding: 16px 14px !important; }
      body.mx-open [data-compose] { padding: 10px 12px !important; padding-bottom: max(10px, env(safe-area-inset-bottom)) !important; }
      [data-input] { font-size: 16px !important; } /* no zoom-in on iPhone */
      .mx-back { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; margin-left: -6px; border: none; border-radius: 50%; background: transparent; color: #2c1a0e; cursor: pointer; flex-shrink: 0; }
      .mx-back:active { background: rgba(110,84,56,.12); }
      [data-view-sit] { padding: 8px 12px !important; font-size: .64rem !important; }
      [data-active-pic] { width: 38px !important; height: 38px !important; }
    }

    .mx-nav-link:hover { color:#2f5d45 !important; }
    .mx-tab:hover { color:#2f5d45 !important; }
    .mx-card:hover { box-shadow:0 10px 34px rgba(44,26,14,.08) !important; border-color:rgba(110,84,56,.4) !important; }
    .mx-view:hover { background:#2f5d45 !important; color:#fff !important; border-color:#2f5d45 !important; }
    .mx-input:focus { border-color:#2f5d45 !important; box-shadow:0 0 0 3px rgba(110,84,56,.15) !important; }
    .mx-send:hover { background:#3e7a5b !important; border-color:#3e7a5b !important; transform:translateY(-2px) !important; box-shadow:0 12px 28px rgba(110,84,56,.36) !important; }
    .mx-send:active { transform:translateY(0) scale(.96) !important; }
  </style>
  <link rel="stylesheet" href="/mobile.css" />
  <style is:global>
    /* WhatsApp-style messages in MYAH colours (round 3) */
    [data-msg-pad] { padding:24px 48px 40px !important; }
    [data-msg-head] { padding-bottom:16px !important; margin-bottom:18px !important; border-bottom:0 !important; }
    [data-msg-head] h1 { font-size:1.9rem !important; }
    .wa-app { display:grid; grid-template-columns:360px minmax(0,1fr); height:calc(100vh - 250px); min-height:520px; background:#fff; border:1px solid rgba(110,84,56,.2); border-radius:20px; overflow:hidden; box-shadow:0 18px 50px rgba(44,26,14,.08); }
    .wa-side { display:flex; flex-direction:column; min-height:0; border-right:1px solid rgba(110,84,56,.14); background:#fff; }
    .wa-side-head { padding:16px 16px 10px; }
    .wa-h { margin:0 0 12px; font:400 1.5rem 'Marcellus',serif; color:#2c1a0e; }
    .wa-search { display:flex; align-items:center; gap:10px; padding:9px 14px; border-radius:12px; background:#f3ece0; color:#8a6a4f; }
    .wa-search input { flex:1; min-width:0; border:0; outline:none; background:none; font:400 .9rem 'Montserrat',sans-serif; color:#2c1a0e; }
    .wa-filters { display:flex; gap:6px; margin-top:10px; }
    .wa-filters button { border:0; border-radius:50px; padding:6px 13px; background:#f3ece0; font:600 .76rem 'Montserrat',sans-serif; color:#6b4e35; cursor:pointer; }
    .wa-filters button[aria-pressed="true"] { background:#dcebdf; color:#2f5d45; }
    .wa-list { flex:1; overflow-y:auto; }
    .wa-row { display:flex; gap:13px; align-items:center; width:100%; padding:10px 16px; border:0; background:#fff; cursor:pointer; text-align:left; font-family:'Montserrat',sans-serif; transition:background .15s; }
    .wa-row:hover { background:#faf6ee; }
    .wa-row.on { background:#f3ece0; }
    .wa-row > img { width:50px; height:50px; border-radius:50%; object-fit:cover; flex:none; }
    .wa-mid { flex:1; min-width:0; display:flex; flex-direction:column; gap:2px; padding:4px 0 10px; border-bottom:1px solid rgba(44,26,14,.07); }
    .wa-row:last-child .wa-mid { border-bottom:0; }
    .wa-top { display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
    .wa-top b { font-weight:600; font-size:.98rem; color:#2c1a0e; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .wa-top small { flex:none; font-size:.72rem; color:#8a6a4f; }
    .wa-row.unread .wa-top small { color:#2f5d45; font-weight:700; }
    .wa-sit { font-size:.7rem; font-weight:600; color:#2f5d45; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .wa-last { display:flex; align-items:center; gap:5px; font-size:.86rem; color:#6b4e35; min-width:0; }
    .wa-last > span { flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .wa-row.unread .wa-last > span { color:#2c1a0e; font-weight:600; }
    .wa-last em { flex:none; font-style:normal; min-width:20px; height:20px; padding:0 6px; border-radius:50px; background:#2f5d45; color:#fff; font-size:.68rem; font-weight:700; display:flex; align-items:center; justify-content:center; }
    .wa-tick { font-style:normal; font-size:.72rem; letter-spacing:-3px; padding-right:3px; color:rgba(44,26,14,.4); }
    .wa-tick.read { color:#3b8fd0; }
    .wa-none { padding:24px 18px; color:#8a6a4f; font-size:.88rem; }
    .wa-thread { min-width:0; min-height:0; background:#efe7da; }
    .wa-thread > div:first-child { background:#f6f0e6 !important; border-bottom:1px solid rgba(110,84,56,.14) !important; padding:10px 18px !important; }
    [data-scroll] { padding:18px 6% !important; gap:2px !important; }
    .wa-day { text-align:center; margin:10px 0; }
    .wa-day span { display:inline-block; padding:5px 12px; border-radius:8px; background:#fff; box-shadow:0 1px 1px rgba(44,26,14,.12); font-size:.72rem; font-weight:600; color:#6b4e35; text-transform:uppercase; letter-spacing:.06em; }
    .wa-line { display:flex; margin:1px 0; }
    .wa-line.tail { margin-top:8px; }
    .wa-line.me { justify-content:flex-end; }
    .wa-b { position:relative; max-width:min(75%,520px); padding:7px 10px 6px 11px; border-radius:10px; box-shadow:0 1px 1px rgba(44,26,14,.13); word-wrap:break-word; }
    .wa-b.pop { animation:msg-pop .25s ease; }
    .wa-line.them .wa-b { background:#fff; }
    .wa-line.me .wa-b { background:#dcebdf; }
    .wa-line.tail.them .wa-b { border-top-left-radius:0; }
    .wa-line.tail.me .wa-b { border-top-right-radius:0; }
    .wa-line.tail .wa-b::before { content:""; position:absolute; top:0; width:10px; height:12px; }
    .wa-line.tail.them .wa-b::before { left:-8px; background:#fff; clip-path:polygon(0 0,100% 0,100% 100%); }
    .wa-line.tail.me .wa-b::before { right:-8px; background:#dcebdf; clip-path:polygon(0 0,100% 0,0 100%); }
    .wa-txt { font-size:.93rem; line-height:1.45; color:#2c1a0e; white-space:pre-wrap; }
    .wa-meta { float:right; display:inline-flex; align-items:center; gap:3px; margin:8px 0 -4px 12px; font-size:.66rem; color:rgba(44,26,14,.5); }
    [data-compose] { background:#f6f0e6 !important; border-top:0 !important; padding:10px 14px !important; }
    [data-compose] [data-input] { background:#fff !important; border:0 !important; border-radius:22px !important; padding:12px 18px !important; box-shadow:0 1px 1px rgba(44,26,14,.08); }
    [data-compose] .mx-send { width:46px !important; height:46px !important; box-shadow:none !important; }
    @media (max-width:900px) {
      [data-msg-pad] { padding:16px !important; }
      .wa-app { grid-template-columns:minmax(0,1fr); height:auto; min-height:0; border-radius:18px; }
      .wa-side { border-right:0; }
      .wa-list { max-height:none; }
    }
    @media (max-width:760px) {
      [data-msg-head] { display:none !important; }
      .wa-app { border:0; box-shadow:none; background:transparent; border-radius:0; margin:0 -14px; }
      .wa-side { background:transparent; }
      .wa-side-head { padding:4px 14px 8px; }
      .wa-h { font:700 1.9rem 'Montserrat',sans-serif; letter-spacing:-.02em; margin-bottom:10px; }
      .wa-row { background:transparent; padding:8px 14px; }
      .wa-row.on { background:transparent; }
      body.mx-open .wa-thread > div:first-child { padding:8px 10px !important; }
      body.mx-open [data-scroll] { padding:12px 10px !important; }
      .wa-b { max-width:82%; }
    }
  </style>
</head>
<body>
<div style="min-height:100vh;display:flex;flex-direction:column;background:#faf6ee">

  <div data-loader="1" aria-hidden="true" style="position:fixed;inset:0;z-index:9999;background:rgba(250,246,238,.92);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s ease">
    <div style="position:relative;width:132px;height:132px;display:flex;align-items:center;justify-content:center">
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid rgba(110,84,56,.18)"></div>
      <div style="position:absolute;inset:0;border-radius:50%;border:3px solid transparent;border-top-color:#2f5d45;border-right-color:rgba(110,84,56,.45);animation:gs-ring 1s linear infinite"></div>
      <img src="/images/logo-mark.png" alt="" style="width:74px;height:74px;object-fit:contain;animation:gs-pulse 1.8s ease-in-out infinite" />
    </div>
  </div>

  <AppNav side={acct!.side} active="messages" />

  <div data-msg-toasts="1" style="position:fixed;top:20px;right:20px;z-index:8000;display:flex;flex-direction:column;gap:10px;pointer-events:none"></div>

  <main data-msg-pad="1" style="flex:1;padding:40px 48px 60px">
    <div style="max-width:1100px;margin:0 auto">
      <div data-msg-head="1" style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;border-bottom:1px solid rgba(110,84,56,.3);padding-bottom:26px;margin-bottom:28px">
        <div>
          <p style="font-size:.75rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:#6e5438;margin:0 0 14px;display:flex;align-items:center;gap:12px"><span style="width:26px;height:1px;background:#6e5438;display:block;flex-shrink:0"></span>Your inbox</p>
          <h1 style="font-family:'Marcellus',serif;font-size:2.3rem;color:#2c1a0e;line-height:1.15;margin:0">Messages</h1>
        </div>
        <p data-unread="1" style="margin:0 0 4px;font-size:.8rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#6b4e35"></p>
      </div>

      <div data-msg-grid="1" class="wa-app">

        <div class="wa-side">
          <div class="wa-side-head">
            <p class="wa-h">Chats</p>
            <label class="wa-search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg><input data-wa-search type="search" placeholder="Search" aria-label="Search chats" /></label>
            <div class="wa-filters" role="group" aria-label="Show"><button type="button" data-wa-filter="all" aria-pressed="true">All</button><button type="button" data-wa-filter="unread" aria-pressed="false">Unread</button></div>
          </div>
          <div data-conv-list="1" class="wa-list"></div>
        </div>

        <div data-thread="1" class="wa-thread" style="display:flex;flex-direction:column">
          <div style="display:flex;align-items:center;gap:13px;padding:14px 20px;background:#fff;border-bottom:1px solid rgba(110,84,56,.2);flex-shrink:0">
            <img data-active-pic="1" src="/images/avatar-cream.png" alt="" style="width:44px;height:44px;border-radius:50%;object-fit:cover;flex-shrink:0;border:2px solid rgba(110,84,56,.3)" />
            <div style="flex:1;min-width:0">
              <p data-active-name="1" style="font-weight:600;font-size:1rem;color:#2c1a0e;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"></p>
              <p data-active-listing="1" style="font-size:.75rem;color:#2f5d45;font-weight:600;letter-spacing:.03em;margin:2px 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"></p>
            </div>
            <a data-view-sit="1" href="/listings" class="mx-view" style="font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#2f5d45;text-decoration:none;border:1.5px solid rgba(110,84,56,.4);border-radius:50px;padding:9px 18px;white-space:nowrap;transition:background .2s, color .2s, border-color .2s">View sit</a>
          </div>

          <div data-scroll="1" style="flex:1;overflow-y:auto;padding:20px 22px;display:flex;flex-direction:column;gap:3px"></div>

          {acct!.verified ? (
          <form data-compose="1" style="display:flex;gap:10px;align-items:center;padding:14px 18px;background:#fff;border-top:1px solid rgba(110,84,56,.2);flex-shrink:0">
            <input data-input="1" type="text" placeholder="Type a message…" autocomplete="off" class="mx-input" style="flex:1;border:1.5px solid rgba(110,84,56,.3);border-radius:50px;padding:13px 20px;font-size:.94rem;font-family:'Montserrat',sans-serif;color:#2c1a0e;background:#faf6ee;outline:none;transition:border-color .2s, box-shadow .2s" />
            <button type="submit" aria-label="Send message" class="mx-send" style="width:48px;height:48px;border-radius:50%;border:1.5px solid #2f5d45;background:#2f5d45;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 6px 18px rgba(110,84,56,.3);transition:background .2s, border-color .2s, transform .12s">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            </button>
          </form>
          ) : (
            <div style="padding:12px;background:#fff;border-top:1px solid rgba(110,84,56,.2)"><IdGate profile={acct!.profile} what="send messages" compact /></div>
          )}
        </div>
      </div>
    </div>
  </main>
</div>

<script is:inline define:vars={{ myProfileId, initialConv }}>
(() => {
  const q = s => document.querySelector(s);
  const esc = s => { const d = document.createElement('div'); d.textContent = String(s ?? ''); return d.innerHTML; };
  const hhmm = iso => new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
  const listTime = iso => {
    const d = new Date(iso);
    const diff = Date.now() - d.getTime();
    if (diff < 86400000 && d.getDate() === new Date().getDate()) return hhmm(iso);
    if (diff < 604800000) return d.toLocaleDateString('en-GB', { weekday: 'short' });
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
  };
  const dayLabel = iso => {
    const d = new Date(iso);
    const today = new Date();
    if (d.toDateString() === today.toDateString()) return 'Today';
    const y = new Date(today); y.setDate(today.getDate() - 1);
    if (d.toDateString() === y.toDateString()) return 'Yesterday';
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  };
  const avatar = p => p || '/images/avatar-cream.png';

  let conversations = [];
  let active = initialConv || null;
  const knownIds = new Set();
  let firstThreadLoad = true;

  // ── conversation list ──────────────────────────────────────────
  let waFilter = 'all';
  const renderList = () => {
    const list = q('[data-conv-list]');
    if (!list) return;
    // WhatsApp-style rows (round 3): avatar, name and last message, time and
    // an unread count on the right.
    const needle = (q('[data-wa-search]') && q('[data-wa-search]').value.trim().toLowerCase()) || '';
    const rows = conversations.filter(c => {
      const unread = c.id === active ? 0 : (c.unread_count || 0);
      if (waFilter === 'unread' && !unread) return false;
      if (!needle) return true;
      return (((c.other && c.other.name) || '') + ' ' + ((c.listing && c.listing.title) || '')).toLowerCase().includes(needle);
    });
    list.innerHTML = rows.length ? rows.map(c => {
      const on = c.id === active;
      const unread = on ? 0 : (c.unread_count || 0);
      const last = c.last_message;
      const text = last ? last.body || '' : '';
      const mine = last && last.sender_profile_id === myProfileId;
      const tick = mine ? '<i class="wa-tick' + (last.read_at ? ' read' : '') + '">' + (last.read_at ? '✓✓' : '✓') + '</i>' : '';
      return '<button type="button" data-conv="' + esc(c.id) + '" class="wa-row' + (on ? ' on' : '') + (unread ? ' unread' : '') + '">' +
        '<img src="' + esc(avatar(c.other && c.other.profile_pic)) + '" alt="" />' +
        '<span class="wa-mid">' +
          '<span class="wa-top"><b>' + esc((c.other && c.other.name) || 'Unknown') + '</b><small>' + esc(last ? listTime(last.created_at) : '') + '</small></span>' +
          '<span class="wa-sit">' + esc((c.listing && c.listing.title) || '') + '</span>' +
          '<span class="wa-last">' + tick + '<span>' + esc(text) + '</span>' + (unread ? '<em>' + unread + '</em>' : '') + '</span>' +
        '</span>' +
      '</button>';
    }).join('') : '<p class="wa-none">' + (needle ? 'No chats match “' + esc(needle) + '”.' : waFilter === 'unread' ? 'No unread chats.' : 'No messages yet.') + '</p>';
  };

  const renderUnread = () => {
    const total = conversations.reduce((n, c) => n + (c.id === active ? 0 : (c.unread_count || 0)), 0);
    const el = q('[data-unread]');
    if (el) el.textContent = total > 0 ? total + ' unread' : 'All caught up';
  };

  const loadConversations = async () => {
    try {
      const res = await fetch('/api/messages/conversations');
      const data = await res.json();
      conversations = Array.isArray(data) ? data : [];
      if (!active && conversations.length) { active = conversations[0].id; selectThread(active); }
      renderList();
      renderUnread();
    } catch {}
  };

  // ── thread ─────────────────────────────────────────────────────
  const renderHeader = () => {
    const c = conversations.find(x => x.id === active);
    const other = (c && c.other) || {};
    const listing = (c && c.listing) || {};
    q('[data-active-pic]').src = avatar(other.profile_pic);
    q('[data-active-name]').textContent = other.name || '';
    q('[data-active-listing]').textContent = listing.title || '';
    const view = q('[data-view-sit]');
    if (listing.id) { view.href = '/listings/' + listing.id; view.style.display = ''; }
    else view.style.display = 'none';
  };

  const scrollDown = () => {
    const box = q('[data-scroll]');
    if (box) requestAnimationFrame(() => { box.scrollTop = box.scrollHeight; });
  };

  const renderMessages = msgs => {
    const box = q('[data-scroll]');
    if (!box) return;
    const fresh = msgs.filter(m => !knownIds.has(m.id));
    let html = '';
    let lastDay = '';
    let prevMine = null;
    msgs.forEach(m => {
      const day = dayLabel(m.created_at);
      if (day !== lastDay) {
        html += '<div class="wa-day"><span>' + esc(day) + '</span></div>';
        lastDay = day; prevMine = null;
      }
      const mine = m.sender_profile_id === myProfileId;
      const read = !!m.read_at;
      const isNew = firstThreadLoad || !knownIds.has(m.id);
      const tail = prevMine !== mine;
      prevMine = mine;
      html += '<div class="wa-line ' + (mine ? 'me' : 'them') + (tail ? ' tail' : '') + '"><div class="wa-b' + (isNew ? ' pop' : '') + '">' +
        '<span class="wa-txt">' + esc(m.body) + '</span>' +
        '<span class="wa-meta">' + hhmm(m.created_at) + (mine ? '<i class="wa-tick' + (read ? ' read' : '') + '">' + (read ? '✓✓' : '✓') + '</i>' : '') + '</span>' +
      '</div></div>';
    });
    box.innerHTML = html;
    if (firstThreadLoad || fresh.length) scrollDown();
    msgs.forEach(m => knownIds.add(m.id));
    firstThreadLoad = false;
  };

  const loadThread = async () => {
    if (!active) return;
    const id = active;
    try {
      const res = await fetch('/api/messages/' + encodeURIComponent(id));
      const msgs = await res.json();
      if (id !== active || !Array.isArray(msgs)) return;
      renderMessages(msgs);
      conversations = conversations.map(c => c.id === id ? Object.assign({}, c, { unread_count: 0 }) : c);
      renderUnread();
    } catch {}
  };

  const selectThread = id => {
    active = id;
    knownIds.clear();
    firstThreadLoad = true;
    const box = q('[data-scroll]');
    if (box) box.innerHTML = '';
    renderHeader();
    renderList();
    loadThread();
    if (history.replaceState) history.replaceState(null, '', '/messages?c=' + encodeURIComponent(id));
  };

  // Phones: tapping a conversation opens it full screen; back returns to the list.
  const phone = window.matchMedia('(max-width: 760px)');
  const openThread = (push) => {
    if (!phone.matches) return;
    if (!document.body.classList.contains('mx-open') && push && history.pushState) history.pushState({ mxThread: 1 }, '', location.href);
    document.body.classList.add('mx-open');
    const box = q('[data-scroll]'); if (box) setTimeout(() => { box.scrollTop = box.scrollHeight; }, 60);
  };
  const closeThread = () => {
    document.body.classList.remove('mx-open');
    if (history.replaceState) history.replaceState(null, '', '/messages');
  };
  const head = q('[data-thread] > div');
  if (head && !q('[data-thread-back]')) {
    const back = document.createElement('button');
    back.type = 'button'; back.className = 'mx-back'; back.setAttribute('data-thread-back', '1'); back.setAttribute('aria-label', 'All messages');
    back.innerHTML = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>';
    back.addEventListener('click', () => { if (history.state && history.state.mxThread) history.back(); else closeThread(); });
    head.insertBefore(back, head.firstChild);
  }
  window.addEventListener('popstate', () => { if (document.body.classList.contains('mx-open')) closeThread(); });
  // Arriving from a notification or "Open message" link (?c=…) opens that conversation.
  if (initialConv) openThread(false);

  const wsearch = q('[data-wa-search]');
  wsearch && wsearch.addEventListener('input', () => renderList());
  document.querySelectorAll('[data-wa-filter]').forEach(b => b.addEventListener('click', () => {
    waFilter = b.getAttribute('data-wa-filter');
    document.querySelectorAll('[data-wa-filter]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    renderList();
  }));
  q('[data-conv-list]').addEventListener('click', e => {
    const row = e.target.closest && e.target.closest('[data-conv]');
    if (row) { selectThread(row.getAttribute('data-conv')); openThread(true); }
  });

  // ── send ───────────────────────────────────────────────────────
  const form = q('[data-compose]');
  form && form.addEventListener('submit', async e => {
    e.preventDefault();
    const input = q('[data-input]');
    const body = (input.value || '').trim();
    if (!body || !active) return;
    input.value = '';
    try {
      await fetch('/api/messages/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conversation_id: active, body })
      });
      await loadThread();
      loadConversations();
    } catch {}
    input.focus();
  });

  // ── loader ─────────────────────────────────────────────────────
  const loader = q('[data-loader]');
  let hideT;
  const show = () => {
    if (!loader) return;
    loader.style.opacity = '1';
    loader.style.pointerEvents = 'all';
    clearTimeout(hideT);
    hideT = setTimeout(() => { loader.style.opacity = '0'; loader.style.pointerEvents = 'none'; }, 1600);
  };
  document.querySelectorAll('a[href]').forEach(a => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#') || href.startsWith('http')) return;
    a.addEventListener('click', e => { if (e.metaKey || e.ctrlKey || e.shiftKey) return; show(); });
  });

  // ── toasts for messages in other conversations ─────────────────
  const seen = new Set();
  let firstUnread = true;
  const ping = () => {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain); gain.connect(ctx.destination);
      osc.frequency.setValueAtTime(660, ctx.currentTime);
      osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
      gain.gain.setValueAtTime(0.08, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
      osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.4);
    } catch {}
  };
  const toast = m => {
    const box = q('[data-msg-toasts]');
    if (!box) return;
    const s = m.sender || {};
    const av = s.profile_pic
      ? '<img src="' + esc(s.profile_pic) + '" class="msg-toast-avatar" />'
      : '<div class="msg-toast-avatar-ph">' + esc((s.name || '?').charAt(0).toUpperCase()) + '</div>';
    const t = document.createElement('a');
    t.href = '#';
    t.className = 'msg-toast';
    t.innerHTML = av + '<div class="msg-toast-body"><div class="msg-toast-name">' + esc(s.name || 'Someone') + '</div><div class="msg-toast-preview">' + esc((m.body || '').slice(0, 80)) + '</div></div>';
    t.addEventListener('click', e => { e.preventDefault(); selectThread(m.conversation_id); t.remove(); });
    box.appendChild(t);
    setTimeout(() => { t.classList.add('toast-out'); setTimeout(() => t.remove(), 300); }, 5000);
  };
  const checkUnread = async () => {
    try {
      const res = await fetch('/api/messages/unread');
      const data = await res.json();
      if (data.messages) {
        if (!firstUnread) {
          const fresh = data.messages.filter(m => !seen.has(m.id) && m.conversation_id !== active);
          if (fresh.length) { ping(); fresh.slice(0, 3).forEach(toast); loadConversations(); }
        }
        data.messages.forEach(m => seen.add(m.id));
      }
      firstUnread = false;
    } catch {}
  };

  // ── init ───────────────────────────────────────────────────────
  if (active) selectThread(active);
  loadConversations().then(renderHeader);
  setInterval(loadConversations, 15000);
  setInterval(loadThread, 3000);
  checkUnread();
  setInterval(checkUnread, 8000);
})();
</script>
</body>
</html>
